{
  "name": "@yuyi919/tslibs-effect",
  "private": false,
  "version": "0.4.3",
  "description": "A collection of effect libraries for TypeScript",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "biome check --write .",
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "bun test src"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "sideEffects": [],
  "type": "module",
  "dependencies": {
    "glob": "^13.0.6"
  },
  "peerDependencies": {
    "@yuyi919/shared-proto": "^0.1.23",
    "@effect/platform-bun": "catalog:",
    "effect": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@effect/sql-pg": "catalog:",
    "es-toolkit": ">= 1"
  },
  "peerDependenciesMeta": {
    "@effect/platform-bun": {
      "optional": true
    },
    "@effect/sql-sqlite-bun": {
      "optional": true
    },
    "@effect/sql-pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@yuyi919/shared-proto": "^0.1.23",
    "@types/bun": "catalog:",
    "effect": "catalog:",
    "es-toolkit": "^1.45.1",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2",
    "vite": "^8.0.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "dist",
    "examples",
    "docs",
    "!**/__tests__/**",
    "!**/*.(spec,test).js",
    "!**/*.(spec,test).d.ts",
    "package.json"
  ]
}
