{
  "name": "@yuyi919/tslibs-effect",
  "private": false,
  "version": "0.4.4",
  "description": "A collection of effect libraries for TypeScript",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./GlobalScope": {
      "types": "./dist/GlobalScope.d.ts",
      "default": "./dist/GlobalScope.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "biome check --write .",
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "bun test src"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "sideEffects": [],
  "type": "module",
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "glob": "^13.0.6",
    "memfs": "^4.57.2",
    "tslib": "^2.8.1",
    "zeptomatch": "^2.1.0"
  },
  "peerDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@yuyi919/shared-proto": "^0.1.23",
    "@parcel/watcher": ">=2",
    "effect": "catalog:",
    "es-toolkit": ">= 1",
    "pathe": ">=2"
  },
  "peerDependenciesMeta": {
    "@effect/platform-bun": {
      "optional": true
    },
    "@effect/sql-sqlite-bun": {
      "optional": true
    },
    "@effect/sql-pg": {
      "optional": true
    },
    "pathe": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@parcel/watcher": "^2.5.6",
    "@types/cross-spawn": "^6.0.6",
    "@types/bun": "catalog:",
    "@yuyi919/shared-proto": "^0.1.23",
    "effect": "catalog:",
    "es-toolkit": "^1.45.1",
    "pathe": "^2.0.3",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2",
    "vite": "^8.0.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "dist",
    "examples",
    "docs",
    "!**/__tests__/**",
    "!**/*.(spec,test).js",
    "!**/*.(spec,test).d.ts",
    "package.json"
  ],
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*.d.ts",
        "./*"
      ]
    }
  },
  "perry": {
    "compilePackages": []
  }
}
