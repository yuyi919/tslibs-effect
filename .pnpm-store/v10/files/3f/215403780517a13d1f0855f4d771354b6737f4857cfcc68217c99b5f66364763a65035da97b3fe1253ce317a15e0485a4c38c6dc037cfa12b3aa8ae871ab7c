{"version":3,"file":"Bounded.js","names":["O","clamp","B","bottom","top","reverse","R","equals","compare","boundedNumber","ordNumber","Infinity"],"sources":["src/Bounded.js"],"sourcesContent":["/**\n * The `Bounded` type class represents totally ordered types that have an upper and lower boundary.\n *\n * Instances should satisfy the following law in addition to the `Ord` laws:\n *\n * - Bounded: `bottom <= a <= top`\n *\n * @since 2.0.0\n */import*as O from\"./Ord.js\";// -------------------------------------------------------------------------------------\n// utils\n// -------------------------------------------------------------------------------------\n/**\n * Clamp a value between bottom and top values.\n *\n * @category utils\n * @since 2.12.0\n */export const clamp=B=>O.clamp(B)(B.bottom,B.top);/**\n * Reverses the Ord of a bound and swaps top and bottom values.\n *\n * @category utils\n * @since 2.12.0\n */export const reverse=B=>{const R=O.reverse(B);return{equals:R.equals,compare:R.compare,top:B.bottom,bottom:B.top}};// -------------------------------------------------------------------------------------\n// deprecated\n// -------------------------------------------------------------------------------------\n/**\n * Use [`Bounded`](./number.ts.html#bounded) instead.\n *\n * @category zone of death\n * @since 2.0.0\n * @deprecated\n */export const boundedNumber={equals:O.ordNumber.equals,compare:O.ordNumber.compare,top:Infinity,bottom:-Infinity};"],"mappings":"AAAA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA,GAAG,OAAM,KAAIA,CAAC,MAAK,UAAU,CAAC;AAC9B;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AAAG,OAAO,IAAMC,KAAK,GAACC,CAAC,IAAEF,CAAC,CAACC,KAAK,CAACC,CAAC,CAAC,CAACA,CAAC,CAACC,MAAM,EAACD,CAAC,CAACE,GAAG,CAAC,CAAC;AACpD;AACA;AACA;AACA;AACA;AAAG,OAAO,IAAMC,OAAO,GAACH,CAAC,IAAE;EAAC,IAAMI,CAAC,GAACN,CAAC,CAACK,OAAO,CAACH,CAAC,CAAC;EAAC,OAAM;IAACK,MAAM,EAACD,CAAC,CAACC,MAAM;IAACC,OAAO,EAACF,CAAC,CAACE,OAAO;IAACJ,GAAG,EAACF,CAAC,CAACC,MAAM;IAACA,MAAM,EAACD,CAAC,CAACE;EAAG,C