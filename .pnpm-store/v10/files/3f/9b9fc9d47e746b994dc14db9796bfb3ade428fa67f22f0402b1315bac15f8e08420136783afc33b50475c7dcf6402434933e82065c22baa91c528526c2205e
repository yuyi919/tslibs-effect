import * as E from "fp-ts/Either"

import { error, pipe } from "@yuyi919/shared-proto/Functions"

import * as cf from "./CodeFrame"
import * as Context from "./context"
import * as P from "./Parser"
import * as C from "./parser-ts/char"
import * as stream from "./parser-ts/Stream"
import * as PR from "./parserResult"

interface ExecLocation {
  readonly start: {
    readonly line: number
    readonly column: number
  }
}

export function getLocation(source: string, cursor: number): ExecLocation {
  const endln = /\r?\n/g
  const position = cursor
  let lastPos = 0
  let result: RegExpMatchArray | null
  let line = 0

  while ((result = endln.exec(source))) {
    if (result.index! > position) break
    lastPos = result.index! + result[0].length
    line++
  }
  return {
    start: {
      line: line + 1,
      column: (line === 0 ? position : position - lastPos) + 1,
    },
  }
}

/**
 * Returns a pretty printed error message using `@babel/code-frame`
 *
 * @since 0.6.0
 */
export const codeFrame = <I>(err: PR.ParseError<I>, source: string): string =>
  cf.codeFrameColumns(source, getLocation(source, PR.getErrorCursor(err)), {
    message: `Expected: ${PR.getExpected(err).join(", ")}`,
  })

export const run = <A>(
  p: P.Parser<C.Char, A>,
  source: string,
  startCursor = 0,
): PR.ParseSuccess<C.Char, A> | PR.ParseError<C.Char> => {
  const result = P._run(
    p,
    stream.stream(source, startCursor),
    P.EmptyParseOption,
  )
  return PR.getStruct(result)
}

export type ExecResult<I, A> =
  | {
      _tag: "ExecResult"
      success: false
      result: PR.ParseResult<I, A>
      next: number
      start: number
      end: boolean
      value: undefined
      expected: string[]
    }
  | {
      _tag: "ExecResult"
      success: true
      result: PR.ParseResult<I, A>
      next: number
      start: number
      end: boolean
      value: A
      expected: string[] | undefined
    }

export const printExecResult = (
  res: ExecResult<any, any>,
  source: stream.SeqLike<any> = PR.getSource(res.result),
): string => {
  const loca = getLocation(
    stream.seq2str(source),
    PR.getResultCursor(res.result),
  )
  return cf.codeFrameColumns(stream.seq2str(source), loca)
}

export const isExecResult = <i, A>(res: unknown): res is ExecResult<i, A> =>
  typeof res === "object" && !!res && (res as any)._tag === "ExecResult"

export function execF<I, A>(
  parser: P.Parser<I, A>,
  source: stream.SeqLike<I>,
  startCursor = 0,
): ExecResult<I, A> {
  const result = P._run(
    parser,
    stream.stream(source, startCursor),
    P.EmptyParseOption,
  )
  const success = PR.isRight(result)
  const nextCursor = success
    ? PR.getNextCursor(result)
    : PR.getErrorCursor(result)
  return {
    _tag: "ExecResult",
    next: nextCursor,
    success,
    value: success ? PR.getValue(result) : undefined,
    start: startCursor,
    end: nextCursor === source.length,
    result: PR.getStruct(result),
    expected: success ? undefined : PR.getExpected(result),
  } as ExecResult<I, A>
}

export const exec = <A>(
  p: P.Parser<string, A>,
  source: string,
  startCursor = 0,
): ExecResult<string, A> => execF(p, source as unknown as string[], startCursor)

export const runEitherF = <I, A>(
  p: P.Parser<I, A>,
  source: I[],
  startCursor = 0,
): E.Either<PR.ParseError<I>, A> =>
  pipe(
    P._run(p, stream.stream(source, startCursor), P.EmptyParseOption),
    PR.bimapEither((e) => e, PR.getValue),
  )

export const runEither: <A>(
  p: P.Parser<C.Char, A>,
  source: string,
  startCursor?: number,
) => E.Either<PR.ParseError<C.Char>, A> = Context.withCtx(
  <A>(
    p: P.Parser<C.Char, A>,
    source: string,
    startCursor: number = 0,
  ): E.Either<PR.ParseError<C.Char>, A> =>
    runEitherF(p, source as unknown as string[], startCursor),
)

export const runThrow: <A>(
  p: P.Parser<C.Char, A>,
  source: string,
  startCursor?: number,
  debug?: boolean,
) => A = Context.withCtx(
  <A>(
    p: P.Parser<C.Char, A>,
    source: string,
    startCursor: number = 0,
    debug: boolean = false,
  ): A => {
    const result = P._run(
      p,
      stream.stream(source as unknown as string[], startCursor),
      P.EmptyParseOption,
    )
    if (PR.isRight(result)) {
      if (debug) {
        console.log("输入　　 |", source)
        if (PR.getNextCursor(result) < source.length) {
          console.log("未处理流 |", source.slice(PR.getNextCursor(result)))
        }
      }
      return PR.getValue(result)
    }
    debug && console.error(result)
    throw error(codeFrame(result, source).replace(/\n/g, "\n       "))
  },
)
