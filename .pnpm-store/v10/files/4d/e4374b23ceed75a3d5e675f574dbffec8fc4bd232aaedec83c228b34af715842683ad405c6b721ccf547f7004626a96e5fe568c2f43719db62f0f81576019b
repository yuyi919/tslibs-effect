import type { Callbag, DATA, END, Source, START } from "callbag"

import {
  addEventListener,
  removeEventListener,
} from "@yuyi919/shared-proto/dom"
import { isFn } from "@yuyi919/shared-proto/JsTypes"

import { SYMBOL, UNDEFINED } from "./constant"

const START = 0 as START
const DATA = 1 as DATA
const END = 2 as END

export type CallbagInput<I, O> =
  // handshake:
  | { _tag: START; _0: true; _1: Callbag<O, I> }
  // data from source:
  | { _tag: DATA; _0: true; error: I }
  // pull request:
  | { _tag: DATA; _0: false; _1: undefined }
  // error:
  | { _tag: END; _0: true; error: unknown }
  // end without error:
  | { _tag: END; _0: false; _1: undefined }

export const CallbagInput: {
  <I, O>(
    type: START,
    hasArgs: true,
    talkback: Callbag<O, I>,
  ): CallbagInput<I, O>
  <I>(type: DATA, hasArgs: true, data: I): CallbagInput<I, never>
  <I>(type: DATA, hasArgs: false, _1: undefined): CallbagInput<I, never>
  <I>(type: END, hasArgs: true, error: unknown): CallbagInput<I, never>
  <I>(type: END, hasArgs: false, _1: undefined): CallbagInput<I, never>
} = (_tag: END | DATA | START, _0: boolean, _1: any) =>
  ({
    _tag,
    _0,
    _1,
  }) as any

