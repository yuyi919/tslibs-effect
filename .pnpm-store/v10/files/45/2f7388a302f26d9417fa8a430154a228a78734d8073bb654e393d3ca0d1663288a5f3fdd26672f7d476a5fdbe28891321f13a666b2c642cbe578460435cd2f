import * as Stream from "../Stream"

export interface IParseOption<I = any> {
  collectError?: boolean
  stream?: Stream.StreamFactory<I>
  scanMode: Stream.ConsumeMode
}

export type ParseOption<E extends {} = {}, I = any> = E &
  Partial<IParseOption<I>>

export const extendOption = <O extends ParseOption>(o: O): O & IParseOption =>
  ({
    ...o,
    collectError: o.collectError ?? EmptyParseOption.collectError,
    scanMode: o.scanMode ?? EmptyParseOption.scanMode,
  }) as O & IParseOption

export const EmptyParseOption: IParseOption = {
  collectError: true,
  scanMode: Stream.ConsumeMode.Next,
}
