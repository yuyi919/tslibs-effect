{"version":3,"file":"CodeFrame.js","names":["toString","NEWLINE","getRealLength","str","len","strLen","length","i","charCode","charCodeAt","getRealPos","pos","max","Math","min","codePointAt","undefined","getMarkerLines","loc","source","opts","startLoc","column","line","start","endLoc","end","linesAbove","linesBelow","startLine","startColumn","endLine","endColumn","lineDiff","markerLines","lineNumber","sourceLength","codeFrameColumns","rawLines","defs","gutter","marker","message","maybeHighlight","chalkFn","text","lines","split","hasColumns","numberMaxWidth","highlightedLines","frame","slice","map","index","number","paddedNumber","hasMarker","lastMarkerLine","markerLine","Array","isArray","markerSpacing","repeat","numberOfMarkers","replace","join"],"sources":["../../../src/internal/Parser/parser/CodeFrame.js"],"sourcesContent":["import { toString } from \"@yuyi919/shared-proto/JsTypes\";\n/** Syntax highlight the code as JavaScript for terminals. default: false */ /**  The number of lines to show above the error. default: 2 */ /**  The number of lines to show below the error. default: 3 */ /**\n   * Forcibly syntax highlight the code as JavaScript (for non-terminals);\n   * overrides highlightCode.\n   * default: false\n   */ /**\n   * Pass in a string to be displayed inline (if possible) next to the\n   * highlighted location in the code. If it can't be positioned inline,\n   * it will be placed above the code frame.\n   * default: nothing\n   */ /**\n * RegExp to test for newlines in terminal.\n */ const NEWLINE = /\\r\\n|[\\n\\r\\u2028\\u2029]/;\n// 获取字符串实际长度（字符串），返回字符串实际长度\nfunction getRealLength(str) {\n    if (str == null || str === \"\") {\n        return 0;\n    }\n    let len = 0;\n    const strLen = str.length;\n    for(let i = 0; i < strLen; i++){\n        const charCode = str.charCodeAt(i);\n        // 获取指定位置的字符的 Unicode 编码\n        if (charCode >= 0 && charCode <= 128) {\n            // 判断 Unicode 编码 是否在0到128，原因上面有说\n            len += 1;\n        } else {\n            len += 2;\n        }\n    }\n    return len;\n}\n// 获取字符串实际长度（字符串），返回字符串实际长度\nfunction getRealPos(str, pos) {\n    if (str == null || str === \"\") return 0;\n    let len = 0;\n    const max = Math.min(str.length, pos);\n    for(let i = 0; i <= max; i++){\n        const charCode = str.codePointAt(i);\n        // 获取指定位置的字符的 Unicode 编码\n        if (charCode === undefined) {\n            return len + 1;\n        }\n        if (charCode >= 0 && charCode <= 128) {\n            // 判断 Unicode 编码 是否在0到128，原因上面有说\n            len += 1;\n        } else {\n            len += 2;\n        }\n    }\n    return len;\n}\n/**\n * Extract what lines should be marked and highlighted.\n */ function getMarkerLines(loc, source, opts) {\n    const startLoc = {\n        column: 0,\n        // @ts-expect-error\n        line: -1,\n        ...loc.start\n    };\n    const endLoc = {\n        ...startLoc,\n        ...loc.end\n    };\n    const { linesAbove = 2, linesBelow = 3 } = opts || {};\n    const startLine = startLoc.line;\n    const startColumn = getRealPos(source[startLine - 1], startLoc.column - 1);\n    const endLine = endLoc.line;\n    const endColumn = getRealPos(source[endLine - 1], endLoc.column - 1);\n    let start = Math.max(startLine - (linesAbove + 1), 0);\n    let end = Math.min(source.length, endLine + linesBelow);\n    if (startLine === -1) {\n        start = 0;\n    }\n    if (endLine === -1) {\n        end = source.length;\n    }\n    const lineDiff = endLine - startLine;\n    const markerLines = {};\n    if (lineDiff) {\n        for(let i = 0; i <= lineDiff; i++){\n            const lineNumber = i + startLine;\n            if (!startColumn) {\n                markerLines[lineNumber] = true;\n            } else if (i === 0) {\n                const sourceLength = getRealLength(source[lineNumber - 1]);\n                markerLines[lineNumber] = [\n                    startColumn,\n                    sourceLength - startColumn + 1\n                ];\n            } else if (i === lineDiff) {\n                source[lineNumber];\n                markerLines[lineNumber] = [\n                    0,\n                    endColumn\n                ];\n            } else {\n                const sourceLength = getRealLength(source[lineNumber - i]);\n                markerLines[lineNumber] = [\n                    0,\n                    sourceLength\n                ];\n            }\n        }\n    } else if (startColumn === endColumn) {\n        if (startColumn) {\n            markerLines[startLine] = [\n                startColumn,\n                0\n            ];\n        } else {\n            markerLines[startLine] = true;\n        }\n    } else {\n        markerLines[startLine] = [\n            startColumn,\n            endColumn - startColumn\n        ];\n    }\n    return {\n        start,\n        end,\n        markerLines\n    };\n}\nexport function codeFrameColumns(rawLines, loc, opts = {}) {\n    // const highlighted = false;\n    // (opts.highlightCode || opts.forceColor) && shouldHighlight(opts);\n    // const chalk = getChalk(opts);\n    // const defs = getDefs(chalk);\n    const defs = {\n        gutter: \"\",\n        marker: \"\",\n        message: \"\"\n    };\n    const maybeHighlight = (chalkFn, text)=>// return highlighted ? chalkFn(text) : text;\n        text;\n    const lines = rawLines.split(NEWLINE);\n    const { start, end, markerLines } = getMarkerLines(loc, lines, opts);\n    const hasColumns = loc.start && typeof loc.start.column === \"number\";\n    const numberMaxWidth = toString(end).length;\n    // const highlightedLines = highlighted ? highlight(rawLines, opts) : rawLines;\n    const highlightedLines = rawLines;\n    let frame = highlightedLines.split(NEWLINE, end).slice(start, end).map((line, index)=>{\n        const number = start + 1 + index;\n        const paddedNumber = ` ${number}`.slice(-numberMaxWidth);\n        const gutter = ` ${paddedNumber} |`;\n        const hasMarker = markerLines[number];\n        const lastMarkerLine = !markerLines[number + 1];\n        if (hasMarker) {\n            let markerLine = \"\";\n            if (Array.isArray(hasMarker)) {\n                const markerSpacing = \" \".repeat(Math.max(hasMarker[0] - 1, 0));\n                const numberOfMarkers = hasMarker[1] || 1;\n                markerLine = [\n                    \"\\n \",\n                    maybeHighlight(defs.gutter, gutter.replace(/\\d/g, \" \")),\n                    \" \",\n                    markerSpacing,\n                    maybeHighlight(defs.marker, \"^\").repeat(numberOfMarkers)\n                ].join(\"\");\n                if (lastMarkerLine && opts.message) {\n                    markerLine += ` ${maybeHighlight(defs.message, opts.message)}`;\n                }\n            }\n            return [\n                maybeHighlight(defs.marker, \">\"),\n                maybeHighlight(defs.gutter, gutter),\n                line.length > 0 ? ` ${line}` : \"\",\n                markerLine\n            ].join(\"\");\n        }\n        return ` ${maybeHighlight(defs.gutter, gutter)}${line.length > 0 ? ` ${line}` : \"\"}`;\n    }).join(\"\\n\");\n    if (opts.message && !hasColumns) {\n        frame = `${\" \".repeat(numberMaxWidth + 1)}${opts.message}\\n${frame}`;\n    }\n    // if (highlighted) {\n    //   return chalk.reset(frame);\n    // } else {\n    return frame;\n} // }\n"],"mappings":"AAAA,SAASA,QAAQ,QAAQ,+BAA+B;AACxD,6EAA6E,gEAAgE,gEAAgE;AAC7M;AACA;AACA;AACA,+MAJ6M,CAIvM;AACN;AACA;AACA;AACA;AACA,kNALM,CAKA;AACN;AACA;AAAI,IAAMC,OAAO,GAAG,yBAAyB;AAC7C;AAAA,IACSC,aAAa,GAACC,GAAG,IAAE;EACxB,IAAIA,GAAG,IAAI,IAAI,IAAIA,GAAG,KAAK,EAAE,EAAE;IAC3B,OAAO,CAAC;EACZ;EACA,IAAIC,GAAG,GAAG,CAAC;EACX,IAAMC,MAAM,GAAGF,GAAG,CAACG,MAAM;EACzB,KAAI,IAAIC,CAAC,GAAG,CAAC,EAAEA,CAAC,GAAGF,MAAM,EAAEE,CAAC,EAAE,EAAC;IAC3B,IAAMC,QAAQ,GAAGL,GAAG,CAACM,UAAU,CAACF,CAAC,CAAC;IAClC;IACA,IAAIC,QAAQ,IAAI,CAAC,IAAIA,QAAQ,IAAI,GAAG,EAAE;MAClC;MACAJ,GAAG,IAAI,CAAC;IACZ,