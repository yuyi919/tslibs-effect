{"version":3,"file":"IORef.js","names":["IORef","constructor","value","read","write","bind","modify","a","f","newIORef"],"sources":["src/IORef.js"],"sourcesContent":["/**\n * Mutable references in the `IO` monad\n *\n * @since 2.0.0\n *//**\n * @example\n * import { flatMap } from 'fp-ts/IO'\n * import { newIORef } from 'fp-ts/IORef'\n *\n * assert.strictEqual(flatMap(newIORef(1), ref => flatMap(ref.write(2), () => ref.read))(), 2)\n *\n * @category model\n * @since 2.0.0\n */export class IORef{constructor(value){this.value=value;this.read=()=>this.value;this.write=this.write.bind(this);this.modify=this.modify.bind(this)}/**\n   * @since 2.0.0\n   */write(a){return()=>{this.value=a}}/**\n   * @since 2.0.0\n   */modify(f){return()=>{this.value=f(this.value)}}}/**\n * @category constructors\n * @since 2.0.0\n */export function newIORef(a){return()=>new IORef(a)}"],"mappings":"AAAA;AACA;AACA;AACA;AACA,GAJA,CAIG;AACH;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA,MAAG,OAAO,MAAMA,KAAK;EAACC,WAAWA,CAACC,KAAK,EAAC;IAAC,IAAI,CAACA,KAAK,GAACA,KAAK;IAAC,IAAI,CAACC,IAAI,GAAC,MAAI,IAAI,CAACD,KAAK;IAAC,IAAI,CAACE,KAAK,GAAC,IAAI,CAACA,KAAK,CAACC,IAAI,CAAC,IAAI,CAAC;IAAC,IAAI,CAACC,MAAM,GAAC,IAAI,CAACA,MAAM,CAACD,IAAI,CAAC,IAAI,CAAC;EAAA,CAAC;AACvJ;AACA;EAAKD,KAAKA,CAACG,CAAC,EAAC;IAAC,OAAM,MAAI;MAAC,IAAI,CAACL,KAAK,GAACK,CAAC;IAAA,CAAC;EAAA,CAAC;AACvC;AACA;EAAKD,MAAMA,CAACE,CAAC,EAAC;IAAC,OAAM,MAAI;MAAC,IAAI,CAACN,KAAK,GAACM,CAAC,CAAC,IAAI,CAACN,KAAK,CAAC;IAAA,CAAC;EAAA;AAAC,CAAC;AACrD;AACA;AACA;AAAG,WAAgBO,QAAQ,GAACF,CAAC,IAAQ,MAAI,IAAIP,KAAK,CAACO,CAAC,CAAC","ignoreList":[]}