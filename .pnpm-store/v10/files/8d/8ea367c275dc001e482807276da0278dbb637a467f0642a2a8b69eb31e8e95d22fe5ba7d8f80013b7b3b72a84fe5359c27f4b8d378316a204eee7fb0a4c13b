  }
}

type i64 = readonly [number, number]

function i64_eq(x: i64, y: i64): boolean {
  if (x[1] === y[1]) {
    return x[0] === y[0]
  } else {
    return false
  }
}

function i64_ge(x: i64, y: i64): boolean {
  var other_hi = y[0]
  var hi = x[0]
  if (hi > other_hi) {
    return true
  } else if (hi < other_hi) {
    return false
  } else {
    return x[1] >= y[1]
  }
}

function i64_neq(x: i64, y: i64): boolean {
  return !i64_eq(x, y)
}

function i64_lt(x: i64, y: i64): boolean {
  return !i64_ge(x, y)
}

function i64_gt(x: i64, y: i64): boolean {
  if (x[0] > y[0]) {
    return true
  } else if (x[0] < y[0]) {
    return false
  } else {
    return x[1] > y[1]
  }
}

function i64_le(x: i64, y: i64): boolean {
  return !i64_gt(x, y)
}

function i64_min(x: i64, y: i64): i64 {
  if (i64_ge(x, y)) {
    return y
  } else {
    return x
  }
}

function i64_max(x: i64, y: i64): i64 {
  if (i64_gt(x, y)) {
    return x
  } else {
    return y
  }
}

