function int_compare(x: number, y: number): 1 | 0 | -1 {
  if (x < y) {
    return -1
  } else if (x === y) {
    return 0
  } else {
    return 1
  }
}

function bool_compare(x: boolean, y: boolean): 1 | 0 | -1 {
  if (x) {
    if (y) {
      return 0
    } else {
      return 1
    }
  } else if (y) {
    return -1
  } else {
    return 0
  }
}

function float_compare(x: number, y: number): 1 | 0 | -1 {
  if (x === y) {
    return 0
  } else if (x < y) {
    return -1
  } else if (x > y || x === x) {
    return 1
  } else if (y === y) {
    return -1
  } else {
    return 0
  }
}

function bigint_compare(x: bigint, y: bigint): 1 | 0 | -1 {
  if (x < y) {
    return -1
  } else if (x === y) {
    return 0
  } else {
    return 1
  }
}

function string_compare(s1: string, s2: string): 1 | 0 | -1 {
  if (s1 === s2) {
    return 0
  } else if (s1 < s2) {
    return -1
  } else {
    return 1
  }
}

function bool_min(x: boolean, y: boolean): boolean {
  if (x) {
    return y
  } else {
    return x
  }
}

function int_min(x: number, y: number): number {
  if (x < y) {
    return x
  } else {
