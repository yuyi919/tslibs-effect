  }
}

function float_min(x: number, y: number): number {
  if (x < y) {
    return x
  } else {
    return y
  }
}

function string_min(x: string, y: string): string {
  if (x < y) {
    return x
  } else {
    return y
  }
}

function bool_max(x: any, y: any): any {
  if (x) {
    return x
  } else {
