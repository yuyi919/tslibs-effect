/**
 * @since 0.0.0
 * @category getters
 */
export function toMillis(self: Duration): number
export function toMillis({ A: value }: Duration): number {
  if (JsTypes.isUnsafeNum(value)) {
    return value
  } else {
    return NUMBER(value) / int1e6
  }
}

/**
 * @since 0.0.0
 * @category getters
 */
export function toSeconds(self: Duration): number {
  return _match(
    self,
    (millis) => millis / int1e3,
    (nanos) => NUMBER(nanos) / int1e9,
  )
}

/**
 * Get the duration in nanoseconds as a bigint.
 *
 * If the duration is infinite, it throws an error.
 *
 * @since 0.0.0
 * @category getters
 */
export function unsafeToNanos(self: Duration): bigint
export function unsafeToNanos({ A: value }: Duration): bigint {
  if (JsTypes.isUnsafeNum(value)) {
    return BIGINT(Math.round(value * int1e6))
  }
  return value
}

/**
 * Get the duration in nanoseconds as a bigint.
 *
 * If the duration is infinite, returns `Option.none()`
 *
 * @since 0.0.0
 * @category getters
 */
export function toNanos(self: Duration): Option.Option<bigint> {
  return Option.liftPredicate(
    (self: Duration) => self.A !== INFINITY,
    unsafeToNanos,
  )(self)
}

/**
 * @since 0.0.0
 * @category getters
 */
export function toHrTime(self: Duration): [seconds: number, nanos: number]
export function toHrTime({
  A: value,
}: Duration): [seconds: number, nanos: number] {
  if (value === INFINITY) {
    return [INFINITY, 0]
  } else if (JsTypes.isUnsafeNum(value)) {
    return [Math.floor(value / 1000), Math.round((value % 1000) * 1000000)]
  } else {
    return [NUMBER(value / bigint1e9), NUMBER(value % bigint1e9)]
  }
}

export function _match<A, B>(
  self: Duration,
  onMillis: (millis: number) => A,
  onNanos: (nanos: bigint) => B,
): A | B
export function _match<A, B>(
  { A: value }: Duration,
  onMillis: (millis: number) => A,
  onNanos: (nanos: bigint) => B,
): A | B {
  if (JsTypes.isUnsafeNum(value)) {
    return onMillis(value)
  } else {
    return onNanos(value)
  }
}

/**
 * @since 0.0.0
 * @category pattern matching
 */
export const match: {
  <A, B>(
    onMillis: (millis: number) => A,
    onNanos: (nanos: bigint) => B,
  ): (self: Duration) => A | B
  <A, B>(
    self: Duration,
    onMillis: (millis: number) => A,
    onNanos: (nanos: bigint) => B,
  ): A | B
} = dual(3, _match)

/**
 * @since 0.0.0
 * @category pattern matching
 */
export const decodeAndMatch: {
  <A, B>(
    onMillis: (millis: number) => A,
    onNanos: (nanos: bigint) => B,
  ): (self: DurationInput) => A | B
  <A, B>(
    self: DurationInput,
    onMillis: (millis: number) => A,
    onNanos: (nanos: bigint) => B,
  ): A | B
} = dual(
  3,
  <A, B>(
    value: Duration,
    onMillis: (millis: number) => A,
    onNanos: (nanos: bigint) => B,
  ): A | B => _match(decode(value), onMillis, onNanos),
)

export function _matchWith<A, B>(
  self: Duration,
  that: Duration,
  onMillis: (self: number, that: number) => A,
  onNanos: (self: bigint, that: bigint) => B,
): A | B {
  if (self.A === INFINITY || that.A === INFINITY) {
    return onMillis(toMillis(self), toMillis(that))
  } else if (isNanos(self.A) || isNanos(that.A)) {
    return onNanos(unsafeToNanos(self), unsafeToNanos(that))
  }
  return onMillis(self.A, that.A)
}

/**
 * @since 0.0.0
 * @category pattern matching
 */
export const decodeAndMatchWith: {
  <A, B>(
    that: DurationInput,
    onMillis: (self: number, that: number) => A,
    onNanos: (self: bigint, that: bigint) => B,
  ): (self: DurationInput) => A | B
  <A, B>(
    self: DurationInput,
    that: DurationInput,
    onMillis: (self: number, that: number) => A,
    onNanos: (self: bigint, that: bigint) => B,
  ): A | B
} = dual(
  4,
  <A, B>(
    self: Duration,
    that: Duration,
    onMillis: (self: number, that: number) => A,
    onNanos: (self: bigint, that: bigint) => B,
  ): A | B => {
    return _matchWith(decode(self), decode(that), onMillis, onNanos)
  },
)

/**
 * @since 0.0.0
 * @category pattern matching
 */
export const matchWith: {
  <A, B>(
    that: Duration,
    onMillis: (self: number, that: number) => A,
    onNanos: (self: bigint, that: bigint) => B,
  ): (self: Duration) => A | B
  <A, B>(
    self: Duration,
    that: Duration,
    onMillis: (self: number, that: number) => A,
    onNanos: (self: bigint, that: bigint) => B,
  ): A | B
} = dual(4, _matchWith)

