export const $Duration = "Duration"
export const TypeId: unique symbol = Symbol.for(signed($Duration))

const bigint0 = BIGINT(0)
const bigint24 = BIGINT(24)
const bigint60 = BIGINT(60)
const bigint1e3 = BIGINT(1e3)
const bigint1e6 = BIGINT(1e6)
const bigint1e9 = BIGINT(1e9)

const int1e3 = 1e3
const int1e6 = 1e6
const int1e9 = 1e9

/**
 * @since 0.0.0
 * @category symbol
 */
export type TypeId = typeof TypeId

/**
 * @category models
 */
export interface DurationExtensions {}
/**
 * @category models
 */
export interface DurationProto extends Pipeable {
  readonly [TypeId]: (_: unknown) => void
}

/**
 * @category models
 */
export interface Duration extends DurationProto, DurationExtensions {
  readonly A: DurationValue
}

export type DurationValue = number | bigint

export function isInfinity(value: unknown): value is DurationValue {
  return value === INFINITY
}

export function isNanos(value: DurationValue): value is bigint {
  return JsTypes.isBigInt(value)
}

/**
 * @since 0.0.0
 * @category models
 */
export type Unit =
  | "nano"
  | "nanos"
  | "micro"
  | "micros"
  | "milli"
  | "millis"
  | "second"
  | "seconds"
  | "minute"
  | "minutes"
  | "hour"
  | "hours"
  | "day"
  | "days"
  | "week"
  | "weeks"

export type ShortcutUnit = "d" | "h" | "m" | "s" | "ms" | "µs" | "ns"

/**
 * @since 0.0.0
 * @category models
 */
export type DurationInput =
  | Duration
  | number // millis
  | bigint // nanos
  | [seconds: number, nanos: number]
  | DurationInputString

/**
 * @since 0.0.0
 * @category models
 */
export type DurationInputString =
  | `${number} ${Unit}`
  | `${number}${ShortcutUnit}`
const DURATION_REGEX =
  /^(-?\d+(?:\.\d+)?)(?:[ ]*(d|h|m|[mµn]?s)|[ ]+(nano|micro|milli|second|minute|hour|day|week)s?)$/

const InvalidDurationInputErrorMessage = "Invalid DurationInput"
/**
 * @since 0.0.0
 */
export function decode(input: DurationInput): Duration {
  if (isDuration(input)) {
    return input
  } else if (JsTypes.isStr(input)) {
    return parse(input)
  } else if (JsTypes.isUnsafeNum(input)) {
    return millis(input)
  } else if (JsTypes.isBigInt(input)) {
    return nanos(input)
  } else if (JsTypes.isArr(input)) {
    return nanos(BIGINT(input[0]) * bigint1e9 + BIGINT(input[1]))
  } else {
    return raise(syntaxError(InvalidDurationInputErrorMessage))
  }
}

export function parse(input: DurationInputString): Duration {
  DURATION_REGEX.lastIndex = 0 // Reset the lastIndex before each use
  const match = DURATION_REGEX.exec(input)
  const valueStr = match?.[1]
  const s_unit = match?.[2] as ShortcutUnit | undefined
  const unit = match?.[3] as Unit | undefined
  if (match) {
    if (unit === "nano" || s_unit === "ns") {
      return nanos(BIGINT(valueStr!))
    } else if (unit === "micro" || s_unit === "µs") {
      return micros(BIGINT(valueStr!))
    } else if (unit === "milli" || s_unit === "ms") {
      return millis(NUMBER(valueStr))
    } else if (unit === "second" || s_unit === "s") {
      return seconds(NUMBER(valueStr))
    } else if (unit === "minute" || s_unit === "m") {
      return minutes(NUMBER(valueStr))
    } else if (unit === "hour" || s_unit === "h") {
      return hours(NUMBER(valueStr))
    } else if (unit === "day" || s_unit === "d") {
      return days(NUMBER(valueStr))
    } else if (unit === "week") {
      return weeks(NUMBER(valueStr))
    } else {
      return raise(error(InvalidDurationInputErrorMessage))
    }
  } else {
    return raise(error(InvalidDurationInputErrorMessage))
  }
}

/**
 * @since 0.0.0
 */
export const decodeUnknown: (u: unknown) => Option.Option<Duration> =
  Option.liftThrowable(decode) as any

export const zeroValue: DurationValue = 0

export const infinityValue: DurationValue = INFINITY

export const DurationProto: DurationProto = pipe(
  {
    [TypeId]: ignore,
  },
  Extensions.Add(PipeableProto),
)

export function addExtensions<Extends extends {}>(
  exts: Partial<DurationProto> & Extends,
): DurationProto & Extends {
  return Extensions.AddTo(DurationProto)(exts)
}

const make = (input: number | bigint): Duration => {
  const duration = OBJ_CREATE(DurationProto) as Mutable<Duration>
  if (JsTypes.isUnsafeNum(input)) {
    if (input !== input || input <= 0) {
      duration.A = zeroValue
    } else if (!JsTypes.isFinite(input)) {
      duration.A = infinityValue
    } else if (!JsTypes.isInteger(input)) {
      duration.A = BIGINT(Math.round(input * int1e6))
    } else {
      duration.A = input
    }
  } else {
    duration.A = input <= bigint0 ? zeroValue : input
  }
  return duration
}

/**
 * @since 0.0.0
 * @category guards
 */
export const isDuration = (u: unknown): u is Duration =>
  JsTypes.isObj(u) && TypeId in u

/**
 * @since 0.0.0
 * @category guards
 */
export function isZero(duration: Duration): boolean
export function isZero({ A: value }: Duration): boolean {
  if (value === INFINITY) {
    return false
  } else if (value === 0) {
    return true
  } else {
    return value === bigint0
  }
}

