export function _divide(self: Duration, by: number): Option.Option<Duration> {
  return _match(
    self,
    (millis) => {
      if (by === 0 || by !== by || !JsTypes.isFinite(by)) {
        return Option.none()
      }
      return Option.some(make(millis / by))
    },
    (nanos) => {
      if (by !== by || by <= 0 || !JsTypes.isFinite(by)) {
        return Option.none()
      }
      return tryCatch(
        () => Option.some(make(nanos / BIGINT(by))),
        () => Option.none(),
      )
    },
  )
}
/**
 * @since 0.0.0
 * @category math
 */
export const divide: {
  (by: number): (self: Duration) => Option.Option<Duration>
  (self: Duration, by: number): Option.Option<Duration>
} = dual(2, _divide)

export function _unsafeDivide(self: Duration, by: number): Duration {
  return _match(
    self,
    (millis) => make(millis / by),
    (nanos) => {
      if (by !== by || by < 0 || OBJECT_IS(by, -0)) {
        return zero
      } else if (by === 0 || !JsTypes.isFinite(by)) {
        return infinity
      }
      return make(nanos / BIGINT(by))
    },
  )
}

