function _parts(
  days: number,
  hours: number,
  minutes: number,
  seconds: number,
  millis: number,
  nanos: number,
) {
  return {
    days,
    hours,
    minutes,
    seconds,
    millis,
    nanos,
  }
}

/**
 * Converts a `Duration` to its parts.
 *
 * @since 0.0.0
 * @category conversions
 */
export function parts(self: DurationInput): {
  days: number
  hours: number
  minutes: number
  seconds: number
  millis: number
  nanos: number
} {
  const duration = decode(self)
  if (duration.A === INFINITY) {
    return _parts(INFINITY, INFINITY, INFINITY, INFINITY, INFINITY, INFINITY)
  }

  const nanos = unsafeToNanos(duration)
  const ms = nanos / bigint1e6
  const sec = ms / bigint1e3
  const min = sec / bigint60
  const hr = min / bigint60
  const days = hr / bigint24

  return _parts(
    NUMBER(days),
    NUMBER(hr % bigint24),
    NUMBER(min % bigint60),
    NUMBER(sec % bigint60),
    NUMBER(ms % bigint1e3),
    NUMBER(nanos % bigint1e6),
  )
}

/**
 * Converts a `Duration` to a human readable string.
 * @since 0.0.0
 *
 * @example
 *
 * toDurationString(Duration.millis(1000)) // "1s"
 * toDurationString(Duration.millis(1001)) // "1s 1ms"
 */
export function toDurationString(self: DurationInput): string {
  const duration = decode(self)
  const parts: string[] = []

  if (duration.A === INFINITY) {
    return "Infinity"
  }

  const nanos = unsafeToNanos(duration)

  if (nanos % bigint1e6) {
    parts.push(`${nanos % bigint1e6}ns`)
  }

  const ms = nanos / bigint1e6
  if (ms % bigint1e3 !== bigint0) {
    parts.push(`${ms % bigint1e3}ms`)
  }

  const sec = ms / bigint1e3
  if (sec % bigint60 !== bigint0) {
    parts.push(`${sec % bigint60}s`)
  }

  const min = sec / bigint60
  if (min % bigint60 !== bigint0) {
    parts.push(`${min % bigint60}m`)
  }

  const hr = min / bigint60
  if (hr % bigint24 !== bigint0) {
    parts.push(`${hr % bigint24}h`)
  }

  const days = hr / bigint24
  if (days !== bigint0) {
    parts.push(`${days}d`)
  }

  return parts.reverse().join(" ")
}
