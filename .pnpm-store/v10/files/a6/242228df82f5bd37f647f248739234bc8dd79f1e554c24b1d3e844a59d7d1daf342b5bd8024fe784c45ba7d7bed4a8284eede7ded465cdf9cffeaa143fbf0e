import * as Monoid from "@effect/typeclass/Monoid"
import * as Semigroup from "@effect/typeclass/Semigroup"
import * as FpTsMonoid from "fp-ts/Monoid"

import { constant, constEmptyArray } from "../function"
import { isNil, isNotNil } from "../JsTypes"
import { Nilable } from "../Types"
import { NULL, UNDEFINED } from "./constant"
import { assign } from "./object"
import * as ComplexSemigroup from "./Semigroup"

export interface ComplexMonoid<A>
  extends Monoid.Monoid<A>,
    ComplexSemigroup.ComplexSemigroupOrMonoid<A> {
  _tag: "Monoid"
  readonly empty: A
  readonly combineAll: (collection: Iterable<A>) => A
}

export function toComplex<A>(m: Monoid.Monoid<A>): ComplexMonoid<A> {
  return assign(ComplexSemigroup.toComplex(m), { _tag: "Monoid" } as const)
}

export function fromSemigroup<A>(
  m: Semigroup.Semigroup<A>,
  empty: A,
): ComplexMonoid<A> {
  return toComplex(Monoid.fromSemigroup(m, empty))
}

export function fromFpTs<A>(m: FpTsMonoid.Monoid<A>): ComplexMonoid<A> {
  return fromSemigroup(ComplexSemigroup.fromFpTs(m), getEmpty(m))
}

export function getEmpty<A>(m: FpTsMonoid.Monoid<A>): A {
  return m.empty
}

export function getArrayMonoid<A>(): ComplexMonoid<ReadonlyArray<A>> {
  return constant(
    fromSemigroup(ComplexSemigroup.getArraySemigroup<A>(), constEmptyArray()),
  )()
}

export function getArrayMonoidFpTs<A>(): ComplexMonoid<readonly A[]> {
  return constant(toComplex(getArrayMonoid<A>()))()
}

export const UndefinedMonoid: ComplexMonoid<undefined> = fromSemigroup(
  ComplexSemigroup.UndefinedSemigroup,
  UNDEFINED,
)

export const VoidMonoid: ComplexMonoid<void> =
  UndefinedMonoid as ComplexMonoid<void>

export const NullMonoid: ComplexMonoid<null> = fromSemigroup(
  ComplexSemigroup.NullSemigroup,
  NULL,
)

export function getNilableMonoid<A>(
  monoid: ComplexMonoid<A>,
): ComplexMonoid<Nilable<A>> {
  const { combine, concat, combineMany } =
    ComplexSemigroup.getNilableSemigroup<A>(monoid)
  return {
    ...monoid,
    combine,
    concat,
    combineMany,
    combineAll(collection) {
      return monoid.combineAll(Array.from(collection).filter(isNotNil))
    },
  }
}
