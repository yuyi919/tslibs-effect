  ..._: ((_: Z) => Z)[]
): Z {
  return _.reduce(
    (r, a) => a(r),
    pipe25(
      a,
      ab!,
      bc!,
      cd!,
      de!,
      ef!,
      fg!,
      gh!,
      hi!,
      ij!,
      jk!,
      kl!,
      lm!,
      mn!,
      no!,
      op!,
      pq!,
      qr!,
      rs!,
      st!,
      tu!,
      uv!,
      vw!,
      wx!,
      xy!,
      yz!,
    ),
  )
}

