== 0 ? x : [\n            ...x,\n            ...y\n        ], (a, then)=>[\n            ...a,\n            ...Array.from(then).flat(1)\n        ]))();\n}\nexport function getNilableSemigroup(semigroup) {\n    return makeComplex((x, y)=>isNil(x) || isNil(y) ? x ?? y : semigroup.combine(x, y), (head, then)=>{\n        const { combineMany, combineAll } = semigroup;\n        const array = Array.from(then).filter(isNotNil);\n        if (isNil(head)) {\n            if (combineAll) return combineAll(array);\n            return array.length < 2 ? array[0] : combineMany(array[0], array.slice(1));\n        }\n        return array.length === 0 ? head : combineMany(head, array);\n    });\n}\nexport const VoidSemigroup = makeComplex(ignore, ignore);\nexport const UndefinedSemigroup = VoidSemigroup;\nexport const NullSemigroup = makeComplex(constNull, constNull);\nexport const NumberAddSemigroup = makeComplex((a, b)=>a + b);\nexport const NumberSubSemigroup = makeComplex((a, b)=>a - b);\nexport { array, constant, first, imap, intercalate, last, make, max, min, reverse, Product, SemiProduct, struct } from \"@effect/typeclass/Semigroup\";\n","import * as Monoid from \"@effect/typeclass/Monoid\";\nimport { constant, constEmptyArray } from \"../function/index.js\";\nimport { isNotNil } from \"../JsTypes.js\";\nimport { NULL, UNDEFINED } from \"./constant/index.js\";\nimport { assign } from \"./object.js\";\nimport * as ComplexSemigroup from \"./Semigroup.js\";\nexport function toComplex(m) {\n    return assign(ComplexSemigroup.toComplex(m), {\n        _tag: \"Monoid\"\n    });\n}\nexport function fromSemigroup(m, empty) {\n    return toComplex(Monoid.fromSemigroup(m, empty));\n}\nexport function fromFpTs(m) {\n    return fromSemigroup(ComplexSemigroup.fromFpTs(m), getEmpty(m));\n}\nexport function getEmpty(m) {\n    return m.empty;\n}\nexport function getArrayMonoid() {\n    return constant(fromSemigroup(ComplexSemigroup.getArraySemigroup(), constEmptyArray()))();\n}\nexport function getArrayMonoidFpTs() {\n    return constant(toComplex(getArrayMonoid()))();\n}\nexport const UndefinedMonoid = fromSemigroup(ComplexSemigroup.UndefinedSemigroup, UNDEFINED);\nexport const VoidMonoid = UndefinedMonoid;\nexport const NullMonoid = fromSemigroup(ComplexSemigroup.NullSemigroup, NULL);\nexport function getNilableMonoid(monoid) {\n    const { combine, concat, combineMany } = ComplexSemigroup.getNilableSemigroup(monoid);\n    return {\n        ...monoid,\n        combine,\n        concat,\n        combineMany,\n        combineAll (collection) {\n            return monoid.combineAll(Array.from(collection).filter(isNotNil));\n        }\n    };\n}\n"]}