import { inspect } from "node:util"
import { describe, expect, it } from "vitest"

import * as Equal from "effect/Equal"
import * as Hash from "effect/Hash"

import * as F from "../Functions"
import * as O from "../Option"
import { addOptionPreset } from "../PresetExtensions"
import * as Proto from "../Proto"

addOptionPreset()

describe("Option", () => {
  it("inspect", () => {
    class Cls {
      declare a: number
      get b() {
        return this.a
      }
    }

    expect(Proto.setPrototypeOf({ a: 1 }, Cls.prototype).b).toBe(1)
    expect(
      Proto.setPrototypeOf(Object.create({ a: 1 }), Cls.prototype).b,
    ).toBeUndefined()

    expect(Object.setPrototypeOf(Object.create({}), { a: 1 }).a).toBe(1)
    expect(O.some(2).exists).toBe(true)
    expect(O.some(2).value).toBe(2)
    expect(O.none().value).toBeUndefined()
    expect(O.none().exists).toBe(false)
    expect(O.SomeValue(2).toJSON()).toEqual({ _tag: "Some", value: 2 })
    expect(O.some(2).toJSON()).toEqual({ _tag: "Some", value: 2 })
    expect(O.isSome(O.some(2))).toBe(true)
    expect(O.isNone(O.none())).toBe(true)
    expect(O.some(2).toString()).toEqual("Some(2)")
    expect(inspect(O.some(O.some(2)))).toEqual("Some(Some(2))")
    expect(inspect(O.some({ _: O.some(2) }))).toEqual("Some({ _: Some(2) })")
  })

  it("hash", () => {
    expect(Hash.hash(O.some(2))).toBe(Hash.hash(O.some(2)))
    expect(Equal.equals(O.some(2), O.some(2))).toBe(true)
  })
  it("entries", () => {
    expect(O.nonEmptyString("")).toEqual(O.None())
    expect(O.nonEmptyString()).toEqual(O.None())
    expect(O.nonEmptyString(null)).toEqual(O.None())
    expect(O.nonEmptyString("   ")).toEqual(O.None())
    expect(O.nonEmptyString("foobar")).toEqual(O.SomeValue("foobar"))

    expect(O.fromBoolean(1, true)).toEqual(O.SomeValue(1))
    expect(O.fromBoolean(1, false)).toEqual(O.None())

    expect(O.fromNullable(false)).toEqual(O.SomeValue(false))
    expect(O.fromNullable(null)).toEqual(O.None())

    expect(O.fromProperty({ foo: 1 }, "foo")).toEqual(O.SomeValue(1))
    expect(O.fromProperty({ foo: 1 }, "foo2")).toEqual(O.None())
    expect(O.fromProperty({}, "foo")).toEqual(O.None())
    expect(O.fromProperty({ foo: null }, "foo")).toEqual(O.SomeValue(null))

    expect(O.fromNullableProperty({ foo: 1 }, "foo")).toEqual(O.SomeValue(1))
    expect(O.fromNullableProperty({}, "foo")).toEqual(O.None())
    expect(O.fromNullableProperty({ foo: null }, "foo")).toEqual(O.None())
    expect(O.fromNullableProperty(undefined, "")).toEqual(O.none())

    expect(O.fromProperty("", "length")).toEqual(O.some(0))
    expect(O.fromProperty([], "length")).toEqual(O.some(0))

    expect(O.find([1, 2], (a) => a === 2)).toEqual(O.some(2))
    expect(O.find([1, 2], (a) => a === 3)).toEqual(O.none())
    expect(O.findLast([1, 2], (a) => a === 1)).toEqual(O.some(1))
    expect(O.findLast([1, 2], (a) => a === 3)).toEqual(O.none())

    expect(O.none<number>().chain((v) => O.some(v + 1))).toEqual(O.none())
    expect(O.none<number>().mapTo(1)).toEqual(O.none())
    expect(O.some<number>(2).mapTo(1)).toEqual(O.some(1))
    expect(
      O.none<number>()
        .chain((v) => O.some(v + 1))
        .orOption(() => O.some(3)),
    ).toEqual(O.some(3))
    expect(O.some(1).chain((v) => O.some(v + 1))).toEqual(O.some(2))
    expect(O.some(1).map((v) => O.some(v + 1))).toEqual(O.some(O.some(2)))
    expect(O.some(1).mapTo(3)).toEqual(O.some(3))

    expect(O.none<number>().bindTo("a")).toEqual(O.none())
    expect(O.some<number>(1).bindTo("a")).toEqual(O.some({ a: 1 }))
    expect(O.some<number>(1).mapTry(() => F.raise(void 0))).toEqual(O.none())
    expect(O.some<number>(1).tryOr((): string => F.raise(void 0))).toEqual(
      O.some(1),
    )

    O.some<string[]>([]).tapSelf((o) => {
      expect(o.tryOr(() => F.raise(void 0) as [1])).toEqual(O.some([]))
    })

    expect(O.none<string[]>().getOr(() => [])).toEqual([])
  })
})
