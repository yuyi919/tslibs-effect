import type * as FpTsSemigroup from "fp-ts/Semigroup"
import * as Semigroup from "@effect/typeclass/Semigroup"

import { constant, constEmptyArray, constNull, ignore } from "../function"
import { isNil, isNotNil } from "../JsTypes"
import { Nilable } from "../Types"

export interface ComplexSemigroupOrMonoid<A>
  extends Semigroup.Semigroup<A>,
    FpTsSemigroup.Semigroup<A> {
  readonly combine: (self: A, that: A) => A
  /** @deprecated 保留fp-ts的兼容，推荐用{@link combine} */
  readonly concat: (self: A, that: A) => A
  readonly combineMany: (self: A, collection: Iterable<A>) => A

  /** @internal */
  readonly empty?: A
  /** @internal */
  readonly combineAll?: (collection: Iterable<A>) => A
}

export interface ComplexSemigroup<A> extends ComplexSemigroupOrMonoid<A> {
  _tag: "Semigroup"
}

export { type ComplexSemigroup as T }

export function toComplex<S extends Semigroup.Semigroup<any>>(
  m: S,
): S & { concat: S["combine"]; _tag: "Semigroup" }
export function toComplex<A>(m: Semigroup.Semigroup<A>): ComplexSemigroup<A>
export function toComplex<A>(m: Semigroup.Semigroup<A>): ComplexSemigroup<A> {
  return {
    ...m,
    concat: m.combine,
    _tag: "Semigroup",
  }
}

export const fromFpTs = <A>(
  m: FpTsSemigroup.Semigroup<A>,
): Semigroup.Semigroup<A> => Semigroup.make(m.concat)

export function makeComplex<A>(
  combine: Semigroup.Semigroup<A>["combine"],
  combineMany?: Semigroup.Semigroup<A>["combineMany"],
): ComplexSemigroup<A> {
  return toComplex(Semigroup.make<A>(combine, combineMany))
}

export function getArraySemigroup<A>(): ComplexSemigroup<ReadonlyArray<A>> {
  return constant(
    makeComplex<readonly A[]>(
      (x, y) =>
        x.length === 0
          ? y.length === 0
            ? constEmptyArray()
            : y
          : y.length === 0
            ? x
            : [...x, ...y],
      (a, then) => [...a, ...Array.from(then).flat(1)],
    ),
  )()
}

export function getNilableSemigroup<A>(
  semigroup: ComplexSemigroupOrMonoid<A>,
): ComplexSemigroup<Nilable<A>> {
  return makeComplex<Nilable<A>>(
    (x, y) => (isNil(x) || isNil(y) ? (x ?? y) : semigroup.combine(x, y)),
    (head, then) => {
      const { combineMany, combineAll } = semigroup
      const array = Array.from(then).filter(isNotNil)
      if (isNil(head)) {
        if (combineAll) return combineAll(array)
        return array.length < 2
          ? (array[0] satisfies Nilable<A>)
          : combineMany(array[0] as A, array.slice(1))
      }
      return array.length === 0 ? head : combineMany(head, array)
    },
  )
}

export const VoidSemigroup: ComplexSemigroup<void> = makeComplex(ignore, ignore)

export const UndefinedSemigroup: ComplexSemigroup<undefined> =
  VoidSemigroup as ComplexSemigroup<undefined>

export const NullSemigroup: ComplexSemigroup<null> = makeComplex(
  constNull,
  constNull,
)

export const NumberAddSemigroup: ComplexSemigroup<number> = makeComplex(
  (a, b) => a + b,
)
export const NumberSubSemigroup: ComplexSemigroup<number> = makeComplex(
  (a, b) => a - b,
)

