import { expect, it, test } from "vitest"

import * as Eval from "../Eval"
import { yCombinator, yEval } from "../Y-Expr"

test("yExpr", () => {
  const f = yCombinator<[n: number], (arg: string) => number>()(
    (f) => (n) => (a) => (n == 1 ? 1 : n * f(n - 1)(a)),
  )
  expect(f(5)("")).toBe(120)

  console.time()
  yCombinator<(n: number) => number>(
    (factorial) => (n) => (n <= 1 ? 1 : n * factorial(n - 1)),
  )(100)
  console.timeEnd()
  // console.time();
  // yCombinator2<(n: number) => nuber>(
  //   (factorial) => (n) => (n <= 1 ? 1 : n * factorial(n - 1)),
  // )(100);
  // console.timeEnd();
})

it("should calculate sum with Eval-wrapped result", () => {
  const sumEval = yEval<(n: number) => number>(
    (rec, Eval) => (n: number) =>
      n <= 1 ? Eval.one : rec(n - 1).map((m) => n + m),
  )
  expect(sumEval(1_000_000)).toBe(500000500000)
})

it("should calculate sum with Eval-wrapped result 2", () => {
  expect(
    Eval.batch(new Array(1000).fill(true).map((_, i) => Eval.pure(i))).value,
  ).toEqual(new Array(1000).fill(true).map((_, i) => i))
})
