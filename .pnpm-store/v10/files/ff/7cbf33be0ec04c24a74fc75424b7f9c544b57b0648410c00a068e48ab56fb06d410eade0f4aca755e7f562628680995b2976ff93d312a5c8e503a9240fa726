,CAAGM,CAAAA,CAAC,CAAC,CAAA,CAC5C,QACI,OAAQA,CAAIX,EAAAA,CAAAA,CAAE,GAAGD,CAAAA,CAAIQ,GAAKP,CAAAA,CAAAA,EAAIA,CAAEW,CAAAA,CAAC,CAAC,CAAC,CAC3C,CACJ,CACJ","file":"LiftMap.js","sourcesContent":["import * as MI from \"fp-ts/Identity\";\nimport * as MIO from \"fp-ts/IO\";\nimport * as MR from \"fp-ts/Reader\";\n/**\n * @category type class\n * @since 0.24.0\n */ export const IO = {\n    ...MIO.Functor,\n    liftMap: (...ans)=>{\n        const f = ans.pop();\n        const [fa, fb, fc, fd] = ans;\n        switch(ans.length){\n            case 2:\n                return ()=>f(fa(), fb());\n            case 3:\n                return ()=>f(fa(), fb(), fc());\n            case 4:\n                return ()=>f(fa(), fb(), fc(), fd());\n            default:\n                return ()=>f(...ans.map((a)=>a()));\n        }\n    }\n};\nexport const Identity = {\n    ...MI.Functor,\n    liftMap: (...fa)=>{\n        const f = fa.pop();\n        const a = fa;\n        switch(a.length){\n            case 2:\n                return f(a[0], a[1]);\n            case 3:\n                return f(a[0], a[1], a[2]);\n            case 4:\n                return f(a[0], a[1], a[2], a[3]);\n            default:\n                return f(...a);\n        }\n    }\n};\nexport const Reader = {\n    ...MR.Functor,\n    liftMap: (...ans)=>{\n        const f = ans.pop();\n        const [fa, fb, fc, fd] = ans;\n        const len = ans.length;\n        switch(len){\n            case 2:\n                return (r)=>f(fa(r), fb(r));\n            case 3:\n                return (r)=>f(fa(r), fb(r), fc(r));\n            case 4:\n                return (r)=>f(fa(r), fb(r), fc(r), fd(r));\n            default:\n                return (r)=>f(...ans.map((f)=>f(r)));\n        }\n    }\n};\n"]}