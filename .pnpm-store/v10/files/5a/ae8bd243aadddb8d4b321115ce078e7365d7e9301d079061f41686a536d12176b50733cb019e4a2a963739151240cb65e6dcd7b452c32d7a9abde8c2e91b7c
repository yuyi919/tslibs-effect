type function = {apply: 'this 'args. ('this, array<'args>) => unit}
type object = Js.Types.obj_val
type symbol = Js.Types.symbol
type undefined = Js.Types.undefined_val
type null = Js.Types.null_val

@genType
type rec t<'t> =
  | @as("undefined") Undefined: t<undefined>
  | @as("null") Null: t<null>
  | @as("boolean") Boolean: t<bool>
  | @as("number") Number: t<float>
  | @as("string") String: t<string>
  | @as("function") Function: t<function>
  | @as("object") Object: t<object>
  | @as("symbol") Symbol: t<symbol>
  | @as("bigint") BigInt: t<bigint>

module Make: () =>
{
  let string: t<string>
  let number: t<float>
  external unsafe: t<'a> => t<'b> = "%identity"
  let isStr: 'a => bool
  let test: ('a, t<'b>) => bool
  let typeof: 'a => t<'b>
}
let string: t<string>
let number: t<float>
external unsafe: t<'a> => t<'b> = "%identity"
let isStr: 'a => bool
let test: ('a, t<'b>) => bool
let typeof: 'a => t<'b>
