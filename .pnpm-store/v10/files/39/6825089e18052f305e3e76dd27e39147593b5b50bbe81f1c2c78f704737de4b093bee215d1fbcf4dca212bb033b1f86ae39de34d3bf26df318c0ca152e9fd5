import assert from "node:assert"
import { describe, expect, test } from "vitest"

import { clsx, clsxLite } from "../../css"

describe("common", () => {
  test("(compat) keeps object keys with truthy values", () => {
    const out = clsx({ a: true, b: false, c: 0, d: null, e: undefined, f: 1 })
    assert.equal(out, "a f")
  })

  test("(compat) joins arrays of class names and ignore falsy values", () => {
    const out = clsx("a", 0, null, undefined, true, 1, "b")
    assert.equal(out, "a 1 b")
  })

  test("(compat) supports heterogenous arguments", () => {
    assert.equal(clsx({ a: true }, "b", 0), "a b")
  })

  test("(compat) should be trimmed", () => {
    assert.equal(clsx("", "b", {}, ""), "b")
  })

  test("(compat) returns an empty string for an empty configuration", () => {
    assert.equal(clsx({}), "")
  })

  test("(compat) supports an array of class names", () => {
    assert.equal(clsx(["a", "b"]), "a b")
  })

  test("(compat) joins array arguments with string arguments", () => {
    assert.equal(clsx(["a", "b"], "c"), "a b c")
    assert.equal(clsx("c", ["a", "b"]), "c a b")
  })

  test("(compat) handles multiple array arguments", () => {
    assert.equal(clsx(["a", "b"], ["c", "d"]), "a b c d")
  })

  test("(compat) handles arrays that include falsy and true values", () => {
    assert.equal(clsx(["a", 0, null, undefined, false, true, "b"]), "a b")
  })

  test("(compat) handles arrays that include arrays", () => {
    assert.equal(clsx(["a", ["b", "c"]]), "a b c")
  })

  test("(compat) handles arrays that include objects", () => {
    assert.equal(clsx(["a", { b: true, c: false }]), "a b")
  })

  test("(compat) handles deep array recursion", () => {
    assert.equal(clsx(["a", ["b", ["c", { d: true }]]]), "a b c d")
  })

  test("(compat) handles arrays that are empty", () => {
    assert.equal(clsx("a", []), "a")
  })

  test("(compat) handles nested arrays that have empty nested arrays", () => {
    assert.equal(clsx("a", [[]]), "a")
  })

  test("(compat) handles all types of truthy and falsy property values as expected", () => {
    const out = clsx({
      // falsy:
      null: null,
      emptyString: "",
      noNumber: NaN,
      zero: 0,
      negativeZero: -0,
      false: false,
      undefined: undefined,

      // truthy (literally anything else):
      nonEmptyString: "foobar",
      whitespace: " ",
      function: Object.prototype.toString,
      emptyObject: {},
      nonEmptyObject: { a: 1, b: 2 },
      emptyList: [],
      nonEmptyList: [1, 2, 3],
      greaterZero: 1,
    })

    assert.equal(
      out,
      "nonEmptyString whitespace function emptyObject nonEmptyObject emptyList nonEmptyList greaterZero",
    )
  })
})

describe("clsx lite", () => {
  test("exports", () => {
    expect(typeof clsxLite(), "~> returns string output").toBe("string")
    expect(typeof clsxLite, "~> exports named function").toBe("function")
  })

  test("strings", () => {
    assert.equal(clsxLite(""), "")
    assert.equal(clsxLite("foo"), "foo")
    assert.equal(clsxLite(true && "foo"), "foo")
    assert.equal(clsxLite(false && "foo"), "")
  })

  test("strings (variadic)", () => {
    assert.equal(clsxLite(""), "")
    assert.equal(clsxLite("foo", "bar"), "foo bar")
    assert.equal(clsxLite(true && "foo", false && "bar", "baz"), "foo baz")
    assert.equal(clsxLite(false && "foo", "bar", "baz", ""), "bar baz")
  })

  test("emptys", () => {
    assert.equal(clsxLite(""), "")
    assert.equal(clsxLite(undefined), "")
    assert.equal(clsxLite(null), "")
    assert.equal(clsxLite(0), "")
  })

  // lite ignores all non-strings
  test("non-strings", () => {
    // number
    assert.equal(clsxLite(1), "")
    assert.equal(clsxLite(1, 2), "")
    assert.equal(clsxLite(Infinity), "")
    assert.equal(clsxLite(NaN), "")
    assert.equal(clsxLite(0), "")

    // objects
    assert.equal(clsxLite({}), "")
    assert.equal(clsxLite(null), "")
    assert.equal(clsxLite({ a: 1 }), "")
    assert.equal(clsxLite({ a: 1 }, { b: 2 }), "")

    // arrays
    assert.equal(clsxLite([]), "")
    assert.equal(clsxLite(["foo"]), "")
    assert.equal(clsxLite(["foo", "bar"]), "")

    const fn = clsxLite
    // functions
    assert.equal(clsxLite(fn), "")
    assert.equal(clsxLite(fn, fn), "")
  })
})
