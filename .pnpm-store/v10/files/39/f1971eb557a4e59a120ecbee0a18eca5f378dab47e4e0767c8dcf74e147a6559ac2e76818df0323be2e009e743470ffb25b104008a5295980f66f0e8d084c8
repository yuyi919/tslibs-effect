import { MAP } from "./internal/constant"

/**
 *
 * @remark PURE
 */
export function empty<K, V>(): Map<K, V> {
  return new MAP()
}

/**
 *
 * @remark PURE
 */
export function get<K, V>(map: Map<K, V>, k: K): V | undefined
export function get<K, V>(
  map: { get(key: K): V | undefined },
  k: K,
): V | undefined
export function get<K, V>(
  map: { get(key: K): V | undefined },
  k: K,
): V | undefined {
  return map.get(k)
}

/**
 *
 * @remark PURE
 */
export function unsafeGet<K, V>(map: Map<K, V>, k: K): V
export function unsafeGet<K, V>(map: { get(key: K): V | undefined }, k: K): V
export function unsafeGet<K, V>(map: { get(key: K): V | undefined }, k: K): V {
  return get(map, k)!
}

/**
 *
 * @remark PURE
 */
export function set<K, V>(map: Map<K, V>, key: K, value: V): Map<K, V>
export function set<K, V, T extends { set(key: K, value: V): unknown }>(
  map: T,
  key: K,
  value: V,
): T
export function set<K, V>(map: Map<K, V>, key: K, value: V): Map<K, V> {
  return (map.set(key, value), map)
}

/**
 *
 * @remark PURE
 */
export function getOrInit<K, V>(
  map: {
    set(key: K, value: V): unknown
    get(key: K): V | undefined
    has(key: K): unknown
  },
  key: K,
  value: () => V,
): V {
  let initial!: any
  return map.has(key)
    ? map.get(key)!
    : (map.set(key, (initial = value())), initial)
}

/**
 *
 * @remark PURE
 */
export function remove<K, V>(map: Map<K, V>, key: K): Map<K, V>
export function remove<K, T extends Pick<Map<K, any>, "delete">>(
  map: T,
  key: K,
): T
export function remove<K, T extends { delete(key: K): unknown }>(
  map: T,
  key: K,
): T {
  return (map.delete(key), map)
}

/**
 *
 * @remark PURE
 */
export function clear<K, V>(map: Map<K, V>): Map<K, V>
export function clear<T extends { clear(): unknown }>(map: T): T
export function clear<T extends { clear(): unknown }>(map: T): T {
  return (map.clear(), map)
}
