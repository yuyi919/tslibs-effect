,CACAC,CAAAA,CAAAA,CACG,CACH,OAAO,IAAID,CAAOC,CAAAA,CAAG,CACvB","file":"chunk-3O6RAPAW.js","sourcesContent":["// import { __KEY_UNDEFINED, OBJ_CREATE, OBJ_SEAL } from \"./lib\"\n\n// /**\n//  * 常量`null`\n//  * @internal\n//  */\n// export const NULL = null\n// /**\n//  * 常量`undefined`\n//  * @internal\n//  */\n// export const UNDEFINED = void 0\n\n// export const VOID: void = UNDEFINED\n\n// export const NEVER: never = UNDEFINED as never\n\n// /**\n//  * ```ts\n//  * typeof Buffer !== undefined ? Buffer : UNDEFINED\n//  * ```\n//  */\n// export const BUFFER = typeof Buffer !== __KEY_UNDEFINED ? Buffer : UNDEFINED\n// export const __NAME_BUFFER: \"Buffer\" = \"Buffer\"\n\n// export const WINDOW = typeof window !== __KEY_UNDEFINED ? window : UNDEFINED\n\n// /**\n//  * 静态不可变空对象\n//  * @example\n//  * ```ts\n//  * EMPTY_OBJECT instanceof Object //=> false\n//  * typeof EMPTY_OBJECT === 'object' //=> true\n//  * ```\n//  * @remarks\n//  * 使用`Object.create(null)`创建，因此使用`instanceof Object`做判断会返回false\n//  * 想让instanceof正确判断请使用{@link EmptyObject}\n//  * @public\n//  */\n// export const EMPTY_OBJECT: Readonly<{}> = /* @__PURE__ */ OBJ_SEAL(\n//   OBJ_CREATE(NULL),\n// )\n\n// /**\n//  * 静态不可变空对象\n//  * @example\n//  * ```ts\n//  * EmptyObject instanceof Object\n//  * // => true\n//  * typeof EMPTY_OBJECT === 'object'\n//  * // => true\n//  * ```\n//  * @remarks\n//  * 不同于{@link EMPTY_OBJECT}，`EMPTY_OBJECT instanceof Object`会返回true\n//  * @public\n//  */\n// export const EmptyObject: Readonly<{}> = /* @__PURE__ */ OBJ_SEAL({})\n\n// /**\n//  * 静态不可变空数组\n//  * @public\n//  */\n// export const EmptyArray = /* @__PURE__ */ OBJ_SEAL([])\n\n// export * from \"./lib\"\n\n// declare global {\n//   export interface ObjectConstructor {\n//     /**\n//      * Determines whether an object has a property with the specified name.\n//      * @param o An object.\n//      * @param v A property name.\n//      */\n//     hasOwn(o: object, v: PropertyKey): boolean\n//   }\n// }\n\nexport * from \"@yuyi919/shared-constant\"\n","import { ArrayIterator, ConstructorType, Types } from \"@yuyi919/shared-types\"\n\nimport {\n  __KEY_FUNC,\n  __KEY_PROTOTYPE,\n  __KEY_STR,\n  ARRAY,\n  CALLER,\n  FUNCTION,\n} from \"./constant\"\n\n/**\n * @internal\n */\nexport function _typeof(\n  a: unknown,\n):\n  | \"string\"\n  | \"number\"\n  | \"bigint\"\n  | \"boolean\"\n  | \"symbol\"\n  | \"undefined\"\n  | \"object\"\n  | \"function\" {\n  return typeof a\n}\n\n/**\n * @public\n */\nexport function isTypeof(a: unknown, typeName: Types.Primitive): a is any {\n  return _typeof(a) === typeName\n}\n\n/**\n * @internal\n */\nexport function makeTypeof<Name extends Types.Primitive>(typeName: Name) {\n  return (a: unknown): a is any => isTypeof(a, typeName)\n}\n\n/**\n * @internal\n */\nexport function makeTypeof2<Name extends Types.Primitive>(ta: Name, tb: Name) {\n  return (a: unknown): a is any => isTypeof(a, ta) || isTypeof(a, tb)\n}\n\n/**\n * @internal\n */\nexport function makeTypeof3<Name extends Types.Primitive>(\n  ta: Name,\n  tb: Name,\n  tc: Name,\n) {\n  return (a: unknown): a is any =>\n    isTypeof(a, ta) || isTypeof(a, tb) || isTypeof(a, tc)\n}\n\nexport function isFn(a: unknown): a is Types.Function.Base {\n  return makeTypeof(__KEY_FUNC)(a)\n}\n\nexport function isStr(a: unknown): a is string {\n  return makeTypeof(__KEY_STR)(a)\n}\n\n/**\n * @alpha\n */\nexport interface InstanceArgsShifter<\n  T extends ConstructorType<any>,\n  Instance extends InstanceType<T>,\n  K extends keyof Instance,\n> {\n  <Args extends Instance[K] extends (...args: infer Args) => any ? Args : any>(\n    source: Instance,\n    ...arg: Args\n  ): ReturnType<Instance[K]>\n}\n\n/**\n *\n * @param Func -\n * @param thisArgs -\n * @param args -\n * @alpha\n */\nexport function bind<\n  T extends Types.Function.Base<[any, ...any[]], any>,\n  TA,\n  R extends T extends (this: any, ...other: infer K) => infer Re\n    ? Types.Function.Base<K, Re>\n    : Function,\n>(Func: T, thisArgs: TA, ...args: any[]): R {\n  return FUNCTION.bind.call(Func, thisArgs, ...args) as R\n}\n\n/**\n *\n * @param constructor -\n * @param key -\n * @alpha\n */\nexport function INSTANCE_BIND<\n  T extends ConstructorType<any>,\n  P extends InstanceType<T>,\n  K extends keyof P,\n>(constructor: T, key: K): InstanceArgsShifter<T, P, K>\nexport function INSTANCE_BIND<P extends any, K extends keyof P>(\n  constructor: unknown,\n  key: K,\n): InstanceArgsShifter<any, P, K>\nexport function INSTANCE_BIND<\n  T extends ConstructorType<any>,\n  P extends InstanceType<T>,\n  K extends keyof P,\n>(constructor: T, key: K): InstanceArgsShifter<T, P, K> {\n  return bind(CALLER, constructor[__KEY_PROTOTYPE][key]) as any\n}\n\nexport function map<T extends any, R = T>(\n  arr: T[],\n  callbackfn: ArrayIterator<T, R>,\n): R[]\nexport function map<T extends any, R = T>(\n  arr: ReadonlyArray<T>,\n  callbackfn: ArrayIterator<T, R>,\n): ReadonlyArray<R>\nexport function map(\n  arr: any,\n  callbackfn: ArrayIterator<any, any>,\n  thisArgs?: any,\n) {\n  return INSTANCE_BIND(ARRAY, \"map\")(arr, callbackfn, thisArgs)\n}\n\nexport function some<T extends any>(\n  arr: T[],\n  callbackfn: ArrayIterator<T, boolean>,\n): boolean\nexport function some<T extends any>(\n  arr: ReadonlyArray<T>,\n  callbackfn: ArrayIterator<T, boolean>,\n): boolean\nexport function some(arr: any, callbackfn: ArrayIterator<any, boolean>) {\n  return INSTANCE_BIND(ARRAY, \"some\")(arr, callbackfn)\n}\n\nexport function _every(\n  arr: any[],\n  callbackfn: (el: any, index: number, array: any[]) => boolean,\n): boolean {\n  return INSTANCE_BIND(ARRAY, \"every\")(arr, callbackfn)\n}\n\nexport type INVALID_RANGE<T, MSG> = T extends 0 | 1 ? MSG : T\n\nexport function dualWith<\n  DataLast extends (...args: Array<any>) => any,\n  DataFirst extends (...args: Array<any>) => any,\n>(\n  isDataFirst: (args: IArguments) => boolean,\n  body: DataFirst,\n): DataLast & DataFirst {\n  return function (this: any, ...args: any[]) {\n    return isDataFirst(args as any)\n      ? body.apply(this, args)\n      : (((self: any) => body(self, ...args)) as any)\n  } as any\n}\n/**\n * Creates a function that can be used in a data-last (aka `pipe`able) or\n * data-first style.\n *\n * The first parameter to `dual` is either the arity of the uncurried function\n * or a predicate that determines if the function is being used in a data-first\n * or data-last style.\n *\n * Using the arity is the most common use case, but there are some cases where\n * you may want to use a predicate. For example, if you have a function that\n * takes an optional argument, you can use a predicate to determine if the\n * function is being used in a data-first or data-last style.\n *\n * @param arity - Either the arity of the uncurried function or a predicate\n *                which determines if the function is being used in a data-first\n *                or data-last style.\n * @param body - The definition of the uncurried function.\n *\n * @example\n * import { dual, pipe } from \"effect/Function\"\n *\n * // Exampe using arity to determine data-first or data-last style\n * const sum: {\n *   (that: number): (self: number) => number\n *   (self: number, that: number): number\n * } = dual(2, (self: number, that: number): number => self + that)\n *\n * assert.deepStrictEqual(sum(2, 3), 5)\n * assert.deepStrictEqual(pipe(2, sum(3)), 5)\n *\n * // Example using a predicate to determine data-first or data-last style\n * const sum2: {\n *   (that: number): (self: number) => number\n *   (self: number, that: number): number\n * } = dual((args) => args.length === 1, (self: number, that: number): number => self + that)\n *\n * assert.deepStrictEqual(sum(2, 3), 5)\n * assert.deepStrictEqual(pipe(2, sum(3)), 5)\n *\n * @since 2.0.0\n */\nexport function dual<\n  DataFirst extends (...args: readonly [any, any, ...any[]]) => any,\n>(\n  arity: INVALID_RANGE<Parameters<DataFirst>[\"length\"], \"INVALID DUAL RANGE\">,\n  body: DataFirst,\n): DataFirst &\n  (DataFirst extends Types.Function.Base<[infer A, ...infer Args], infer R>\n    ? (...args: any[]) => any\n    : (...args: any[]) => any)\n\nexport function dual(arity: any, body: any): (...args: any[]) => any {\n  // return isFn(arity)\n  //   ? function (this: any, ...args) {\n  //       return arity(args as any)\n  //         ? body.apply(this, args)\n  //         : (((self: any) => body(self, ...args)) as any)\n  //     }\n  //   :\n  return function (this: any, ...args: unknown[]) {\n    return len(args) >= arity\n      ? body.apply(this, args)\n      : (self: any) => body(self, ...args)\n  }\n}\n\nexport function every<A, B extends A>(\n  refinement: (a: NoInfer<A>, i: number, self: ReadonlyArray<A>) => a is B,\n): (self: ReadonlyArray<A>) => self is ReadonlyArray<B>\nexport function every<A>(\n  predicate: (a: NoInfer<A>, i: number, self: ReadonlyArray<A>) => boolean,\n): (self: ReadonlyArray<A>) => boolean\nexport function every<A, B extends A>(\n  self: ReadonlyArray<A>,\n  refinement: (a: A, i: number, self: ReadonlyArray<A>) => a is B,\n): self is ReadonlyArray<B>\nexport function every<A>(\n  self: ReadonlyArray<A>,\n  predicate: (a: A, i: number, self: ReadonlyArray<A>) => boolean,\n): boolean\nexport function every(..._: [any, any?]): any {\n  return dual(2, _every)(..._)\n}\n\nexport const name = <K>(target: { name: K }): K => target.name\n\nexport const tryCatch: {\n  <A, B>(fn: () => A, or: (err: unknown) => B): A | B\n} = (fn: any, f1: any): any => {\n  try {\n    return fn()\n  } catch (e) {\n    // if (process.env.NODE_ENV !== \"production\") {\n    //   console.warn(e)\n    // }\n    return f1(e)\n  }\n}\n\nexport function len(target: { readonly length: number }): number {\n  return target.length\n}\n\nexport const newFunction = <F extends Function>(\n  content: string,\n  args: string[],\n) => new FUNCTION(...args, content) as F\n\nexport const ENABLE_EVALFUNCTION = tryCatch(\n  () => !!newFunction(\"return 1\", []),\n  (_) => false,\n)\n\nexport function cloneFn<F extends Function>(\n  fn: F,\n  BACK_UP_TO_STRING?: () => string,\n): F {\n  return ENABLE_EVALFUNCTION\n    ? newFunction(\n        `\"${Date.now()}\";return (${BACK_UP_TO_STRING ? BACK_UP_TO_STRING() : fn})`,\n        [],\n      )()\n    : fn\n}\n","// Copyright (c) 2021-2023 Peter Matta\n//\n// This source code is licensed under the MIT license found in the\n// LICENSE file in the root directory of this source tree.\n\nimport * as $ from \"../internal/constant\"\nimport { tryCatch } from \"../internal/helper\"\n\nexport interface Lazy<A> {\n  (): A\n}\n\nexport function lazy<F extends () => any>(init: F): F\nexport function lazy<A>(init: () => A): Lazy<A>\nexport function lazy<A>(init: () => A): Lazy<A> {\n  return ((value?: A) => () => (\n    init && ((value = init()), ((init as any) = $.NULL)),\n    value!\n  ))()\n}\n\nexport function cached<A extends object, B extends object>(\n  f: (a: A) => B,\n): (a: A) => B {\n  const cache = new WeakMap<A, WeakRef<B>>()\n  return (a: A): B => {\n    if (cache.has(a)) {\n      const ref = cache.get(a)!\n      const b = ref.deref()\n      if (b) return b\n    }\n    const b = f(a)\n    cache.set(a, new WeakRef(b))\n    return b\n  }\n}\n/**\n * wrapper for `ThrowStatement`\n * @param e - throw e\n * @return never\n */\nexport function raise(e: unknown): never {\n  throw e\n}\n\n/**\n * return an `Error(msg?, opts?)`\n * @example\n * raise(error(\"Invalid Argument\"))\n */\nexport function error(\n  message?: string | undefined,\n  options?: ErrorOptions | undefined,\n): Error {\n  return $.ERROR(message, options)\n}\n\n/**\n * return a `TypeError(msg?, opts?)`\n * @example\n * raise(typeError(\"Invalid Argument\"))\n */\nexport function typeError(\n  message?: string | undefined,\n  options?: ErrorOptions | undefined,\n): Error {\n  return $.ERRORS_TypeError(message, options)\n}\n\n/**\n * return a `SyntaxError(msg?, opts?)`\n * @example\n * raise(syntaxError(\"Invalid Input\"))\n */\nexport function syntaxError(\n  message?: string | undefined,\n  options?: ErrorOptions | undefined,\n): Error {\n  return $.ERRORS_SyntaxError(message, options)\n}\n\n/**\n * alias for {@link raise}\n * @example\n * raise(typeError(\"Invalid Argument\"))\n */\nexport function throwError(e: Error) {\n  return raise(e)\n}\n\n/**\n * @param a - Return value\n * @returns `() => a`\n */\nexport function constant<A>(a: A): Lazy<A> {\n  return () => a\n}\n\nexport function identity<A>(a: A) {\n  return a\n}\n/**\n * Casts the result to the specified type.\n * @param a - The value to be casted to the target type.\n */\nexport function unsafeCoerce<B>(a: unknown): B {\n  return identity(a) as any\n}\n\n/**\n * A function that ensures that the type of an expression matches some type,\n * without changing the resulting type of that expression.\n *\n * @example\n *\n * const test1 = satisfies<number>()(5 as const)\n *     //^? const test: 5\n *     // @ts-expect-error\n * const test2 = satisfies<string>()(5)\n *     //^? Argument of type 'number' is not assignable to parameter of type 'string'\n *\n * assert.deepStrictEqual(satisfies<number>()(5), 5)\n *\n */\nexport function satisfies<A>(): <B extends A>(b: B) => B {\n  return identity\n}\n\nexport function return1<A>(a: A, ...other: any[]): A\nexport function return1<A>(a: A): A {\n  return identity(a)\n}\n\nexport function return2<B>(_a: unknown, b: B, ...other: unknown[]): B\nexport function return2<B>(_a: any, b: B): B {\n  return b\n}\n\nexport function return3<C>(\n  _a: unknown,\n  _b: unknown,\n  c: C,\n  ...other: unknown[]\n): C\nexport function return3<C>(_a: any, _b: any, c: C): C {\n  return c\n}\n\nexport function return4<D>(\n  _a: unknown,\n  _b: unknown,\n  _c: unknown,\n  d: D,\n  ...other: unknown[]\n): D\nexport function return4<D>(_a: any, _b: any, _c: any, d: D): D {\n  return d\n}\n\nexport function constantWith<F extends () => any>(expr: F): F\nexport function constantWith<A extends {}>(expr: () => A): Lazy<A>\nexport function constantWith<A>(expr: () => A): Lazy<A> {\n  return tryCatch(\n    () => constant(expr()),\n    () => lazy(expr),\n  )\n}\n\nexport function fst<A, B>(x: readonly [A, B]): A {\n  return x[0]\n}\nexport function snd<A, B>(x: readonly [A, B]): B {\n  return x[1]\n}\n\nexport function flip<\n  A extends readonly unknown[],\n  B extends readonly unknown[],\n  C,\n>(f: (...a: A) => (...b: B) => C): (...b: B) => (...a: A) => C {\n  return (...b) =>\n    (...a) =>\n      f(...a)(...b)\n}\n\nexport function flip0<A, B, C>(f: (a: A, b: B) => C): (b: B, a: A) => C {\n  return (b, a) => f(a, b)\n}\n\n/**\n * 将函数参数按顺序curry化\n * @param f -\n */\nexport function curry<A, B, C>(f: (a: A, b: B) => C): (a: A) => (b: B) => C {\n  return (x) => (y) => f(x, y)\n}\n\n/**\n * 将函数参数按相反顺序curry化\n * @param f -\n */\nexport function curryReverse<A, B, C>(\n  f: (b: B, a: A) => C,\n): (a: A) => (b: B) => C {\n  return (x) => (y) => f(y, x)\n}\n\n/**\n * 将函数参数按顺序反curry化\n * @param f -\n */\nexport function uncurry<A, B, C>(f: (a: A) => (b: B) => C): (a: A, b: B) => C {\n  return (x, y) => f(x)(y)\n}\n\n/**\n * 将函数参数按相反顺序反curry化\n * @param f -\n */\nexport function uncurryReverse<A, B, C>(\n  f: (b: B) => (a: A) => C,\n): (a: A, b: B) => C {\n  return (x, y) => f(y)(x)\n}\n\nexport function applyTo<A>(a: A): <B>(f: (a: A) => B) => B {\n  return (f) => f(a)\n}\n\nexport function tuple<A extends unknown[], R>(f: (...args: A) => R) {\n  return (args: A): R => f(...args)\n}\n\nexport function untuple<A extends unknown[], R>(f: (args: A) => R) {\n  return (...args: A): R => f(args)\n}\n\n/**\n * The `absurd` function is a stub for cases where a value of type `never` is encountered in your code,\n * meaning that it should be impossible for this code to be executed.\n *\n * This function is particularly when it's necessary to specify that certain cases are impossible.\n *\n */\nexport function absurd<A>(x: never): A\nexport function absurd<A>(): A\nexport function absurd<A>(_?: never): A {\n  return raise(error(\"Absurd function called\"))\n}\n\nexport interface LengthLike {\n  readonly length: number\n}\n\nexport function len(target: LengthLike) {\n  return target.length\n}\n\nexport function lastIndex(target: LengthLike) {\n  return len(target) - 1\n}\n\nexport function lastElement<T>(target: ArrayLike<T>) {\n  return target[lastIndex(target)]\n}\n\nexport function firstElement<T>(target: ArrayLike<T>) {\n  return target[0]\n}\n\nexport function _new<T extends {}, Args extends readonly any[]>(\n  target: new (...args: Args) => T,\n  args: Readonly<Args>,\n  newTarget?: new (...args: any) => any,\n): T {\n  return $.CREATE_NEW(target, args, newTarget ?? target)\n}\n\nexport function _new0<T extends {}>(Target: new () => T): T {\n  return new Target()\n}\n\nexport function _new1<T extends {}, Arg>(\n  Target: new (arg: Arg) => T,\n  arg: Arg,\n): T {\n  return new Target(arg)\n}\n\nexport function _new2<T extends {}, Arg, Args2>(\n  Target: new (arg: Arg, arg2: Args2) => T,\n  arg: Arg,\n  arg2: Args2,\n): T {\n  return new Target(arg, arg2)\n}\n\nexport function makeNew<T extends {}, Args extends readonly any[]>(\n  Target: new (...args: Args) => T,\n) {\n  return (...args: Args) => _new(Target, args)\n}\n\n/**\n * Creates a tupled version of this function: instead of `n` arguments, it accepts a single tuple argument.\n *\n * @example\n *\n * const sumTupled = tupled((x: number, y: number): number => x + y)\n *\n * assert.deepStrictEqual(sumTupled([1, 2]), 3)\n *\n */\nexport function tupled<A extends ReadonlyArray<unknown>, B>(\n  f: (...a: A) => B,\n): (a: A) => B {\n  return (a) => f(...a)\n}\n\n/**\n * Inverse function of `tupled`\n *\n * @example\n *\n * const getFirst = untupled(<A, B>(tuple: [A, B]): A => tuple[0])\n *\n * assert.deepStrictEqual(getFirst(1, 2), 1)\n *\n */\nexport function untupled<A extends ReadonlyArray<unknown>, B>(\n  f: (a: A) => B,\n): (...a: A) => B {\n  return (...a) => f(a)\n}\n\nexport function ign