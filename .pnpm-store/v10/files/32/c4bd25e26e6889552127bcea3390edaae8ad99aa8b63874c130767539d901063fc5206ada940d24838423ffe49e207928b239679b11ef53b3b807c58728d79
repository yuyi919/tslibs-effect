import * as Equal from "effect/Equal"

import { len } from "./Functions"
import * as Hash from "./Hash"
import { assign, jsObjectKeys, keys } from "./JsObject"
import * as proto from "./Proto"
import { EqualSymbol, HashSymbol } from "./Symbol"

export const StructuralPrototype: Equal.Equal = proto.makeStructProto({
  [HashSymbol]: (self: any) => Hash.cached(self, Hash.object(self)),
  [EqualSymbol]: (self: Equal.Equal, that: Equal.Equal) => {
    const selfKeys = keys(self),
      thatKeys = keys(that as any)
    return len(selfKeys) === len(thatKeys)
      ? selfKeys.every(
          (key) =>
            key in (that as object) &&
            Equal.equals((this as any)[key], (that as any)[key]),
        )
      : false
  },
})

export const Structural: new <A extends Record<string, any>>(
  a: A,
) => Equal.Equal & Readonly<A> = (() =>
  proto.setProtos(function (this: any, args: any) {
    args && assign(this, args)
  }, StructuralPrototype) as any)()

export const struct: typeof import("effect/Data").struct = (prop: any): any =>
  proto.setPrototypeOf(prop, StructuralPrototype)

export function TaggedClass<Tag extends string>(
  tag: Tag,
): new <A extends Record<string, any> = {}>(
  a: A,
) => Equal.Equal & Readonly<A> & { readonly _tag: Tag } {
  const tagHash = Hash.$structureEntries(Hash.$tag(tag))
  class Base extends Structural<any> {
    declare readonly _tag: Tag
    declare private readonly _keys?: string[]
    declare private readonly _keyHashs: Record<string, number>
    declare private readonly _tagHash: number
  }
  proto._TAG(Base, tag)
  proto.withProtoF(Base, (self) => {
    // @ts-ignore
    self._keyHashs = {}
    // @ts-ignore
    self._tagHash = tagHash
    self[HashSymbol] = proto.useThis(
      (self: {
        readonly _keys?: readonly ("_keys" | "_keyHashs" | "_tagHash")[]
        readonly _keyHashs: Record<string, number>
        readonly _tagHash: number
      }) =>
        Hash.structureKeysWithCache(
          self,
          self._keys || jsObjectKeys(self),
          self._keyHashs,
          self._tagHash,
        ),
    )
  })
  return Base as any
}
