/* eslint-disable @typescript-eslint/ban-types */
export function flow<A extends [any, ...any[]], B>(
  ab: (..._: A) => B,
): (..._: A) => B
export function flow<A extends [any, ...any[]], B, C>(
  ab: (..._: A) => B,
  bc: (_: B) => C,
): (..._: A) => C
export function flow<A extends [any, ...any[]], B, C, D>(
  ab: (..._: A) => B,
  bc: (_: B) => C,
  cd: (_: C) => D,
): (..._: A) => D
export function flow<A extends [any, ...any[]], B, C, D, E>(
  ab: (..._: A) => B,
  bc: (_: B) => C,
  cd: (_: C) => D,
  de: (_: D) => E,
): (..._: A) => E
export function flow<A extends [any, ...any[]], B, C, D, E, F>(
  ab: (..._: A) => B,
  bc: (_: B) => C,
  cd: (_: C) => D,
  de: (_: D) => E,
  ef: (_: E) => F,
): (..._: A) => F
export function flow<A extends [any, ...any[]], B, C, D, E, F, G>(
  ab: (..._: A) => B,
  bc: (_: B) => C,
  cd: (_: C) => D,
  de: (_: D) => E,
  ef: (_: E) => F,
  fg: (_: F) => G,
): (..._: A) => G
export function flow<A extends [any, ...any[]], B, C, D, E, F, G, H>(
  ab: (..._: A) => B,
  bc: (_: B) => C,
  cd: (_: C) => D,
  de: (_: D) => E,
  ef: (_: E) => F,
  fg: (_: F) => G,
  gh: (_: G) => H,
): (..._: A) => H
export function flow<A extends [any, ...any[]], B, C, D, E, F, G, H, I, Z>(
  ab: (..._: A) => B,
  bc: (_: B) => C,
  cd: (_: C) => D,
  de: (_: D) => E,
  ef: (_: E) => F,
  fg: (_: F) => G,
  gh: (_: G) => H,
  hi: (_: H) => I,
  ...args: any[]
): (..._: A) => Z
export function flow<A extends [any, ...any[]]>(
  head: any,
  ...args: any[]
): (..._: A) => unknown {
  return (..._) => args.reduce((r, f) => f(r), head(..._))
}
