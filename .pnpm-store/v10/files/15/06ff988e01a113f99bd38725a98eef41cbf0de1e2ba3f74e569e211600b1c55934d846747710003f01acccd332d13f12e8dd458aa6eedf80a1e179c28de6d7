@genType
type t<'a> = dict<'a>

external from: {..} => t<'a> = "%identity"
external fromUnsafe: 't => t<'a> = "%identity"
external asUnsafe: t<'a> => 'struct = "%identity"

@genType
let make = Dict.make

@module("fp-ts/Record")
external bind: (t<'a>, string, 'a) => t<'a> = "bind"

@module("fp-ts/Record")
external singleton: (string, 'a) => t<'a> = "singleton"

let zero: t<'a> = %raw("{}")
let zero: 'a. unit => t<'a> = () => zero->Types.unsafeCoerce

@inline
let bindSymbol: (t<'a>, Symbol.t, 'a) => t<'a> = (dict, key, value) =>
  dict->bind(key->Types.unsafeCoerce, value)

@inline
let singletonSymbol: (Symbol.t, 'a) => t<'a> = (key, value) =>
  singleton(key->Types.unsafeCoerce, value)

@module("fp-ts/Record") external map: (t<'a>, 'a => 'b) => t<'b> = "map"

@module("fp-ts/Record") external mapI: (t<'a>, (string, 'a) => 'b) => t<'b> = "mapI"

@val
external keys: t<'a> => array<string> = "Object.keys"

@val @scope("Object")
external fromEntries: array<('k, 'a)> => t<'a> = "fromEntries"

@val @scope("Object")
external entries: t<'a> => array<(string, 'a)> = "entries"
