import { describe, expect, it } from "vitest"

import { pipe } from "../Functions"
import * as JsObject from "../JsObject"
import { mapGetter } from "../JsPropertyDescriptor"

describe("Option", () => {
  it("basic", () => {
    JsObject._mapI({ a: 1, b: "" }, (key, value) => (key === "b" ? value : 0))
    const testSymbol = Symbol.for("b")
    const c = pipe(
      JsObject.singleton("A", 1),
      JsObject.bind("A", "1"),
      JsObject.bindWith("b", (a) => parseInt(a.A)),
      JsObject.bindWith(testSymbol, (a) => a.b + ""),
    )
    console.log(c)
    expect(JsObject.getOwnPropertySymbols(c)).toEqual([Symbol.for("b")])

    const obj = {
      foo: 1,
      get bar() {
        return this.foo
      },
    }
    Object.defineProperty(
      obj,
      "bar",
      mapGetter(
        JsObject.getOwnPropertyDescriptor(obj, "bar"),
        (self: typeof obj, source) => self.foo * 10 + source(),
      ),
    )
    expect(obj.bar).toBe(11)
  })
})
