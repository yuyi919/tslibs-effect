{"version":3,"file":"Ring.js","names":["getRing","tuple","rings","add","x","y","map","R","i","zero","mul","one","sub","negate","a","getTupleRing","getFunctionRing"],"sources":["src/Ring.js"],"sourcesContent":["/**\n * The `Ring` class is for types that support addition, multiplication, and subtraction operations.\n *\n * Instances must satisfy the following law in addition to the `Semiring` laws:\n *\n * - Additive inverse: `a - a <-> (zero - a) + a <-> zero`\n *\n * Adapted from https://github.com/purescript/purescript-prelude/blob/master/src/Data/Ring.purs\n *\n * @since 2.0.0\n */import{getRing}from\"./function.js\";// -------------------------------------------------------------------------------------\n// combinators\n// -------------------------------------------------------------------------------------\n/**\n * Given a tuple of `Ring`s returns a `Ring` for the tuple\n *\n * @example\n * import { tuple } from 'fp-ts/Ring'\n * import * as N from 'fp-ts/number'\n *\n * const R = tuple(N.Field, N.Field, N.Field)\n * assert.deepStrictEqual(R.add([1, 2, 3], [4, 5, 6]), [5, 7, 9])\n * assert.deepStrictEqual(R.mul([1, 2, 3], [4, 5, 6]), [4, 10, 18])\n * assert.deepStrictEqual(R.one, [1, 1, 1])\n * assert.deepStrictEqual(R.sub([1, 2, 3], [4, 5, 6]), [-3, -3, -3])\n * assert.deepStrictEqual(R.zero, [0, 0, 0])\n *\n * @since 2.10.0\n */export const tuple=(...rings)=>({add:(x,y)=>rings.map((R,i)=>R.add(x[i],y[i])),zero:rings.map(R=>R.zero),mul:(x,y)=>rings.map((R,i)=>R.mul(x[i],y[i])),one:rings.map(R=>R.one),sub:(x,y)=>rings.map((R,i)=>R.sub(x[i],y[i]))});// -------------------------------------------------------------------------------------\n// utils\n// -------------------------------------------------------------------------------------\n/**\n * `negate x` can be used as a shorthand for `zero - x`\n *\n * @since 2.0.0\n */export const negate=R=>a=>R.sub(R.zero,a);// -------------------------------------------------------------------------------------\n// deprecated\n// -------------------------------------------------------------------------------------\n/**\n * Use [`tuple`](#tuple) instead.\n *\n * @category zone of death\n * @since 2.0.0\n * @deprecated\n */export const getTupleRing=tuple;/**\n * Use [`getRing`](./function.ts.html#getring) instead.\n *\n * @category zone of death\n * @since 2.0.0\n * @deprecated\n */export const getFunctionRing=getRing;"],"mappings":"AAAA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA,GAAG,SAAOA,OAAO,QAAK,eAAe,CAAC;AACtC;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AAAG,OAAO,IAAMC,KAAK,GAACA,CAAC,GAAGC,KAAK,MAAI;EAACC,GAAG,EAACA,CAACC,CAAC,EAACC,CAAC,KAAGH,KAAK,CAACI,GAAG,CAAC,CAACC,CAAC,EAACC,CAAC,KAAGD,CAAC,CAACJ,GAAG,CAACC,CAAC,CAACI,CAAC,CAAC,EAACH,CAAC,CAACG,CAAC,CAAC,CAAC,CAAC;EAACC,IAAI,EAACP,KAAK,CAACI,GAAG,CAACC,CAAC,IAAEA,CAAC,CAACE,IAAI,CAAC;EAACC,GAAG,EAACA,CAACN,CAAC,EAACC,CAAC,KAAGH,KAAK,CAACI,GAAG,CAAC,CAACC,CAAC,EAACC,CAAC,KAAGD,CAAC,CAACG,GAAG,CAACN,CAAC,CAACI,CAAC,CAAC,EAACH,CAAC,CAACG,CAAC,CAAC,CAAC,CAAC;EAACG,GAAG,EAACT,KAAK,CAACI,GAAG,CAACC,CAAC,IAAEA,CAAC,CAACI,GAAG,CAAC;EAACC,GAAG,EAACA,CAACR,CAAC,EAACC,CAAC,KAAGH,KAAK,CAACI,GAAG,CAAC,CAACC,CAAC,EAACC,CAAC,KAAGD,CAAC,CAACK,GAAG,CAACR,CAAC,CAACI,CAAC,CAAC,EAACH,CAAC,CAACG,CAAC,CAAC,CAAC;AAAC,CAAC,CAAC,CAAC;AAClO;AACA;AACA;AACA;AACA;AACA;AACA;AAAG,OAAO,IAAMK,MAAM,GAACN,CAAC,IAAEO,CAAC,IAAEP,CAAC,CAACK,GAAG,CAACL,CAAC,CAACE,IAAI,EAACK,CAAC,CAAC,CAAC;AAC7C;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AAAG,OAAO,IAAMC,YAAY,GAACd,KAAK,CAAC;AACnC;AACA;AACA;AACA;AACA;AACA;AAAG,OAAO,IAAMe,eAAe,GAAChB,OAAO","ignoreList":[]}