import { __KEY_GET, __KEY_VALUE, __KEY_WRITABLE } from "../constant"
import { useThis } from "../proto"
import { _bind } from "./bind"
import { _hasOwnKey } from "./keys"

export function chainValue(
  desc: PropertyDescriptor,
  fn: (value: any, descriptor: PropertyDescriptor) => PropertyDescriptor,
) {
  return _hasOwnKey(desc, __KEY_VALUE) ? fn(desc[__KEY_VALUE], desc) : desc
}

export function mapValue(
  desc: PropertyDescriptor,
  fn: (value: any, descriptor: PropertyDescriptor) => any,
) {
  return chainValue(desc, (value, self) =>
    _bind(self, __KEY_VALUE, fn(value, desc)),
  )
}

export function mapGetter<This = any>(
  desc: PropertyDescriptor,
  fn: (self: This, source: () => any) => any,
) {
  return _mapGetter<This>(desc, (self, source) =>
    fn(self, () => source.call(self)),
  )
}

export function _mapGetter<This = any>(
  desc: PropertyDescriptor,
  fn: (self: This, source: () => any) => any,
) {
  return _hasOwnKey(desc, __KEY_GET)
    ? _bind(
        desc,
        __KEY_GET,
        useThis((self) => fn(self, desc.get!)),
      )
    : desc
}

export function withReadonly(
  desc: PropertyDescriptor,
  readonly: boolean = true,
) {
  return chainValue(desc, (_, self) => _bind(self, __KEY_WRITABLE, !readonly))
}
