/**
 * This module provides an implementation of the `Order` type class which is used to define a total ordering on some type `A`.
 * An order is defined by a relation `<=`, which obeys the following laws:
 *
 * - either `x <= y` or `y <= x` (totality)
 * - if `x <= y` and `y <= x`, then `x == y` (antisymmetry)
 * - if `x <= y` and `y <= z`, then `x <= z` (transitivity)
 *
 * The truth table for compare is defined as follows:
 *
 * | `x <= y` | `x >= y` | Ordering |                       |
 * | -------- | -------- | -------- | --------------------- |
 * | `true`   | `true`   | `0`      | corresponds to x == y |
 * | `true`   | `false`  | `< 0`    | corresponds to x < y  |
 * | `false`  | `true`   | `> 0`    | corresponds to x > y  |
 *
 * @since 2.0.0
 */

import { flip0 } from "./Functions"
import { dual } from "./internal/helper"
import { jsObjectKeys } from "./JsObject"
import * as NonNullable from "./NonNullable"

/**
 * @category type class
 * @since 2.0.0
 */
export interface Order<in A> {
  (self: A, that: A): -1 | 0 | 1
}

/**
 * @category constructors
 * @since 2.0.0
 */
export function define<A>(compare: (self: A, that: A) => -1 | 0 | 1): Order<A> {
  return compare
}

/**
 * @category constructors
 * @since 2.0.0
 */
export function make<A>(compare: (self: A, that: A) => -1 | 0 | 1): Order<A> {
  return (self, that) => (self === that ? 0 : compare(self, that))
}

/**
 * @category constructors
 * @since 2.0.0
 */
export function from<A>(compare: (self: A, that: A) => -1 | 0 | 1): Order<A> {
  return compare
}

/**
 * @category instances
 * @since 2.0.0
 */
export const string: Order<string> = (self, that) =>
  self === that ? 0 : self < that ? -1 : 1

/**
 * @category instances
 * @since 2.0.0
 */
export const number: Order<number> = (self, that) =>
  self === that ? 0 : self < that ? -1 : 1

/**
 * @category instances
 * @since 2.0.0
 */
export const boolean: Order<boolean> = (self, that) =>
  self === that ? 0 : self < that ? -1 : 1

/**
 * @category instances
 * @since 2.0.0
 */
export const bigint: Order<bigint> = (self, that) =>
  self === that ? 0 : self < that ? -1 : 1

/**
 * @since 2.0.0
 */
export const reverse = <A>(O: Order<A>): Order<A> => flip0(O)

/**
 * @category combining
 * @since 2.0.0
 */
export const combine: {
  <A>(that: Order<A>): (self: Order<A>) => Order<A>
  <A>(self: Order<A>, that: Order<A>): Order<A>
} = dual(
  2,
  <A>(self: Order<A>, that: Order<A>): Order<A> =>
    (a1, a2) =>
      NonNullable.nullWhen(self(a1, a2), 0) ?? that(a1, a2),
)

/**
 * @category combining
 * @since 2.0.0
 */
export const combineMany: {
  <A>(collection: Iterable<Order<A>>): (self: Order<A>) => Order<A>
  <A>(self: Order<A>, collection: Iterable<Order<A>>): Order<A>
} = dual(
  2,
  <A>(self: Order<A>, collection: Iterable<Order<A>>): Order<A> =>
    (a1, a2) =>
      NonNullable.nullWhen(self(a1, a2), 0) ??
      NonNullable.findIterableMap(collection, (O, _) =>
        NonNullable.nullWhen(O(a1, a2), 0),
      ) ??
      0,
)

/**
 * @since 2.0.0
 */
export const empty =
  <A>(): Order<A> =>
  (_a, _b) =>
    0

/**
 * @category combining
 * @since 2.0.0
 */
export const combineAll = <A>(collection: Iterable<Order<A>>): Order<A> =>
  combineMany(empty(), collection)

/**
 * @category mapping
 * @since 2.0.0
 */
export const mapInput: {
  <B, A>(f: (b: B) => A): (self: Order<A>) => Order<B>
  <A, B>(self: Order<A>, f: (b: B) => A): Order<B>
} = dual(
  2,
  <A, B>(self: Order<A>, f: (b: B) => A): Order<B> =>
    (b1, b2) =>
      self(f(b1), f(b2)),
)

/**
 * @category instances
 * @since 2.0.0
 */
export const Date: Order<Date> = mapInput(number, (date) => date.getTime())

/**
 * @category combining
 * @since 2.0.0
 */
export const product: {
  <B>(that: Order<B>): <A>(self: Order<A>) => Order<readonly [A, B]> // readonly because invariant
  <A, B>(self: Order<A>, that: Order<B>): Order<readonly [A, B]> // readonly because invariant
} = dual(
  2,
  <A, B>(self: Order<A>, that: Order<B>): Order<readonly [A, B]> =>
    make(
      ([xa, xb], [ya, yb]) =>
        NonNullable.nullWhen(self(xa, ya), 0) ?? that(xb, yb),
    ),
) as any

/**
 * @category combining
 * @since 2.0.0
 */
export function all<A>(
  collection: Iterable<Order<A>>,
): Order<ReadonlyArray<A>> {
  return make((x, y) =>
    ((len) =>
      NonNullable.findIterableMap(collection, (O, i) =>
        i >= len ? 0 : NonNullable.nullWhen(O(x[i]!, y[i]!), 0),
      ) ?? 0)(Math.min(x.length, y.length)),
  )
}

/**
 * @category combining
 * @since 2.0.0
 */
export const productMany: {
  <A>(
    collection: Iterable<Order<A>>,
  ): (self: Order<A>) => Order<readonly [A, ...Array<A>]> // readonly because invariant
  <A>(
    self: Order<A>,
    collection: Iterable<Order<A>>,
  ): Order<readonly [A, ...Array<A>]> // readonly because invariant
} = dual(
  2,
  <A>(
    self: Order<A>,
    collection: Iterable<Order<A>>,
  ): Order<readonly [A, ...Array<A>]> =>
    ((O) =>
      make((x, y) =>
        ((o) => (o !== 0 ? o : O(x.slice(1), y.slice(1))))(self(x[0], y[0])),
      ))(all(collection)),
)

/**
 * Similar to `Promise.all` but operates on `Order`s.
 *
 * ```
 * [Order<A>, Order<B>, ...] -> Order<[A, B, ...]>
 * ```
 *
 * This function creates and returns a new `Order` for a tuple of values based on the given `Order`s for each element in the tuple.
 * The returned `Order` compares two tuples of the same type by applying the corresponding `Order` to each element in the tuple.
 * It is useful when you need to compare two tuples of the same type and you have a specific way of comparing each element
 * of the tuple.
 *
 * @category combinators
 * @since 2.0.0
 */
export function tuple<T extends ReadonlyArray<Order<any>>>(
  ...elements: T
): Order<
  Readonly<{
    [I in keyof T]: [T[I]] extends [Order<infer A>] ? A : never
  }>
> {
  return all(elements) as any
}

/**
 * This function creates and returns a new `Order` for an array of values based on a given `Order` for the elements of the array.
 * The returned `Order` compares two arrays by applying the given `Order` to each element in the arrays.
 * If all elements are equal, the arrays are then compared based on their length.
 * It is useful when you need to compare two arrays of the same type and you have a specific way of comparing each element of the array.
 *
 * @category combinators
 * @since 2.0.0
 */
export function array<A>(O: Order<A>): Order<ReadonlyArray<A>> {
  return make((a, b) =>
    ((aLen, bLen) =>
      NonNullable.findIterableMap(bLen < aLen ? b : a, (_, key) =>
        NonNullable.nullWhen(O(a[key]!, b[key]!), 0),
      ) ?? number(aLen, bLen))(a.length, b.length),
  )
}

/**
 * This function creates and returns a new `Order` for a struct of values based on the given `Order`s
 * for each property in the struct.
 *
 * @category combinators
 * @since 2.0.0
 */
export function struct<R extends { readonly [x: string]: Order<any> }>(
  fields: R,
): Order<{
  [K in keyof R]: [R[K]] extends [Order<infer A>] ? A : never
}> {
  return ((keys) =>
    make(
      (self, that) =>
        NonNullable.findIterableMap(keys, (key) =>
          NonNullable.nullWhen(fields[key]!(self[key]!, that[key]!), 0),
        ) ?? 0,
    ))(jsObjectKeys(fields))
}

/**
 * Test whether one value is _strictly less than_ another.
 *
 * @since 2.0.0
 */
export function _lessThan<A>(O: Order<A>, self: A, that: A): boolean {
  return O(self, that) === -1
}
/**
 * Test whether one value is _strictly less than_ another.
 *
 * @since 2.0.0
 */
export function lessThan<A>(O: Order<A>): {
  (that: A): (self: A) => boolean
  (self: A, that: A): boolean
} {
  return dual(2, (self: A, that: A) => O(self, that) === -1)
}

/**
 * Test whether one value is _strictly less than_ another.
 *
 * @since 2.0.0
 */
export function _greaterThan<A>(O: Order<A>, self: A, that: A): boolean {
  return O(self, that) === 1
}
/**
 * Test whether one value is _strictly greater than_ another.
 *
 * @since 2.0.0
 */
export function greaterThan<A>(O: Order<A>): {
  (that: A): (self: A) => boolean
  (self: A, that: A): boolean
} {
  return dual(2, (self: A, that: A) => O(self, that) === 1)
}

/**
 * Test whether one value is _non-strictly less than_ another.
 *
 * @since 2.0.0
 */
export function lessThanOrEqualTo<A>(O: Order<A>): {
  (that: A): (self: A) => boolean
  (self: A, that: A): boolean
} {
  return dual(2, (self: A, that: A) => O(self, that) !== 1)
}

/**
 * Test whether one value is _non-strictly greater than_ another.
 *
 * @since 2.0.0
 */
export function greaterThanOrEqualTo<A>(O: Order<A>): {
  (that: A): (self: A) => boolean
  (self: A, that: A): boolean
} {
  return dual(2, (self: A, that: A) => O(self, that) !== -1)
}

/**
 * Take the minimum of two values. If they are considered equal, the first argument is chosen.
 *
 * @since 2.0.0
 */
export function _min<A>(O: Order<A>, self: A, that: A): A {
  return self === that || O(self, that) < 1 ? self : that
}

/**
 * Take the minimum of two values. If they are considered equal, the first argument is chosen.
 *
 * @since 2.0.0
 */
export function min<A>(O: Order<A>): {
  (that: A): (self: A) => A
  (self: A, that: A): A
} {
  return dual(2, (self: A, that: A) => _min(O, self, that))
}

/**
 * Take the minimum of two values. If they are considered equal, the first argument is chosen.
 *
 * @since 2.0.0
 */
export function _max<A>(O: Order<A>, self: A, that: A): A {
  return self === that || O(self, that) > -1 ? self : that
}

/**
 * Take the maximum of two values. If they are considered equal, the first argument is chosen.
 *
 * @since 2.0.0
 */
export function max<A>(O: Order<A>): {
  (that: A): (self: A) => A
  (self: A, that: A): A
} {
  return dual(2, (self: A, that: A) => _max(O, self, that))
}

export type ClampOption<A> = {
  min: A
  max: A
}

/**
 * Clamp a value between a minimum and a maximum.
 *
 * @example
 * import { Order, Number } from "effect"
 *
 * const clamp = Order.clampWith(Number.Order)({ min: 1, max: 5 })
 *
 * assert.equal(clamp(3), 3)
 * assert.equal(clamp(0), 1)
 * assert.equal(clamp(6), 5)
 *
 * @since 2.0.0
 */
export function clampWith<A>(O: Order<A>): {
  (options: ClampOption<A>): (self: A) => A
  (self: A, options: ClampOption<A>): A
} {
  return dual(
    2,
    (self: A, options: ClampOption<A>): A =>
      _min(O, options.max, _max(O, options.min, self)),
  )
}

/**
 * Clamp a value between a minimum and a maximum.
 *
 * @example
 * import { Order, Number } from "effect"
 *
 * const clamp = Order.clampWithArgs(Number.Order)(1, 5)
 *
 * assert.equal(clamp(3), 3)
 * assert.equal(clamp(0), 1)
 * assert.equal(clamp(6), 5)
 *
 * @since 2.0.0
 */
export function clampWithArgs<A>(O: Order<A>): {
  (min: A, max: A): (self: A) => A
  (self: A, min: A, max: A): A
} {
  return dual(
    3,
    (self: A, min: A, max: A): A => _min(O, max, _max(O, min, self)),
  )
}

/**
 * Test whether a value is between a minimum and a maximum (inclusive).
 *
 * @since 2.0.0
 */
export function betweenWith<A>(O: Order<A>): {
  (options: ClampOption<A>): (self: A) => boolean
  (self: A, options: ClampOption<A>): boolean
} {
  return dual(
    2,
    (self: A, options: ClampOption<A>): boolean =>
      !_lessThan(O, self, options.min) && !_greaterThan(O, self, options.max),
  )
}

/**
 * Test whether a value is between a minimum and a maximum (inclusive).
 *
 * @since 2.0.0
 */
export function betweenWithArgs<A>(O: Order<A>): {
  (min: A, max: A): (self: A) => boolean
  (self: A, min: A, max: A): boolean
} {
  return dual(
    3,
    (self: A, min: A, max: A): boolean =>
      !_lessThan(O, self, min) && !_greaterThan(O, self, max),
  )
}
