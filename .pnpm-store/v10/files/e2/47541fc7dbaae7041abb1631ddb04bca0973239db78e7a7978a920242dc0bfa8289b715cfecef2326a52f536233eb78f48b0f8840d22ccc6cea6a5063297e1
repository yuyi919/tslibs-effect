import { toArray as castArray } from "../JsTypes"

type Parameter = { name: string; optional?: boolean; default: string }
type Factory = {
  args: Parameter[]
  typed: boolean
  typeName: string
}

class SimpleStruct {
  constructor(
    public args: string[],
    public typed: boolean,
    public typeName: string,
    public hash = [...args].sort().join(","),
  ) {}
  bump(args: string[]) {
    return new SimpleStruct(args, this.typed, this.typeName)
  }

  toCall(callName: string, mapToRaw: (key: string) => string) {
    const { args, typed, typeName } = this
    return `const ${callName} = (${args
      .map(getLabel)
      .join(", ")}) => ${args.reduce(
      (call, o) => {
        const key = mapToRaw(o)
        const value = getLabel(o)
        if (JSON.stringify(value) === key) {
          return value
        }
        return `appendDefine(${key}, ${value})(${call})`
      },
      typed ? `define(${mapToRaw("$type")}, ${mapToRaw(typeName)})\n` : "{}",
    )}`
  }

  toExtendCall(
    callName: string,
    mapToRaw: (key: string) => string,
    lastCallName: string,
    last: SimpleStruct,
  ) {
    const { args } = this
    return `const ${callName} = (${args.map(getLabel).join(", ")}) => ${args
      .filter((o) => !last.args.includes(o))
      .reduce(
        (result, o) => {
          const key = mapToRaw(o)
          const value = getLabel(o)
          if (JSON.stringify(value) === key) {
            return value
          }
          return `appendDefine(${key}, ${value})(${result})`
        },
        `${lastCallName}(${last.args.map(getLabel).join(", ")})`,
      )}`
  }
}

function sortArgsBump(
  args: string[],
  next: [string, string][],
  undefinedRaw: string,
): [string, string][] {
  // return next.map(o=> o).sort((a, b) => args.includes(a) ? args.includes(b) ? 0 : -1 : 1)
  const first: [string, string][] = args.map((name) => {
    return [name, next.find((o) => o[0] === name)?.[1] ?? undefinedRaw]
  })
  return first.concat(next.filter((o) => !first.some((t) => t[0] === o[0])))
}

class Automic {
  structs: SimpleStruct[] = []
  constructor(input: SimpleStruct | SimpleStruct[]) {
    this.structs.push(...castArray(input))
  }

  static from(args: string[], typed: boolean, typeName: string) {
    return new Automic(new SimpleStruct(args, typed, typeName))
  }

  findIndex(fn: (exsist: SimpleStruct) => any) {
    return this.structs.findIndex(fn)
  }

  append(index: number, args: string[]) {
    this.structs.push(this.structs[index]!.bump(args))
  }

  bump(callName: string, kvs: [string, string][], mapToRaw: (arg: any) => any) {
    let args = kvs.map((o) => o[0])
    let nextHash = [...args].sort().join(",")
    let match = this.structs.findIndex((struct) => nextHash === struct.hash)
    // 先寻找形状相似的
    if (match === -1) {
      const i = this.structs.length - 1
      const last = this.structs[i]!
      kvs = sortArgsBump(last.args, kvs, mapToRaw(undefined))
      // 找不到就继承之前的，再次寻找之前是否已有继承过的形状
      args = kvs.map((o) => o[0])
      nextHash = [...args].sort().join(",")
      match = this.structs.findIndex((struct) => nextHash === struct.hash)
    }
    if (match === -1) {
      // 找不到就生成新的形状，如果之前进行过扩张
      const i = this.structs.length - 1
      const last = this.structs[i]!
      this.structs.push(last.bump(kvs.map((o) => o[0])))
      const nextI = i + 1
      callName += "_" + nextI
    } else if (match > 0) {
      callName += "_" + match
    }
    return `${callName}(${this.toCallParams(match, kvs).join(", ")})`
  }

  toCallParams(match: number, struts: [string, string][]) {
    return this.structs[match]
      ? this.structs[match].args.map(
          (name) => struts.find((o) => o[0] === name)![1],
        )
      : struts.map((value) => value[1])
  }

  outputDefine(fnName: string) {
    return this.structs.map(
      (define, index) =>
        [index === 0 ? fnName : fnName + "_" + index, define] as const,
    )
  }
}
const macro = new Map<string, Factory | Automic>([
  [
    "ParserRule",
    {
      args: [
        { name: "name", default: "undefined" },
        { name: "definesHiddenTokens", default: "false" },
        { name: "entry", default: "false" },
        { name: "fragment", default: "false" },
        { name: "hiddenTokens", default: "[]" },
        { name: "parameters", default: "[]" },
        { name: "wildcard", default: "false" },
        { name: "definition", default: "undefined" },
        { name: "dataType", default: "undefined" },
        { name: "inferredType", default: "undefined" },
        { name: "returnType", default: "undefined" },
      ],
      typed: true,
      typeName: "ParserRule",
    },
  ],
  [
    "RuleCall",
    {
      args: [
        { name: "rule", default: "undefined" },
        { name: "arguments", default: "[]" },
        { name: "cardinality", default: "undefined" },
      ],
      typed: true,
      typeName: "RuleCall",
    },
  ],
])

const labelNames: any = {
  true: "true_",
  false: "false_",
  arguments: "arguments_",
  function: "function_",
  let: "let_",
}

const getLabel = (name: string) =>
  !labelNames[name] || labelNames[name] === name ? name : labelNames[name]
export function compressToFactory(
  data: Record<string, any>,
  mapToRaw: (arg: any) => string = (a) => JSON.stringify(a),
) {
  function each(data: any): string {
    if (data instanceof Array) return "[" + data.map(each).join(",") + "]"
    const keys = Object.keys(data)
    const name = keys.find((o) => o === "$type" || o === "$ref")
    if (name) {
      const values: [string, string][] = []
      for (let key of keys) {
        if (key == "$type") continue
        values.push([key, each(data[key])])
      }
      // values.sort(([an], [bn]) => an.localeCompare(bn));
      const args = values.map((value) => value[0])
      let callName = name !== "$type" ? name : data[name]
      const exsist = macro.get(callName)
      if (!exsist) {
        macro.set(callName, Automic.from(args, name === "$type", data[name]))
        const params = values.map((value) => value[1])
        return `${callName}(${params.join(", ")})`
      } else if (exsist instanceof Automic) {
        return exsist.bump(callName, values, mapToRaw)
      } else {
        return `${callName}(${exsist.args
          .map((p) =>
            args.includes(p.name)
              ? values.find((o) => o[0] === p.name)![1]
              : mapToRaw(p.default === "undefined" ? undefined : p.default),
          )
          .join(", ")})`
      }
    }
    return mapToRaw(data)
  }
  const content = each(data)
  const macros = Array.from(macro.entries())
    .flatMap(([name, define]) => {
      if (define instanceof Automic) {
        return define.outputDefine(name)
      }
      return [
        [
          name,
          new SimpleStruct(
            define.args.map((o) => o.name),
            define.typed,
            define.typeName,
            "",
          ),
        ] as const,
      ]
    })
    .map(([name, define], i, list) => {
      if (i > 0 && list[i - 1]![1].typeName === define.typeName) {
        const [lastName, last] = list[i - 1]!
        return define.toExtendCall(name, mapToRaw, lastName, last)
      }
      return define.toCall(name, mapToRaw)
    })
  return [macros, content] as const
}
