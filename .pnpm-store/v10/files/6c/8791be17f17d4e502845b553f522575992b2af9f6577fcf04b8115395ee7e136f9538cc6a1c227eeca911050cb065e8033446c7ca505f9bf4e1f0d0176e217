type t<'a>

type value<'a> = {
  done: bool,
  value: option<'a>,
}

@send external next: t<'a> => value<'a> = "next"
@module("./constant")
external toArray: t<'a> => array<'a> = "ARRAY_FROM"
@module("./constant")
external toArrayWithMapper: (t<'a>, 'a => 'b) => array<'b> = "ARRAY_FROM"

let forEach = (iterator, f) => {
  let iteratorDone = ref(false)

  while !iteratorDone.contents {
    let {done, value} = iterator->next
    f(value)
    iteratorDone := done
  }
}
