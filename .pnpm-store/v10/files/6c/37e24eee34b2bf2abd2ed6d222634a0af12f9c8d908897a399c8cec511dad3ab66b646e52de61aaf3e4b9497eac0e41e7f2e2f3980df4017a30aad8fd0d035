export const from = (
  pattern: string | RegExp,
): Parser.Parser<string, string> =>
  typeof pattern === "string" ? string(pattern) : regexp(pattern)

/**
 * @category constructors
 * @since 0.7.0
 */
export function oneOfString<K extends string>(
  strs: [K, ...K[]],
): Parser.Parser<string, K> {
  return Parser.define((input: Stream.IStream<string>) => {
    const expect: string[] = []
    for (let i = 0; i < strs.length; ++i) {
      const str = strs[i]!
      if (Stream.matchNextStr(input, str))
        return PR.succeed(str, Stream.consume(input, str.length), input)
      expect.push(JSON.stringify(str))
    }
    return PR.failed(input, expect, false)
  })
}

export function oneOfPattern<K extends string>(
  patterns: [K | RegExp, ...(K | RegExp)[]],
): Parser.t<string, string> {
  return Parser.define((input) => {
    const expect: string[] = []
    const buffer = Stream.seq2str(Stream.getBuffer(input))
    const cursor = Stream.getCursor(input)
    for (let i = 0; i < patterns.length; ++i) {
      const pattern = patterns[i]!
      if (typeof pattern === "string") {
        if (Stream.matchNextStr(input, pattern)) {
          return PR.succeed(
            pattern,
            Stream.consume(input, pattern.length),
            input,
          )
        }
      } else {
        const result = Exp._execAt(pattern, buffer, cursor)
        if (result) {
          return PR.succeed(
            result[0],
            Stream.consume(input, result[0].length),
            input,
          )
        }
      }
      expect.push(JSON.stringify(pattern))
    }
    return PR.failed(input, expect, false)
  })
}

export const string = <K extends string>(str: K): Parser.t<string, K> => {
  const expected = [JSON.stringify(str)]
  return Parser.define((input) =>
    Stream.matchNextStr(input, str)
      ? PR.succeed(str, Stream.consume(input, str.length), input)
      : PR.failed(input, expected, false),
  )
}

export const expMap =
  <T>(map: (matched: RegExpExecArray) => T) =>
  (regex: Exp.ExpressionBuilder): Parser.t<string, T> =>
    regexpMap<T>(pipe(regex, Exp.sticky, Exp.unicode, Exp.toRegex), map)

export function regexpMap<T>(
  regex: RegExp,
  map: (matched: RegExpExecArray) => T,
): Parser.t<string, T> {
  const errors = [regex.source]
  return Parser.define((stream) => {
    const result = Exp._execAt(
      regex,
      Stream.seq2str(Stream.getBuffer(stream)),
      Stream.getCursor(stream),
    )
    return result === null
      ? PR.failed(stream, errors, false)
      : PR.succeed(
          map(result),
          Stream.consume(stream, result[0].length),
          stream,
        )
  })
}

export const exp = (
  regex: Exp.ExpressionBuilder,
  matchIndex?: number | undefined,
): Parser.t<string, string> =>
  regexp(pipe(regex, Exp.sticky, Exp.unicode, Exp.toRegex), matchIndex)
export function regexp(
  regex: RegExp,
  matchIndex?: number | undefined,
): Parser.t<string, string>
export function regexp<T>(
  regex: RegExp,
  extract: number | undefined = 0,
): Parser.t<string, string | void | T> {
  if (!regex.sticky) {
    regex = new RegExp(regex.source, `${regex.flags}y`)
  }
  const errors = [regex.source]
  const index = typeof extract !== "number" ? 0 : extract
  return Parser.define((stream, _option) => {
    const result = Exp._execAt(
      regex,
      Stream.seq2str(Stream.getBuffer(stream)),
      Stream.getCursor(stream),
    )
    return result === null || (index > 0 && result[index] == null)
      ? PR.failed(stream, errors, false)
      : PR.succeed(
          result[index],
          Stream.consume(stream, result[0].length),
          stream,
        )
  })
}

export const EOF: Parser.Parser<string, string> =
  Parser.eofWith<string>("")<string>()
export const EOL: Parser.Parser<string, string> = regexp(/\r?\n/y)
export const MANY_SPACE_EOL: Parser.Parser<string, string> = Parser.alts(
  EOF,
  pipe(regexp(/[ \t]*(\r?\n|$)/y), Parser.withStartHint(" ", "\r", "\n")),
)

export const TOKEN_END: Parser.Parser<string, string | C.Char> = Parser.alts(
  C.notAlphanum,
  EOL,
  EOF,
)

export const castArray: <I>(
  parser: Parser.t<I, string>,
) => Parser.t<I, string[]> = (parser) =>
  Parser.mapF(parser, (a) => (a.length > 0 ? [a] : []))

export const chainConcat =
  <I>(
    i: Parser.t<I, string>,
  ): ((a: Parser.t<I, string>) => Parser.t<I, string>) =>
  (input) =>
    Parser.liftMap(input, i, (r, e) => (e && r ? r + e : r || e))
export const chainConcatLazy =
  <I>(
    i: () => Parser.t<I, string>,
  ): ((a: Parser.t<I, string>) => Parser.t<I, string>) =>
  (input) =>
    Parser.liftMap(input, Parser.lazy(i), (r, e) => (e && r ? r + e : r || e))

export const keyword = (str: string): Parser.Parser<string, string> =>
  Parser.apLookAhead(TOKEN_END)(string(str))

export const spaces: Parser.Parser<string, string> = regexp(/\s*/y)
export const spaces1: Parser.Parser<string, string> = Parser.expected(
  regexp(/\s+/y),
  "a whitespace",
)
export const notSpaces: Parser.Parser<string, string> = regexp(/[^\s]*/y)
export const notSpaces1: Parser.Parser<string, string> = regexp(/[^\s]+/y)
export const spacesInline: Parser.Parser<string, string> = regexp(/[ \t]*/y)
export const spacesInline1: Parser.Parser<string, string> = regexp(/[ \t]+/y)

export const intS: Parser.Parser<string, string> = regexp(/\d+/y)
export const floatS: Parser.Parser<string, string> = regexp(/\d+\.\d*|\.\d+/y)

export const _unit: Parser.Parser<unknown, string> = Parser.of("")

export const unit = <I>() => _unit as Parser.t<I, string>

export const maybeLazy = <I>(
  p: () => Parser.t<I, string>,
): Parser.Parser<I, string> =>
  Parser.eitherConst<I, string>(Parser.lazy(p), _unit as Parser.t<I, string>)

export const betweenCat =
  <I>(left: Parser.t<I, string>, right: Parser.t<I, string>) =>
  (p: Parser.t<I, string>): Parser.Parser<I, string> =>
    _betweenCat(p, left, right)

export const _betweenCat = <I>(
  content: Parser.t<I, string>,
  left: Parser.t<I, string>,
  right: Parser.t<I, string>,
): Parser.Parser<I, string> => Parser.liftMap3(left, content, right, join3)

export function concat<I>(
  ...all: NA.NonEmptyArray<Parser.t<I, string>>
): Parser.t<I, string>
export function concat<I>() {
  switch (arguments.length) {
    case 1:
      return arguments[0]
    case 2:
      return Parser.liftMap2<I, string, string, string>(
        arguments[0],
        arguments[1],
        join2,
      )
    case 3:
      return Parser.liftMap3<I, string, string, string, string>(
        arguments[0],
        arguments[1],
        arguments[2],
        join3,
      )
    default:
      return Parser.liftMap(...(arguments as unknown as [any, any, any]), join)
  }
}

export const concatMaybe =
  <I>(
    maybe: Parser.t<I, string>,
  ): ((content: Parser.t<I, string>) => Parser.t<I, string>) =>
  (content) =>
    _concatMaybe(content, maybe)

export const _concatMaybe = <I>(
  content: Parser.t<I, string>,
  maybe: Parser.t<I, string>,
): Parser.t<I, string> =>
  Parser._tryChain(content, (a) => Parser.mapF(maybe, (b) => a + b))

export const concatAll = (...strs: (string | string[])[]): string[] => {
  const result: string[] = []
  for (let i = 0; i < strs.length; ++i)
    if (strs[i]!.length > 0)
      if (typeof strs[i] === "string") result.push(strs[i] as string)
      else result.push(...strs[i]!)
  return result
}
export const join2 = (a: string, b: string): string => a + b
export const join3 = (a: string, b: string, c: string): string => a + b + c
export const joinAll = (strs: string[]): string => {
  let result: string = strs[0]!
  if (strs.length > 1)
    for (let i = 1; i < strs.length; ++i)
      if (strs[i]!.length > 0)
        if (typeof strs[i] === "string") result += strs[i]
  return result
}

export const join = (...strs: string[]): string => {
  let result: string = strs[0]!
  if (strs.length > 1)
    for (let i = 1; i < strs.length; ++i)
      if (strs[i]!.length > 0)
        if (typeof strs[i] === "string") result += strs[i]
  return result
}
