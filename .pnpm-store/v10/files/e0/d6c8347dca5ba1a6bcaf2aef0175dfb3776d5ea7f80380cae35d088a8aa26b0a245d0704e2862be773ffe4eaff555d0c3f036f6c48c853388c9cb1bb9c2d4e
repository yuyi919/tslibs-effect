export const str2seq = (
  arr: string | readonly string[],
): SeqLike.SeqLike<string> => (typeof arr === "string" ? arr : arr.join("")) // [0];

export const seq2str = (arr: SeqLike.SeqLike<string>): string =>
  arr instanceof Array ? arr.join("") : (arr as string) // [0];

