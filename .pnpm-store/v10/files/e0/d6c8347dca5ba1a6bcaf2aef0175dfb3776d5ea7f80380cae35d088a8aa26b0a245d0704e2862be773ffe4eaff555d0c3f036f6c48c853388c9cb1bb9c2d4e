/**
 * @category destructors
 * @since 0.6.0
 */
export const unsafeGet: <A>(stream: IStream<A>) => A | undefined = (s) => {
  const { cursor, buffer } = s
  if (cursor < buffer.length) return buffer[cursor]
  return undefined
}

/**
 * @category destructors
 * @since 0.6.0
 */
export const get: <A>(s: IStream<A>) => O.Option<A> = (s) => {
  const { cursor, buffer } = s
  if (cursor >= buffer.length) return O.none
  return O.some(buffer[cursor]!)
}

/**
 * @category destructors
 * @since 0.6.0
 */
export const matchNext: <A>(
  stream: IStream<A>,
  match: SeqLike.SeqLike<A>,
) => boolean = (stream, match) =>
  SeqLike.testNext(stream.buffer, match, stream.cursor)

/**
 * @category destructors
 * @since 0.6.0
 */
export const isStringStream = (
  stream: IStream<any>,
): stream is IStream<string> => SeqLike.isStringSeq(stream.buffer)

/**
 * @category destructors
 * @since 0.6.0
 */
export const matchNextStr: (
  stream: IStream<string>,
  match: SeqLike.SeqLike<string>,
) => boolean = (stream, match) =>
  SeqLike.testNextStr(stream.buffer, match, stream.cursor)

/**
 * Stream消费模式
 * 下一个/忽略空格/忽略空白字符
 */
export const enum ConsumeMode {
  Next,
  IgnoreSpace,
  IgnoreWhitespace,
}

export const ResolveSuccess = <A>(
  value: A,
  next: IStream<A>,
): ResolveResult<A> => ({
  _tag: "Success",
  value,
  next,
})

export type ResolveFailed = { _tag: "Failed" }
export type ResolveSuccess<A> = { _tag: "Success"; value: A; next: IStream<A> }
export type ResolveResult<A> = ResolveSuccess<A> | ResolveFailed

const RESOLVE_FAILED: ResolveFailed = { _tag: "Failed" }
export const isNone = <A>(result: ResolveResult<A>): result is ResolveFailed =>
  result === RESOLVE_FAILED

/**
 * @category destructors
 * @since 0.6.0
 */
export const getAndNext: <A>(
  stream: IStream<A>,
  mode: ConsumeMode,
) => ResolveResult<A> | ResolveResult<never> = (stream, mode) => {
  const { cursor, buffer } = stream
  if (cursor >= buffer.length) return RESOLVE_FAILED
  const next = getNextOffset(stream, mode)
  return next > 0
    ? ResolveSuccess(buffer[cursor + next]!, consume(stream, next + 1))
    : ResolveSuccess(buffer[cursor]!, consume(stream, 1))
}

/**
 * @category destructors
 * @since 0.6.0
 */
export const resolveNext: <A>(
  stream: IStream<A>,
  mode: ConsumeMode,
) => IStream<A> = (stream, mode) => {
  if (mode === ConsumeMode.Next) return stream
  if (stream.cursor >= stream._bufferLength) return stream
  return consume(stream, getNextOffset(stream, mode))
}

export const getNextOffset = <A>(
  stream: IStream<A>,
  mode: ConsumeMode,
  start?: number,
): number => stream._getNextOffset(mode, start)

/**
 * @category destructors
 * @since 0.6.0
 */
export const atEnd: <A>(stream: IStream<A>) => boolean = (s) => s.atEnd()

export const eqCursor = <A>(a: IStream<A>, b: IStream<A>) =>
  getCursor(a) === getCursor(b)

