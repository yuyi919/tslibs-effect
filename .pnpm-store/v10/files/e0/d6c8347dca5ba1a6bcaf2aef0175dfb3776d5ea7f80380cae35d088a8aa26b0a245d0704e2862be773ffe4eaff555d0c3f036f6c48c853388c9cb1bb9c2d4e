/**
 * @category model
 * @since 0.6.0
 */
export abstract class AbstractStream<A> {
  constructor(
    public readonly buffer: SeqLike.SeqLike<A>,
    public readonly cursor: number,
  ) {}

  protected _make(buffer: SeqLike.SeqLike<A>, cursor: number) {
    const Stream = this.constructor as new (
      buffer: SeqLike.SeqLike<A>,
      cursor: number,
    ) => IStream<A>
    return new Stream(buffer, cursor)
  }

  get _bufferLength() {
    return this.buffer.length
  }

  clone() {
    return this._make(this.buffer, this.cursor)
  }

  consume(step: number) {
    return this._make(this.buffer, this.cursor + step)
  }

  atEnd() {
    return this.cursor >= this._bufferLength
  }

  // eslint-disable-next-line class-methods-use-this
  abstract _getNextOffset(mode: ConsumeMode, start?: number): number
}

export interface IStream<A> extends AbstractStream<A> {}

export class Stream<A> extends AbstractStream<A> {
  // eslint-disable-next-line class-methods-use-this
  _getNextOffset(_: ConsumeMode, start: number = 0): number {
    // TODO
    return start
  }
}

export class StringStream extends AbstractStream<string> {
  _getNextOffset(mode: ConsumeMode, start: number = this.cursor): number {
    let next = 0
    if (mode !== ConsumeMode.Next) {
      const exec: RegExpExecArray | null =
        mode === ConsumeMode.IgnoreWhitespace
          ? execAt(Patterns.WHITESPACE, this.buffer as string, start)
          : execAt(Patterns.SPACE, this.buffer as string, start)
      exec && (next = exec[0].length)
    }
    return next
  }
}

export const getStruct = <A>(stream: IStream<A>): NonNullable<IStream<A>> =>
  stream

export const getCursor = <I>(stream: IStream<I>): number => stream.cursor

export const getBuffer = <A>(stream: IStream<A>): SeqLike.SeqLike<A> =>
  stream.buffer

export const getBufferLength = <A>(stream: IStream<A>): number =>
  stream._bufferLength

export const extendBufferF = <A, B>(
  source: IStream<A>,
  f: (a: SeqLike.SeqLike<A>) => SeqLike.SeqLike<B>,
): IStream<B> => stream(f(source.buffer), source.cursor)

export const mapF = <A, B>(source: IStream<A>, f: (a: A) => B): IStream<B> =>
  stream(mapSeqF(source.buffer, f), source.cursor)

export const mapSeqF = <A, B>(
  source: SeqLike.SeqLike<A>,
  f: (a: A) => B,
): SeqLike.SeqLike<B> =>
  f(source as A & SeqLike.SeqLike<A>) as B & SeqLike.SeqLike<B>

/**
 * @category constructors
 * @since
 */
export type StreamFactory<A> = (
  buffer: SeqLike.SeqLike<A>,
  cursor?: number,
) => IStream<A>

