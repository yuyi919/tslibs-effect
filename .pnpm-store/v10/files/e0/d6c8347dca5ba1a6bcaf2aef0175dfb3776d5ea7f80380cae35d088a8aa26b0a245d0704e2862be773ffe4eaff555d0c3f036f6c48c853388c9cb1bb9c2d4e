export const Foldable: MFoldableWithIndex.FoldableWithIndex1<URI, number> = {
  URI,
  reduce: (fa, b, f) => SeqLike.reduceF(fa.buffer, b, f),
  foldMap: (M) => (fa, f) => SeqLike.foldMapF(M)(fa.buffer, f),
  reduceRight: (fa, b, f) => SeqLike.reduceRightF(fa.buffer, b, f),
  reduceWithIndex: (fa, b, f) => SeqLike.reduceWithIndexF(fa.buffer, b, f),
  foldMapWithIndex: (M) => (fa, f) =>
    SeqLike.foldMapWithIndexF(M)(fa.buffer, f),
  reduceRightWithIndex: (fa, b, f) =>
    SeqLike.reduceRightWithIndexF(fa.buffer, b, f),
}

export const reduce = pipeable.reduce(Foldable)
export const reduceWithIndex = pipeable.reduceWithIndex(Foldable)
export const foldMap = pipeable.foldMap(Foldable)
export const foldMapWithIndex = pipeable.foldMapWithIndex(Foldable)
export const reduceRight = pipeable.reduceRight(Foldable)
export const reduceRightWithIndex = pipeable.reduceRightWithIndex(Foldable)

export const extend: <A, B>(
  wa: IStream<A>,
  f: (wa: IStream<A>) => B,
) => IStream<B> = (wa, f) => from(f(wa), wa.cursor)
export const extendCursor: <A, B>(
  source: IStream<A>,
  next: IStream<B>,
) => IStream<B> = (source, next) =>
  getCursor(source) === getCursor(next)
    ? next
    : stream(getBuffer(next), getCursor(source))

export const Extend: MExtend.Extend1<URI> = {
  URI,
  extend,
  map: mapF,
}

export const consume = <A>(stream: IStream<A>, length: number): IStream<A> =>
  length === 0 ? stream.clone() : stream.consume(length)

