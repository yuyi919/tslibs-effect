/**
 * @category constructors
 * @since 0.6.0
 */
export const stream: {
  <A>(
    factory: StreamFactory<A>,
    buffer: SeqLike.SeqLike<A>,
    cursor?: number,
  ): IStream<A>
  <A>(buffer: SeqLike.SeqLike<A>, cursor?: number): IStream<A>
} = (a: any, b?: any, c?: any): IStream<any> =>
  isStr(a) ? string(a, b) : isFn(a) ? makeF(a, b, c) : pure(a, b)

/**
 * @category constructors
 * @since 0.7.0
 */
export const makeF = <A>(
  factory: StreamFactory<A>,
  buffer: SeqLike.SeqLike<A>,
  cursor?: number,
): IStream<A> => factory(buffer, cursor)

/**
 * @param string
 * @param cursor
 * @returns
 * @category constructors
 * @since 0.7.0
 */
export const string = (string: string, cursor = 0) =>
  new StringStream(string, cursor)

/**
 * @category constructors
 * @since 0.7.0
 */
export const pure: {
  <A>(buffer: SeqLike.SeqLike<A>, cursor?: number): IStream<A>
} = (buffer, cursor = 0) => new Stream(buffer, cursor)

export const URI = "InputStream"
export type URI = "InputStream"

declare module "fp-ts/HKT" {
