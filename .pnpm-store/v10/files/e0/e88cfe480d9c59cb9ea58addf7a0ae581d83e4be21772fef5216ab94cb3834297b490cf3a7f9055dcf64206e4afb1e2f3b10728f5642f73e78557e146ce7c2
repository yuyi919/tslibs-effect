describe("definePropertyGetter", () => {
  it("hasParentClass", () => {
    class A {}
    class B extends A {}
    expect(Proto.hasParentClass(A)).toBe(false)
    expect(Proto.hasParentClass(B)).toBe(true)
    function Ctor() {}
    Ctor.prototype[Symbol.asyncIterator] = () => {}
    function Ctor2() {}
    // @ts-expect-error
    Ctor2.prototype = new Ctor()
    expect(Proto.hasParentClass(Ctor)).toBe(false)
    expect(Proto.hasParentClass(Ctor2)).toBe(true)
  })

  it("Pipeable", () => {
    expect(Pipeable.PipeableProto.pipe).toBeFunction()
    expect(Pipeable.PipeableProto.tapSelf).toBeFunction()
    expect(Pipeable.PipeableProto["|>"]).toBeFunction()
  })
  it("definePropertyGetter", () => {
    const obj = Proto.defineGetter({ b: 1 }, "a", (self) => self.b)
    expect(obj.a).toBe(obj.b)
  })
  it("defineProtoPropertyGetter", () => {
    const cls = new (Proto.defineProtoGetter(
      class A {
        declare readonly a: number
        b = 1
      },
      "a",
      (self) => self.b,
    ))()
    expect(cls.a).toBe(cls.b)
  })
  it("definePropertyReadonlyValue", () => {
    const cls = new (Proto.defineProtoPropertyReadonlyValue(
      class A {
        declare a: number
        b = 1
      },
      "a",
      1,
    ))()
    expect(cls.a).toBe(cls.b)
    expect(() => (cls.a = 2)).toThrowError(/read\s*only/)
  })

  it("makeStructThis", () => {
    const symbol = Symbol()
    const proto = Proto.makeStructProto({
      [symbol]: (self: any) => self,
      self: (self: any) => self,
    })
    class A {
      declare [symbol]: () => this
      declare self: () => this
    }
    Proto.withProtoF(A, (A) => Proto.assign(A, proto))
    const a = new A()
    expect(a[symbol]()).toBe(a)
    expect(a.self()).toBe(a)
  })
})

describe("Pipeable", () => {
  it("pipeArguments", () => {
    const f = (n: number): number => n + 1
    const g = (n: number): number => n * 2

    expect(_.some(2).pipe).toBeFunction()
    expect(_.some(2).pipe(_.map(f))).toEqual(_.some(3))
    expect(_.some(2).pipe(_.map(f), _.map(g))).toEqual(_.some(6))
    expect(_.some(2).pipe(_.map(f), _.map(g), _.map(f))).toEqual(_.some(7))
    expect(_.some(2).pipe(_.map(f), _.map(g), _.map(f), _.map(g))).toEqual(
      _.some(14),
    )
    expect(
      _.some(2).pipe(_.map(f), _.map(g), _.map(f), _.map(g), _.map(f)),
    ).toEqual(_.some(15))
    expect(
      _.some(2).pipe(
        _.map(f),
        _.map(g),
        _.map(f),
        _.map(g),
        _.map(f),
        _.map(g),
      ),
    ).toEqual(_.some(30))
    expect(
      _.some(2).pipe(
        _.map(f),
        _.map(g),
        _.map(f),
        _.map(g),
        _.map(f),
        _.map(g),
        _.map(f),
      ),
    ).toEqual(_.some(31))
    expect(
      _.some(2).pipe(
        _.map(f),
        _.map(g),
        _.map(f),
        _.map(g),
        _.map(f),
        _.map(g),
        _.map(f),
        _.map(g),
      ),
    ).toEqual(_.some(62))
    expect(
      _.some(2).pipe(
        _.map(f),
        _.map(g),
        _.map(f),
        _.map(g),
        _.map(f),
        _.map(g),
        _.map(f),
        _.map(g),
        _.map(f),
      ),
    ).toEqual(_.some(63))
    expect(
      _.some(2).pipe(
        _.map(f),
        _.map(g),
        _.map(f),
        _.map(g),
        _.map(f),
        _.map(g),
        _.map(f),
        _.map(g),
        _.map(f),
        _.map(g),
      ),
    ).toEqual(_.some(126))

    expect(_.some(2).tapSelf(_.map(f))).toEqual(_.some(2))
  })
})
