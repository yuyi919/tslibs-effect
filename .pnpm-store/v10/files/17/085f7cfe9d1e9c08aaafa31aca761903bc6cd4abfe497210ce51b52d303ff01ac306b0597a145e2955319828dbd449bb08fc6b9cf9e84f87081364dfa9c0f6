export function stopPropagation<E extends Event>(e: E): E
export function stopPropagation<E extends { stopPropagation(): void }>(e: E): E
export function stopPropagation<E extends { stopPropagation(): void }>(
  e: E,
): E {
  return (e.stopPropagation(), e)
}

export function stopImmediatePropagation<E extends Event>(e: E): E
export function stopImmediatePropagation<
  E extends { stopImmediatePropagation(): void },
>(e: E): E
export function stopImmediatePropagation<
  E extends { stopImmediatePropagation(): void },
>(e: E): E {
  return (e.stopImmediatePropagation(), e)
}

export function preventDefault<E extends Event>(e: E): E
export function preventDefault<E extends { preventDefault(): void }>(e: E): E
export function preventDefault<E extends { preventDefault(): void }>(e: E): E {
  return (e.preventDefault(), e)
}
