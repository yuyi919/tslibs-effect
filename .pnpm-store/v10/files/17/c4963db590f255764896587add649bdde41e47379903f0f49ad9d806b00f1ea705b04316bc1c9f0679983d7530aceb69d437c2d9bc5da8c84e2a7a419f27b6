/**
 * @category model
 * @since 0.6.0
 */
export class ParseError<I> extends Pipeable {
  constructor(
    public input: S.IStream<I>,
    public expected: ReadonlyArray<string>,
    public fatal: boolean,
  ) {
    super()
  }
  setInput<I2 = I>(input: S.IStream<I2>) {
    return failedF(input, this.expected, this.fatal)
  }
  setExpected(expected: string[]) {
    return failedF(this.input, expected, this.fatal)
  }
  setFatal(fatal: boolean) {
    return failedF(this.input, this.expected, fatal)
  }

  getErrorCursor() {
    return S.getCursor(this.input)
  }

  extend(err: ParseError<I>) {
    let l = getErrorCursor(this),
      r = getErrorCursor(err)
    if (l < r) return err
    if (l > r) return this
    return this.setExpected([...this.expected, ...err.expected])
  }

  clone() {
    return failedF(this.input, this.expected, this.fatal)
  }
}

export const getInput = <I>(o: ParseError<I>): S.IStream<I> => o.input
export const getExpected = <I>(o: ParseError<I>): readonly string[] =>
  o.expected
export const isFatal = <I>(o: ParseError<I>): boolean => o.fatal
export const setInput = <I, J = I>(
  o: ParseError<I>,
  input: S.IStream<J>,
): ParseError<J> => o.setInput(input)
export const setFatal = <I>(o: ParseError<I>, fatal: boolean): ParseError<I> =>
  o.setFatal(fatal)

/**
 * @category model
 * @since 0.6.0
 * @seal
 */
export class ParseSuccess<I, A> extends Pipeable {
  constructor(
    public value: A,
    public next: S.IStream<I>,
    public start: S.IStream<I>,
  ) {
    super()
  }

  setValue<B>(value: B) {
    return succeedF(value, this.next, this.start)
  }
  setNext(next: S.IStream<I>) {
    return succeedF(this.value, next, this.start)
  }
  setStart(start: S.IStream<I>) {
    return succeedF(this.value, this.next, start)
  }
  clone() {
    return succeedF(this.value, this.next, this.start)
  }
  getStartCursor() {
    return S.getCursor(this.start)
  }
  getNextCursor() {
    return S.getCursor(this.next)
  }
  isConsumed() {
    return S.getCursor(this.next) > S.getCursor(this.start)
  }
}

export const getValue = <I, A>(result: ParseSuccess<I, A>): A => result.value
export const getNext = <I, A>(result: ParseSuccess<I, A>): S.IStream<I> =>
  result.next
export const getNextCursor = <I, A>(result: ParseSuccess<I, A>): number =>
  result.getNextCursor()
export const getStart = <I, A>(result: ParseSuccess<I, A>): S.IStream<I> =>
  result.start

export const getStartCursor = <I, A>(result: ParseSuccess<I, A>): number =>
  result.getStartCursor()

export const isConsumed = <I, A>(result: ParseSuccess<I, A>): boolean =>
  result.isConsumed()

export const setValue = <I, A, B>(result: ParseSuccess<I, A>, value: B) =>
  result.setValue(value)
export const mapValue = <I, A, B>(
  result: ParseSuccess<I, A>,
  value: (value: A) => B,
) => result.setValue(value(result.value))
export const setNext = <I, A>(result: ParseSuccess<I, A>, next: S.IStream<I>) =>
  result.setNext(next)
export const setStart = <I, A>(
  result: ParseSuccess<I, A>,
  start: S.IStream<I>,
) => result.setStart(start)

export const predicateValue = <I, A>(
  o: ParseSuccess<I, A>,
  predicate: Predicate<A>,
) => predicate(o.value)

export const mapStartToF = <I, A>(
  result: ParseResult<I, A>,
  start: S.IStream<I>,
): ParseResult<I, A> => (isRight(result) ? setStart(result, start) : result)

export const mapNextToF = <I, A>(
  result: ParseResult<I, A>,
  next: S.IStream<I>,
): ParseResult<I, A> => (isRight(result) ? setNext(result, next) : result)

/**
 * @category model
 */
export type ParseResult<I, A> = ParseError<I> | ParseSuccess<I, A>

export { type ParseResult as t }

/**
 * @category extractor
 */
export type ParseValue<R extends ParseResult<any, any>> =
  R extends ParseSuccess<any, infer A> ? A : never

// type A = ParseValue<ParseError<string> | ParseResult<string, { a: string }>>;

export const getSource = <I, A>(o: ParseResult<I, A>) =>
  S.getBuffer(isRight(o) ? getNext(o) : getInput(o))
export const getResultCursor = <I, A>(o: ParseResult<I, A>) =>
  S.getCursor(isRight(o) ? getNext(o) : getInput(o))

const isSuccess = (
  result: ParseError<any> | ParseSuccess<any, any>,
): result is ParseSuccess<any, any> => "value" in result

export function getStruct<T extends ParseError<any> | ParseSuccess<any, any>>(
  result: T,
): T
export function getStruct(result: ParseError<any> | ParseSuccess<any, any>) {
  if (isSuccess(result)) {
    return setStart(
      setNext(result, S.getStruct(getNext(result))),
      S.getStruct(getStart(result)),
    )
  }
  return setInput(result, S.getStruct(getInput(result)))
}

export function getResult<I, A>(result: ParseResult<I, A>): ParseResult<I, A> {
  if (isRight(result)) {
    return setStart(
      setNext(result, S.getStruct(getNext(result))),
      S.getStruct(getStart(result)),
    )
  }
  return setInput(result, S.getStruct(getInput(result)))
}

export const mapLeft: <I>(
  f: (e: ParseError<I>) => ParseError<I>,
) => <A>(fa: ParseResult<I, A>) => ParseResult<I, A> = (f) => (fa) =>
  mapLeftF(fa, f)

export const mapLeftF: <I, A>(
  fa: ParseResult<I, A>,
  f: (e: ParseError<I>) => ParseError<I>,
) => ParseResult<I, A> = (fa, f) => (isInstanceof(fa, ParseError) ? f(fa) : fa)

export const isLeft = <E>(
  result: ParseResult<E, any>,
): result is ParseError<E> => isInstanceof(result, ParseError)

export const isRight = <I, A>(
  result: ParseResult<I, A>,
): result is ParseSuccess<I, A> => isInstanceof(result, ParseSuccess)

export function bimapEither<I, A, E1, A1>(
  f: (e: ParseError<I>) => E1,
  g: (a: ParseSuccess<I, A>) => A1,
): (fa: ParseResult<I, A>) => E.Either<E1, A1> {
  return (fa) => {
    if (isInstanceof(fa, ParseError)) return E.left(f(fa))
    return E.right(g(fa))
  }
}
export function bimap2<I, A, I1, A1>(
  f: (e: ParseError<I>) => ParseError<I1>,
  g: (a: ParseSuccess<I, A>) => ParseSuccess<I1, A1>,
): (fa: ParseResult<I, A>) => ParseResult<I1, A1> {
  return (fa) => {
    if (isInstanceof(fa, ParseError)) return f(fa)
    return g(fa)
  }
}
export function bimap<I, A, I1, A1>(
  f: (e: I) => I1,
  g: (a: A) => A1,
): (fa: ParseResult<I, A>) => ParseResult<I1, A1> {
  return (fa) => {
    if (isInstanceof(fa, ParseError))
      return setInput(fa, S.mapF(getInput(fa), f))
    return succeed(
      g(getValue(fa)),
      S.mapF(getNext(fa), f),
      S.mapF(getStart(fa), f),
    )
  }
}
export function mapStream<I, A, I1>(
  f: (e: I) => I1,
): (fa: ParseResult<I, A>) => ParseResult<I1, A> {
  return bimap(f, identity)
}
export function switchStream<I, A, I1>(
  stream: S.IStream<I1>,
): (fa: ParseResult<I, A>) => ParseResult<I1, A> {
  return (result) => {
    if (isLeft(result)) return setInput(result, stream)
    return succeed(
      getValue(result),
      S.extendCursor(getNext(result), stream),
      S.extendCursor(getStart(result), stream),
    )
  }
}
export const chainF = <I, A, B>(
  fa: ParseResult<I, A>,
  f: (a: A, next: S.IStream<I>, start: S.IStream<I>) => ParseResult<I, B>,
): ParseResult<I, B> =>
  isRight(fa) ? f(getValue(fa), getNext(fa), getStart(fa)) : fa
export const chain =
  <I, A, B>(
    f: (a: A, next: S.IStream<I>, start: S.IStream<I>) => ParseResult<I, B>,
  ) =>
  (fa: ParseResult<I, A>): ParseResult<I, B> =>
    chainF(fa, f)

export const map =
  <I, A, B>(f: (a: A, result: ParseSuccess<I, A>) => B) =>
  (fa: ParseResult<I, A>): ParseResult<I, B> =>
    mapF(fa, f)

export const mapF = <I, A, B>(
  fa: ParseResult<I, A>,
  f: (a: A, result: ParseSuccess<I, A>) => B,
): ParseResult<I, B> => (isRight(fa) ? setValue(fa, f(getValue(fa), fa)) : fa)

export const mapTraceF = <I, A, B>(
  fa: ParseResult<I, A>,
  f: (a: A, start: S.IStream<I>, next: S.IStream<I>) => B,
): ParseResult<I, B> =>
  isRight(fa) ? setValue(fa, f(getValue(fa), getStart(fa), getNext(fa))) : fa
export const mapTrace =
  <I, A, B>(
    f: (a: A, start: S.IStream<I>, next: S.IStream<I>) => B,
  ): ((fa: ParseResult<I, A>) => ParseResult<I, B>) =>
  (fa) =>
    mapTraceF(fa, f)

export const tapF = <I, A, B>(
  fa: ParseResult<I, A>,
  f: (a: A, next: S.IStream<I>, start: S.IStream<I>) => B,
): ParseResult<I, B> =>
  isRight(fa) ? setValue(fa, f(getValue(fa), getNext(fa), getStart(fa))) : fa

export const mapWithSelf =
  <I, A, B>(f: (a: A, result: ParseSuccess<I, A>) => B) =>
  (fa: ParseResult<I, A>): ParseResult<I, B> =>
    isRight(fa) ? setValue(fa, f(getValue(fa), fa)) : fa
