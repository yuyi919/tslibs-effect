/**
 * @category constructors
 * @since 0.6.0
 */
export const succeedF: <I, A>(
  value: A,
  next: S.IStream<I>,
  start: S.IStream<I>,
) => ParseSuccess<I, A> = (value, next, start) =>
  new ParseSuccess(value, next, start)

/**
 * @category constructors
 * @since 0.6.0
 */
export const succeed: <I, A>(
  value: A,
  next: S.IStream<I>,
  start: S.IStream<I>,
) => ParseResult<I, A> = succeedF

export const liftMap2F: <I, A, B, C>(
  fa: ParseSuccess<I, A>,
  fb: ParseSuccess<I, B>,
  f: (a: A, b: B) => C,
) => ParseSuccess<I, C> = (fa, fb, f) =>
  succeedF(f(fa.value, fb.value), fb.next, fa.start)

export const liftMap3F: <I, A, B, C, D>(
  fa: ParseSuccess<I, A>,
  fb: ParseSuccess<I, B>,
  fc: ParseSuccess<I, C>,
  f: (a: A, b: B, C: C) => D,
) => ParseSuccess<I, D> = (fa, fb, fc, f) =>
  succeedF(f(fa.value, fb.value, fc.value), fc.next, fa.start)

export const liftMap4F: <I, A, B, C, D, E>(
  fa: ParseSuccess<I, A>,
  fb: ParseSuccess<I, B>,
  fc: ParseSuccess<I, C>,
  fd: ParseSuccess<I, D>,
  f: (a: A, b: B, C: C, d: D) => E,
) => ParseSuccess<I, E> = (ma, mb, mc, md, f) =>
  succeedF(f(ma.value, mb.value, mc.value, md.value), md.next, ma.start)

export const succeedResult: <I, A>(
  value: A,
  next: S.IStream<I>,
  start: S.IStream<I>,
) => ParseResult<I, A> = (value, next, start) =>
  succeed(value, S.getStruct(next), S.getStruct(start))

/**
 * @category constructors
 * @since 0.6.0
 */
export const failedF: <I>(
  input: S.IStream<I>,
  expected: readonly string[],
  fatal: boolean,
) => ParseError<I> = (input, expected = EMPTY_EXPECTED, fatal = false) =>
  new ParseError(input, expected, fatal)
/**
 * @category constructors
 * @since 0.6.0
 */
export const failed: <I, A = never>(
  input: S.IStream<I>,
  expected: readonly string[],
  fatal: boolean,
) => ParseResult<I, A> = failedF

export const Expected = getArrayMonoidFpTs<string>()
export const EMPTY_EXPECTED = Expected.empty

export const errorResult: <I, A = never>(
  input: S.IStream<I>,
  expected?: ReadonlyArray<string>,
  fatal?: boolean,
) => ParseResult<I, A> = (input, expected = EMPTY_EXPECTED, fatal = false) =>
  failed(S.getStruct(input), expected, fatal)

