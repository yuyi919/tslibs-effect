export function* unsafe_map<A, B>(
  iterable: Iterable<A>,
  fn: (a: A) => B,
): Iterable<B> {
  for (const a of iterable) yield fn(a)
}
export function unsafe_every<A>(
  iterable: Iterable<A>,
  fn: (a: A) => boolean,
): boolean {
  for (const a of iterable) {
    if (!fn(a)) return false
  }
  return true
}
