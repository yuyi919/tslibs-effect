import { inspect } from "node:util"
import { describe, expect, it } from "vitest"

import { TaggedClass } from "../data"
import * as Hash from "../Hash"
import { makeHash, makeHashArgs, makeThisHash } from "../HashFactory"
import * as Proto from "../Proto"
import { HashSymbol } from "../Symbol"

describe("hash", () => {
  it("gen", () => {
    const keys = [
      "_tag",
      "A",
      "B",
      "C",
      "A1",
      "B1",
      "C1",
      "A2",
      "B2",
      "C2",
    ] as const
    const hash1 = makeHash(Hash.EMPTY_STRUCTURE_KEYS, keys)
    const hash2 = makeHashArgs(Hash.EMPTY_STRUCTURE_KEYS, keys)
    expect(hash2.toString()).toMatchInlineSnapshot(`
      "(_$_tag,_$A,_$B,_$C,_$A1,_$B1,_$C1,_$A2,_$B2,_$C2)=>$optimize$2(
        $combine3$0(
        $combine3$0(
        $combine3$0(
        $combine3$0(
        $combine3$0(
        $combine3$0(
        $combine3$0(
        $combine3$0(
        $combine3$0(
        $combine3$0(
        12289,1013879240,$hash$1(
        $hash$1(
        _$_tag
      )
      )
      ),177636,$hash$1(
        $hash$1(
        _$A
      )
      )
      ),177639,$hash$1(
        $hash$1(
        _$B
      )
      )
      ),177638,$hash$1(
        $hash$1(
        _$C
      )
      )
      ),5859413,$hash$1(
        $hash$1(
        _$A1
      )
      )
      ),5859414,$hash$1(
        $hash$1(
        _$B1
      )
      )
      ),5859415,$hash$1(
        $hash$1(
        _$C1
      )
      )
      ),5859382,$hash$1(
        $hash$1(
        _$A2
      )
      )
      ),5859381,$hash$1(
        $hash$1(
        _$B2
      )
      )
      ),5859380,$hash$1(
        $hash$1(
        _$C2
      )
      )
      )
      )"
    `)
    let n1 = 0
    const o = {
      _tag: "",
      A: 1,
      B: 2,
      C: 3,
      A1: 1,
      B1: 2,
      C1: 3,
      A2: 1,
      B2: 2,
      C2: 3,
    }
    console.time("hash1")
    for (let i = 0; i < 100000; i++) {
      n1 = hash1(o)
    }
    console.timeEnd("hash1")
    let n2 = 0
    const o2 = {
      _tag: "",
      A: 1,
      B: 2,
      C: 3,
      A1: 1,
      B1: 2,
      C1: 3,
      A2: 1,
      B2: 2,
      C2: 3,
    }
    console.time("hash2")
    for (let i = 0; i < 100000; i++) {
      n2 = hash2(
        o2._tag,
        o2.A,
        o2.B,
        o2.C,
        o2.A1,
        o2.B1,
        o2.C1,
        o2.A2,
        o2.B2,
        o2.C2,
      )
    }
    console.timeEnd("hash2")
    console.log(n1, n2)
  })

  it("struct", () => {
    expect(
      Hash.struct({
        size: undefined,
        bold: undefined,
        italic: false,
        und: true,
        color: undefined,
      }),
    ).not.toBe(
      Hash.struct({
        size: undefined,
        bold: undefined,
        italic: true,
        und: false,
        color: undefined,
      }),
    )
    const keys = ["_tag", "A", "B", "C"] as const
    class T extends TaggedClass("tag") {
      A: string = "A"
      B: string = "B"
      C: string = "C"
      #hash = makeThisHash<T>(Hash.EMPTY_STRUCTURE_KEYS, keys)
      static HASH(T: T) {
        return T.#hash()
      }
    }
    const val = new T({})
    expect(Hash.hash(val)).toBe(T.HASH(val))

    const set = new Map<any, any>()
    const test = Hash.hashedFn((a: T, b: string) => ({ a, b }), set)

    const _ = test(new T({}), "a")
    const _2 = test(new T({}), "a")
    const _3 = test(new T({}), "b")
    const _4 = test(new T({}), "b")

    expect(Hash.isHash(test)).toBe(true)

    expect(set.size).toBe(2)
  })

  it("toBeTruthy", () => {
    const keys = ["_tag", "A", "B", "C"] as const
    class T extends TaggedClass("tag") {
      A: string = "A"
      B: string = "B"
      C: string = "C"
      #hash = makeThisHash<T>(Hash.EMPTY_STRUCTURE_KEYS, keys)
      static HASH(T: T) {
        return T.#hash()
      }
    }
    const val = new T({})
    expect(makeHash(Hash.EMPTY_STRUCTURE_KEYS, keys)(val)).toBe(
      Hash.structureKeys(val, keys),
    )
    expect(Hash.isHash(val)).toBe(true)
    expect(T.HASH(val)).toBe(Hash.structureKeys(val, keys))
    expect(Object.keys(val)).toEqual(["A", "B", "C"])
    expect(Hash.hash(val)).toBe(val[HashSymbol]())
    expect(Hash.hash(val)).toBe(T.HASH(val))
    expect(Hash.combineWith(2)(1)).toBe(Hash.combine2(1, 2))

    const App = Proto.useConstructFunction((self) => self, "App")
    expect(inspect(new App(), true, 1, false)).toBe("App {}")
    expect(App()).toBeUndefined()
  })
})
