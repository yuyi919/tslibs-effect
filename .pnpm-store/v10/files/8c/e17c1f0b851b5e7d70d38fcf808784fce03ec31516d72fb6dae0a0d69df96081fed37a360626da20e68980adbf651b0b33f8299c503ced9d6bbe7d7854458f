import * as E from "fp-ts/Endomorphism"
import * as NEA from "fp-ts/NonEmptyArray"

import { isArray } from "@yuyi919/shared-proto/Array"
import { flow, pipe } from "@yuyi919/shared-proto/Functions"

import * as Exp from "./source"

/* eslint-disable no-param-reassign */
export * from "./source"

export {
  unicode as enableUnicode,
  allowMultiple as markGlobal,
  lineByLine as markMultiLine,
  sticky as markSticky,
} from "./source"

export const make = (
  ...patterns: NEA.NonEmptyArray<E.Endomorphism<Exp.ExpressionBuilder>>
): RegExp =>
  pipe(
    Exp.compile,
    ...(patterns as [E.Endomorphism<Exp.ExpressionBuilder>]),
    Exp.toRegex,
  )

export const pattern = (
  ...patterns: NEA.NonEmptyArray<E.Endomorphism<Exp.ExpressionBuilder>>
): Exp.ExpressionBuilder =>
  pipe(Exp.compile, ...(patterns as [E.Endomorphism<Exp.ExpressionBuilder>]))

const _from = (val: string | RegExp) =>
  typeof val === "string" ? Exp.sanitize(val) : `(?:${val.source})`

const _union = (val: (string | RegExp)[], breakCapture = true): string =>
  breakCapture ? `(?:${_union(val, false)})` : val.map(_from).join("|")

const _unionChar = (val: (string | RegExp)[], breakCapture = true): string =>
  breakCapture ? `[${_unionChar(val, false)}]` : val.map(_from).join("")

/**
 * @category combinators
 * @since 0.0.1
 */
export const manyOneOfNot: (
  patterns: (string | RegExp)[],
) => E.Endomorphism<Exp.ExpressionBuilder> = (patterns: (string | RegExp)[]) =>
  flow(oneOfNot(patterns), Exp.zeroOrMore)

/**
 * @category combinators
 * @since 0.0.1
 */
export const oneOrMoreNotDot: (
  patterns: (string | RegExp)[],
) => E.Endomorphism<Exp.ExpressionBuilder> = (patterns: (string | RegExp)[]) =>
  flow(oneOfNot(patterns), Exp.oneOrMore)

export const lookBack =
  (patterns: (string | RegExp)[], content: (string | RegExp)[]) =>
  (pattern: Exp.ExpressionBuilder): Exp.ExpressionBuilder =>
    pipe(
      pattern,
      Exp.add(`(?:(?<=${_union(patterns, false)})${_union(content)})`),
    )

export const appendUnicode = (pattern: string) =>
  flow(Exp.add(`\\p${pattern}`), Exp.unicode)

export type PScriptLang = "Han" | "Katakana" | "Hiragana"

export const pScript = (
  lang: PScriptLang | PScriptLang[],
): E.Endomorphism<Exp.ExpressionBuilder> =>
  isArray(lang)
    ? flow(
        ...(lang.map((lang) => pScript(lang)) as [
          E.Endomorphism<Exp.ExpressionBuilder>,
        ]),
      )
    : Exp.add(`\\p{Script=${lang}}`)
export const charWord = Exp.add("\\w")
export const charAlphanum = Exp.add("a-zA-Z")
export const char = (char: string) => Exp.add(char)

export const chars = (
  ...chars: NEA.NonEmptyArray<E.Endomorphism<Exp.ExpressionBuilder>>
) =>
  flow(
    Exp.add("["),
    ...(chars as [E.Endomorphism<Exp.ExpressionBuilder>]),
    Exp.add("]"),
  )
export const capture = (
  ...chars: NEA.NonEmptyArray<E.Endomorphism<Exp.ExpressionBuilder>>
) =>
  flow(
    Exp.beginCapture,
    ...(chars as [E.Endomorphism<Exp.ExpressionBuilder>]),
    Exp.endCapture,
  )

export const or = (
  chars: NEA.NonEmptyArray<E.Endomorphism<Exp.ExpressionBuilder>>,
) =>
  flow(
    Exp.beginCapture,
    Exp.add("?:"),
    chars.reduce((r, a) => flow(r, Exp.concatOr, a)),
    Exp.endCapture,
  )

export const withLookAhead = (exp: E.Endomorphism<Exp.ExpressionBuilder>) =>
  flow(Exp.add("(?="), exp, Exp.endCapture)

export const withNotLookAhead = (exp: E.Endomorphism<Exp.ExpressionBuilder>) =>
  flow(Exp.add("(?!"), exp, Exp.endCapture)

export const maybeGroup = (
  ...exp: [
    E.Endomorphism<Exp.ExpressionBuilder>,
    ...E.Endomorphism<Exp.ExpressionBuilder>[],
  ]
) =>
  flow(
    Exp.add("(?:"),
    ...(exp as [E.Endomorphism<Exp.ExpressionBuilder>]),
    Exp.add(")?"),
  )

export const group = (
  ...exp: [
    E.Endomorphism<Exp.ExpressionBuilder>,
    ...E.Endomorphism<Exp.ExpressionBuilder>[],
  ]
) =>
  flow(
    Exp.add("(?:"),
    ...(exp as [E.Endomorphism<Exp.ExpressionBuilder>]),
    Exp.add(")"),
  )

export const compose = (
  ...exp: [
    E.Endomorphism<Exp.ExpressionBuilder>,
    ...E.Endomorphism<Exp.ExpressionBuilder>[],
  ]
) => flow(...(exp as [E.Endomorphism<Exp.ExpressionBuilder>]))

export const singleString = (string: string) =>
  flow(Exp.string(string), withNotLookAhead(Exp.string(string)))

export const exp = (exp: Exp.ExpressionBuilder) =>
  Exp.add(Exp.toRegexSource(exp))

export const from = (pattern: RegExp | string) =>
  typeof pattern === "string" ? Exp.string(pattern) : Exp.add(pattern.source)

const charPatterns = (pattern: string | RegExp) => {
  // eslint-disable-next-line no-param-reassign
  pattern = typeof pattern === "string" ? pattern : pattern.source
  return pattern.length === 1 || /^\\\w$/.test(pattern)
}

/**
 * @category combinators
 * @since 0.0.1
 */
export const oneOf: (
  value: (string | RegExp)[],
) => E.Endomorphism<Exp.ExpressionBuilder> = (value: (string | RegExp)[]) =>
  value.every(charPatterns)
    ? Exp.add(`[${_unionChar(value, false)}]`)
    : Exp.add(`(?:${_union(value, false)})`)

/**
 * @category combinators
 * @since 0.0.1
 */
export const oneOfNot: (
  value: (string | RegExp)[],
) => E.Endomorphism<Exp.ExpressionBuilder> = (value: (string | RegExp)[]) =>
  value.every(charPatterns)
    ? Exp.add(`[^${_unionChar(value, false)}]`)
    : Exp.add(`(?:(?!${_union(value, false)}).)`)

export function testAt(text: string, offset: number) {
  return (reg: RegExp) => _testAt(reg, text, offset)
}

export function _testAt(reg: RegExp, text: string, offset: number) {
  if (offset >= 0 && reg.lastIndex !== offset) {
    reg.lastIndex = offset
  }
  return reg.test(text)
}

export function execAt(text: string, offset: number) {
  return (reg: RegExp) => _execAt(reg, text, offset)
}
export function _execAt(reg: RegExp, text: string, offset: number) {
  if (offset >= 0 && reg.lastIndex !== offset) {
    // eslint-disable-next-line no-param-reassign
    reg.lastIndex = offset
  }
  return reg.exec(text)
}
export function matchAt(text: string, offset: number) {
  return (reg: RegExp) => _matchAt(reg, text, offset)
}

export function _matchAt(reg: RegExp, text: string, offset: number) {
  if (offset >= 0 && reg.lastIndex !== offset) {
    // eslint-disable-next-line no-param-reassign
    reg.lastIndex = offset
  }
  return text.match(reg)
}
