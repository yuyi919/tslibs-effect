export type WithOption<I> = Partial<Omit<IParseOption<I>, "stream">>

/**
 *
 * @category combinators
 * @since 0.6.0
 */
export function withOption<I>(env: WithOption<I>) {
  return <A>(parser: core.Parser<I, A>): core.Parser<I, A> =>
    impl.define((i, option) => impl._run(parser, i, { ...option, ...env }))
}

/**
 * A parser combinator which returns the provided parser unchanged, except
 * that if it fails, the provided error message will be returned in the
 * ParseError`.
 *
 * @category combinators
 * @since 0.6.0
 */
export function expected<I, A>(
  parser: core.Parser<I, A>,
  message: string,
): core.Parser<I, A> {
  return parser._withExpected(message)
}
export function withExpected<I, A>(
  message: string,
): (parser: core.Parser<I, A>) => core.Parser<I, A> {
  return (parser) => parser._withExpected(message)
}
// define((i, option) =>
//   PR.mapLeftF(_run(parser, i, option), (err: PR.ParseError<any>) =>
//     option.collectError ? PR.withExpected(err, [message]) : err,
//   ));
export function withStartHintMany(char: Char[]) {
  return <I, A>(parser: core.Parser<I, A>): core.Parser<I, A> =>
    parser._withStartHintAll(char)
}

export function withStartHint(
  char: Char,
  ...args: readonly Char[]
): <I, A>(parser: core.Parser<I, A>) => core.Parser<I, A>
export function withStartHint(...args: Parameters<typeof withStartHint>) {
  return toArgumentsFirst(withStartHintMany)(...args)
}

/**
 * The `cut` parser combinator takes a parser and produces a new parser for
 * which all errors are fatal, causing either to stop trying further
 * parsers and return immediately with a fatal error.
 *
 * @category combinators
 * @since 0.6.0
 */
export function cut<I, A>(parser: core.Parser<I, A>): core.Parser<I, A> {
  return impl.define((i, option) =>
    ParseResult.mapLeftF(impl._run(parser, i, option), ParseResult.escalate),
  )
}

/**
 * Takes two parsers `p1` and `p2`, returning a parser which will match
 * `p1` first, discard the result, then either match `p2` or produce a fatal
 * error.
 *
 * @category combinators
 * @since 0.6.0
 */
export function cutWith<I, A, B>(
  p1: core.Parser<I, A>,
  p2: core.Parser<I, B>,
): core.Parser<I, B> {
  return core.apSecondF(p1, cut(p2))
}

/**
 * The `seq` combinator takes a parser, and a function which will receive
 * the result of that parser if it succeeds, and which should return another
 * parser, which will be run immediately after the initial parser. In this
 * way, you can join parsers together in a sequence, producing more complex
 * parsers.
 *
 * This is equivalent to the monadic `chain` operation.
 *
 * @category combinators
 * @since 0.6.0
 */
export function seq<I, A, B>(
  fa: core.Parser<I, A>,
  f: (a: A) => core.Parser<I, B>,
): core.Parser<I, B>
export function seq(...args: Parameters<typeof core.chainF>) {
  return core.chainF(...args)
}
// {
//   const first = _run(fa, i, option);
//   return PR.isLeft(first) ? first : PR.mapStart(parseNext(first, f, option), i);
// };
export function seqTrace<I, A, B>(
  fa: core.Parser<I, A>,
  f: (a: A, next: Stream.t<I>, start: Stream.t<I>) => core.Parser<I, B>,
): core.Parser<I, B> {
  return impl.define((i, option) =>
    ParseResult.chainF(impl._run(fa, i, option), (first, next, start) =>
      ParseResult.mapStartToF(
        impl._run(f(first, next, start), next, option),
        start,
      ),
    ),
  )
}

/**
 * The `either` combinator takes two parsers, runs the first on the input
 * stream, and if that fails, it will backtrack and attempt the second
 * parser on the same input. Basically, try parser 1, then try parser 2.
 *
 * If the first parser fails with an error flagged as fatal (see `cut`),
 * the second parser will not be attempted.
 *
 * This is equivalent to the `alt` operation.
 *
 * @category combinators
 * @since 0.6.0
 */
export function either<I, A, B = A>(
  parser: core.Parser<I, A>,
  f: () => core.Parser<I, B>,
): core.Parser<I, A | B>
export function either(...args: Parameters<typeof core.altF>) {
  return core.altF(...args)
}

export const eitherConst: <I, A, B = A>(
  parser: core.Parser<I, A>,
  f: core.Parser<I, B>,
) => core.Parser<I, A | B> = (parser, f) => either(parser, constant(f))

/**
 * Converts a parser into one which will return the point in the stream where
 * it started parsing in addition to its parsed value.
 *
 * Useful if you want to keep track of where in the input stream a parsed
 * token came from.
 *
 * @category combinators
 * @since 0.6.0
 */
export const withStart: <I, A>(
  parser: core.Parser<I, A>,
) => core.Parser<I, [A, Stream.t<I>]> = (parser) =>
  impl.define((i, option) =>
    ParseResult.mapF(impl._run(parser, i, option), (s) => [s, i]),
  )

export type MaybeC<T> = <I, A extends T>(
  parser: core.Parser<I, A>,
  zero?: core.Parser<any, A>,
) => core.Parser<I, A>

export type MaybeMC<M extends URIS, T> = <I, A extends T>(
  parser: core.Parser<I, Kind<M, A>>,
  zero?: core.Parser<any, Kind<M, A>>,
) => core.Parser<I, Kind<M, A>>

export type MaybeM<M extends URIS> = <I, A>(
  parser: core.Parser<I, Kind<M, A>>,
  zero?: core.Parser<any, Kind<M, A>>,
) => core.Parser<I, Kind<M, A>>

export type Maybe = <I, A>(
  parser: core.Parser<I, A>,
  zero?: core.Parser<any, A>,
) => core.Parser<I, A>

export const isZero = (zero: any): zero is Zero1<any> =>
  zero.URI && isFn(zero.zero)

/**
 * The `maybe` parser combinator creates a parser which will run the provided
 * parser on the input, and if it fails, it will returns the empty value (as
 * defined by `empty`) as a result, without consuming any input.
 *
 * @category combinators
 * @since 0.6.0
 */
export const maybe: {
  <T>(M: Monoid<T>): MaybeC<T>
  <T>(zero: () => T): MaybeC<T>
  <M extends URIS>(M: Zero1<M>): MaybeM<M>
} =
  (M: Monoid<any> | Zero1<any> | (() => any)) =>
  (
    parser: any,
    zero = core.succeed<any, any>(
      isFn(M) ? M() : isZero(M) ? M.zero() : M.empty,
    ),
  ) =>
    eitherConst(parser, zero)

/**
 * Matches the end of the stream.
 *
 * @category constructor
 * @since 0.6.0
 */
export const eofWith = <A>(mapTo: A, isExpected?: boolean) =>
  impl.defineLambda((i, option) =>
    Stream.atEnd(i)
      ? ParseResult.succeed(mapTo, i, i)
      : ParseResult.failed(
          i,
          isExpected && option.collectError
            ? ["end of file"]
            : ParseResult.EMPTY_EXPECTED,
          false,
        ),
  )

export const EOF: <I>() => core.Parser<I, void> = eofWith<void>(
  undefined,
  false,
)

export const EOF_EXPECTED: <I>() => core.Parser<I, void> = eofWith<void>(
  undefined,
  true,
)

/**
 * Matches the end of the stream.
 *
 * @category combinators
 * @since 0.6.0
 */
export const eof: <I>(isExpected?: boolean) => core.Parser<I, void> = (
  isExpected = true,
) => (isExpected ? EOF_EXPECTED() : EOF())

export function getManyC_<I, A>(
  monoid: Monoid<A>,
  expectFailed: Predicate<A>,
  parser: core.Parser<I, A>,
): core.Parser<I, A> {
  const { concat } = monoid
  const _concat = cloneFn(concat)
  return impl.define((start, option) => {
    let next = start
    let noConsumedTimes = 0
    let value = monoid.empty
    let result: ParseResult.t<I, A>
    const concat = _concat
    while ((result = impl._run(parser, next, option))) {
      if (ParseResult.isLeft(result)) {
        return ParseResult.isFatal(result) || expectFailed(value)
          ? result
          : ParseResult.succeed(value, next, start)
      }
      if (!ParseResult.isConsumed(result) && ++noConsumedTimes > 1) break
      value = concat(value, ParseResult.getValue(result))
      next = ParseResult.getNext(result)
    }
    return expectFailed(value)
      ? ParseResult.failed(next, ParseResult.EMPTY_EXPECTED, false)
      : ParseResult.succeed(value, next, start)
  })
}

export function getMany1C_<I, A>(
  monoid: Semigroup<A>,
  parser: core.Parser<I, A>,
): core.Parser<I, A> {
  const { concat } = monoid
  const _concat = cloneFn(concat)
  return impl.define((start, option) => {
    let result: ParseResult.t<I, A> = impl._run(parser, start, option)
    if (ParseResult.isLeft(result)) return result
    const concat = _concat
    let noConsumedTimes = ParseResult.isConsumed(result) ? 0 : 1
    let value = ParseResult.getValue(result)
    let next = ParseResult.getNext(result)
    while ((result = impl._run(parser, next, option))) {
      if (ParseResult.isLeft(result)) {
        return ParseResult.isFatal(result)
          ? result
          : ParseResult.succeed(value, next, start)
      }
      if (!ParseResult.isConsumed(result) && ++noConsumedTimes > 1) break
      value = concat(value, ParseResult.getValue(result))
      next = ParseResult.getNext(result)
    }
    return ParseResult.succeed(value, next, start)
  })
}

export const getLeastF: {
  <I, A, B extends A>(
    min: number,
    parser: core.Parser<I, A>,
    requirement?: Refinement<A, B>,
  ): core.Parser<I, A[]>
  <I, A>(
    min: number,
    parser: core.Parser<I, A>,
    predicate?: Predicate<A>,
  ): core.Parser<I, A[]>
} = <I, A>(
  min: number,
  parser: core.Parser<I, A>,
  requirement?: Predicate<A>,
): core.Parser<I, A[]> => {
  const isEmpty = (list: A[]) => list.length < min
  const allow = requirement || (() => true)
  // eslint-disable-next-line require-yield
  return impl.define((start: Stream.t<I>, option) => {
    let next = start
    let noConsumedTimes = 0
    const value: A[] = []
    let result: ParseResult.t<I, A>
    while ((result = impl._run(parser, next, option))) {
      if (ParseResult.isLeft(result)) {
        return ParseResult.isFatal(result) || isEmpty(value)
          ? result
          : ParseResult.succeed(value, next, start)
      }
      if (!ParseResult.isConsumed(result) && ++noConsumedTimes > 1) break
      allow(ParseResult.getValue(result)) &&
        (value[value.length] = ParseResult.getValue(result))
      next = ParseResult.getNext(result)
    }
    return isEmpty(value)
      ? ParseResult.failed(next, ParseResult.EMPTY_EXPECTED, false)
      : ParseResult.succeed(value, next, start)
  })
}

export const fromParseGen = <I, A>(
  parser: core.ParserGen<I, A>,
): core.Parser<I, A> =>
  impl.define((start, option) => {
    const g = impl._run(parser, start, option)
    let r: IteratorResult<ParseResult.t<I, A>, ParseResult.t<I, A>>
    while (!(r = g.next()).done) {}
    return r.value
  })

export const getLeast =
  (min: number) =>
  <I, A>(parser: core.Parser<I, A>): core.Parser<I, A[]> =>
    getLeastF(min, parser)

/**
 * The `many` combinator takes a parser, and returns a new parser which will
 * run the parser repeatedly on the input stream until it fails, returning
 * a list of the result values of each parse operation as its result, or the
 * empty list if the parser never succeeded.
 *
 * Read that as "match this parser zero or more times and give me a list of
 * the results."
 *
 * @category combinators
 * @since 0.6.0
 */
export const many: <I, A>(parser: core.Parser<I, A>) => core.Parser<I, A[]> =
  getLeast(0)

/**
 * The `leastOne` combinator is just like the `many` combinator, except it
 * requires its wrapped parser to match at least once. The resulting list is
 * thus guaranteed to contain at least one value.
 *
 * @category combinators
 * @since 0.6.0
 */
export const many1: <I, A>(
  parser: core.Parser<I, A>,
) => core.Parser<I, NEA.NonEmptyArray<A>> = getLeast(1) as any

export function getManyC<T>(
  M: Monoid<T>,
): <I, A extends T>(parser: core.Parser<I, A>) => core.Parser<I, A>
export function getManyC<T>(monoid: Monoid<T>) {
  return (parser: core.Parser<any, T>) =>
    getManyC_(monoid, (_) => false, parser)
}

export const getMany1C: {
  <T>(
    M: Semigroup<T>,
  ): <I, A extends T>(parser: core.Parser<I, A>) => core.Parser<I, A>
} = (monoid: Semigroup<any>) => (parser) => getMany1C_(monoid, parser)

export const manyConcat: <I, A>(
  parser: core.Parser<I, A[]>,
) => core.Parser<I, A[]> = getManyC(getArrayMonoidFpTs())

export const many1Concat: <I, A>(
  parser: core.Parser<I, A[]>,
) => core.Parser<I, NEA.NonEmptyArray<A>> = getMany1C(
  getArrayMonoidFpTs(),
) as any

export const getZeroM = <T>(monoid: Monoid<T>) => core.of(monoid.empty)

/**
 * Matches the provided parser `parser` zero or more times, but requires the
 * parser `sep` to match once in between each match of `parser`. In other words,
 * use `sep` to match separator characters in between matches of `parser`.
 *
 * @category combinators
 * @since 0.6.0
 */
export const getSepByMonoid = <T>(monoid: Monoid<T>) => {
  const sepBy1 = getSepBy1Monoid(monoid)
  return <I, A extends T>(
    sep: core.Parser<I, A>,
    parser: core.Parser<I, A>,
  ): core.Parser<I, A> => maybe(monoid)(sepBy1(sep, parser))
}

export const getSepBy1Monoid = <T>(monoid: Monoid<T>) => {
  const many = getManyC(monoid)
  return <I, A extends T>(
    sep: core.Parser<I, A>,
    parser: core.Parser<I, A>,
  ): core.Parser<I, A> =>
    liftMap2(
      parser,
      many(liftMap2(sep, parser, (monoid as Monoid<A & T>).concat)),
      (monoid as Monoid<A & T>).concat,
    )
}

export type SepByParser<I, A, Least extends number> = core.Parser<
  I,
  Least extends 0 ? A[] : NEA.NonEmptyArray<A>
>
export type SepByF<Least extends number> = <I, A, B>(
  sep: core.Parser<I, A>,
  parser: core.Parser<I, B>,
) => SepByParser<I, B, Least>
export type SepBy<Least extends number> = <I, A>(
  sep: core.Parser<I, A>,
) => <B>(parser: core.Parser<I, B>) => SepByParser<I, B, Least>

/**
 * Matches the provided parser `parser` zero or more times, but requires the
 * parser `sep` to match once in between each match of `parser`. In other words,
 * use `sep` to match separator characters in between matches of `parser`.
 *
 * @category combinators
 * @since 0.6.0
 */
export const sepByF: SepByF<0> = (sep, parser) =>
  maybe(A.zero)(sepBy1F(sep, parser))
export const sepBy: SepBy<0> = (sep) => (parser) => sepByF(sep, parser)

/**
 * Matches the provided parser `parser` one or more times, but requires the
 * parser `sep` to match once in between each match of `parser`. In other words,
 * use `sep` to match separator characters in between matches of `parser`.
 *
 * @category combinators
 * @since 0.6.0
 */
export const sepBy1F: SepByF<1> = (sep, parser) =>
  liftMap2(parser, many(core.apSecondF(sep, parser)), (head, tails) => [
    head,
    ...tails,
  ])

/**
 *
 * @param sep
 * @returns
 */
export const sepBy1: SepBy<1> = (sep) => (parser) => sepBy1F(sep, parser)

export type SepSeqParser<I, Sep, A, Least extends number> = core.Parser<
  I,
  Least extends 0 ? E.Either<Sep, A>[] : NEA.NonEmptyArray<E.Either<Sep, A>>
>
export type SepSeq<Least extends number> = <I, Sep>(
  sep: core.Parser<I, Sep>,
) => <A>(parser: core.Parser<I, A>) => SepSeqParser<I, Sep, A, Least>

export type SepSeqF<Least extends number> = <I, Sep, A>(
  sep: core.Parser<I, Sep>,
  parser: core.Parser<I, A>,
) => SepSeqParser<I, Sep, A, Least>

export function sepSeq1F<I, Sep, A>(
  sep: core.Parser<I, Sep>,
  parser: core.Parser<I, A>,
): SepSeqParser<I, Sep, A, 1> {
  return liftMap2(
    parser,
    many(liftMap(sep, parser, (sep, a) => separated(sep, a))),
    (head, seq) =>
      A.Foldable.reduce(
        seq,
        NEA.of<E.Either<Sep, A>>(E.right(head)),
        (r, a) => (r.push(E.left(a.left), E.right(a.right)), r),
      ),
  )
}

export const sepSeq1: SepSeq<1> = (sep) => (parser) => sepSeq1F(sep, parser)

/**
 * Like `sepBy1`, but cut on the separator, so that matching a `sep` not
 * followed by a `parser` will cause a fatal error.
 *
 * @category combinators
 * @since 0.6.0
 */
export const sepByCut: <I, A, B>(
  sep: core.Parser<I, A>,
  parser: core.Parser<I, B>,
) => core.Parser<I, NEA.NonEmptyArray<B>> = (sep, parser) =>
  pipe(
    parser,
    core.chain((head) =>
      pipe(
        many(cutWith(sep, parser)),
        core.map((tail) => [head, ...tail]),
      ),
    ),
  )

/**
 * Filters the result of a parser based upon a `Refinement` or a `Predicate`.
 *
 * @example
 * import { pipe } from 'fp-ts/function'
 * import { run } from 'parser-ts/code-frame'
 * import * as C from 'parser-ts/char'
 * import * as P from 'parser-ts/Parser'
 *
 * const parser = P.expected(
 *   pipe(
 *     item<C.Char>(),
 *     filter((c) => c !== 'a')
 *   ),
 *  'anything except "a"'
 * )
 *
 * run(parser, 'a')
 * // {  _tag: 'Left', left: '> 1 | a\n    | ^ Expected: anything except "a"' }
 *
 * run(parser, 'b')
 * // { _tag: 'Right', right: 'b' }
 *
 * @category combinators
 * @since 0.6.10
 */
export const filter: {
  <A, B extends A>(
    refinement: Refinement<A, B>,
  ): <I>(parser: core.Parser<I, A>) => core.Parser<I, B>
  <A>(
    predicate: Predicate<A>,
  ): <I>(parser: core.Parser<I, A>) => core.Parser<I, A>
} =
  <A>(predicate: Predicate<A>) =>
  <I>(parser: core.Parser<I, A>): core.Parser<I, A> =>
    impl.define((i, option) => {
      const r = impl._run(parser, i, option)
      if (ParseResult.isLeft(r)) return r
      const value = ParseResult.getValue(r)
      return predicate(value)
        ? r
        : ParseResult.failed(i, ParseResult.EMPTY_EXPECTED, false)
    })
// pipe(
//   _run(parser, i),
//   PR.chain((next) =>
//     predicate(next) ? PR.right(next) : PR.error(i),
//   ),
// );
/**
 * Matches the provided parser `parser` that occurs between the provided `left` and `right` parsers.
 *
 * `parser` is polymorphic in its return type, because in general bounds and actual parser could return different types.
 *
 * @category combinators
 * @since 0.6.4
 */
export const between: <I, A>(
  left: core.Parser<I, A>,
  right: core.Parser<I, A>,
) => <B>(parser: core.Parser<I, B>) => core.Parser<I, B> =
  (left, right) => (parser) =>
    liftMap3(
      impl.ParserImpl.skip(left),
      parser,
      impl.ParserImpl.skip(right),
      return2,
    )

export const betweenContact: <I, AL, AR>(
  left: core.Parser<I, AL>,
  right: core.Parser<I, AR>,
) => <B>(C: core.Parser<I, B>) => core.Parser<I, [AL, B, AR]> =
  (left, right) => (parser) =>
    liftMap3(left, parser, right, (l, c, r) => [l, c, r])

export const rightBy: <I, A>(
  bound: core.Parser<I, A>,
) => <B>(parser: core.Parser<I, B>) => core.Parser<I, B> =
  (bound) => (parser) =>
    liftMap2(parser, bound, identity)

/**
 * Matches the provided parser `parser` that is surrounded by the `bound` parser. Shortcut for `between(bound, bound)`.
 *
 * @category combinators
 * @since 0.6.4
 */
export const surroundedBy: <I, A>(
  bound: core.Parser<I, A>,
) => <B>(parser: core.Parser<I, B>) => core.Parser<I, B> = (bound) =>
  between(bound, bound)

/**
 *
 * @category combinators
 * @since 0.6.0
 */
export const withScanMode = <I>(scanMode = Stream.ConsumeMode.IgnoreSpace) =>
  withOption<I>({ scanMode })

/**
 * Takes a `Parser` and tries to match it without consuming any input.
 *
 * @example
 * import { run } from 'parser-ts/code-frame'
 * import * as P from 'parser-ts/Parser'
 * import * as S from 'parser-ts/string'
 *
 * const parser = S.fold([
 *   S.string('hello '),
 *    lookAhead(S.string('world')),
 *    S.string('wor')
 * ])
 *
 * run(parser, 'hello world')
 * // { _tag: 'Right', right: 'hello worldwor' }
 *
 * @category combinators
 * @since 0.6.6
 */
export const lookAhead: <I, A>(
  parser: core.Parser<I, A>,
) => core.Parser<I, A> = (parser) =>
  impl.define((i, option) =>
    impl
      ._run(parser, i, option)
      .pipe(ParseResult.chain((next) => ParseResult.succeed(next, i, i))),
  )

/**
 * Takes a `Predicate` and continues parsing until the given `Predicate` is satisfied.
 *
 * @example
 * import * as C from 'parser-ts/char'
 * import { run } from 'parser-ts/code-frame'
 * import * as P from 'parser-ts/Parser'
 *
 * const parser = takeUntil((c: C.Char) => c === 'w')
 *
 * run(parser, 'hello world')
 * // { _tag: 'Right', right: [ 'h', 'e', 'l', 'l', 'o', ' ' ] }
 *
 * @category combinators
 * @since 0.6.6
 */
export const takeUntil: <I>(
  predicate: Predicate<I>,
) => core.Parser<I, Array<I>> = (predicate) => many(core.sat(not(predicate)))

/**
 * Returns `Some<A>` if the specified parser succeeds, otherwise returns `None`.
 *
 * @example
 * import * as C from 'parser-ts/char'
 * import { run } from 'parser-ts/code-frame'
 * import * as P from 'parser-ts/Parser'
 *
 * const a = sat((c: C.Char) => c === 'a')
 * const parser = optional(a)
 *
 * run(parser, 'a')
 * // { _tag: 'Right', right: { _tag: 'Some', value: 'a' } }
 *
 * run(parser, 'b')
 * // { _tag: 'Left', left: { _tag: 'None' } }
 *
 * @category combinators
 * @since 0.6.10
 */
export const optional = <I, A>(
  parser: core.Parser<I, A>,
): core.Parser<I, O.Option<A>> =>
  parser.pipe(core.map(O.some), core.altConst(Option()))
const Option = impl.defineLambda(core.succeed(O.none as O.None))

export const constTrue = impl.defineLambda(core.succeed(true))
export const constFalse = impl.defineLambda(core.succeed(false))

export const optionBindBool = <I, A>(
  parser: core.Parser<I, A>,
): core.Parser<I, boolean> =>
  eitherConst(core.mapToF(parser, true), constFalse())

/**
 * The `manyTill` combinator takes a value `parser` and a `terminator` parser, and
 * returns a new parser that will run the value `parser` repeatedly on the input
 * stream, returning a list of the result values of each parse operation as its
 * result, or the empty list if the parser never succeeded.
 *
 * @example
 * import * as C from 'parser-ts/char'
 * import { run } from 'parser-ts/code-frame'
 * import * as P from 'parser-ts/Parser'
 *
 * const parser = manyTill(C.letter, C.char('-'))
 *
 * run(parser, 'abc-')
 * // { _tag: 'Right', right: [ 'a', 'b', 'c' ] }
 *
 * run(parser, '-')
 * // { _tag: 'Right', right: [] }
 *
 * @category combinators
 * @since 0.6.11
 */
export const manyTill = <I, A, B>(
  parser: core.Parser<I, A>,
  terminator: core.Parser<I, B>,
): core.Parser<I, ReadonlyArray<A>> =>
  terminator.pipe(
    core.map<B, ReadonlyArray<A>>(RA.zero),
    core.alt<I, ReadonlyArray<A>>(() => many1Till(parser, terminator)),
  )

/**
 * The `many1Till` combinator is just like the `manyTill` combinator, except it
 * requires the value `parser` to match at least once before the `terminator`
 * parser. The resulting list is thus guaranteed to contain at least one value.
 *
 * @example
 * import * as C from 'parser-ts/char'
 * import { run } from 'parser-ts/code-frame'
 * import * as P from 'parser-ts/Parser'
 *
 * const parser = many1Till(C.letter, C.char('-'))
 *
 * run(parser, 'abc-')
 * // { _tag: 'Right', right: [ 'a', 'b', 'c' ] }
 *
 * run(parser, '-')
 * // { _tag: 'Left', left: '> 1 | -\n    | ^ Expected: a letter' }
 *
 * @category combinators
 * @since 0.6.11
 */
export const many1Till = <I, A, B>(
  parser: core.Parser<I, A>,
  terminator: core.Parser<I, B>,
): core.Parser<I, RNEA.ReadonlyNonEmptyArray<A>> =>
  pipe(
    parser,
    core.chain((x) =>
      core.chainRecF(RNEA.of(x), (acc) =>
        pipe(
          terminator,
          core.map(() => E.right(acc)),
          core.alt(() =>
            core.mapF(parser, (a) =>
              E.left([...acc, a] as unknown as typeof acc),
            ),
          ),
        ),
      ),
    ),
  )

export const sequence = RNEA.Traversable.sequence(Applicative)
