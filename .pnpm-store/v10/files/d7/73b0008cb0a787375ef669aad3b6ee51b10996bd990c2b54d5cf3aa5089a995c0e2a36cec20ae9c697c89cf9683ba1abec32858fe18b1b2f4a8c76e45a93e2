his object.\n   */ /**\n   * Invoking this method will set this object's AbortSignal's aborted flag and signal to any observers that the associated activity is to be aborted.\n   */ {\n    const [signal, abort] = make();\n    const dispose = ()=>abort();\n    return {\n        signal,\n        abort,\n        [SYMBOL_DISPOSE]: dispose,\n        [SYMBOL_ASYNC_DISPOSE]: dispose\n    };\n}\nexport function isAborted(signal) {\n    return signal.aborted;\n}\n/**\n *\n * @param signal - AbortSignalLike\n * @returns 可能为空的reason，但类型上是安全的\n */ export function unsafe_getReason(signal) {\n    return signal.reason;\n}\n/**\n * 返回一个AbortError\n * @param signal - AbortSignalLike\n * @returns \n */ export function error(signal) {\n    return new AbortError(unsafe_getReason(signal));\n}\n/**\n *\n * @param signal - AbortSignalLike\n * @returns 返回{@link Ok|Ok<R, void>}\n */ export function getReason(signal) {\n    return isAborted(signal) ? no(VOID) : ok(unsafe_getReason(signal));\n}\n/**\n * 为signal添加abort监听函数\n * @param signal - {@link AbortSignalLike}\n * @param cb - abort事件监听，回调参数为{@link AbortSignalLike.reason|AbortSignalLike<R>.reason}\n */ export function onAbort(signal, cb) {\n    addEventListener(signal, \"abort\", ()=>cb(signal.reason), {\n        once: true\n    });\n}\nexport function onAbortIfAlive(signal, cb) {\n    return isAborted(signal) ? false : (onAbort(signal, cb), true);\n}\n"]}