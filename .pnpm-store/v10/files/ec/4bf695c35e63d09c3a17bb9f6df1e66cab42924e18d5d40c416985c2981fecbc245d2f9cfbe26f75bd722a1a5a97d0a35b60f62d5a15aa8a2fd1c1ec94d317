import { describe, expect, it } from "vitest"

import { IDENTIFIER } from "../patterns"

describe("patterns", () => {
  it("IDENTIFIER", () => {
    expect(IDENTIFIER).toEqual(
      /[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}a-zA-Z][\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}\w_]*|[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}a-zA-Z_][\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}\w_]+/uy,
    )
    expect(IDENTIFIER.sticky).toBeTruthy()
    expect(IDENTIFIER.unicode).toBeTruthy()
  })
})
