module ArrayBuffer = {
  type t = Js.TypedArray2.ArrayBuffer.t

  @new external make: int => t = "ArrayBuffer"
  @get external byteLength: t => int = "byteLength"

  @send external slice: (t, ~start: int, ~end: int) => t = "slice"
  @send external sliceToEnd: (t, ~start: int) => t = "slice"
}
module type Functor = (
  M: {
    type t
  },
) =>
{
  let fromTypedArray: TypedArray.t<'a> => TypedArray.t<M.t>
}

module Fuctor = (
  M: {
    type t
    let fromBuffer: (ArrayBuffer.t, ~byteOffset: int=?, ~length: int=?) => t
  },
) => {
  open M

  let fromTypedArray: TypedArray.t<'a> => t = ta => ta->TypedArray.buffer->fromBuffer->Identity.id
}

module Uint8Array = {
  type t = TypedArray.t<int>

  module Constants = {
    external bytesPerElement: int = "Uint8Array.BYTES_PER_ELEMENT"
  }

  @new
  external fromArray: array<int> => t = "Uint8Array"

  @new
  external fromBuffer: (ArrayBuffer.t, ~byteOffset: int=?, ~length: int=?) => t = "Uint8Array"

  include Fuctor({
    type t = t
    let fromBuffer = fromBuffer
  })

  @new
  external fromLength: int => t = "Uint8Array"

  @val
  external fromArrayLikeOrIterable: 'a => t = "Uint8Array.from"

  @val
  external fromArrayLikeOrIterableWithMap: ('a, ('b, int) => int) => t = "Uint8Array.from"
}
