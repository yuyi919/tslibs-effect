import * as Monoid from "@effect/typeclass/Monoid"
import * as Semigroup from "@effect/typeclass/Semigroup"
import * as FpTsMonoid from "fp-ts/Monoid"

const empty: readonly unknown[] = []
const ArraySemigroup = Semigroup.make<readonly unknown[]>((x, y) =>
  x.length === 0
    ? y.length === 0
      ? empty
      : y
    : y.length === 0
      ? x
      : [...x, ...y],
)

export const toFpTs = <T>(
  m: Monoid.Monoid<T>,
): Monoid.Monoid<T> & FpTsMonoid.Monoid<T> => ({
  ...m,
  concat: m.combine,
})

const _ArrayMonoid: Monoid.Monoid<readonly unknown[]> = Monoid.fromSemigroup(
  ArraySemigroup,
  empty,
)

export function getArrayMonoid<T>() {
  return toFpTs(_ArrayMonoid) as Monoid.Monoid<readonly T[]> &
    FpTsMonoid.Monoid<readonly T[]>
}
