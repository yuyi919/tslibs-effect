import { pureMemoize } from "@yuyi919/shared-proto/Functions"
import { globalValue } from "@yuyi919/shared-proto/GlobalValue"
import * as JsTypes from "@yuyi919/shared-proto/JsTypes"
import { HashSymbol, symbolForEffect } from "@yuyi919/shared-proto/Symbol"

import { type HashValue } from "../Hash"
import * as CONTSTANTS from "./constant"

/** @internal */
export const randomHashCache = globalValue(
  symbolForEffect("Hash/randomHashCache"),
  () => new CONTSTANTS.WEAKMAP<object, HashValue>(),
)

/**
 * @since 2.0.0
 * @category hashing
 */
export function random<A extends object>(self: A): HashValue {
  if (!randomHashCache.has(self)) {
    randomHashCache.set(
      self,
      number(Math.floor(Math.random() * CONTSTANTS.MAX_SAFE_INTEGER)),
    )
  }
  return randomHashCache.get(self)!
}

let _number = 0xffffffff
/**
 * @since 2.0.0
 * @category hashing
 */
export function number(n: number | HashValue) {
  if (n !== n || n === CONTSTANTS.INFINITY) {
    return 0
  }
  let h = n | 0
  if (h !== n) {
    h ^= n * _number
  }
  while (n > _number) {
    h ^= n /= _number
  }
  return optimize(h)
}

export function string(str: string) {
  let h = 5381,
    i = str.length
  while (i) {
    h = (h * 33) ^ str.codePointAt(--i)!
  }
  return optimize(h)
}

export function boolean(value: boolean): HashValue {
  return value ? HASH_TRUE : HASH_FALSE
}

export function memoizedString() {
  return pureMemoize(string)
}

export function bigInt(self: bigint): HashValue {
  return string(self.toString(10))
}

export function memoizedBigInt() {
  return pureMemoize(bigInt)
}
export function symbol(self: symbol) {
  return string(JsTypes.toString(self))
}

export function memoizedSymbol() {
  return pureMemoize(symbol)
}

export const KEYWORD_HASH = memoizedString()

export function optimize(n: HashValue): HashValue {
  return (n & 0xbfffffff) | ((n >>> 1) & 0x40000000)
}

/**
 * 拷贝自effect/Hash的非柯里化版本
 */
export function combine2(a: HashValue, b: HashValue) {
  return (a * 53) ^ b
}

/**
 *
 * @remark 同`combine2(a, combine2(b, c))`
 */
export function combine3(a: HashValue, b: HashValue, c: HashValue) {
  return (a * 53) ^ ((b * 53) ^ c)
}

/**
 * 拷贝自effect/Hash
 */
export function combineWith(b: HashValue) {
  return (self: HashValue) => combine2(self, b)
}

/** @internal */
export const HASH_UNDEFINED = string("\x00" + CONTSTANTS.__KEY_UNDEFINED)
/** @internal */
export const HASH_NULL = string("\x00" + CONTSTANTS.__KEY_NULL)
/** @internal */
export const HASH_TRUE = string("\x00" + JsTypes.IS_TRUE + "")
/** @internal */
export const HASH_FALSE = string("\x00" + JsTypes.IS_FALSE + "")

/**
 * @internal
 * @remark
 * ```ts
 * string("_tag")
 * ```*/
export const HASH_TAG = string(CONTSTANTS.__KEY__TAG)
/**
 * @internal
 * @remark
 * ```ts
 * string("value")
 * ```*/
export const HASH_VALUE = string(CONTSTANTS.__KEY_VALUE)

/**
 *
 * @param name
 * @returns
 * ```ts
 * combine(string("_tag"), typeof name === 'string' ? string(name) : symbol(name))
 * ```
 */
export function $tag(name: string | symbol) {
  return combine2(HASH_TAG, JsTypes.isStr(name) ? string(name) : symbol(name))
}
