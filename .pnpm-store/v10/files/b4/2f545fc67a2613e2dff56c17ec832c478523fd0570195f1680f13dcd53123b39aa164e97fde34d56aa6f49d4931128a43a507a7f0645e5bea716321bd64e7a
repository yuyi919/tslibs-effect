/**
 * 将一个参数不支持空值的函数提升为支持空值，但返回值也将可为空值
 * @param fn - 需要提升的函数
 * @remark 不应对参数可能为null或undefined的函数使用此方法
 */
export function liftNilable<T, R>(fn: (arg?: T) => R): never
export function liftNilable<T, R>(fn: (arg?: T | null) => R): never
export function liftNilable<T, R>(
  fn: (arg: NonNullable<T>) => R,
): (arg?: NonNullable<T> | undefined) => R | undefined
/**
 * 将一个参数不允许为null或undefined的函数转化为可允许，但返回值也将可为undefined
 * @param fn
 */
export function liftNilable<T, R>(
  fn: (arg: NonNullable<T>) => R,
): (arg?: Nilable<NonNullable<T>>) => R | undefined {
  return (arg) => {
    return isNil(arg) ? undefined : fn(arg as T & {})
  }
}

