/**
 * @category Functor
 * @since 0.6.7
 */
export const map: <A, B>(
  f: (a: A) => B,
) => <I>(fa: Parser<I, A>) => Parser<I, B> = (f) => (fa) => mapF(fa, f)

export const mapWith: <I, A, B>(
  f: (a: A, result: ParseResult.ParseSuccess<I, A>) => B,
) => (fa: Parser<I, A>) => Parser<I, B> = (f) => (fa) =>
  define((i, option) => ParseResult.mapF(_run(fa, i, option), f))

export const mapTrace: <I, A, B>(
  f: (a: A, start: Stream.t<I>, option: IParseOption) => B,
) => (fa: Parser<I, A>) => Parser<I, B> = (f) => (fa) => mapTraceF(fa, f)

export const mapTo =
  <B>(to: B): (<I, A>(fa: Parser<I, A>) => Parser<I, B>) =>
  (fa) =>
    mapToF(fa, to)

/**
 * @category Apply
 * @since 0.6.7
 */
export const ap: <I, A>(
  fa: Parser<I, A>,
) => <B>(fab: Parser<I, (a: A) => B>) => Parser<I, B> = (fa) => (fab) =>
  apF(fab, fa)

/**
 * @category Apply
 * @since 0.6.7
 */
export const apFirst: <I, B>(
  fb: Parser<I, B>,
) => <A>(fa: Parser<I, A>) => Parser<I, A> = (fb) => (fa) => apFirstF(fa, fb)

/**
 * @category Apply
 * @since 0.6.7
 */
export const apSecond: <I, B>(
  fb: Parser<I, B>,
) => <A>(fa: Parser<I, A>) => Parser<I, B> = (fb) => (fa) => apSecondF(fa, fb)

/**
 * @category Monad
 * @since 0.6.7
 */
export const chain: <I, A, B>(
  f: (a: A) => Parser<I, B>,
) => (ma: Parser<I, A>) => Parser<I, B> = (f) => (ma) => chainF(ma, f)

/**
 * @category Monad
 * @since 0.6.7
 */
export const chainFirst: <I, A, B>(
  f: (a: A) => Parser<I, B>,
) => (ma: Parser<I, A>) => Parser<I, A> = (f) => (ma) =>
  chainF(ma, (a) => mapF(f(a), () => a))

export const altConst: <I, A>(
  that: Parser<I, A>,
) => <B>(fa: Parser<I, B>) => Parser<I, A | B> =
  <I, A>(that: Parser<I, A>) =>
  <B>(fa: Parser<I, B>): Parser<I, A | B> =>
    altF(fa, util.constant(that) as unknown as () => Parser<I, B>)

/**
 * @category Alt
 * @since 0.6.7
 */
export const alt: <I, A>(
  that: util.Lazy<Parser<I, A>>,
) => <B>(fa: Parser<I, B>) => Parser<I, A | B> =
  <I, A>(that: util.Lazy<Parser<I, A>>) =>
  <B>(fa: Parser<I, B>): Parser<I, A | B> =>
    altF(fa, that as any)

export function altTrack<I, A>(
  that: (e: ParseResult.ParseError<I>) => Parser<I, A>,
) {
  return <B>(fa: Parser<I, B>): Parser<I, A | B> => altTrackF(fa, that as any)
}

/**
 * @category Monad
 * @since 0.6.7
 */
export const flatten: <I, A>(mma: Parser<I, Parser<I, A>>) => Parser<I, A> = (
  mma,
) => chainF(mma, util.identity)

/**
 * @category Alternative
 * @since 0.6.7
 */
export const zero: <I, A>() => Parser<I, A> = fail

export function gen<
  const P extends Generator<Parser<any, any>, any, any>,
  const T extends P extends Generator<Parser<any, any>, infer T, any>
    ? T
    : never,
  I extends P extends Generator<Parser<infer I, any>, T, any> ? I : never,
  A extends P extends Generator<Parser<I, infer A>, T, any> ? A : never,
>(gen: () => P): Parser<I, T> {
  return define((i, option) => {
    const g = gen()
    let next = i
    const start = i
    let nextValue!: void | A
    let r: IteratorResult<Parser<I, A>, T>
    while (!(r = g.next(nextValue as A)).done) {
      const cur = _run(r.value, next, option)
      if (ParseResult.isLeft(cur)) return cur
      next = ParseResult.getNext(cur)
      nextValue = ParseResult.getValue(cur)
    }
    return ParseResult.succeed(r.value, next, start)
  })
}

export function* CONSUME<I, A>(
  parser: Parser<I, A>,
): Generator<Parser<I, A>, A, A> {
  return yield parser
}

