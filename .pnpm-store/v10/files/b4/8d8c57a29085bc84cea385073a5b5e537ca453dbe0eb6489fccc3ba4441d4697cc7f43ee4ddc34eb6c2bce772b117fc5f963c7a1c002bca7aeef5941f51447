/**
 * @internal
 */
const bind_ = <A, N extends string, B>(
  a: A,
  name: Exclude<N, keyof A>,
  b: B,
): { [K in keyof A | N]: K extends keyof A ? A[K] : B } =>
  ({ ...a, [name]: b }) as any

/**
 * @since 0.6.8
 */
export const bindTo =
  <N extends string>(name: N) =>
  <I, A>(fa: Parser<I, A>): Parser<I, { [K in N]: A }> =>
    mapF(fa, (a) => bind_({}, name, a))

/**
 * @since 0.6.8
 */
export const bind =
  <N extends string, I, A, B>(
    name: Exclude<N, keyof A>,
    f: (a: A) => Parser<I, B>,
  ) =>
  (
    fa: Parser<I, A>,
  ): Parser<I, { [K in keyof A | N]: K extends keyof A ? A[K] : B }> =>
    chainF(fa, (a) => mapF(f(a), (b) => bind_(a, name, b)))

/**
 * 强制转化<I>类型
 */
export const as = <I, S>(parser: Parser<any, S>): Parser<I, S> => parser

export const local =
  <I, IB>(fn: (a: IB) => I) =>
  <A>(parser: Parser<I, A>): Parser<IB, A> =>
    define((i: Stream.t<IB>, env) =>
      _run(parser, Stream.mapF(i, fn), env).pipe(ParseResult.switchStream(i)),
    )

export const promapF: fp.profunctor.Profunctor2<URI>["promap"] = <I1, A, I2, B>(
  fea: Parser<I1, A>,
  f: (d: I2) => I1,
  g: (a: A) => B,
): Parser<I2, B> => {
  const parser: Parser<I2, B> = define((i, option) =>
    _run(fea, Stream.mapF(i, f), option).pipe(
      ParseResult.bimap((seq) => i.buffer as I2, g),
    ),
  )
  return parser
}
