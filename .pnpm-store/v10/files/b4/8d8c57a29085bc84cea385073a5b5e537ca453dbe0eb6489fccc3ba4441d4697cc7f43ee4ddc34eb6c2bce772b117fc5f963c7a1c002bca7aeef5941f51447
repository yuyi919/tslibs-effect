/**
 *
 * @category constructors
 * @since 0.6.0
 */
export const scanNext: <I>(consume: Stream.ConsumeMode) => Parser<I, void> = (
  consume,
) =>
  define((i, _option) =>
    ParseResult.succeed(undefined, Stream.resolveNext(i, consume), i),
  )

/**
 * The `failAt` parser will fail immediately without consuming any input,
 * but will report the failure at the provided input position.
 *
 * @category constructors
 * @since 0.6.0
 */
export const failAt: <I, A = never>(i: Stream.t<I>) => Parser<I, A> = (i) =>
  define((_i, _option) =>
    ParseResult.failed(i, ParseResult.EMPTY_EXPECTED, false),
  )

/**
 * The `sat` parser constructor takes a predicate function, and will consume
 * a single character if calling that predicate function with the character
 * as its argument returns `true`. If it returns `false`, the parser will
 * fail.
 *
 * @category constructors
 * @since 0.6.0
 */
export const sat = <I>(
  predicate: fp.predicate.Predicate<I>,
  expectMessage?: string,
): Parser<I, I> =>
  define((i, option) => {
    const result = _run(item<I>(), i, option)
    return ParseResult.isLeft(result) ||
      ParseResult.predicateValue(result, predicate)
      ? result
      : ParseResult.failed(
          i,
          option.collectError && expectMessage
            ? [expectMessage]
            : ParseResult.EMPTY_EXPECTED,
          false,
        )
  })

/**
 * The `item` parser consumes a single value, regardless of what it is,
 * and returns it as its result.
 *
 * @category constructors
 * @since 0.6.0
 */
export const item: <I>() => Parser<I, I> = defineLambda(
  (define) =>
    define((input, option) => {
      const result = Stream.getAndNext(input, option.scanMode)
      return Stream.isNone(result)
        ? ParseResult.failed(input, ParseResult.EMPTY_EXPECTED, false)
        : ParseResult.succeed(result.value, result.next, input)
    }),
  true,
)

export const unit = succeed<any, void>(undefined)
export const ask: <I>() => <A>(a: A) => Parser<I, A> = () => succeed

