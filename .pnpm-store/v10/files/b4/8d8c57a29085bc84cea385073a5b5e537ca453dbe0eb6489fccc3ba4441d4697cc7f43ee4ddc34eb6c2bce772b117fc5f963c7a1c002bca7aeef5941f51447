/**
 * @category model
 * @since 0.6.0
 */
export type Parser<I, A> = ParserImpl<I, A>
export type { Parser as t }
export { run, _run as _run, define, defineLambda }

/**
 * @category model
 * @since 0.6.0
 */
export interface ParserGen<I, A> {
  _run(
    i: Stream.t<I>,
    env: IParseOption,
  ): Generator<any, ParseResult.t<I, A>, any>
  void?: boolean
  startCharacterHint?: Record<string, true>
}

// -------------------------------------------------------------------------------------
// non-pipeables
// -------------------------------------------------------------------------------------

/**
 * @category Pointed
 * @since 0.6.7
 */
export const of: <I, A>(a: A) => Parser<I, A> = (a) =>
  define((i, _option) => ParseResult.succeed(a, i, i))

/**
 * The `succeed` parser constructor creates a parser which will simply
 * return the value provided as its argument, without consuming any input.
 *
 * This is equivalent to the monadic `of`.
 *
 * @category constructors
 * @since 0.6.0
 */
export const succeed: <I, A>(a: A) => Parser<I, A> = of

/**
 * The `fail` parser will just fail immediately without consuming any input
 *
 * @category constructors
 * @since 0.6.0
 */
export const fail: <I, A = never>() => Parser<I, A> = defineLambda(
  (i, _option) => ParseResult.failed(i, ParseResult.EMPTY_EXPECTED, false),
)

export const mapF: fp.monad.Monad2<URI>["map"] = (fa, f) => fa._map(f)

export const mapTraceF: <I, A, B>(
  fa: Parser<I, A>,
  f: (a: A, start: Stream.t<I>, option: IParseOption) => B,
) => Parser<I, B> = (fa, f) =>
  define((i, option) =>
    ParseResult.mapTraceF(_run(fa, i, option), (a) => f(a, i, option)),
  )

export const mapToF = <I, A, B>(ma: Parser<I, A>, to: B): Parser<I, B> =>
  ma._mapTo(to)

export const apF: fp.monad.Monad2<URI>["ap"] = (fab, fa) =>
  liftMap2(fab, fa, Identity.Apply.ap)

export const apFirstF = <I, A, B>(
  fa: Parser<I, A>,
  fb: Parser<I, B>,
): Parser<I, A> =>
  define((start, option) => {
    const ra = _run(fa, start, option)
    if (ParseResult.isLeft(ra)) return ra
    const rb = _run(fb, ParseResult.getNext(ra), option, false)
    return ParseResult.isRight(rb)
      ? ParseResult.setNext(ra, ParseResult.getNext(rb))
      : rb
  })

export const apSecondF = <I, A, B>(
  fa: Parser<I, A>,
  fb: Parser<I, B>,
): Parser<I, B> =>
  define((i, option) => {
    const result: ParseResult.t<I, any> = _run(fa, i, option, false)
    if (ParseResult.isLeft(result)) return result
    return ParseResult.mapStartToF(
      _run(fb, ParseResult.getNext(result), option),
      i,
    )
  })
export const chainF: fp.chain.Chain2<URI>["chain"] = (fa, f) =>
  define((i, option) =>
    ParseResult.chainF(_run(fa, i, option), (first, next, start) =>
      ParseResult.mapStartToF(_run(f(first), next, option), start),
    ),
  )

export const chainRecF: fp.chainRec.ChainRec2<URI>["chainRec"] = <I, A, B>(
  data: A,
  next: (current: A) => Parser<I, E.Either<A, B>>,
): Parser<I, B> =>
  define((start, option) => {
    // 手动实现tailRec
    let stream = start
    let value = data
    while (true) {
      const result = _run(next(value), stream, option)
      if (ParseResult.isLeft(result)) {
        return ParseResult.failed(
          stream,
          ParseResult.getExpected(result),
          ParseResult.isFatal(result),
        )
      }
      const either = ParseResult.getValue(result)
      if (E.isRight(either)) {
        return ParseResult.succeed(
          either.right,
          ParseResult.getNext(result),
          start,
        )
      }
      stream = ParseResult.getNext(result)
      value = either.left
    }
  })

export const altF: fp.alt.Alt2<URI>["alt"] = (pa, pb) =>
  define((i, option) => {
    const e = _run(pa, i, option)
    if (ParseResult.isRight(e) || ParseResult.isFatal(e)) return e
    const e2 = _run(pb(), i, option)
    if (option.collectError && ParseResult.isLeft(e2))
      return ParseResult.extend(e, e2)
    return e2
  })
export function altTrackF<I, A>(
  fa: Parser<I, A>,
  that: (e: ParseResult.ParseError<I>) => Parser<I, A>,
): Parser<I, A> {
  return define((i, option) => {
    const e = _run(fa, i, option)
    if (ParseResult.isRight(e) || ParseResult.isFatal(e)) return e
    const e2 = _run(that(e), i, option)
    if (option.collectError && ParseResult.isLeft(e2))
      return ParseResult.extend(e, e2)
    return e2
  })
}

export const concatAll =
  <A>(monoid: fp.monoid.Monoid<A> & { concatAll?: (args: A[]) => A }) =>
  <I>(parsers: readonly Parser<I, A>[]): Parser<I, A> =>
    parsers.length > 0
      ? monoid.concatAll
        ? liftMapAll<I, A, A>(
            parsers as fp.nonEmptyArray.NonEmptyArray<Parser<I, A>>,
            monoid.concatAll,
          )
        : liftMapAllArgs<I, A, A>(
            parsers as fp.nonEmptyArray.NonEmptyArray<Parser<I, A>>,
            util.concatAllArgsM(monoid),
          )
      : of<I, A>(monoid.empty)

export const concatAllArgs =
  <A>(monoid: fp.monoid.Monoid<A> & { concatAll?: (args: A[]) => A }) =>
  <I>(...parsers: readonly Parser<I, A>[]): Parser<I, A> =>
    concatAll(monoid)(parsers)

