import { constant, pipe } from "@yuyi919/shared-proto/Functions"
import { Order } from "@yuyi919/shared-proto/Order"
import { makeClassWith, setPrototypeOf } from "@yuyi919/shared-proto/Proto"

import * as P from "./internal/protoFactory"
import { isArr } from "./JsTypes"

/**
 * @description The initial data type passed in when initializing the container.
 */
export type ReadableInterface<T> = {
  forEach: (callback: (el: T) => void) => void
}

abstract class Base {
  /**
   * @description Container's size.
   * @internal
   */
  protected _len = 0
  /**
   * @returns The size of the container.
   * @example
   * const container = new Vector([1, 2]);
   * console.log(container.length); // 2
   */
  get length(): number {
    return this._len
  }
  /**
   * @returns The size of the container.
   * @example
   * const container = new Vector([1, 2]);
   * console.log(container.size()); // 2
   */
  size(): number {
    return this._len
  }
  /**
   * @returns Whether the container is empty.
   * @example
   * container.clear();
   * console.log(container.empty());  // true
   */
  empty(): boolean {
    return this._len === 0
  }
  /**
   * @description Clear the container.
   * @example
   * container.clear();
   * console.log(container.empty());  // true
   */
  abstract clear(): void
}

class PriorityQueue<T> extends Base {
  /**
   * @internal
   */
  declare private readonly _queue: T[]
  /**
   * @internal
   */
  declare private readonly _cmp: (x: T, y: T) => number
  /**
   * @description PriorityQueue's constructor.
   * @param container - Initialize container, must have a forEach function.
   * @param cmp - Compare function.
   * @param copy - When the container is an array, you can choose to directly operate on the original object of
   *               the array or perform a shallow copy. The default is shallow copy.
   * @example
   * new PriorityQueue();
   * new PriorityQueue([1, 2, 3]);
   * new PriorityQueue([1, 2, 3], (x, y) => x - y);
   * new PriorityQueue([1, 2, 3], (x, y) => x - y, false);
   */
  constructor(
    container: ReadableInterface<T> | T[] = [],
    cmp: Order<T> = (x: T, y: T) => (x > y ? -1 : x < y ? 1 : 0),
    copy = true,
  ) {
    super()
    this._cmp = cmp
    if (isArr(container)) {
      this._queue = copy ? [...container] : container
    } else {
      this._queue = []
      container.forEach((el) => this._queue.push(el))
    }
    this._len = this._queue.length
    const halfLength = this._len >> 1
    for (let parent = (this._len - 1) >> 1; parent >= 0; --parent) {
      this._pushDown(parent, halfLength)
    }
  }
  /**
   * @internal
   */
  private _pushUp(pos: number) {
    const item = this._queue[pos]!
    while (pos > 0) {
      const parent = (pos - 1) >> 1
      const parentItem = this._queue[parent]!
      if (this._cmp(parentItem, item) <= 0) break
      this._queue[pos] = parentItem
      pos = parent
    }
    this._queue[pos] = item
  }
  /**
   * @internal
   */
  private _pushDown(pos: number, halfLength: number) {
    const item = this._queue[pos]!
    while (pos < halfLength) {
      let left = (pos << 1) | 1
      const right = left + 1
      let minItem = this._queue[left]!
      if (right < this._len && this._cmp(minItem, this._queue[right]!) > 0) {
        left = right
        minItem = this._queue[right]!
      }
      if (this._cmp(minItem, item) >= 0) break
      this._queue[pos] = minItem
      pos = left
    }
    this._queue[pos] = item
  }
  clear(): void {
    this._len = 0
    this._queue.length = 0
  }
  /**
   * @description Push element into a container in order.
   * @param item - The element you want to push.
   * @returns The size of heap after pushing.
   * @example
   * queue.push(1);
   */
  push(item: T): this {
    this._queue.push(item)
    this._pushUp(this._len)
    this._len++
    return this
  }
  /**
   * @description Removes the top element.
   * @returns The element you popped.
   * @example
   * queue.pop();
   */
  pop(): T | undefined {
    if (this._len === 0) return
    const value = this._queue[0]
    const last = this._queue.pop()!
    this._len--
    if (this._len) {
      this._queue[0] = last
      this._pushDown(0, this._len >> 1)
    }
    return value
  }
  /**
   * @description Accesses the top element.
   * @example
   * const top = queue.top();
   */
  top(): T | undefined {
    return this._queue[0]
  }
  /**
   * @description Check if element is in heap.
   * @param item - The item want to find.
   * @returns Whether element is in heap.
   * @example
   * const que = new PriorityQueue([], (x, y) => x.id - y.id);
   * const obj = { id: 1 };
   * que.push(obj);
   * console.log(que.has(obj));  // true
   */
  has(item: T): boolean {
    return this._queue.indexOf(item) >= 0
  }
  /**
   * @description Remove specified item from heap.
   * @param item - The item want to remove.
   * @returns Whether remove success.
   * @example
   * const que = new PriorityQueue([], (x, y) => x.id - y.id);
   * const obj = { id: 1 };
   * que.push(obj);
   * que.remove(obj);
   */
  remove(item: T): boolean {
    const index = this._queue.indexOf(item)
    if (index < 0) return false
    if (index === 0) {
      this.pop()
    } else if (index === this._len - 1) {
      this._queue.pop()
      this._len--
    } else {
      this._queue.splice(index, 1, this._queue.pop()!)
      this._len--
      this._pushUp(index)
      this._pushDown(index, this._len >> 1)
    }
    return true
  }
  /**
   * @description Update item and it's pos in the heap.
   * @param item - The item want to update.
   * @returns Whether update success.
   * @example
   * const que = new PriorityQueue([], (x, y) => x.id - y.id);
   * const obj = { id: 1 };
   * que.push(obj);
   * obj.id = 2;
   * que.updateItem(obj);
   */
  updateItem(item: T): boolean {
    const index = this._queue.indexOf(item)
    if (index < 0) return false
    this._pushUp(index)
    this._pushDown(index, this._len >> 1)
    return true
  }
  /**
   * @returns Return a copy array of heap.
   * @example
   * const arr = queue.toArray();
   */
  toArray(): T[] {
    return [...this._queue]
  }
}

export type { PriorityQueue, Base }
interface PriorityQueueProto<T> {
  empty: () => boolean
  readonly length: number
  pop: () => T | undefined
  clear: () => void
  has: (item: T) => boolean
  top: () => T | undefined
  _queue: T[]
  _cmp: Order<T>
  remove: (item: T) => boolean
  updateItem: (item: T) => boolean
  toArray: () => T[]
  size: () => number
  _pushUp: (pos: number) => void
  _pushDown: (pos: number, halfLength: number) => void
  _len: number
  push: (item: T) => this
}

export function PriorityQueueProto<T>(): PriorityQueueProto<T> {
  return constant(
    pipe(
      P.type<PriorityQueueProto<T>>(),
      P.raw({
        _pushUp(pos: number) {
          let self = this,
            item = self._queue[pos]!,
            parent: number = pos,
            parentItem: T = item
          while (pos > 0) {
            parent = (pos - 1) >> 1
            parentItem = self._queue[parent]!
            if (self._cmp(parentItem, item) <= 0) break
            self._queue[pos] = parentItem
            pos = parent
          }
          self._queue[pos] = item
        },
        _pushDown(pos: number, halfLength: number) {
          const self = this,
            item = self._queue[pos]!
          let right: number
          while (pos < halfLength) {
            let left = (pos << 1) | 1
            right = left + 1
            let minItem = self._queue[left]!
            if (
              right < self._len &&
              self._cmp(minItem, self._queue[right]!) > 0
            ) {
              left = right
              minItem = self._queue[right]!
            }
            if (self._cmp(minItem, item) >= 0) break
            self._queue[pos] = minItem
            pos = left
          }
          self._queue[pos] = item
        },
      }),
      P.getter("length", (self) => self._len),
      P.impl("empty", (self) => self._len === 0),
      P.impl("size", (self) => self._len),
      P.method("clear", (self) => {
        self._len = 0
        self._queue.length = 0
      }),
      P.method("push", (self, item) => {
        self._queue.push(item)
        self._pushUp(self._len)
        self._len++
        return self as PriorityQueueProto<T>
      }),
      P.impl("pop", (self) => {
        if (self._len === 0) return
        const value = self._queue[0]
        const last = self._queue.pop()!
        self._len--
        if (self._len) {
          self._queue[0] = last
          self._pushDown(0, self._len >> 1)
        }
        return value
      }),
      P.impl("updateItem", (self, item) => {
        const index = self._queue.indexOf(item)
        if (index < 0) return false
        self._pushUp(index)
        self._pushDown(index, self._len >> 1)
        return true
      }),
      P.impl("top", (self) => self._queue[0]),
      P.impl("has", (self, item) => self._queue.indexOf(item) >= 0),
      P.impl("remove", (self, item) => {
        const index = self._queue.indexOf(item)
        if (index < 0) return false
        if (index === 0) {
          self.pop()
        } else if (index === self._len - 1) {
          self._queue.pop()
          self._len--
        } else {
          self._queue.splice(index, 1, self._queue.pop()!)
          self._len--
          self._pushUp(index)
          self._pushDown(index, self._len >> 1)
        }
        return true
      }),
      P.impl("toArray", (self) => [...self._queue]),
      P.make,
    ),
  )()
}

