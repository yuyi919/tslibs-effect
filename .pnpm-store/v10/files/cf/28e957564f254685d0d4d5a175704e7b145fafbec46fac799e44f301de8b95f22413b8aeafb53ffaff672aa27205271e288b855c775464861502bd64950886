export function makeNum<T extends number>(
  init: ReadableInterface<T>,
  compare?: Order<T>,
): PriorityQueue<T>
export function makeNum<T extends number>(
  init?: readonly T[],
  compare?: Order<T>,
  copy?: boolean,
): PriorityQueue<T>
export function makeNum<T extends number>(
  init: T[] | ReadableInterface<T> = [],
  compare: Order<T> = (x, y) => (x > y ? -1 : x < y ? 1 : 0),
  copy?: boolean,
): PriorityQueue<T> {
  return isArr(init) ? fromArray(init, compare, copy) : from(init, compare)
}

/**
 * @internal
 * @param self -
 * @returns
 */
const _make = <T>(
  compare: Order<T>,
  init: T[],
): ReturnType<typeof PriorityQueueProto<T>> => {
  return setPrototypeOf(
    {
      _cmp: compare,
      _len: init.length,
      _queue: init,
    },
    PriorityQueueProto<T>(),
  )
}

export type UnsafePrototype<T> = ReturnType<typeof _make<T>>

export function make<T>(compare: Order<T>): PriorityQueue<T> {
  return _make(compare, []) as unknown as PriorityQueue<T>
}

/**
 * @internal
 * @param self -
 * @returns
 */
export const _init = <T>(self: UnsafePrototype<T>) => {
  const halfLength = self._len >> 1
  for (let parent = (self._len - 1) >> 1; parent >= 0; --parent)
    self._pushDown(parent, halfLength)
  return self as unknown as PriorityQueue<T>
}

export function fromArray<T>(
  init: T[],
  compare: Order<T>,
  copy: boolean = true,
): PriorityQueue<T> {
  return _init<T>(_make(compare, copy ? [...init] : init))
}

export function from<T>(
  init: ReadableInterface<T>,
  compare: Order<T>,
): PriorityQueue<T> {
  const container: T[] = []
  init.forEach((el) => /* LAZY */ container.push(el))
  return _init<T>(_make(compare, container))
}
