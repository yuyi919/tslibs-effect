/**
 * 参考了`clsx`包的重新实现
 * `cva`修改自`class-variance-authority`
 */

import * as A from "./Array"
import { pipe } from "./Functions"
import { __KEY_CLASS, __KEY_CLASSNAME } from "./internal/constant"
import { entries, keys } from "./internal/object"
import {
  isBool,
  isNEStr,
  isNil,
  isObj,
  isStrOrNum,
  toBeTruthy,
} from "./JsTypes"

export type ClassValue =
  | ClassArray
  | ClassDictionary
  | string
  | number
  | bigint
  | null
  | boolean
  | undefined

export type ClassDictionary = Record<string, any>
export type ClassArray = ClassValue[]

export function clsxDict(mix: ClassDictionary) {
  let str = ""
  for (let y in mix) if (y && mix[y]) str += (str && " ") + y
  return str
}

export function clsx(...args: ClassValue[]): string {
  return pipe(
    args,
    (inputs) =>
      A.map(
        inputs,
        (mix) =>
          mix &&
          (isStrOrNum(mix)
            ? mix
            : isObj(mix)
              ? A.isArray(mix)
                ? clsx(...mix)
                : clsxDict(mix)
              : ""),
      ),
    (mixed) => A.filterJoin(mixed, toBeTruthy, " "),
  )
}

export function clsxLite(...args: string[]): string
export function clsxLite(...args: unknown[]): string
export function clsxLite(...args: (string | unknown)[]) {
  return A.filterJoin(args, isNEStr, " ")
}

/* Utils
  ---------------------------------- */

type OmitUndefined<T> = T extends undefined ? never : T
type StringToBoolean<T> = T extends "true" | "false" ? boolean : T
type UnionToIntersection<U> = (U extends any ? (k: U) => void : never) extends (
  k: infer I,
) => void
  ? I
  : never

export type VariantProps<Component extends (...args: any) => any> = Omit<
  OmitUndefined<Parameters<Component>[0]>,
  "class" | "className"
>

/* compose
    ---------------------------------- */

export interface Compose {
  <T extends ReturnType<CVA>[]>(
    ...components: [...T]
  ): (
    props?: (
      | UnionToIntersection<
          {
            [K in keyof T]: VariantProps<T[K]>
          }[number]
        >
      | undefined
    ) &
      CVAClassProp,
  ) => string
}

/* cx
    ---------------------------------- */

export interface CX {
  (...inputs: ClassValue[]): string
}

export type CXOptions = Parameters<CX>
export type CXReturn = ReturnType<CX>

/* cva
    ============================================ */

type CVAConfigBase = { base?: ClassValue }
type CVAVariantShape = Record<string, Record<string, ClassValue>>
type CVAVariantSchema<V extends CVAVariantShape> = {
  [Variant in keyof V]?: StringToBoolean<keyof V[Variant]> | undefined
}
type CVAClassProp =
  | {
      class?: ClassValue
      className?: never
    }
  | {
      class?: never
      className?: ClassValue
    }

export interface CVA {
  <
    _ extends "cva's generic parameters are restricted to internal use only.",
    V,
  >(
    config: V extends CVAVariantShape
      ? CVAConfigBase & {
          variants?: V
          compounds?: (V extends CVAVariantShape
            ? (
                | CVAVariantSchema<V>
                | {
                    [Variant in keyof V]?:
                      | StringToBoolean<keyof V[Variant]>
                      | StringToBoolean<keyof V[Variant]>[]
                      | undefined
                  }
              ) &
                CVAClassProp
            : CVAClassProp)[]
          defaults?: CVAVariantSchema<V>
        }
      : CVAConfigBase & {
          variants?: never
          compounds?: never
          defaults?: never
        },
  ): (
    props?: V extends CVAVariantShape
      ? CVAVariantSchema<V> & CVAClassProp
      : CVAClassProp,
  ) => string

  <V>(
    variants: V & CVAVariantShape,
    config: V extends CVAVariantShape
      ? CVAConfigBase & {
          compounds?: (V extends CVAVariantShape
            ? (
                | CVAVariantSchema<V>
                | {
                    [Variant in keyof V]?:
                      | StringToBoolean<keyof V[Variant]>
                      | StringToBoolean<keyof V[Variant]>[]
                      | undefined
                  }
              ) &
                CVAClassProp
            : CVAClassProp)[]
          defaults?: CVAVariantSchema<V>
        }
      : CVAConfigBase & {
          compounds?: never
          defaults?: never
        },
  ): (
    props?: V extends CVAVariantShape
      ? CVAVariantSchema<V> & CVAClassProp
      : CVAClassProp,
  ) => string
}

/* defineConfig
    ---------------------------------- */

export interface DefineConfigOptions {
  cx: CX
}

export interface DefineConfig {
  (options: DefineConfigOptions): {
    compose: Compose
    cx: CX
    cva: CVA
  }
}

/* Exports
    ============================================ */

const falsyToString = <T extends unknown>(value: T) =>
  isBool(value) ? `${value}` : value === 0 ? "0" : value

__KEY_CLASS

export const defineConfig: DefineConfig = ({ cx }) => {
  const cva: CVA =
    <V>(...args: [any, any?]) =>
    (props: any) => {
      const variants: CVAVariantShape = args[1] ? args[0] : args[0].variants
      const config: V extends CVAVariantShape
        ? CVAConfigBase & {
            variants?: V
            compounds?: (V extends CVAVariantShape
              ? (
                  | CVAVariantSchema<V>
                  | {
                      [Variant in keyof V]?:
                        | StringToBoolean<keyof V[Variant]>
                        | StringToBoolean<keyof V[Variant]>[]
                        | undefined
                    }
                ) &
                  CVAClassProp
              : CVAClassProp)[]
            defaults?: CVAVariantSchema<V>
          }
        : CVAConfigBase & {
            variants?: never
            compounds?: never
            defaults?: never
          } = args.length === 1 ? args[0] : args[1]

      const { defaults: defaultVariants } = config

      const getVariantClassNames = A.map(
        keys(variants),
        (variant: keyof typeof variants) => {
          const variantProp = props?.[variant as keyof typeof props]

          const variantKey = (falsyToString(variantProp) ||
            falsyToString(
              defaultVariants?.[variant],
            )) as keyof (typeof variants)[typeof variant]

          return variants[variant]![variantKey]
        },
      )

      const defaultsAndProps = {
        ...defaultVariants,
        // remove `undefined` props
        ...(props &&
          A.reduce(
            entries(props),
            (acc, [key, value]) =>
              isNil(value) ? acc : { ...acc, [key]: value },
            {} as typeof props,
          )),
      }

      const getCompoundVariantClassNames = config?.compounds?.reduce(
        (
          acc,
          {
            [__KEY_CLASS]: cvClass,
            [__KEY_CLASSNAME]: cvClassName,
            ...cvConfig
          },
        ) =>
          A.every(entries(cvConfig), ([cvKey, cvSelector]) => {
            const selector =
              defaultsAndProps[cvKey as keyof typeof defaultsAndProps]

            return A.isArray(cvSelector)
              ? A.includes(cvSelector, selector)
              : selector === cvSelector
          })
            ? [...acc, cvClass, cvClassName]
            : acc,
        [] as ClassValue[],
      )

      return cx(
        config?.base,
        getVariantClassNames,
        getCompoundVariantClassNames,
        props?.[__KEY_CLASS],
        props?.[__KEY_CLASSNAME],
      )
    }

  const compose: Compose =
    (...components) =>
    (props) => {
      const {
        [__KEY_CLASS]: _,
        [__KEY_CLASSNAME]: _cn,
        ...propsWithoutClass
      } = props || ({} as any)
      return cx(
        A.map(components, (_) => _(propsWithoutClass)),
        props?.[__KEY_CLASS],
        props?.[__KEY_CLASSNAME],
      )
    }

  return {
    compose,
    /**
     * @see https://cva.style/docs
     */
    cva,
    cx,
  }
}

const { compose, cva: _cva } = defineConfig({ cx: clsx })

export { compose }

export function cva<
  _ extends "cva's generic parameters are restricted to internal use only.",
  V,
>(
  config: V extends CVAVariantShape
    ? CVAConfigBase & {
        variants?: V
        compounds?: (V extends CVAVariantShape
          ? (
              | CVAVariantSchema<V>
              | {
                  [Variant in keyof V]?:
                    | StringToBoolean<keyof V[Variant]>
                    | StringToBoolean<keyof V[Variant]>[]
                    | undefined
                }
            ) &
              CVAClassProp
          : CVAClassProp)[]
        defaults?: CVAVariantSchema<V>
      }
    : CVAConfigBase & {
        variants?: never
        compounds?: never
        defaults?: never
      },
): (
  props?: V extends CVAVariantShape
    ? CVAVariantSchema<V> & CVAClassProp
    : CVAClassProp,
) => string

export function cva<V>(
  variants: V & CVAVariantShape,
  config: V extends CVAVariantShape
    ? CVAConfigBase & {
        compounds?: (V extends CVAVariantShape
          ? (
              | CVAVariantSchema<V>
              | {
                  [Variant in keyof V]?:
                    | StringToBoolean<keyof V[Variant]>
                    | StringToBoolean<keyof V[Variant]>[]
                    | undefined
                }
            ) &
              CVAClassProp
          : CVAClassProp)[]
        defaults?: CVAVariantSchema<V>
      }
    : CVAConfigBase & {
        compounds?: never
        defaults?: never
      },
): (
  props?: V extends CVAVariantShape
    ? CVAVariantSchema<V> & CVAClassProp
    : CVAClassProp,
) => string
export function cva(...args: [a: any, b?: any]) {
  return _cva(...args)
}
