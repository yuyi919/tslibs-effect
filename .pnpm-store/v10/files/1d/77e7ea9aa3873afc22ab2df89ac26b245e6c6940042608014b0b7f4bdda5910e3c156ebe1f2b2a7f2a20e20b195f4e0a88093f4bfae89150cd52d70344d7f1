interface Location {
  readonly start: {
    readonly line: number
    readonly column: number
  }
}

const lineTerminatorRegex = /[\n\r]$/m

export const getLocation: (source: string, cursor: number) => Location = (
  source,
  cursor,
) => {
  let line = 1
  let column = 1
  let i = 0
  while (i < cursor) {
    i++
    const c = source.charAt(i)
    if (lineTerminatorRegex.test(c)) {
      line++
      column = 1
    } else {
      column++
    }
  }
  return {
    start: {
      line,
      column,
    },
  }
}
