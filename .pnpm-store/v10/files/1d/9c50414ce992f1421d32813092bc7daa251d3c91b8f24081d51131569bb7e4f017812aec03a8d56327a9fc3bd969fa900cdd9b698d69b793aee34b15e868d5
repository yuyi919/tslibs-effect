import { UNDEFINED } from "./consts"
import { ARRAY, NUMBER, OBJECT, SYMBOL } from "./generated"
import { __KEY_PROTOTYPE, __KEY_UNDEFINED } from "./keys"

/**
 * ```ts
 * Object.prototype
 * ```
 * @internal
 */
export const OBJECT_PROPOTYPE: Readonly<Object> = OBJECT[__KEY_PROTOTYPE]

/**
 * ```ts
 * Array.prototype
 * ```
 * @internal
 */
export const ARRAY_PROPOTYPE: readonly never[] = ARRAY[__KEY_PROTOTYPE] as any

export const MAX_SAFE_INTEGER: typeof Number.MAX_SAFE_INTEGER =
  NUMBER.MAX_SAFE_INTEGER
export const MIN_SAFE_INTEGER: typeof Number.MIN_SAFE_INTEGER =
  NUMBER.MIN_SAFE_INTEGER

export const INFINITY: typeof Infinity = Infinity

export const SYMBOL_DISPOSE: typeof Symbol.dispose = SYMBOL.dispose
export const SYMBOL_ASYNC_DISPOSE: typeof Symbol.asyncDispose =
  SYMBOL.asyncDispose

/**
 * ```ts
 * typeof Buffer !== undefined ? Buffer : UNDEFINED
 * ```
 */
export const BUFFER: BufferConstructor | undefined =
  typeof Buffer !== __KEY_UNDEFINED ? Buffer : UNDEFINED
export const __NAME_BUFFER: "Buffer" = "Buffer"

export const WINDOW: (Window & typeof globalThis) | undefined =
  typeof window !== __KEY_UNDEFINED ? window : UNDEFINED
