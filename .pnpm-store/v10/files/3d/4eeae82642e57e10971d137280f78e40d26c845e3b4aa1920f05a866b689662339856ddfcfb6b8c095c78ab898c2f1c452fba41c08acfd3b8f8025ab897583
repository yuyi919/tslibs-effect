n lazy(init) {\n    return ((value)=>()=>(init && (value = init(), init = $.NULL), value))();\n}\nexport function cached(f) {\n    const cache = new WeakMap();\n    return (a)=>{\n        if (cache.has(a)) {\n            const ref = cache.get(a);\n            const b = ref.deref();\n            if (b) return b;\n        }\n        const b = f(a);\n        cache.set(a, new WeakRef(b));\n        return b;\n    };\n}\n/**\n * wrapper for `ThrowStatement`\n * @param e - throw e\n * @return never\n */ export function raise(e) {\n    throw e;\n}\n/**\n * return an `Error(msg?, opts?)`\n * @example\n * raise(error(\"Invalid Argument\"))\n */ export function error(message, options) {\n    return $.ERROR(message, options);\n}\n/**\n * return a `TypeError(msg?, opts?)`\n * @example\n * raise(typeError(\"Invalid Argument\"))\n */ export function typeError(message, options) {\n    return $.ERRORS_TypeError(message, options);\n}\n/**\n * return a `SyntaxError(msg?, opts?)`\n * @example\n * raise(syntaxError(\"Invalid Input\"))\n */ export function syntaxError(message, options) {\n    return $.ERRORS_SyntaxError(message, options);\n}\n/**\n * alias for {@link raise}\n * @example\n * raise(typeError(\"Invalid Argument\"))\n */ export function throwError(e) {\n    return raise(e);\n}\n/**\n * @param a - Return value\n * @returns `() => a`\n */ export function constant(a) {\n    return ()=>a;\n}\nexport function identity(a) {\n    return a;\n}\n/**\n * Casts the result to the specified type.\n * @param a - The value to be casted to the target type.\n */ export function unsafeCoerce(a) {\n    return identity(a);\n}\n/**\n * A function that ensures that the type of an expression matches some type,\n * without changing the resulting type of that expression.\n *\n * @example\n *\n * const test1 = satisfies<number>()(5 as const)\n *     //^? const test: 5\n *     // @ts-expect-error\n * const test2 = satisfies<string>()(5)\n *     //^? Argument of type 'number' is not assignable to parameter of type 'string'\n *\n * assert.deepStrictEqual(satisfies<number>()(5), 5)\n *\n */ export function satisfies() {\n    return identity;\n}\nexport function return1(a) {\n    return identity(a);\n}\nexport function return2(_a, b) {\n    return b;\n}\nexport function return3(_a, _b, c) {\n    return c;\n}\nexport function return4(_a, _b, _c, d) {\n    return d;\n}\nexport function constantWith(expr) {\n    return tryCatch(()=>constant(expr()), ()=>lazy(expr));\n}\nexport function fst(x) {\n    return x[0];\n}\nexport function snd(x) {\n    return x[1];\n}\nexport function flip(f) {\n    return (...b)=>(...a)=>f(...a)(...b);\n}\nexport function flip0(f) {\n    return (b, a)=>f(a, b);\n}\n/**\n * 将函数参数按顺序curry化\n * @param f -\n */ export function curry(f) {\n    return (x)=>(y)=>f(x, y);\n}\n/**\n * 将函数参数按相反顺序curry化\n * @param f -\n */ export function curryReverse(f) {\n    return (x)=>(y)=>f(y, x);\n}\n/**\n * 将函数参数按顺序反curry化\n * @param f -\n */ export function uncurry(f) {\n    return (x, y)=>f(x)(y);\n}\n/**\n * 将函数参数按相反顺序反curry化\n * @param f -\n */ export function uncurryReverse(f) {\n    return (x, y)=>f(y)(x);\n}\nexport function applyTo(a) {\n    return (f)=>f(a);\n}\nexport function tuple(f) {\n    return (args)=>f(...args);\n}\nexport function untuple(f) {\n    return (...args)=>f(args);\n}\n/**\n * The `absurd` function is a stub for cases where a value of type `never` is encountered in your code,\n * meaning that it should be impossible for this code to be executed.\n *\n * This function is particularly when it's necessary to specify that certain cases are impossible.\n *\n */ export function absurd(_) {\n    return raise(error(\"Absurd function called\"));\n}\nexport function len(target) {\n    return target.length;\n}\nexport function lastIndex(target) {\n    return len(target) - 1;\n}\nexport function lastElement(target) {\n    return target[lastIndex(target)];\n}\nexport function firstElement(target) {\n    return target[0];\n}\nexport function _new(target, args, newTarget) {\n    return $.CREATE_NEW(target, args, newTarget ?? target);\n}\nexport function _new0(Target) {\n    return new Target();\n}\nexport function _new1(Target, arg) {\n    return new Target(arg);\n}\nexport function _new2(Target, arg, arg2) {\n    return new Target(arg, arg2);\n}\nexport function makeNew(Target) {\n    return (...args)=>_new(Target, args);\n}\n/**\n * Creates a tupled version of this function: instead of `n` arguments, it accepts a single tuple argument.\n *\n * @example\n *\n * const sumTupled = tupled((x: number, y: number): number => x + y)\n *\n * assert.deepStrictEqual(sumTupled([1, 2]), 3)\n *\n */ export function tupled(f) {\n    return (a)=>f(...a);\n}\n/**\n * Inverse function of `tupled`\n *\n * @example\n *\n * const getFirst = untupled(<A, B>(tuple: [A, B]): A => tuple[0])\n *\n * assert.deepStrictEqual(getFirst(1, 2), 1)\n *\n */ export function untupled(f) {\n    return (...a)=>f(a);\n}\nexport function ignore(_) {}\n"]}