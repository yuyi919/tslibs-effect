 const Tuple = (args)=>`[${args}]`;\nexport const Func = (name, args, body)=>`${__KEY_FUNC} ${name}(${args}){\\n  ${body.flat(1).join(\"\\n  \")}\\n}`;\n/**\n * @internal\n * 不安全的函数\n */ export function makeReturnArrowFunction(deps, contentArgs, content) {\n    return make(deps, (...extend)=>Return(ArrowFunc(contentArgs, content(contentArgs)(...extend))));\n}\n/**\n * @internal\n * 不安全的函数\n */ export function make(args, content) {\n    const names = args.map((_, index)=>`$${_.name ?? \"arg\"}$` + index);\n    const _args = names.map((name, index)=>isFn(args[index]) ? (...args)=>`${name}(\\n  ${args.join(\",\")}\\n)` : name);\n    return pure(content(..._args), names)(...args);\n}\n"]}