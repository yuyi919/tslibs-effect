 printExecResult = (res, source = PR.getSource(res.result))=>{\n    const loca = getLocation(stream.seq2str(source), PR.getResultCursor(res.result));\n    return cf.codeFrameColumns(stream.seq2str(source), loca);\n};\nexport const isExecResult = (res)=>typeof res === \"object\" && !!res && res._tag === \"ExecResult\";\nexport function execF(parser, source, startCursor = 0) {\n    const result = P._run(parser, stream.stream(source, startCursor), P.EmptyParseOption);\n    const success = PR.isRight(result);\n    const nextCursor = success ? PR.getNextCursor(result) : PR.getErrorCursor(result);\n    return {\n        _tag: \"ExecResult\",\n        next: nextCursor,\n        success,\n        value: success ? PR.getValue(result) : undefined,\n        start: startCursor,\n        end: nextCursor === source.length,\n        result: PR.getStruct(result),\n        expected: success ? undefined : PR.getExpected(result)\n    };\n}\nexport const exec = (p, source, startCursor = 0)=>execF(p, source, startCursor);\nexport const runEitherF = (p, source, startCursor = 0)=>pipe(P._run(p, stream.stream(source, startCursor), P.EmptyParseOption), PR.bimapEither((e)=>e, PR.getValue));\nexport const runEither = Context.withCtx((p, source, startCursor = 0)=>runEitherF(p, source, startCursor));\nexport const runThrow = Context.withCtx((p, source, startCursor = 0, debug = false)=>{\n    const result = P._run(p, stream.stream(source, startCursor), P.EmptyParseOption);\n    if (PR.isRight(result)) {\n        if (debug) {\n            console.log(\"输入　　 |\", source);\n            if (PR.getNextCursor(result) < source.length) {\n                console.log(\"未处理流 |\", source.slice(PR.getNextCursor(result)));\n            }\n        }\n        return PR.getValue(result);\n    }\n    debug && console.error(result);\n    throw error(codeFrame(result, source).replace(/\\n/g, \"\\n       \"));\n});\n"],"mappings":"AAAA,SAASA,KAAK,EAAEC,IAAI,QAAQ,iCAAiC;AAC7D,OAAO,KAAKC,EAAE,MAAM,gBAAgB;AACpC,OAAO,K