module type F = {
  type t<'a>
}

module Object = (M: F) => {
  @get_index external getSymbol: (M.t<'a>, JsTypes.symbol) => option<'b> = ""
  @get_index external getSymbolUnsafe: (M.t<'a>, JsTypes.symbol) => 'b = ""
  @set_index external setSymbol: (M.t<'a>, JsTypes.symbol, 'b) => unit = ""

  @send external toString: M.t<'a> => string = "toString"
  @send external toLocaleString: M.t<'a> => string = "toLocaleString"

  @get_index external getSymbol: (M.t<'a>, JsTypes.symbol) => option<'b> = ""
  @get_index external getSymbolUnsafe: (M.t<'a>, JsTypes.symbol) => 'b = ""
  @set_index external setSymbol: (M.t<'a>, JsTypes.symbol, 'b) => unit = ""
}

module Id = (M: F) => {
  external getUnsafe: (M.t<'a>, int) => 'a = "%array_unsafe_get"
  external setUnsafe: (M.t<'a>, int, 'a) => unit = "%array_unsafe_set"

  @get external length: M.t<'a> => int = "length"

  @get_index external get: (M.t<'a>, int) => option<'a> = ""
  @set_index external set: (M.t<'a>, int, 'a) => unit = ""
}

module IdUnsafe = (M: F) => {
  include Id(M)

  external get: (M.t<'a>, int) => 'a = "%array_unsafe_get"
  external set: (M.t<'a>, int, 'a) => unit = "%array_unsafe_set"
}

module Proto = (M: F) => {
  @send external at: (M.t<'a>, int) => option<'a> = "at"
  @send external atUnsafe: (M.t<'a>, int) => 'a = "at"

  @send external copyAllWithin: (M.t<'a>, ~target: int) => M.t<'a> = "copyWithin"

  @send
  external copyWithinToEnd: (M.t<'a>, ~target: int, ~start: int) => M.t<'a> = "copyWithin"

  @send
  external copyWithin: (M.t<'a>, ~target: int, ~start: int, ~end: int) => M.t<'a> = "copyWithin"

  @send external reverse: M.t<'a> => unit = "reverse"
  @send external toReversed: M.t<'a> => M.t<'a> = "toReversed"

  @variadic @send
  external splice: (M.t<'a>, ~start: int, ~remove: int, ~insert: array<'a>) => M.t<'a> = "splice"
  @variadic @send
  external toSpliced: (M.t<'a>, ~start: int, ~remove: int, ~insert: array<'a>) => M.t<'a> =
    "toSpliced"

  @send external withAt: (M.t<'a>, int, 'a) => M.t<'a> = "with"

  @send external includes: (M.t<'a>, 'a) => bool = "includes"
  @send external indexOf: (M.t<'a>, 'a) => int = "indexOf"

  @inline
  let indexOfOpt = (arr, item) =>
    switch arr->indexOf(item) {
    | -1 => None
    | index => Some(index)
    }

  @send external indexOfFrom: (M.t<'a>, 'a, int) => int = "indexOf"

  @send external slice: (M.t<'a>, ~start: int, ~end: int) => M.t<'a> = "slice"
  @send external sliceToEnd: (M.t<'a>, ~start: int) => M.t<'a> = "slice"
  @send external copy: (M.t<'a>, @as(0) _) => M.t<'a> = "slice"

  @send external lastIndexOf: (M.t<'a>, 'a) => int = "lastIndexOf"
  let lastIndexOfOpt = (arr, item) =>
    switch arr->lastIndexOf(item) {
    | -1 => None
    | index => Some(index)
    }
  @send external lastIndexOfFrom: (M.t<'a>, 'a, int) => int = "lastIndexOf"

  @send external sort: (M.t<'a>, ('a, 'a) => COrdering.t) => unit = "sort"
  @send external toSorted: (M.t<'a>, ('a, 'a) => COrdering.t) => M.t<'a> = "toSorted"

  @send external every: (M.t<'a>, 'a => bool) => bool = "every"
  @send external everyI: (M.t<'a>, ('a, int) => bool) => bool = "every"

  @send external filter: (M.t<'a>, 'a => bool) => M.t<'a> = "filter"
  @send external filterI: (M.t<'a>, ('a, int) => bool) => M.t<'a> = "filter"

  @send external find: (M.t<'a>, 'a => bool) => option<'a> = "find"
  @send external findI: (M.t<'a>, ('a, int) => bool) => option<'a> = "find"

  @send external findIndex: (M.t<'a>, 'a => bool) => int = "findIndex"
  @send external findIndexI: (M.t<'a>, ('a, int) => bool) => int = "findIndex"

  @inline
  let findIndexOpt = (fa: M.t<'a>, finder: 'a => bool): option<int> =>
    switch findIndex(fa, finder) {
    | -1 => None
    | index => Some(index)
    }

  @send external forEach: (M.t<'a>, 'a => unit) => unit = "forEach"
  @send external forEachI: (M.t<'a>, ('a, int) => unit) => unit = "forEach"

  @send external map: (M.t<'a>, 'a => 'b) => M.t<'b> = "map"
  @send external mapI: (M.t<'a>, ('a, int) => 'b) => M.t<'b> = "map"

  @send external reduceI: (M.t<'b>, ('a, 'b, int) => 'a, 'a) => 'a = "reduce"
  let reduceI = (arr, init, f) => reduceI(arr, f, init)
  @inline
  let reduce = (arr: M.t<'b>, init: 'a, f: ('a, 'b) => 'a) =>
    reduceI(arr, init, f->Types.unsafeCoerce)
  @send
  external reduceRight: (M.t<'b>, ('a, 'b) => 'a, 'a) => 'a = "reduceRight"
  let reduceRight = (arr, init, f) => reduceRight(arr, f, init)
  @send
  external reduceRightI: (M.t<'b>, ('a, 'b, int) => 'a, 'a) => 'a = "reduceRight"
  let reduceRightI = (arr, init, f) => reduceRightI(arr, f, init)

  @send external some: (M.t<'a>, 'a => bool) => bool = "some"
  @send external someI: (M.t<'a>, ('a, int) => bool) => bool = "some"

  @send external fillAll: (M.t<'b>, 'a) => M.t<'a> = "fill"
  @send external fillToEnd: (M.t<'a>, 'a, ~start: int) => M.t<'a> = "fill"
  @send external fill: (M.t<'a>, 'a, ~start: int, ~end: int) => M.t<'a> = "fill"

  @send external join: M.t<'a> => string = "join"
  @send external joinWith: (M.t<'a>, string) => string = "join"

  include Object(M)
}
