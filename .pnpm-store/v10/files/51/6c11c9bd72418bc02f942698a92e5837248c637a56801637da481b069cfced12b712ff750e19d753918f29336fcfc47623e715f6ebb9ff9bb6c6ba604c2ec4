export type NonNull<T extends NonNullable<any>> = T | undefined

/**
 * 进行迭代，遇到第一个map结果不为null的元素时不的场合，将结果返回
 *
 * 未满足上述条件则继续迭代直到最后返回undefined
 * @param array
 * @param mapFn
 * @returns
 */
export function findIterableMap<T, A extends NonNull<any>>(
  array: Iterable<T>,
  mapFn: (any: T, index: number) => null | A,
): A | undefined {
  let i = 0
  let o: A | null
  for (const key of array) {
    o = mapFn(key, i)
    if (o !== null) return o
    i++
  }
}
export function findArrayMap<T, A extends NonNull<any>>(
  array: ReadonlyArray<T>,
  mapFn: (any: T, index: number) => null | A,
): A | undefined {
  let i = 0
  let o: A | null
  for (let index = 0; index < array.length; index++) {
    o = mapFn(array[index]!, i)
    if (o !== null) return o
  }
}

export function nullElse<A extends NonNullable<any>, E extends A>(
  a: A,
  e: E,
): E | null
export function nullElse<A extends NonNullable<any>>(a: A, e: A): A | null
export function nullElse<A extends NonNullable<any>>(a: A, e: A): A | null {
  return a === e ? a : null
}

export function nullWhen<A extends NonNullable<any>, const B extends A>(
  a: A,
  be: B,
): Exclude<A, B> | null
export function nullWhen<A extends NonNullable<any>>(a: A, be: A): A | null
export function nullWhen<A extends NonNullable<any>>(a: A, be: A): A | null {
  return a === be ? null : a
}

/**
 *
 * @param a
 * @param b
 * @param otherwise
 * @remark
 * ```ts
 * a === b ? otherwise : a
 * ```
 */
export function nullishWhen<A extends NonNullable<any>, const A2 extends A, B>(
  a: A,
  b: A2,
  otherwise: () => B,
): Exclude<A, A2> | B

export function nullishWhen<A extends NonNullable<any>, B>(
  a: A,
  be: A,
  otherwise: () => B,
): A | B
export function nullishWhen<A extends NonNullable<any>, B>(
  a: A,
  be: A,
  otherwise: () => B,
): A | B | null {
  return a === be ? otherwise() : a
}
