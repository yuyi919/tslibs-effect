/**
 * Returns an object created by key-value entries for properties and methods
 * @param entries An iterable object that contains key-value entries for properties and methods.
 */
export function fromEntries(entries: Iterable<readonly any[]>): any
export function fromEntries(entries: Iterable<any>) {
  return OBJECT.fromEntries(entries)
}
export function singleton<P extends JsPropertyKey, const A>(
  name: P,
  a: A,
): JsObject<A, P>
export function singleton<T>(name: string, a: T): JsObject<T>
export function singleton<T>(name: string, a: T) {
  return { [name]: a }
}

export function entries<T>(o: { [s: string]: T } | ArrayLike<T>): [string, T][]
export function entries(o: {}): [string, any][]
export function entries<T>(
  o: { [s: string]: T } | ArrayLike<T>,
): [string, T][] {
  return ENTRIES(o)
}
export function _mapI<T extends JsObject, R = T>(
  record: T,
  each: (...args: JsObjectEntries<T>) => any,
): R
export function _mapI<T extends JsObject, R = T>(
  record: T,
  each: (...args: [key: keyof T, value: any]) => any,
): R
export function _mapI(
  record: JsObject,
  each: (...args: [k: any, a: any]) => any,
) {
  let descriptors = OBJ_getOwnPropertyDescriptors$(record)
  forEach(
    ownKeys(record),
    (k) =>
      (descriptors[k] = mapValue(descriptors[k]!, (value) => each(k, value))),
  )
  return OBJ_CREATE({}, descriptors) as any
}
export function _map<A, B>(
  record: Record<any, A>,
  each: (value: A, key: JsPropertyKey) => B,
) {
  return _mapI(record, (k, a) => each(a, k))
}

