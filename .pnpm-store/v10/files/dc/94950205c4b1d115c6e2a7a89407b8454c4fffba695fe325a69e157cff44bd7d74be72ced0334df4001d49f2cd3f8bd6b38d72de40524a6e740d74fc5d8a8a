*\n * Use [`BooleanAlgebra`](./boolean.ts.html#booleanalgebra) instead.\n *\n * @category zone of death\n * @since 2.0.0\n * @deprecated\n */export const booleanAlgebraBoolean={meet:(x,y)=>x&&y,join:(x,y)=>x||y,zero:false,one:true,implies:(x,y)=>!x||y,not:x=>!x};/**\n * Use [`getBooleanAlgebra`](./function.ts.html#getbooleanalgebra) instead.\n *\n * @category zone of death\n * @since 2.0.0\n * @deprecated\n */export const getFunctionBooleanAlgebra=getBooleanAlgebra;"],"mappings":"AAAA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA,GAAG,SAAOA,iBAAiB,QAAK,eAAe,CAAC;AAChD;AACA;AACA;AACA;AACA;AACA;AACA;AAAG,OAAO,IAAMC,OAAO,GAACC,CAAC,KAAG;EAACC,IAAI,EAACA,CAACC,CAAC,EAACC,CAAC,KAAGH,CAAC,CAACI,IAAI,CAACF,CAAC,EAACC,CAAC,CAAC;EAACC,IAAI,EAACA,CAACF,CAAC,EAACC,CAAC,KAAGH,CAAC,CAACC,IAAI,CAACC,CAAC,EAACC,CAAC,CAAC;EAACE,IAAI,EAACL,CAAC,CAACM,GAAG;EAACA,GAAG,EAACN,CAAC,CAACK,IAAI;EAACE,OAAO,EAACA,CAACL,CAAC,EAACC,CAAC,KAAGH,CAAC,CAACI,IAAI,CAACJ,CAAC,CAACQ,GAAG,CAACN,CAAC,CAAC,EAACC,CAAC,CAAC;EAACK,GAAG,EAACR,CAAC,CAACQ;AAAG,CAAC,CAAC,CAAC;AACjJ;AACA;AACA;AACA;AACA;AACA;AAAG,OAAO,IAAMC,kBAAkB,GAAC;EAACR,IAAI,EAACA,CAAA,KAAIS,SAAS;EAACN,IAAI,EAACA,CAAA,KAAIM,SAAS;EAACL,IAAI,EAACK,SAAS;EAACJ,GAAG,EAACI,SAAS;EAACH,OAAO,EAACA,CAAA,KAAIG,SAAS;EAACF,GAAG,EAACA,CAAA,KAAIE;AAAS,CAAC,CAAC;AAChJ;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AAAG,OAAO,IAAMC,qBAAqB,GAACZ,OAAO,CAAC;AAC9C;AACA;AACA;AACA;AACA;AACA;AAAG,OAAO,IAAMa,qBAAqB,GAAC;EAACX,IAAI,EAACA,CAACC,CAAC,EAACC,CAAC,KAAGD,CAAC,IAAEC,CAAC;EAACC,IAAI,EAACA,CAACF,CAAC,EAACC,CAAC,KAAGD,CAAC,IAAEC,CAAC;EAACE,IAAI,EAAC,KAAK;EAACC,GAAG,EAAC,IAAI;EAACC,OAAO,EAACA,CAACL,CAAC,EAACC,CAAC,KAAG,CAACD,CAAC,IAAEC,CAAC;EAACK,GAAG,EAACN,CAAC,IAAE,CAACA;AAAC,CAAC,CAAC;AAC7H;AACA;AACA;AACA;AACA;AACA;AAAG,OAAO,IAAMW,yBAAyB,GAACf,iBAAiB","ignoreList":[]}