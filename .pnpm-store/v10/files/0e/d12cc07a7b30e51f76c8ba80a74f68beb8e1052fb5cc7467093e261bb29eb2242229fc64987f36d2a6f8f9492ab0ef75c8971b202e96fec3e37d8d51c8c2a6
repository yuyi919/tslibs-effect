module NameStyles = {
  @inline
  let fill = (color: string) =>
    `background:${color};border-radius:0.2em;color:white;font-weight:bold;padding:2px 0.5em;margin-right:4px;`
  @inline
  let text = (color: string) => `color:${color};font-weight:bold;margin-right:4px;`

  let dict = {
    "fill": fill,
    "text": text,
  }
}

