import type {
  AbstractClass,
  ExtractArguments,
  PropertyCommonDescriptor,
  PropertyGetterDescriptor,
  PropertyValueDescriptor,
} from "../Proto"
import {
  __KEY_CONFIGURABLE,
  __KEY_ENUMERABLE,
  __KEY_VALUE,
  __KEY_WRITABLE,
  OBJ_defineProperty$,
  OBJ_getPrototypeOf$,
  OBJ_setPrototypeOf$,
} from "./constant"

/**
 * 将一个接受显式 `self` 参数的函数转换为一个可以使用 `this` 关键字的函数。
 * 该函数支持多种重载形式，以适应不同的函数签名。
 *
 * @template Fn - 原始函数的类型，该函数接受一个 `self` 参数和其他参数。
 * @template T - `self` 参数的类型，即 `this` 的类型。
 * @param fn - 原始函数，第一个参数为 `self`。
 * @returns 一个新的函数，该函数使用 `this` 作为 `self` 参数，并且返回与原始函数相同的结果。
 */
export function useThis<
  Fn extends (self: any, ...args: any[]) => any,
  T extends Parameters<Fn>[0],
>(fn: Fn): (this: T, ...args: ExtractArguments<Fn, T>) => ReturnType<Fn>
export function useThis<
  A extends {},
  R = any,
  Args extends readonly any[] = [],
>(fn: (self: A) => R): (this: A, ...args: Args) => R
export function useThis<
  Fn extends (self: any, ...args: any[]) => any,
  T extends Parameters<Fn>[0],
>(fn: Fn): (this: T, ...args: any[]) => ReturnType<Fn> {
  return function (...args) {
    // return fn.apply(this, [this, ...args])
    // return fn.apply(this, [this, ...arguments])
    return fn(this, ...args)
  }
}
export const setProtos = (f: Function, proto: {}) => ((f.prototype = proto), f)
export const getProtos = <T extends {}>(f: T) => (f as any).prototype

export function setPrototypeOf<T extends {}, P extends {}>(
  o: T,
  proto: P,
): T & P
export function setPrototypeOf<T extends {}>(o: T, proto: object | null): T
export function setPrototypeOf(o: any, proto: any) {
  return OBJ_setPrototypeOf$(o, proto)
}

export function getPrototypeOf<T>(
  o: abstract new (...args: any[]) => any,
): Function
export function getPrototypeOf<T = any>(o: Function): T
export function getPrototypeOf<T = any>(
  o: readonly T[],
): Readonly<Omit<readonly T[], number>>
export function getPrototypeOf(o: {}): Object
export function getPrototypeOf(o: any) {
  return OBJ_getPrototypeOf$(o)
}

/**
 * @internal
 */
export function defineProtoPropertyDescriptor<
  C extends AbstractClass<any>,
  T extends InstanceType<C>,
  K extends keyof T,
>(target: C, name: K, descriptor: PropertyDescriptor) {
  return OBJ_defineProperty$(getProtos(target), name, descriptor)
}

export type PropertyDescriptorOptions =
  | PropertyValueDescriptor
  | PropertyGetterDescriptor

const fromDescriptorOptions = (
  descriptor: PropertyDescriptorOptions,
): PropertyDescriptor => ({
  [__KEY_CONFIGURABLE]: descriptor._configurable,
  [__KEY_ENUMERABLE]: descriptor._enumerable,
})

/**
 * @internal
 */
export function makeGetter<T extends {}, V>(
  getter: (self: T) => V,
  descriptor?: PropertyGetterDescriptor,
): TypedPropertyDescriptor<V>
export function makeGetter(
  getter: (self: any) => any,
  descriptor: PropertyGetterDescriptor = {},
): PropertyDescriptor {
  return ((option) => (
    (option.get = useThis(getter)),
    (option.set = descriptor._set),
    option
  ))(fromDescriptorOptions(descriptor))
}
/**
 * @internal
 */
export function makeMethod<T extends {}, Args extends any[], ReturnValue>(
  method: (self: T, ...args: Args) => ReturnValue,
  descriptor?: PropertyValueDescriptor,
): TypedPropertyDescriptor<(this: T, ...args: Args) => ReturnValue>
export function makeMethod(
  method: (self: any) => any,
  descriptor: PropertyValueDescriptor = {},
): PropertyDescriptor {
  return ((option) => ((option[__KEY_VALUE] = useThis(method)), option))(
    fromDescriptorOptions(descriptor),
  )
}
/**
 * @internal
 */
export function makeProperty<V>(
  value: V,
  descriptor?: PropertyValueDescriptor,
): TypedPropertyDescriptor<V>
export function makeProperty(
  value: any,
  descriptor: PropertyValueDescriptor = {},
): PropertyDescriptor {
  return ((option) => (
    ((option[__KEY_VALUE] = value),
    (option[__KEY_WRITABLE] = descriptor?._writable ?? true)),
    option
  ))(fromDescriptorOptions(descriptor))
}

/**
 * @internal
 */
export function defineProperty<V>(
  target: any,
  name: string | symbol,
  value: V,
  descriptor?: PropertyValueDescriptor,
): any
export function defineProperty<T, K extends keyof T>(
  target: T,
  name: K,
  value: T[K],
  descriptor?: PropertyValueDescriptor,
): T
export function defineProperty<V, T = any>(
  target: T,
  name: string | symbol,
  value: V,
  descriptor: PropertyValueDescriptor = {},
) {
  return OBJ_defineProperty$(target, name, makeProperty(value, descriptor))
}

/**
 * @internal
 */
export function defineHiddenProperty<T>(
  target: T,
  name: string | symbol,
  value: any,
  descriptor: Omit<PropertyValueDescriptor, "_enumerable"> = {},
) {
  return defineProperty(target, name, value, {
    _enumerable: false,
    ...descriptor,
  })
}
/**
 * @internal
 */
export function defineReadonlyProperty<T>(
  target: T,
  name: string | symbol,
  value: any,
  descriptor: Omit<PropertyValueDescriptor, "_enumerable"> = {},
) {
  return defineProperty(target, name, value, {
    _writable: false,
    ...descriptor,
  })
}

export function defineGetter<T extends {}, K extends keyof T>(
  target: T,
  name: K,
  getter: (self: T) => T[K],
  descriptor?: PropertyGetterDescriptor,
): T
export function defineGetter<T extends {}, K extends string | symbol, V>(
  target: T,
  name: K,
  getter: (self: T) => V,
  descriptor?: PropertyGetterDescriptor,
): T & { [key in K]: V }
export function defineGetter(
  target: any,
  name: string | symbol,
  getter: (self: any) => any,
  descriptor: PropertyGetterDescriptor = {},
) {
  return OBJ_defineProperty$(target, name, makeGetter(getter, descriptor))
}

export const defineProtoGetter = <
  C extends AbstractClass<any>,
  T extends InstanceType<C>,
  K extends keyof T,
>(
  target: C,
  name: K,
  getter: (self: T) => T[K],
  descriptor: PropertyGetterDescriptor = {},
): C => (defineGetter(getProtos(target), name, getter, descriptor), target)

export const defineProtoValue = <
  C extends AbstractClass<any>,
  T extends InstanceType<C>,
  K extends keyof T,
>(
  target: C,
  name: K,
  value: T[K],
  descriptor: PropertyValueDescriptor = {},
) => (
  defineProtoPropertyDescriptor(
    target,
    name,
    ((option) => (
      (option[__KEY_VALUE] = value),
      (option[__KEY_WRITABLE] = descriptor._writable),
      option
    ))(fromDescriptorOptions(descriptor)),
  ),
  target
)

export function defineProtoPropertyReadonlyValue<
  C extends AbstractClass<any>,
  T extends InstanceType<C>,
  K extends keyof T,
>(target: C, name: K, value: T[K], descriptor: PropertyCommonDescriptor = {}) {
  return defineProtoValue(target, name, value, {
    ...descriptor,
    _writable: false,
  })
}
