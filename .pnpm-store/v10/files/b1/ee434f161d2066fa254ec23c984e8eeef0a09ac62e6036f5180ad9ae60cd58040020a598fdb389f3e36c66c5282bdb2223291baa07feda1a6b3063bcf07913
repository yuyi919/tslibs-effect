import type { Kind, URIS, URIS2 } from "fp-ts/HKT"
import * as MApplicative from "fp-ts/Applicative"
import * as array from "fp-ts/Array"
import * as NEA from "fp-ts/NonEmptyArray"

import * as util from "@yuyi919/shared-proto/Functions"
import * as LiftMapT from "@yuyi919/shared-proto/LiftMap"

import * as ParseResult from "../ParseResult"
import { Parser } from "./core"
import { _run, define } from "./impl"
import { URI } from "./URI"

export const liftMap: LiftMapT.LiftMap2<URI>["liftMap"] = <I, A, B, C, D>(
  ...args: NEA.NonEmptyArray<any>
): Parser<I, any> => {
  switch (args.length) {
    case 3:
      return liftMap2(
        ...(args as [fa: Parser<I, A>, fb: Parser<I, B>, f: (a: A, b: B) => C]),
      )
    case 4:
      return liftMap3(
        ...(args as [
          fa: Parser<I, A>,
          fb: Parser<I, B>,
          fc: Parser<I, C>,
          f: (a: A, b: B, c: C) => D,
        ]),
      )
    default: {
      const f: (...args: any[]) => any = (args as any as any[]).pop()!
      return liftMapAllArgs(args, f)
    }
  }
}

export const liftMapAllArgs = <I, A, B>(
  args: NEA.NonEmptyArray<Parser<I, A>>,
  f: (...args: A[]) => B,
): Parser<I, B> => liftMapAll(args, util.toArrayElementFirst(f))

export const liftMapAll = <I, A, B>(
  args: NEA.NonEmptyArray<Parser<I, A>>,
  f: (args: NEA.NonEmptyArray<A>) => B,
): Parser<I, B> => {
  const [fa] = args as NEA.NonEmptyArray<Parser<I, A>>
  return define((start, option) => {
    const third: ParseResult.t<any, any> = _run(fa, start, option)
    if (ParseResult.isLeft(third)) return third
    let prevResult: ParseResult.t<I, A> = third
    const lastIndex = args.length - 1
    const result = new Array(lastIndex) as NEA.NonEmptyArray<A>
    result[0] = ParseResult.getValue(prevResult)
    for (let i = 1; i < args.length; ++i) {
      prevResult = _run(args[i]!, ParseResult.getNext(prevResult), option)
      if (ParseResult.isLeft(prevResult)) return prevResult
      result[i] = ParseResult.getValue(prevResult)
    }
    return ParseResult.succeed(
      f(result),
      ParseResult.getNext(prevResult),
      start,
    )
  })
}

export const liftMap2 = <I, A, B, C>(
  fa: Parser<I, A>,
  fb: Parser<I, B>,
  f: (a: A, b: B) => C,
): Parser<I, C> =>
  define((start, option) => {
    const first = _run(fa, start, option)
    if (ParseResult.isLeft(first)) return first
    const second = _run(fb, ParseResult.getNext(first), option)
    if (ParseResult.isLeft(second)) return second
    return ParseResult.liftMap2F(first, second, f)
  })

export const liftMap3 = <I, A, B, C, D>(
  fa: Parser<I, A>,
  fb: Parser<I, B>,
  fc: Parser<I, C>,
  f: (a: A, b: B, C: C) => D,
): Parser<I, D> =>
  define((start, option) => {
    const first = _run(fa, start, option)
    if (ParseResult.isLeft(first)) return first
    const second = _run(fb, ParseResult.getNext(first), option)
    if (ParseResult.isLeft(second)) return second
    const third = _run(fc, ParseResult.getNext(second), option)
    if (ParseResult.isLeft(third)) return third
    return ParseResult.liftMap3F(first, second, third, f)
  })

export const liftMap4 = <I, A, B, C, D, E>(
  fa: Parser<I, A>,
  fb: Parser<I, B>,
  fc: Parser<I, C>,
  fd: Parser<I, D>,
  f: (a: A, b: B, C: C, d: D) => E,
): Parser<I, E> =>
  define((start, option) => {
    const first = _run(fa, start, option)
    if (ParseResult.isLeft(first)) return first
    const second = _run(fb, ParseResult.getNext(first), option)
    if (ParseResult.isLeft(second)) return second
    const third = _run(fc, ParseResult.getNext(second), option)
    if (ParseResult.isLeft(third)) return third
    const fourth = _run(fd, ParseResult.getNext(third), option)
    if (ParseResult.isLeft(fourth)) return fourth
    return ParseResult.liftMap4F(first, second, third, fourth, f)
  })
export const getLiftMap1: <URI extends URIS>(
  M: MApplicative.Applicative1<URI>,
) => LiftMap<URI> = <URI extends URIS>(M: MApplicative.Applicative1<URI>) => {
  type I = "I"
  type A = 1
  type B = 2
  type C = 3
  type D = 4
  type Args = [A, B, C?, D?]
  type Z = symbol
  const fn2 = array.traverseWithIndex(M)
  const fn = fn2<Kind<URI, Args[number]>, Args[number]>(util.return2)

  return (...fa: any[]) => {
    const f = fa.pop() as (...args: Args) => Z
    const a = fa as unknown as NEA.NonEmptyArray<Parser<I, Kind<URI, any>>>
    const ap1 = M.of((a: A) => (b: B) => f(a, b) as Z)
    const ap2 = M.of((a: A) => (b: B) => (c: C) => f(a, b, c) as Z)
    const ap3 = M.of((a: A) => (b: B) => (c: C) => (d: D) => f(a, b, c, d) as Z)
    const apAll = M.of(util.toArrayArgFirst(f))
    switch (a.length) {
      case 2:
        return liftMap2(a[0], a[1]!, (a, b) => M.ap(M.ap(ap1, a), b))
      case 3:
        return liftMap3(a[0], a[1]!, a[2]!, (a, b, c) =>
          M.ap(M.ap(M.ap(ap2, a), b), c),
        )
      case 4:
        return liftMap4(a[0], a[1]!, a[2]!, a[3]!, (a, b, c, d) =>
          M.ap(M.ap(M.ap(M.ap(ap3, a), b), c), d),
        )
      default:
        return liftMapAll(a, (arr) => {
          const args = fn(arr) as unknown as Kind<URI, Args>
          return M.ap(apAll, args)
        })
    }
  }
}

export const getLiftMap2: {
  <M extends URIS>(M: LiftMapT.LiftMap1<M>): LiftMapT.LiftMapT21<URI, M>
  <M extends URIS2>(M: LiftMapT.LiftMap2<M>): LiftMapT.LiftMapT22<URI, M>
} = <URI extends URIS>(M: LiftMapT.LiftMap1<URI>) => {
  type I = "I"
  type Args = [1, 2, 3?, 4?]
  type Z = symbol
  const liftMap = util.cloneFn(M.liftMap)
  return (...fa: any[]) => {
    const f = fa.pop() as (...args: Args) => Z
    const a = fa as NEA.NonEmptyArray<Parser<I, Kind<URI, any>>>
    switch (a.length) {
      case 2:
        return liftMap2(a[0], a[1]!, (a, b) => liftMap(a, b, f))
      case 3:
        return liftMap3(a[0], a[1]!, a[2]!, (a, b, c) => liftMap(a, b, c, f))
      case 4:
        return liftMap4(a[0], a[1]!, a[2]!, a[3]!, (a, b, c, d) =>
          liftMap(a, b, c, d, f),
        )
      default:
        return liftMapAll(a, (arr) =>
          liftMap(
            ...(arr as [
              Kind<URI, 1>,
              Kind<URI, 2>,
              Kind<URI, 3>,
              Kind<URI, 4>,
            ]),
            f,
          ),
        )
    }
  }
}

export type LiftMap<M extends URIS> = LiftMapT.LiftMapT21<URI, M>
export type LiftMap2<M extends URIS2> = LiftMapT.LiftMapT22<URI, M>
