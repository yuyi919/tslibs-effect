{"version":3,"file":"DistributiveLattice.js","names":["max","min","getMinMaxDistributiveLattice","O","meet","join"],"sources":["src/DistributiveLattice.js"],"sourcesContent":["/**\n * A `DistributiveLattice` must satisfy the following laws in addition to `Lattice` laws:\n *\n * - Distributivity for meet: `a ∨ (b ∧ c) <-> (a ∨ b) ∧ (a ∨ c)`\n * - Distributivity for join: `a ∧ (b ∨ c) <-> (a ∧ b) ∨ (a ∧ c)`\n *\n * @since 2.0.0\n */import{max,min}from\"./Ord.js\";// -------------------------------------------------------------------------------------\n// constructors\n// -------------------------------------------------------------------------------------\n/**\n * @category constructors\n * @since 2.0.0\n */export function getMinMaxDistributiveLattice(O){return{meet:min(O),join:max(O)}}"],"mappings":"AAAA;AACA;AACA;AACA;AACA;AACA;AACA;AACA,GAAG,SAAOA,GAAG,EAACC,GAAG,QAAK,UAAU,CAAC;AACjC;AACA;AACA;AACA;AACA;AACA;AAAG,WAAgBC,4BAA4B,GAACC,CAAC,KAAQ;EAACC,IAAI,EAACH,GAAG,CAACE,CAAC,CAAC;EAACE,IAAI,EAACL,GAAG,CAACG,CAAC;AAAC,CAAC","ignoreList":[]}