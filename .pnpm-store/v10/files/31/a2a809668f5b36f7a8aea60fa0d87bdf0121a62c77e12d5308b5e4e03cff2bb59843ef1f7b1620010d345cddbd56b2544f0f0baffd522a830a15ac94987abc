export type HashValue = number & {}
export interface Hash {
  [HashSymbol](): HashValue
}

/**
 * @since 2.0.0
 * @category hashing
 */
export function cachedStatic<T extends {}>(
  self: T,
  staticHash: HashValue = hash(self),
): T {
  return defineReadonlyProperty<T>(self, HashSymbol, constant(staticHash))
}

export function withHash<T extends object>(target: T, another: unknown): T {
  return cachedStatic(target, hash(another))
}

export function combine(
  x: HashValue,
  y: HashValue,
  ...other: HashValue[]
): HashValue
export function combine(
  x: HashValue,
  y: HashValue,
  ...other: HashValue[]
): HashValue {
  return internal.combine2(
    x,
    reduceRight(other, (r, hash) => internal.combine2(r, hash), y),
  )
}

export function combineAll(all: NEA<HashValue>) {
  return all.reduce((r, hash) => internal.combine2(r, hash))
}

export function hash<A>(self: A): HashValue
export function hash(
  self:
    | number
    | HashValue
    | bigint
    | string
    | symbol
    | Types.Fn
    | object
    | any[]
    | null
    | undefined
    | boolean,
) {
  let t
  if (self === CONTSTANTS.UNDEFINED) {
    return internal.HASH_UNDEFINED
  } else if (self === CONTSTANTS.NULL) {
    return internal.HASH_NULL
  } else if (self === JsTypes.IS_TRUE) {
    return internal.HASH_TRUE
  } else if (self === JsTypes.IS_FALSE) {
    return internal.HASH_FALSE
  } else if (isHashable(self)) {
    return self[HashSymbol]()
  } else {
    t = typeof self
    if (t === CONTSTANTS.__KEY_NUM) {
      return internal.number(self as number)
    } else if (t === CONTSTANTS.__KEY_BIGINT) {
      return internal.bigInt(self as bigint)
    } else if (t === CONTSTANTS.__KEY_SYMBOL) {
      return internal.symbol(self as symbol)
    } else if (t === CONTSTANTS.__KEY_STR) {
      return internal.string(self as string)
    } else if (JsTypes.isDate(self)) {
      return hash(self.toISOString())
    } else if (isHash(self)) {
      return self[HashSymbol]!()
    } else if (JsTypes.isArr(self)) {
      return arrayLike(self)
    } else {
      return internal.random(self as object)
    }
  }
}

export function arrayLike<A>(arr: ArrayLike<A>) {
  let h = 6151,
    len = Length.unknownArray(arr)
  for (let i = 0; i < len; i++) {
    h = internal.combine2(h, hash(arr[i]))
  }
  return optimize(h)
}

export function array<A>(arr: ReadonlyArray<A>) {
  return arrayLike(arr)
}

/** @internal */
export const EMPTY_STRUCTURE_KEYS: HashValue = 12289

/** @internal */
export function structureKeysWithCache<A extends JsObject.JsObject>(
  target: A,
  keys: ReadonlyArray<JsObject.JsObjectKey<A>>,
  cache: JsObject.JsObjectParitalMap<A, number>,
  zero: HashValue,
) {
  let h = zero,
    length = Length.unknownArray(keys),
    key: JsObject.JsObjectKey<A> | undefined
  for (let i = 0; i < length; i++) {
    h = internal.combine3(
      h,
      JsTypes.hasOwnKey(cache, (key = keys[i]!))
        ? cache[key]
        : (cache[key] = internal.string(
            JsTypes.isSymbol(key) ? JsTypes.toString(key) : key,
          )),
      hash(target[key]),
    )
  }
  return optimize(h)
}

/** @internal */
export function $structureEntries(...hashs: [number, ...number[]]) {
  return optimize(
    hashs.reduce((h, hash) => internal.combine2(h, hash), EMPTY_STRUCTURE_KEYS),
  )
}

const keyCache: JsObject.JsObject<number> = {}
export function structureKeys<A extends JsObject.JsObject>(
  o: A,
  keys: ReadonlyArray<JsObject.JsObjectKey<A>>,
) {
  return structureKeysWithCache(o, keys, keyCache, EMPTY_STRUCTURE_KEYS)
}

export function struct<A extends ReadonlyArray<any>>(o: A): never
export function struct<A extends JsObject.JsObject>(o: A): HashValue
export function struct<A extends JsObject.JsObject>(o: A) {
  return structureKeys(
    o,
    JsObject.keys(o) as unknown as ReadonlyArray<JsObject.JsObjectKey<A>>,
  )
}

export function object<A extends ReadonlyArray<any>>(o: A): never
export function object<A extends JsObject.JsObject>(o: A): HashValue
export function object<A extends JsObject.JsObject>(o: A) {
  return structureKeys(
    o,
    JsObject.jsObjectKeys(o) as unknown as ReadonlyArray<
      JsObject.JsObjectKey<A>
    >,
  )
}

export function record<A extends ReadonlyArray<any>>(o: A): never
export function record<A extends JsObject.JsObject>(o: A): HashValue
export function record<A extends JsObject.JsObject>(o: A) {
  return structureKeys(
    o,
    JsObject.keys(o) as unknown as ReadonlyArray<JsObject.JsObjectKey<A>>,
  )
}

/**
 *
 * @param name
 * @returns
 * ```ts
 * combine(string("value"), hash(value))
 * ```
 */
export function $value(value: unknown) {
  return internal.combine2(internal.HASH_VALUE, hash(value))
}

export function isHash(target: unknown): target is Hash {
  return (
    (JsTypes.isObj(target) || JsTypes.isFn(target)) &&
    HashSymbol in target &&
    JsTypes.isFn(target[HashSymbol]!)
  )
}

/**
 * @since 2.0.0
 * @category hashing
 * @deprecated 请使用 `cachedStatic` 和 `withHash`
 */
export function cached(self: object): (hash: HashValue) => HashValue
export function cached(self: object, hash: HashValue): HashValue
export function cached(...args: [any, any?]) {
  return dual(2, (self: object, hash: HashValue) => {
    return (defineReadonlyProperty(self, HashSymbol, constant(hash)), hash)
  })(...args)
}

export function hashedFn<F extends (...args: NEA<any>) => any>(
  fn: F,
  cache?: MemoizeCache<HashValue, ReturnType<F>>,
): F & {
  cache: MemoizeCache<HashValue, ReturnType<F>>
} {
  return cachedStatic(
    pureMemoize(fn, {
      cache,
      key: (...args: Parameters<F> & [unknown, ...unknown[]]) =>
        combineAll(map(args, hash)),
    }),
  )
}

