import * as assert from "node:assert"
import { describe, expect, it } from "vitest"

import * as Either from "../Either"
import * as Newtype from "../Newtype"
import * as Option from "../Option"

declare const IntTypeId: unique symbol

type Int = Newtype.Newtype<number, typeof IntTypeId>
const Int = Newtype.strictNewtype<Int>(
  (n) => Number.isInteger(n),
  (n) => Newtype.error(`Expected ${n} to be an integer`),
)

// const Assert: AssertsId<Int> = Newtype.getAsserts(Int)

type Positive = Newtype.Newtype<number, "Positive">
const Positive = Newtype.strictNewtype<Positive>(
  (n) => n > 0,
  (n) => Newtype.error(`Expected ${n} to be positive`),
)

type PositiveInt = Positive & Int
const PositiveInt = Newtype.all<PositiveInt>(Int, Positive)

describe("Newtype", () => {
  it("nominal", () => {
    type MyNumber = Newtype.Newtype<number, "MyNumber">
    const MyNumber = Newtype.unsafeNewtype<MyNumber>()
    assert.strictEqual(MyNumber(1), 1)
    assert.strictEqual(MyNumber(1.1), 1.1)
    expect(MyNumber.is(1)).toBe(true)
    expect(MyNumber.is(1.1)).toBe(true)
  })

  it("refined (predicate overload)", () => {
    expect(Int(1)).toBe(1)
    expect(() => Int(1.1)).toThrow()
    expect(Int.option(1)).toEqual(Option.some(1))
    expect(Int.option(1.1)).toEqual(Option.none())
    expect(Int.either(1)).toEqual(Either.right(1))
    assert.deepStrictEqual(
      Int.either(1.1),
      Either.left(Newtype.error("Expected 1.1 to be an integer")),
    )
    expect(Int.is(1)).toBe(true)
    expect(Int.is(1.1)).toBe(false)
    try {
      Int(1.1)
      assert.fail("expected `Int(1.1)` to throw an error")
    } catch (e) {
      expect(e).toStrictEqual(Newtype.error("Expected 1.1 to be an integer"))
    }
  })

  it("refined (Option overload)", () => {
    const Int = Newtype.strictNewtype<Int>((n) =>
      Number.isInteger(n)
        ? Option.none()
        : Option.some(Newtype.error(`Expected ${n} to be an integer`)),
    )
    try {
      Int(1.1)
      assert.fail("expected `Int(1.1)` to throw an error")
    } catch (e) {
      expect(e).toStrictEqual(Newtype.error("Expected 1.1 to be an integer"))
    }
  })

  it("composition", () => {
    expect(PositiveInt(1)).toBe(1)
    expect(() => PositiveInt(1.1)).toThrow()
    expect(PositiveInt.option(1)).toEqual(Option.some(1))
    expect(PositiveInt.option(1.1)).toEqual(Option.none())
    expect(PositiveInt.either(1)).toEqual(Either.right(1))
    assert.deepStrictEqual(
      PositiveInt.either(1.1),
      Either.left(Newtype.error("Expected 1.1 to be an integer")),
    )
    assert.deepStrictEqual(
      PositiveInt.either(-1.1),
      Either.left(
        Newtype.errors(
          Newtype.error("Expected -1.1 to be an integer"),
          Newtype.error("Expected -1.1 to be positive"),
        ),
      ),
    )
    expect(PositiveInt.is(1)).toBe(true)
    expect(PositiveInt.is(1.1)).toBe(false)
    expect(PositiveInt.is(-1)).toBe(false)
  })
})
