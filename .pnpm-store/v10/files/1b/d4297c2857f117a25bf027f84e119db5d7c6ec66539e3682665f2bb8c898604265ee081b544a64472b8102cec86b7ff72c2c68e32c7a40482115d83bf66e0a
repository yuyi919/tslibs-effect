{
  "name": "@yuyi919/shared-constant",
  "type": "module",
  "version": "0.0.14",
  "sideEffects": false,
  "keywords": [
    "constant"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "module": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "esnext": "./src/index.ts",
  "files": [
    "README.md",
    "dist",
    "src",
    "package.json"
  ],
  "devDependencies": {
    "@types/node": "^24.0.4",
    "@yuyi919/shared-prettier-config": "0.1.0",
    "@internal/build-tools": "^0.0.1",
    "@yuyi919/shared-tsconfig": "0.1.0"
  },
  "scripts": {
    "dev": "tsup --config ../../tsup.config.ts --watch",
    "build:turbo": "bun --bun usetsup && bun --bun build:annotate",
    "build:annotate": "bun --bun build-tools babel --src dist --outdir dist --slient",
    "build:tsup": "tsup --minify --clean --dts",
    "build:tsc": "tsc --build ./tsconfig.build.json",
    "generate": "bun ./scripts/gen.ts",
    "fastpub": "pnpm publish --no-git-checks",
    "format": "prettier --check . -w",
    "format:dist": "prettier --check ./dist -w"
  }
}