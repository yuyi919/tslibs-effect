Frame(resolve);\n        if (signal) {\n            AbortSignal.onAbort(signal, (reason)=>{\n                __clearTimeout(timerId);\n                reject(reason);\n            });\n        }\n    });\n}\n/**\n * 用一个延时Promise包裹值\n * @param duration - 延时时间（毫秒）\n * @param value - 需要延时返回的值\n * @param options - 可选配置对象，支持传入AbortSignal处理abort逻辑\n * @returns 返回{@link Ok.PromiseOk|Ok.PromiseOk<T, AbortError<R>>}\n */ export function delayValueOk(duration, value, options = {}) {\n    const { signal } = options;\n    if (signal && AbortSignal.isAborted(signal)) {\n        return castPromiseLike(Ok.no(AbortSignal.error(signal)));\n    }\n    return makeWithOk((resolve, reject)=>{\n        const timerId = __setTimeout(resolve, duration, value);\n        if (signal) {\n            AbortSignal.onAbort(signal, (reason)=>{\n                __clearTimeout(timerId);\n                reject(new AbortError(reason));\n            });\n        }\n    });\n}\n/**\n * 参照{@link delay}，但延时结束后会抛出{@link TimeoutError}\n *\n * 若catch到{@link AbortError}则直接返回而不会抛出错误\n * @param duration\n * @param options\n * @throws 通常抛出{@link TimeoutError}；若传入{@link AbortSignal}且延时后处于aborted则不会抛出\n */ export async function timeout(duration, options) {\n    try {\n        await delay(duration, options);\n    } catch (e) {\n        if (!isInstanceof(e, AbortError)) throw e;\n    }\n    if (!options?.signal?.aborted) {\n        throw new TimeoutError();\n    }\n}\n/**\n * 创建一个延时 {@link Ok.PromiseOk|PromiseOk<void, AbortError<R>>}。\n * @param duration - 延时时间（毫秒）\n * @param options - 配置对象\n * @returns Promise\n */ export function delayOK(duration, options) {\n    return delayValueOk(duration, VOID, options);\n}\nexport { delayOK as sleepOK };\n/**\n * 创建一个延时 {@link Promise}。\n * @param duration - 延时时间（毫秒）\n * @param options - 配置对象\n * @returns Promise\n */ export function delay(duration, options) {\n    return delayValue(duration, VOID, options);\n}\n/**\n * @deprecated 请使用{@link delay}\n */ export function sleep(duration, options) {\n    return delay(duration, options);\n}\n/**\n   * 手动触发一次调用（不影响时序）\n   * @returns 如果disposed或aborted，返回false，否则返回true\n   */ /**\n   * Creates a disposable scope for the resource, allowing use in `using` or `await using` statements.\n   * @param reason\n   */ /**\n * 创建一个支持中止的定时器。\n * @param callback - 定时执行的回调函数，参数为从0开始随着callback调用次数递增的整数\n * @param duration - 定时间隔（毫秒）\n * @param options - 配置对象\n * @returns 定时器句柄\n */ export function makeInterval(callback, duration, options = {}) {\n    const { signal, immediate = false, onError } = options;\n    let timerId = null, stopped = false;\n    const ctl = makeController();\n    if (signal?.aborted) {\n        ctl._resolve(Ok.no(AbortSignal.error(signal)));\n        return {\n            dispose: constVoid,\n            afterDispose: ctl._promise,\n            i: 0,\n            tick: constFalse,\n            isDisposed: true,\n            scope: (_a)=>({\n                    [SYMBOL_DISPOSE]: constVoid,\n                    [SYMBOL_ASYNC_DISPOSE]: constVoid\n                })\n        };\n    }\n    const clear = (reason)=>{\n        if (timerId !== null) {\n            __clearInterval(timerId);\n            timerId = null;\n            ctl._resolve(reason);\n        }\n    };\n    let index = 0;\n    const cb = ()=>{\n        callback(index++);\n    };\n    const handle = {\n        dispose: (a)=>clear(Ok.ok(a)),\n        afterDispose: ctl._promise,\n        tick: ()=>stopped ? false : (cb(), true),\n        get i () {\n            return index;\n        },\n        get isDisposed () {\n            return timerId === null;\n        },\n        scope: (a)=>({\n                [SYMBOL_DISPOSE]: ()=>handle.dispose(a),\n                [SYMBOL_ASYNC_DISPOSE]: ()=>handle.dispose(a)\n            })\n    };\n    timerId = onError ? __setInterval(()=>tryCatch(cb, (e)=>onError(e, false)), duration) : __setInterval(cb, duration);\n    if (immediate) {\n        onError ? tryCatch(cb, (e)=>onError(e, true)) : c