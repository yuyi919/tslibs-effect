toArgumentsFirst: {\n  <F extends (args: NEA.NonEmptyArray<any>) => any>(\n    f: F,\n  ): (...args: Parameters<F>[0]) => ReturnType<F>\n} =\n  <F extends (args: NEA.NonEmptyArray<any>) => any>(f: F) =>\n  (...args: Parameters<F>[0]): ReturnType<F> =>\n    f(args)\n\nexport const toArrayArgFirst: {\n  <F extends (...args: any[]) => any>(\n    f: F,\n  ): (args: Parameters<F>) => ReturnType<F>\n} =\n  <A, B>(f: (...args: A[]) => B) =>\n  (args: A[]): B =>\n    f(...args)\n\nexport const toArrayElementFirst: {\n  <A, B>(f: (...args: A[]) => B): (args: A[]) => B\n  <A, B>(f: (...args: readonly A[]) => B): (args: readonly A[]) => B\n  <A, B>(\n    f: (...args: RNEA.ReadonlyNonEmptyArray<A>) => B,\n  ): (args: RNEA.ReadonlyNonEmptyArray<A>) => B\n  <A, B>(\n    f: (...args: NEA.NonEmptyArray<A>) => B,\n  ): (args: NEA.NonEmptyArray<A>) => B\n} = toArrayArgFirst as any\n\nexport const invoke = <F extends io.IO<unknown>>(fn: F): ReturnType<F> =>\n  fn() as ReturnType<F>\n\nexport const getReaderEitherIO = <E, A>(): R.Reader<\n  E.Either<io.IO<E>, io.IO<A>>,\n  E.Either<E, A>\n> => E.bimap(invoke, invoke)\n\nexport const getIoThese =\n  <E, A>(O: these.These<io.IO<E>, io.IO<A>>): io.IO<these.These<E, A>> =>\n  () =>\n    these.Bifunctor.bimap(O, invoke, invoke)\n\nexport const toIoEither =\n  <E, A>(O: E.Either<io.IO<E>, io.IO<A>>): io.IO<E.Either<E, A>> =>\n  () =>\n    E.Bifunctor.bimap(O, invoke, invoke)\n\nexport const toReaderEither =\n  <R, E, A>(\n    O: E.Either<R.Reader<R, E>, R.Reader<R, A>>,\n  ): R.Reader<R, E.Either<E, A>> =>\n  (r) =>\n    E.Bifunctor.bimap(\n      O,\n      (a) => a(r),\n      (a) => a(r),\n    )\n\nexport const compactEitherIO: <Sep, A>(\n  array: NEA.NonEmptyArray<E.Either<io.IO<Sep>, io.IO<A>>>,\n) => io.IO<NEA.NonEmptyArray<E.Either<Sep, A>>> = flow(\n  NEA.map(toIoEither),\n  io.sequenceArray as unknown as <A>(\n    arr: NEA.NonEmptyArray<io.IO<A>>,\n  ) => io.IO<NEA.NonEmptyArray<A>>,\n)\n\nexport const compactEitherReader: <R, Sep, A>(