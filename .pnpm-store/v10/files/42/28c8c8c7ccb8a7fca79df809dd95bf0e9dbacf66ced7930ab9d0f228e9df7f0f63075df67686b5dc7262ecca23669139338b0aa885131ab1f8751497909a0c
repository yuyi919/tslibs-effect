y<unknown, ReturnType<F>>(), key: getKey } = options\n  const _getOrInit = ENABLE_EVALFUNCTION ? cloneFn(getOrInit) : getOrInit\n  return assign(\n    (getKey\n      ? (...arg: Parameters<F>): ReturnType<F> =>\n          _getOrInit(cache, getKey!(...arg), () => fn(...arg))\n      : (a: any, ...other: any[]) =>\n          _getOrInit(cache, a, () => fn(a, ...other))) as F,\n    {\n      cache,\n    },\n  )\n}\n\nexport interface MemoizeOptions<F extends (...args: any) => any> {\n  cache?: MemoizeCache<any, ReturnType<F>>\n  key?: (...args: Parameters<F>) => unknown\n}\n\n/**\n * Represents a cache for memoization, allowing storage and retrieval of computed values.\n *\n * @template K - The type of keys used to store values in the cache.\n * @template V - The type of values stored in the cache.\n */\nexport interface MemoizeCache<K, V> {\n  /**\n   * Stores a value in the cache with the specified key.\n   *\n   * @param key - The key to associate with the value.\n   * @param value - The value to store in the cache.\n   */\n  set(key: K, value: V): void\n\n  /**\n   * Retrieves a value from the cache by its key.\n   *\n   * @param key - The key of the value to retrieve.\n   * @returns The value associated with the key, or undefined if the key does not exist.\n   */\n  get(key: K): V | undefined\n\n  /**\n   * Checks if a value exists in the cache for the specified key.\n   *\n   * @param key - The key to check for existence in the cache.\n   * @returns True if the cache contains the key, false otherwise.\n   */\n  has(key: K): boolean\n\n  /**\n   * Deletes a value from the cache by its key.\n   *\n   * @param key - The key of the value to delete.\n   * @returns True if the value was successfully deleted, false otherwise.\n   */\n  delete(key: K): boolean | void\n\n  /**\n   * Clears all values from the cache.\n   */\n  clear(): void\n\n  /**\n   * The number of entries in the cache.\n   */\n  size: number\n}\n","import { unsafeCoerce } from \"./Functions\"\nimport { SYMBOL } from \"./internal/constant\"\n\n/**\n * @internal\n */\nexport function symbolFor(name: string): symbol {\n  return SYMBOL.for(name)\n}\n\nexport function nameForEffect(moduleName: string) {\n  return `effect/${moduleName}`\n}\n\nexport function signed(moduleName: string) {\n  return `yui9/proto/${moduleName}`\n}\n\n/**\n * @internal\n */\nexport function symbolForEffect(moduleName: string): symbol {\n  return symbolFor(nameForEffect(moduleName))\n}\n\n/**\n * @internal\n */\nexport const EqualSymbol: typeof import(\"effect/Equal\").symbol = unsafeCoerce(\n  symbolForEffect(\"Equal\"),\n)\n\n/**\n * @internal\n */\nexport const HashSymbol: typeof import(\"effect/Hash\").symbol = unsafeCoerce(\n  symbolForEffect(\"Hash\"),\n)\n\n/**\n * @internal\n */\nexport const NodeInspectSymbol: typeof import(\"effect/Inspectable\").NodeInspectSymbol =\n  unsafeCoerce(symbolFor(\"nodejs.util.inspect.custom\"))\n","const globalStore = new Map() as Map<unknown, any>\n\n/**\n * @since 2.0.0\n */\nexport const globalValue = <A>(id: unknown, compute: () => A): A => {\n  if (!globalStore.has(id)) {\n    globalStore.set(id, compute())\n  }\n  return globalStore.get(id)!\n}\n","// import { combineAll, hash, type HashValue } from \"@yuyi919/shared-proto/Hash\"\nimport { pureMemoize } from \"@yuyi919/shared-proto/Functions\"\nimport { globalValue } from \"@yuyi919/shared-proto/GlobalValue\"\nimport * as JsTypes from \"@yuyi919/shared-proto/JsTypes\"\nimport { HashSymbol, symbolForEffect } from \"@yuyi919/shared-proto/Symbol\"\n\nimport { type HashValue } from \"../Hash\"\nimport * as CONTSTANTS from \"./constant\"\n\n/** @internal */\nexport const randomHashCache = globalValue(\n  symbolForEffect(\"Hash/randomHashCache\"),\n  () => new CONTSTANTS.WEAKMAP<object, HashValue>(),\n)\n\n/**\n * @since 2.0.0\n * @category hashing\n */\nexport function random<A extends object>(self: A): HashValue {\n  if (!randomHashCache.has(self)) {\n    randomHashCache.set(\n      self,\n      number(Math.floor(Math.random() * CONTSTANTS.MAX_SAFE_INTEGER)),\n    )\n  }\n  return randomHashCache.get(self)!\n}\n\nlet _number = 0xffffffff\n/**\n * @since 2.0.0\n * @category hashing\n */\nexport function number(n: number | HashValue) {\n  if (n !== n || n === CONTSTANTS.INFINITY) {\n    return 0\n  }\n  let h = n | 0\n  if (h !== n) {\n    h ^= n * _number\n  }\n  while (n > _number) {\n    h ^= n /= _number\n  }\n  return optimize(h)\n}\n\nexport function string(str: string) {\n  let h = 5381,\n    i = str.length\n  while (i) {\n    h = (h * 33) ^ str.codePointAt(--i)!\n  }\n  return optimize(h)\n}\n\nexport function boolean(value: boolean): HashValue {\n  return value ? HASH_TRUE : HASH_FALSE\n}\n\nexport function memoizedString() {\n  return pureMemoize(string)\n}\n\nexport function bigInt(self: bigint): HashValue {\n  return string(self.toString(10))\n}\n\nexport function memoizedBigInt() {\n  return pureMemoize(bigInt)\n}\nexport function symbol(self: symbol) {\n  return string(JsTypes.toString(self))\n}\n\nexport function memoizedSymbol() {\n  return pureMemoize(symbol)\n}\n\nexport const KEYWORD_HASH = memoizedString()\n\nexport function optimize(n: HashValue): HashValue {\n  return (n & 0xbfffffff) | ((n >>> 1) & 0x40000000)\n}\n\n/**\n * 拷贝自effect/Hash的非柯里化版本\n */\nexport function combine2(a: HashValue, b: HashValue) {\n  return (a * 53) ^ b\n}\n\n/**\n *\n * @remark 同`combine2(a, combine2(b, c))`\n */\nexport function combine3(a: HashValue, b: HashValue, c: HashValue) {\n  return (a * 53) ^ ((b * 53) ^ c)\n}\n\n/**\n * 拷贝自effect/Hash\n */\nexport function combineWith(b: HashValue) {\n  return (self: HashValue) => combine2(self, b)\n}\n\n/** @internal */\nexport const HASH_UNDEFINED = string(\"\\x00\" + CONTSTANTS.__KEY_UNDEFINED)\n/** @internal */\nexport const HASH_NULL = string(\"\\x00\" + CONTSTANTS.__KEY_NULL)\n/** @internal */\nexport const HASH_TRUE = string(\"\\x00\" + JsTypes.IS_TRUE + \"\")\n/** @internal */\nexport const HASH_FALSE = string(\"\\x00\" + JsTypes.IS_FALSE + \"\")\n\n/**\n * @internal\n * @remark\n * ```ts\n * string(\"_tag\")\n * ```*/\nexport const HASH_TAG = string(CONTSTANTS.__KEY__TAG)\n/**\n * @internal\n * @remark\n * ```ts\n * string(\"value\")\n * ```*/\nexport const HASH_VALUE = string(CONTSTANTS.__KEY_VALUE)\n\n/**\n *\n * @param name\n * @returns\n * ```ts\n * combine(string(\"_tag\"), typeof name === 'string' ? string(name) : symbol(name))\n * ```\n */\nexport function $tag(name: string | symbol) {\n  return combine2(HASH_TAG, JsTypes.isStr(name) ? string(name) : symbol(name))\n}\n","import type { HashValue } from \"./Hash\"\nimport * as EvalFunction from \"./EvalFunction\"\nimport { unsafeCoerce } from \"./Functions\"\nimport { hash } from \"./Hash\"\nimport { combine3, KEYWORD_HASH, optimize } from \"./internal/hash\"\nimport { useThis } from \"./Proto\"\n\n/**\n * 高度优化的hash函数生成器\n * @param baseHash\n * @param evalArgs - 生成的函数参数数组\n * @param evalSource - 迭代生成的数据源，一般是properties数组\n * @param eachSource - 迭代{@link evalSource}\n * @example\n * evalHashFactory(0, ['data'], ['foo', 'bar'], (key) => ['data.' + key, Hash.string(key), key])\n * // 生成等效代码\n * const fooHash = Hash.string('foo')\n * const barHash = Hash.string('bar')\n * (data) => {\n *   let hash = 0;\n *   hash = combine2(hash, combine2(fooHash, data.foo));\n *   hash = combine2(hash, combine2(barHash, data.bar));\n *   return Hash.optimize(hash)\n * }\n */\nconst evalHashFactory = <T>(\n  baseHash: number,\n  evalArgs: readonly string[],\n  evalSource: readonly T[],\n  eachSource: (\n    toHash: (self: string | number) => string,\n  ) => (\n    data: T,\n    index: number,\n  ) => [propertyGetter: string, keyHash: number, keyName: string],\n) => {\n  let key: string, keyHash: number\n  return EvalFunction.makeReturnArrowFunction(\n    [combine3, hash, optimize],\n    evalArgs,\n    (_evalArgs) => (combine3, toHash, optimize) =>\n      optimize(\n        evalSource.reduce(\n          (head, item, index) => (\n            ([key, keyHash] = eachSource(toHash)(item, index)),\n            combine3(head, keyHash, toHash(key))\n          ),\n          baseHash + \"\",\n        ),\n      ),\n  )\n}\n// `return(data)=>{let h=${base};${data.map((item, index) => {\n//   const [key, hash] = each(item, index);\n//   return `h^=c($(data${\n//     isString(key) ? `.${key}` : `[${key}]`\n//   }))(${hash})`;\n// })};return o(h)}`\nconst objectHashFactory = <T>(\n  baseHash: number,\n  evalArgs: readonly string[],\n  evalSource: readonly T[],\n  eachSource: (\n    hash: (self: string | number) => string,\n  ) => (\n    data: T,\n    index: number,\n  ) => [propertyGetter: string, keyHash: number, keyName: string],\n) => {\n  if (EvalFunction.ENABLE_EVALFUNCTION) {\n    return evalHashFactory(baseHash, evalArgs, evalSource, eachSource)\n  }\n  const keyHashes = evalSource.map(eachSource(unsafeCoerce(hash)))\n  return (data: Record<any, any>) => {\n    let h = baseHash,\n      key: string,\n      keyHash: number\n    // console.log(\"[objectHashFactory] baseHash\", baseHash)\n    for (let i = 0; i < keyHashes.length; i++) {\n      keyHash = keyHashes[i]![1]\n      key = keyHashes[i]![2]\n      h = combine3(h, keyHash, hash(data[key]))\n    }\n    return optimize(h)\n  }\n}\n\nexport function makeHash(base: number, keys: readonly string[]) {\n  return objectHashFactory(base, [\"_$data\"], keys, (hash) => (key) => [\n    hash(EvalFunction.prop(\"_$data\", key)),\n    KEYWORD_HASH(key),\n    key,\n  ])\n}\n\nexport function makeThisHash<T extends {}>(\n  base: number,\n  keys: readonly (keyof T)[],\n): (this: T) => number\nexport function makeThisHash<T extends {}>(\n  base: number,\n  keys: readonly string[],\n): (this: T) => number\nexport function makeThisHash<T extends {}>(base: number, keys: readonly any[]) {\n  return ((hash) => useThis((self: T) => hash(self)))(makeHash(base, keys))\n}\n\nexport function makeHashArray(base: number, keys: readonly string[]) {\n  return objectHashFactory(base, [\"args\"], keys, (hash) => (key, index) => [\n    hash(EvalFunction.prop(\"args\", index)),\n    KEYWORD_HASH(key),\n    key,\n  ])\n}\n\nexport function makeHashArgs(base: number, keys: readonly string[]) {\n  if (EvalFunction.ENABLE_EVALFUNCTION) {\n    return evalHashFactory(\n      base,\n      keys.map((key) => `_$${key}`),\n      keys,\n      (hash) => (key) => [hash(`_$${key}`), KEYWORD_HASH(key), key],\n    )\n  }\n  const keyHashes = keys.map((key) => KEYWORD_HASH(key))\n  return (...args: any[]) => {\n    let h = base\n    for (let i = 0; i < keyHashes.length; i++) {\n      h = combine3(h, keyHashes[i]!, hash(args[i]))\n    }\n    return optimize(h)\n  }\n}\n\nexport function makeIncrementHash(\n  base: number,\n  keys: readonly string[],\n  keyHashes: HashValue[] = keys.map((key) => KEYWORD_HASH(key)),\n): (source: any, field: string | symbol, fieldHash: HashValue) => number {\n  if (EvalFunction.ENABLE_EVALFUNCTION) {\n    return evalHashFactory(\n      base,\n      [\"_$src\", \"_$field\", \"_$hash\"],\n      keys,\n      (hash) => (key) => [\n        `_$field === ${JSON.stringify(key)} ? ${\"_$hash\"} : ${hash(EvalFunction.prop(\"_$src\", key))}`,\n        KEYWORD_HASH(key),\n        key,\n      ],\n    )\n  }\n  return (source: any, field: any, fieldHash: any) => {\n    let h = base,\n      key!: any\n    for (let i = 0; i < keys.length; i++) {\n      h = combine3(\n        h,\n        keyHashes[i]!,\n        (key = keys[i]) === field ? fieldHash : hash(source[key]!),\n      )\n    }\n    return optimize(h)\n  }\n}\n","import * as Hash from \"@yuyi919/shared-proto/Hash\"\nimport { JsObjectKey, jsObjectKeys } from \"@yuyi919/shared-proto/JsObject\"\nimport { HashSymbol } from \"@yuyi919/shared-proto/Symbol\"\n\nimport { forEach } from \"./Array\"\nimport { unsafeCoerce } from \"./Functions\"\nimport { makeHash, makeIncrementHash } from \"./HashFactory\"\nimport { defineHiddenProperty } from \"./internal/proto\"\nimport { getOrInit } from \"./JsMap\"\nimport 