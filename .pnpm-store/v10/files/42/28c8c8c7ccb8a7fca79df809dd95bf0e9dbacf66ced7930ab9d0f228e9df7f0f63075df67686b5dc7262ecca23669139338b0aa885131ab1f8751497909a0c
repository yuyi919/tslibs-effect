 function uint16Array(value: Uint16Array): Length {\n  return cloneFn(len)(value)\n}\nexport function uint32Array(value: Uint32Array): Length {\n  return cloneFn(len)(value)\n}\n","import { MAP } from \"./internal/constant\"\n\n/**\n *\n * @remark PURE\n */\nexport function empty<K, V>(): Map<K, V> {\n  return new MAP()\n}\n\n/**\n *\n * @remark PURE\n */\nexport function get<K, V>(map: Map<K, V>, k: K): V | undefined\nexport function get<K, V>(\n  map: { get(key: K): V | undefined },\n  k: K,\n): V | undefined\nexport function get<K, V>(\n  map: { get(key: K): V | undefined },\n  k: K,\n): V | undefined {\n  return map.get(k)\n}\n\n/**\n *\n * @remark PURE\n */\nexport function unsafeGet<K, V>(map: Map<K, V>, k: K): V\nexport function unsafeGet<K, V>(map: { get(key: K): V | undefined }, k: K): V\nexport function unsafeGet<K, V>(map: { get(key: K): V | undefined }, k: K): V {\n  return get(map, k)!\n}\n\n/**\n *\n * @remark PURE\n */\nexport function set<K, V>(map: Map<K, V>, key: K, value: V): Map<K, V>\nexport function set<K, V, T extends { set(key: K, value: V): unknown }>(\n  map: T,\n  key: K,\n  value: V,\n): T\nexport function set<K, V>(map: Map<K, V>, key: K, value: V): Map<K, V> {\n  return (map.set(key, value), map)\n}\n\n/**\n *\n * @remark PURE\n */\nexport function getOrInit<K, V>(\n  map: {\n    set(key: K, value: V): unknown\n    get(key: K): V | undefined\n    has(key: K): unknown\n  },\n  key: K,\n  value: () => V,\n): V {\n  let initial!: any\n  return map.has(key)\n    ? map.get(key)!\n    : (map.set(key, (initial = value())), initial)\n}\n\n/**\n *\n * @remark PURE\n */\nexport function remove<K, V>(map: Map<K, V>, key: K): Map<K, V>\nexport function remove<K, T extends Pick<Map<K, any>, \"delete\">>(\n  map: T,\n  key: K,\n): T\nexport function remove<K, T extends { delete(key: K): unknown }>(\n  map: T,\n  key: K,\n): T {\n  return (map.delete(key), map)\n}\n\n/**\n *\n * @remark PURE\n */\nexport function clear<K, V>(map: Map<K, V>): Map<K, V>\nexport function clear<T extends { clear(): unknown }>(map: T): T\nexport function clear<T extends { clear(): unknown }>(map: T): T {\n  return (map.clear(), map)\n}\n","// Copyright (c) 2021-2023 Peter Matta\n//\n// This source code is licensed under the MIT license found in the\n// LICENSE file in the root directory of this source tree.\n\n/* eslint-disable @typescript-eslint/ban-types */\nexport function flow<A extends [any, ...any[]], B>(\n  ab: (..._: A) => B,\n): (..._: A) => B\nexport function flow<A extends [any, ...any[]], B, C>(\n  ab: (..._: A) => B,\n  bc: (_: B) => C,\n): (..._: A) => C\nexport function flow<A extends [any, ...any[]], B, C, D>(\n  ab: (..._: A) => B,\n  bc: (_: B) => C,\n  cd: (_: C) => D,\n): (..._: A) => D\nexport function flow<A extends [any, ...any[]], B, C, D, E>(\n  ab: (..._: A) => B,\n  bc: (_: B) => C,\n  cd: (_: C) => D,\n  de: (_: D) => E,\n): (..._: A) => E\nexport function flow<A extends [any, ...any[]], B, C, D, E, F>(\n  ab: (..._: A) => B,\n  bc: (_: B) => C,\n  cd: (_: C) => D,\n  de: (_: D) => E,\n  ef: (_: E) => F,\n): (..._: A) => F\nexport function flow<A extends [any, ...any[]], B, C, D, E, F, G>(\n  ab: (..._: A) => B,\n  bc: (_: B) => C,\n  cd: (_: C) => D,\n  de: (_: D) => E,\n  ef: (_: E) => F,\n  fg: (_: F) => G,\n): (..._: A) => G\nexport function flow<A extends [any, ...any[]], B, C, D, E, F, G, H>(\n  ab: (..._: A) => B,\n  bc: (_: B) => C,\n  cd: (_: C) => D,\n  de: (_: D) => E,\n  ef: (_: E) => F,\n  fg: (_: F) => G,\n  gh: (_: G) => H,\n): (..._: A) => H\nexport function flow<A extends [any, ...any[]], B, C, D, E, F, G, H, I, Z>(\n  ab: (..._: A) => B,\n  bc: (_: B) => C,\n  cd: (_: C) => D,\n  de: (_: D) => E,\n  ef: (_: E) => F,\n  fg: (_: F) => G,\n  gh: (_: G) => H,\n  hi: (_: H) => I,\n  ...args: any[]\n): (..._: A) => Z\nexport function flow<A extends [any, ...any[]]>(\n  head: any,\n  ...args: any[]\n): (..._: A) => unknown {\n  return (..._) => args.reduce((r, f) => f(r), head(..._))\n}\n","impo