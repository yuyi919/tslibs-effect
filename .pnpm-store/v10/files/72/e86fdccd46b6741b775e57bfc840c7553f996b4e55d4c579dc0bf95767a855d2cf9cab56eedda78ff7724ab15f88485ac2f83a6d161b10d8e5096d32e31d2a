{"version":3,"file":"char.js","names":["not","Monoid","P","maybe","char","c","expected","sat","s","notChar","c1","isOneOf","includes","oneOf","notOneOf","JSON","stringify","many","parser","many1","getMany1C","isDigit","digit","spaceRe","isSpace","test","space","isUnderscore","isLetter","toLowerCase","isAlphanum","alphanum","letter","isUnicodeLetter","toUpperCase","unicodeLetter","isUpper","upper","isLower","lower","notDigit","notSpace","notAlphanum","notLetter","notUpper","notLower"],"sources":["../../../../src/internal/Parser/parser/parser-ts/char.js"],"sourcesContent":["/**\n * @since 0.6.0\n */ import { not } from \"fp-ts/Predicate\";\nimport { Monoid } from \"fp-ts/string\";\nimport * as P from \"./Parser.js\";\nconst maybe = P.maybe(Monoid);\n// -------------------------------------------------------------------------------------\n// model\n// -------------------------------------------------------------------------------------\n/**\n * @category model\n * @since 0.6.0\n */ //`${DynamicString}${string}` & {}\n// -------------------------------------------------------------------------------------\n// constructors\n// -------------------------------------------------------------------------------------\n/**\n * The `char` parser constructor returns a parser which matches only the\n * specified single character\n *\n * @category constructors\n * @since 0.6.0\n */ export const char = (c)=>P.expected(P.sat((s)=>s === c), `\"${c}\"`);\n/**\n * The `notChar` parser constructor makes a parser which will match any\n * single character other than the one provided.\n *\n * @category constructors\n * @since 0.6.0\n */ export const notChar = (c)=>P.expected(P.sat((c1)=>c1 !== c), `anything but \"${c}\"`);\nconst isOneOf = (s, c)=>s.includes(c);\n/**\n * Matches any one character from the provided string.\n *\n * @category constructors\n * @since 0.6.0\n */ export const oneOf = (s)=>P.expected(P.sat((c)=>isOneOf(s, c)), `One of \"${s}\"`);\n/**\n * Matches a single character which isn't a character from the provided string.\n *\n * @category constructors\n * @since 0.6.0\n */ export const notOneOf = (s)=>P.expected(P.sat((c)=>!isOneOf(s, c)), `Not one of ${JSON.stringify(s)}`);\n// -------------------------------------------------------------------------------------\n// combinators\n// -------------------------------------------------------------------------------------\n/**\n * Takes a `Parser<Char, Char>` and matches it zero or more times, returning\n * a `string` of what was matched.\n *\n * @category combinators\n * @since 0.6.0\n */ export const many = (parser)=>maybe(many1(parser));\n/**\n * Takes a `Parser<Char, Char>` and matches it one or more times, returning\n * a `string` of what was matched.\n *\n * @category combinators\n * @since 0.6.0\n */ export const many1 = P.getMany1C(Monoid);\nconst isDigit = (c)=>/* LAZY */ \"0123456789\".includes(c);\n/**\n * Matches a single digit.\n *\n * @category combinators\n * @since 0.6.0\n */ export const digit = P.expected(P.sat(isDigit), \"a digit\");\nconst spaceRe = /^\\s$/;\nconst isSpace = (c)=>/* LAZY */ spaceRe.test(c);\n/**\n * Matches a single whitespace character.\n *\n * @category combinators\n * @since 0.6.0\n */ export const space = P.expected(P.sat(isSpace), \"a whitespace\");\nconst isUnderscore = (c)=>c === \"_\";\nconst isLetter = (c)=>/[a-z]/.test(c.toLowerCase());\nconst isAlphanum = (c)=>isLetter(c) || isDigit(c) || isUnderscore(c);\n/**\n * Matches a single letter, digit or underscore character.\n *\n * @category combinators\n * @since 0.6.0\n */ export const alphanum = P.expected(P.sat(isAlphanum), \"a word character\");\n/**\n * Matches a single ASCII letter.\n *\n * @since 0.6.0\n */ export const letter = P.expected(P.sat(isLetter), \"a letter\");\nconst isUnicodeLetter = (c)=>c.toLowerCase() !== c.toUpperCase();\n/**\n * Matches a single Unicode letter.\n * Works for scripts which have a notion of an upper case and lower case letters\n * (Latin-based scripts, Greek, Russian etc).\n *\n * @category combinators\n * @since 0.6.16\n */ export const unicodeLetter = P.expected(P.sat(isUnicodeLetter), \"an unicode letter\");\nconst isUpper = (c)=>isLetter(c) && c === c.toUpperCase();\n/**\n * Matches a single upper case ASCII letter.\n *\n * @category combinators\n * @since 0.6.0\n */ export const upper = P.expected(P.sat(isUpper), \"an upper case letter\");\nconst isLower = (c)=>isLetter(c) && c === c.toLowerCase();\n/**\n * Matches a single lower case ASCII letter.\n *\n * @category combinators\n * @since 0.6.0\n */ export const lower = P.expected(P.sat(isLower), \"a lower case letter\");\n/**\n * Matches a single character which isn't a digit.\n *\n * @category combinators\n * @since 0.6.0\n */ export const notDigit = P.expected(P.sat(not(isDigit)), \"a non-digit\");\n/**\n * Matches a single character which isn't whitespace.\n *\n * @category combinators\n * @since 0.6.0\n */ export const notSpace = P.expected(P.sat(not(isSpace)), \"a non-whitespace character\");\n/**\n * Matches a single character which isn't a letter, digit or underscore.\n *\n * @category combinators\n * @since 0.6.0\n */ export const notAlphanum = P.expected(P.sat(not(isAlphanum)), \"a non-word character\");\n/**\n * Matches a single character which isn't an ASCII letter.\n *\n * @category combinators\n * @since 0.6.0\n */ export const notLetter = P.expected(P.sat(not(isLetter)), \"a non-letter character\");\n/**\n * Matches a single character which isn't an upper case ASCII letter.\n *\n * @category combinators\n * @since 0.6.0\n */ export const notUpper = P.expected(P.sat(not(isUpper)), \"anything but an upper case letter\");\n/**\n * Matches a single character which isn't a lower case ASCII letter.\n *\n * @category combinators\n * @since 0.6.0\n */ export const notLower = P.expected(P.sat(not(isLower)), \"anything but a lower case letter\");\n"],"mappings":"AAAA;AACA;AACA,GAAI,SAASA,GAAG,QAAQ,iBAAiB;AACzC,SAASC,MAAM,QAAQ,cAAc;AACrC,OAAO,KAAKC,CAAC,MAA