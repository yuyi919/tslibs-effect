import { BIND_NULL } from "./function"

/**
 * ```ts
 * globalThis
 * ```
 */
export const GLOBAL_THIS: typeof globalThis = globalThis

/**
 * ```ts
 * globalThis.requestIdleCallback
 * ```
 */
export const __requestIdleCallback:
  | typeof globalThis.requestIdleCallback
  | undefined = BIND_NULL(GLOBAL_THIS.requestIdleCallback)

/**
 * ```ts
 * globalThis.requestIdleCallback
 * ```
 */
export const __cancelIdleCallback:
  | typeof globalThis.cancelIdleCallback
  | undefined = BIND_NULL(GLOBAL_THIS.cancelIdleCallback)

export const __requestAnimationFrame:
  | typeof globalThis.requestAnimationFrame
  | undefined = BIND_NULL(GLOBAL_THIS.requestAnimationFrame)

export const __cancelAnimationFrame:
  | typeof globalThis.cancelAnimationFrame
  | undefined = BIND_NULL(GLOBAL_THIS.cancelAnimationFrame)

/**
 * @internal
 * @see setTimeout
 */
export const SET_TIMEOUT: typeof setTimeout = BIND_NULL(setTimeout)

/**
 * @internal
 * @see setInterval
 */
export const SET_INTERVAL: typeof setInterval = BIND_NULL(setInterval)

/**
 * @internal
 * @see clearTimeout
 */
export const CLEAR_TIMEOUT: typeof clearTimeout = BIND_NULL(clearTimeout)

/**
 * @internal
 * @see clearInterval
 */
export const CLEAR_INTERVAL: typeof clearInterval = BIND_NULL(clearInterval)
