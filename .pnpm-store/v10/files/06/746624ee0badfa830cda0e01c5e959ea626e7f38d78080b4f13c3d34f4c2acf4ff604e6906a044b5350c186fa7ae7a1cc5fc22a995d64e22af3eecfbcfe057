@inline
let div2 = v => v /. 2.0
@inline
let mul2 = v => v *. 2.0
@inline
let mul = (v, mul) => v *. mul
@inline
let div = (v, div) => v /. div
@inline
let div_ceil = (v, div) => Math.ceil(v /. div)
@inline
let minusminus = v => v -. 1.0
@inline
let plusplus = v => v +. 1.0
@inline
let diff = (v, v2) => v -. v2
@inline
let sub = (v, v2) => v -. v2
@inline
let rev_sub = (v2, v) => sub(v, v2)
@inline
let add = (v, v2) => v +. v2
@inline
let lessThan = (a: float, b: float) => a < b
@inline
let greaterThan = (a: float, b: float) => a > b

@val external ceil: float => float = "Math.ceil"

external unsafe_toString: float => string = "%identity"
external unsafe: 'a => float = "%identity"
external unsafe_to_i32: float => int = "%identity"

let p = false
// @inline
let mod: (float, float) => float = %raw("(a, b) => a % b")

// 由于 ReScript 整数的范围比 JavaScript 数字小得多，因此在处理大数字时数据可能会丢失。在这些情况下，将数字绑定为浮点数要安全得多。
// 所以提供了以下转换

@inline
let logand = (a: float, b: float): float => I32.logand(a->unsafe_to_i32, b->unsafe_to_i32)->unsafe
@inline
let logor = (a: float, b: float): float => I32.logor(a->unsafe_to_i32, b->unsafe_to_i32)->unsafe
@inline
let logxor = (a: float, b: float): float => I32.logxor(a->unsafe_to_i32, b->unsafe_to_i32)->unsafe
@inline
let shift_left = (a: float, b: int): float => I32.shift_left(a->unsafe_to_i32, b)->unsafe
@inline
let shift_right = (a: float, b: int): float => I32.shift_right(a->unsafe_to_i32, b)->unsafe
@inline
let shift_right_logical = (a: float, b: int): float =>
  I32.shift_right_logical(a->unsafe_to_i32, b)->unsafe
