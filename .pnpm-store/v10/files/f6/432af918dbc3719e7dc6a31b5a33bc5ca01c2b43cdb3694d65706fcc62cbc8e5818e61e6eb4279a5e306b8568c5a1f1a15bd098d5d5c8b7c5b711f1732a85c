import * as assert from "node:assert/strict"
import { describe, it } from "vitest"

import { Traversable } from "fp-ts/Array"
import { intercalate } from "fp-ts/Foldable"
import * as RA from "fp-ts/ReadonlyArray"
import { Monoid } from "fp-ts/string"

import * as C from "./char"
import { errorResult, succeedResult } from "./ParseResult"
import * as Stream from "./Stream"
import * as S from "./string"

describe("string", () => {
  describe("string", () => {
    it("should parse an empty string", () => {
      const parser = S.string("")

      assert.deepStrictEqual(
        S.run("foo")(parser),
        succeedResult("", Stream.from("foo", 0), Stream.from("foo")),
      )
    })

    it("should parse a non-empty string", () => {
      const parser = S.string("foo")

      assert.deepStrictEqual(
        S.run("foo")(parser),
        succeedResult("foo", Stream.from("foo", 3), Stream.from("foo")),
      )
      assert.deepStrictEqual(
        S.run("foobar")(parser),
        succeedResult("foo", Stream.from("foobar", 3), Stream.from("foobar")),
      )
      assert.deepStrictEqual(
        S.run("fobar")(parser),
        errorResult(Stream.from("fobar", 2), [`"foo"`]),
      )
      assert.deepStrictEqual(
        S.run("barfoo")(parser),
        errorResult(Stream.from("barfoo"), ['"foo"']),
      )
    })

    it("should handle long strings without exceeding the recursion limit (#41)", () => {
      const lorem = "Lorem ipsum dolor sit amet, consectetur adipiscing elit."
      const target = intercalate(Monoid, RA.Foldable)(
        " ",
        RA.replicate(1000, lorem),
      )
      const source = intercalate(Monoid, RA.Foldable)(
        " ",
        RA.replicate(1000, lorem),
      )
      const cursor = target.length
      const parser = S.string(target)

      assert.deepStrictEqual(
        S.run(source)(parser),
        succeedResult(target, Stream.from(source, cursor), Stream.from(source)),
      )
    })
  })

  describe("many", () => {
    it("should handle repeated sequences of the target string", () => {
      const parser = S.many(S.string("ab"))
      assert.deepStrictEqual(
        S.run("ab")(parser),
        succeedResult(
          "ab",
          Stream.from(["a", "b"], 2),
          Stream.from(["a", "b"]),
        ),
      )
      assert.deepStrictEqual(
        S.run("abab")(parser),
        succeedResult(
          "abab",
          Stream.from(["a", "b", "a", "b"], 4),
          Stream.from(["a", "b", "a", "b"]),
        ),
      )
      assert.deepStrictEqual(
        S.run("aba")(parser),
        succeedResult(
          "ab",
          Stream.from(["a", "b", "a"], 2),
          Stream.from(["a", "b", "a"]),
        ),
      )
      assert.deepStrictEqual(
        S.run("ac")(parser),
        succeedResult("", Stream.from(["a", "c"]), Stream.from(["a", "c"])),
      )
    })

    const source = "a".repeat(1e6)
    it("should handle long sequences without exceeding the recursion limit (#45)", () => {
      assert.deepStrictEqual(
        S.run(source)(S.many(C.alphanum)),
        succeedResult(
          source,
          Stream.from(source, source.length),
          Stream.from(source),
        ),
      )
    })
  })

  it("oneOf", () => {
    const parser = S.oneOf(Traversable)(["a", "b"])
    assert.deepStrictEqual(
      S.run("a")(parser),
      succeedResult("a", Stream.from(["a"], 1), Stream.from(["a"])),
    )
    assert.deepStrictEqual(
      S.run("ab")(parser),
      succeedResult("a", Stream.from(["a", "b"], 1), Stream.from(["a", "b"])),
    )
    assert.deepStrictEqual(
      S.run("ba")(parser),
      succeedResult("b", Stream.from(["b", "a"], 1), Stream.from(["b", "a"])),
    )
    assert.deepStrictEqual(
      S.run("ca")(parser),
      errorResult(Stream.from(["c", "a"]), ['"a"', '"b"']),
    )
  })

  it("int", () => {
    const parser = S.int
    assert.deepStrictEqual(
      S.run("1")(parser),
      succeedResult(1, Stream.from(["1"], 1), Stream.from(["1"])),
    )
    assert.deepStrictEqual(
      S.run("-1")(parser),
      succeedResult(-1, Stream.from(["-", "1"], 2), Stream.from(["-", "1"])),
    )
    assert.deepStrictEqual(
      S.run("10")(parser),
      succeedResult(10, Stream.from(["1", "0"], 2), Stream.from(["1", "0"])),
    )
    assert.deepStrictEqual(
      S.run("-10")(parser),
      succeedResult(
        -10,
        Stream.from(["-", "1", "0"], 3),
        Stream.from(["-", "1", "0"]),
      ),
    )
    assert.deepStrictEqual(
      S.run("0.1")(parser),
      succeedResult(
        0,
        Stream.from(["0", ".", "1"], 1),
        Stream.from(["0", ".", "1"]),
      ),
    )
    assert.deepStrictEqual(
      S.run("-0.1")(parser),
      succeedResult(
        -0,
        Stream.from(["-", "0", ".", "1"], 2),
        Stream.from(["-", "0", ".", "1"]),
      ),
    )
    assert.deepStrictEqual(
      S.run("a")(parser),
      errorResult(Stream.from(["a"]), ["an integer"]),
    )
  })

  it("float", () => {
    const parser = S.float
    assert.deepStrictEqual(
      S.run("1")(parser),
      succeedResult(1, Stream.from(["1"], 1), Stream.from(["1"])),
    )
    assert.deepStrictEqual(
      S.run("-1")(parser),
      succeedResult(-1, Stream.from(["-", "1"], 2), Stream.from(["-", "1"])),
    )
    assert.deepStrictEqual(
      S.run("10")(parser),
      succeedResult(10, Stream.from(["1", "0"], 2), Stream.from(["1", "0"])),
    )
    assert.deepStrictEqual(
      S.run("-10")(parser),
      succeedResult(
        -10,
        Stream.from(["-", "1", "0"], 3),
        Stream.from(["-", "1", "0"]),
      ),
    )
    assert.deepStrictEqual(
      S.run("0.1")(parser),
      succeedResult(
        0.1,
        Stream.from(["0", ".", "1"], 3),
        Stream.from(["0", ".", "1"]),
      ),
    )
    assert.deepStrictEqual(
      S.run("-0.1")(parser),
      succeedResult(
        -0.1,
        Stream.from(["-", "0", ".", "1"], 4),
        Stream.from(["-", "0", ".", "1"]),
      ),
    )
    assert.deepStrictEqual(
      S.run("a")(parser),
      errorResult(Stream.from(["a"]), ["a float"]),
    )
  })

  it("doubleQuotedString", () => {
    const parser = S.doubleQuotedString
    assert.deepStrictEqual(
      S.run('""')(parser),
      succeedResult("", Stream.from(['"', '"'], 2), Stream.from(['"', '"'])),
    )
    assert.deepStrictEqual(
      S.run('"a"')(parser),
      succeedResult(
        "a",
        Stream.from(['"', "a", '"'], 3),
        Stream.from(['"', "a", '"']),
      ),
    )
    assert.deepStrictEqual(
      S.run('"ab"')(parser),
      succeedResult(
        "ab",
        Stream.from(['"', "a", "b", '"'], 4),
        Stream.from(['"', "a", "b", '"']),
      ),
    )
    assert.deepStrictEqual(
      S.run('"ab"c')(parser),
      succeedResult(
        "ab",
        Stream.from(['"', "a", "b", '"', "c"], 4),
        Stream.from(['"', "a", "b", '"', "c"]),
      ),
    )
    assert.deepStrictEqual(
      S.run('"a\\"b"')(parser),
      succeedResult(
        'a\\"b',
        Stream.from(['"', "a", "\\", '"', "b", '"'], 6),
        Stream.from(['"', "a", "\\", '"', "b", '"']),
      ),
    )
  })

  it("spaces", () => {
    const parser = S.spaces
    assert.deepStrictEqual(
      S.run("")(parser),
      succeedResult("", Stream.from(""), Stream.from("")),
    )
    assert.deepStrictEqual(
      S.run(" ")(parser),
      succeedResult(" ", Stream.from([" "], 1), Stream.from([" "])),
    )
    assert.deepStrictEqual(
      S.run("\t")(parser),
      succeedResult("\t", Stream.from(["\t"], 1), Stream.from(["\t"])),
    )
    assert.deepStrictEqual(
      S.run("\n")(parser),
      succeedResult("\n", Stream.from(["\n"], 1), Stream.from(["\n"])),
    )
    assert.deepStrictEqual(
      S.run("\n\t")(parser),
      succeedResult(
        "\n\t",
        Stream.from(["\n", "\t"], 2),
        Stream.from(["\n", "\t"]),
      ),
    )
    assert.deepStrictEqual(
      S.run("a")(parser),
      succeedResult("", Stream.from(["a"]), Stream.from(["a"])),
    )
  })

  it("spaces1", () => {
    const parser = S.spaces1
    assert.deepStrictEqual(
      S.run(" ")(parser),
      succeedResult(" ", Stream.from([" "], 1), Stream.from([" "])),
    )
    assert.deepStrictEqual(
      S.run("  ")(parser),
      succeedResult("  ", Stream.from([" ", " "], 2), Stream.from([" ", " "])),
    )
    assert.deepStrictEqual(
      S.run(" a")(parser),
      succeedResult(" ", Stream.from([" ", "a"], 1), Stream.from([" ", "a"])),
    )
    assert.deepStrictEqual(
      S.run("\n\t")(parser),
      succeedResult(
        "\n\t",
        Stream.from(["\n", "\t"], 2),
        Stream.from(["\n", "\t"]),
      ),
    )
    assert.deepStrictEqual(
      S.run("")(parser),
      errorResult(Stream.from(""), ["a whitespace"]),
    )
    assert.deepStrictEqual(
      S.run("a")(parser),
      errorResult(Stream.from(["a"]), ["a whitespace"]),
    )
  })

  it("sepBy1", () => {
    const parser = S.sepBy(S.string(","))(S.oneOf(Traversable)(["a", "b"]))
    assert.deepStrictEqual(
      S.run("a,b")(parser),
      succeedResult("a,b", Stream.from("a,b", 3), Stream.from("a,b")),
    )
  })
})
