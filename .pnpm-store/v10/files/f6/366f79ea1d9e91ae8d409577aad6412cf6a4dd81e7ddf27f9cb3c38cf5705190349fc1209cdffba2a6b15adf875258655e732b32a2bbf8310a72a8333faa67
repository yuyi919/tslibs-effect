describe("", () => {
  it("", () => {
    const prettyTypes = (types: ReadonlyArray<string>): Doc.Doc<any> => {
      const symbolDocuments = pipe(
        ReadonlyArray.makeBy(types.length - 1, () => Doc.text("->")),
        ReadonlyArray.prepend(pipe(Doc.text("::"), Doc.annotate("red"))),
      )
      const typeDocuments = types.map(Doc.text)
      const documents = pipe(
        symbolDocuments,
        ReadonlyArray.zipWith(typeDocuments, (left, right) =>
          Doc.catWithSpace(left, right),
        ),
        Doc.seps,
        Doc.align,
      )
      return documents
    }

    const prettyDeclaration = (
      name: string,
      types: ReadonlyArray<string>,
    ): Doc.Doc<any> =>
      pipe(Doc.text(name), Doc.catWithSpace(prettyTypes(types)))

    const dashes = Doc.pageWidth((width) =>
      Doc.text(
        "-".repeat(PageWidth.isAvailablePerLine(width) ? width.lineWidth : 24),
      ),
    )

    const name = "example"
    const types = ["Int", "Bool", "Char", "Char", "IO ()"]
    const doc: Doc.Doc<any> = prettyDeclaration(name, types)
    const docStream = pipe(
      Doc.vsep([dashes, doc, dashes]),
      Doc.annotate("red" as const),
      Layout.pretty(Layout.options(PageWidth.availablePerLine(24, 1))),
      // DocStream.reAnnotate((a) => (console.log(a), "<red/>")),
    )
    expect(
      pipe(
        DocTree.treeForm(docStream),
        DocTree.renderSimplyDecorated(
          Monoid,
          // eslint-disable-next-line no-sequences
          (str) => (console.log("1", JSON.stringify(str)), str),
          (_, x) => (
            console.log("2", JSON.stringify(_), JSON.stringify(x)),
            `${x}`
          ),
        ),
      ),
    ).toBe(
      stripMargin(
        `|------------------------
         |example :: Int
         |        -> Bool
         |        -> Char
         |        -> Char
         |        -> IO ()
         |------------------------`,
      ),
    )

    // expect(
    //   ts
