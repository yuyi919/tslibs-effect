import { describe, expect, it } from "vitest"

import * as Doc from "@effect/printer/Doc"
import * as DocTree from "@effect/printer/DocTree"
import * as Layout from "@effect/printer/Layout"
import * as PageWidth from "@effect/printer/PageWidth"
import { Monoid } from "@effect/typeclass/data/String"
import * as ReadonlyArray from "effect/Array"
import { pipe } from "effect/Function"
import * as Module from "effect/KeyedPool"
import { stripMargin } from "effect/String"

import { codeFrameColumns } from "../parser/CodeFrame"

describe("getType", () => {
  it("toBeTruthy", () => {
    expect(codeFrameColumns(`\nABC`, { start: { line: 2, column: 2 } })).toBe(
      stripMargin(
        `|  1 |
         |> 2 | ABC
         |    |  ^`,
      ),
    )
  })
})

