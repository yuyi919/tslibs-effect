import * as Hash from "@yuyi919/shared-proto/Hash"
import { JsObjectKey, jsObjectKeys } from "@yuyi919/shared-proto/JsObject"
import { HashSymbol } from "@yuyi919/shared-proto/Symbol"

import { forEach } from "./Array"
import { unsafeCoerce } from "./Functions"
import { makeHash, makeIncrementHash } from "./HashFactory"
import { defineHiddenProperty } from "./internal/proto"
import { getOrInit } from "./JsMap"
import * as Proto from "./Proto"

/**
 * @since 3.5.9
 * @category models
 */
export interface HashableConstructorProto<in out Id, in out Value> {
  readonly cache: Map<number, Id>
}
// TODO(4.0): move key narrowing to the Tag interface
/**
 * @since 2.0.0
 * @category models
 */
export interface HashableClass<Self, Type extends {}>
  extends HashableConstructorProto<Self, Type> {
  new (_: never): Hashable<Type, JsObjectKey<Type>> & Readonly<Type>
  init(): Self
  hash(data: Self): Hash.HashValue
  hash(data: Self | Type): Hash.HashValue
  cache: Map<Hash.HashValue, Self>
  is(val: unknown): val is Self
}

export declare namespace HashableClass {
  export type Data<C extends HashableClass<any, any>> =
    C extends HashableClass<any, infer Type extends {}> ? Type : never
  export type InstanceOf<C extends HashableClass<any, any>> =
    C extends HashableClass<infer Type extends {}, any> ? Type : never
}

const IncrementHash = Symbol("IncrementHash")
const Type = Symbol("Type")

export class Hashable<Values extends {}, K extends JsObjectKey<Values>>
  implements Hash.Hash
{
  declare _values: Values
  declare _hash: number
  declare readonly [Type]: HashableClass<any, Values>
  declare protected [IncrementHash]: (
    source: any,
    field: string | symbol,
    value: any,
  ) => number

  protected constructor() {}

  get _keys(): readonly K[] {
    return []
  }

  [HashSymbol](): number {
    return this._hash
  }

  merge(target: Partial<Values>): this {
    let _ = this
    for (const key of this._keys) {
      if (key in target && this._values[key] !== target[key]) {
        _ = _._hashField(key, target[key], Hash.hash(target[key]))
      }
    }
    return _
  }

  static extend<Values extends {}, Self>(
    initial: Values,
  ): HashableClass<Self, Values> {
    const keysArr = jsObjectKeys(initial)
    const _hashKeys = keysArr.map(Hash.hash)
    const values = { ...initial }
    const map = new Map()
    const get_hash = makeHash(Hash.EMPTY_STRUCTURE_KEYS, keysArr as any[])
    const get_args_hash = makeIncrementHash(
      Hash.EMPTY_STRUCTURE_KEYS,
      keysArr as any[],
      _hashKeys,
    )
    const zeroHash = get_hash(initial)
    class Extended extends Hashable<Values, JsObjectKey<Values>> {
      _values: Values = values
      _hash = zeroHash
      static init(): Self {
        return getOrInit(map, zeroHash, () => new this() as Self)
      }
      get _keys(): readonly JsObjectKey<Values>[] {
        return keysArr
      }
      static cache = map
      static is(a: unknown) {
        return a instanceof this
      }
    }
    defineHiddenProperty(Extended, "hash", get_hash)
    Proto.withProtoF(unsafeCoerce<new () => Extended>(Extended), (proto) => {
      forEach(keysArr, (k) =>
        Proto.defineGetter(proto, k, (self) => self._values[k] as any, {}),
      )
      // proto[IncrementHash] = get_args_hash
      Proto.defineReadonlyProperty(proto, IncrementHash, get_args_hash)
      Proto.defineGetter(proto, Type, (self: any) => self.constructor)
    })
    return Extended as unknown as HashableClass<Self, Values>
  }

  protected get _base() {
    return 0
  }

  private _hashField(field: K, value: any, hash: number) {
    if (this._values[field] === value) return this
    const Self = this[Type]
    const { cache } = Self
    // this[HashArray]!(...this._keys.map(key => this._values[key]))
    const nextHash = this[IncrementHash]!(this._values, field, hash)
    if (cache.has(nextHash)) {
      return cache.get(nextHash)! as this
    }
    const newer = new (unsafeCoerce<any>(Self))() as unknown as this
    newer._hash = nextHash
    newer._values = {
      ...this._values,
      [field]: value,
    }
    cache.set(nextHash, newer)
    return newer as this
  }

  protected _hashNum(field: K, value: number) {
    return this._hashField(field, value, Hash.number(value))
  }

  protected _hashStr(field: K, value: string) {
    return this._hashField(field, value, Hash.string(value))
  }

  protected _hashArr(field: K, value: string[]) {
    return this._hashField(field, value, Hash.array(value))
  }

  protected _hashBool(field: K, value: boolean) {
    return this._hashField(field, value, Hash.hash(value))
  }

  compute<T, R>(target: T, factory: (value: Values, source: T) => R) {
    return factory(this._values, target)
  }

  get() {
    return this._values
  }
}

export declare namespace Hashable {
  export type Data<C extends Hashable<any, any>> =
    C extends Hashable<infer Type extends {}, any> ? Type : never
}

export function isHashable(self: unknown): self is Hashable<any, any> {
  return self instanceof Hashable
}

export type { Hashable as T }
