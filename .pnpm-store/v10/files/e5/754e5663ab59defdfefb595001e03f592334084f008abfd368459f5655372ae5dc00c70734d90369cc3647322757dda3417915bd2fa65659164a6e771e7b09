ion'\n *\n * assert.deepStrictEqual(\n *   pipe(\n *     [1, 2, 3],\n *     NEA.alt(() => [4, 5])\n *   ),\n *   [1, 2, 3, 4, 5]\n * )\n *\n * @category error handling\n * @since 2.6.2\n */export const alt=altW;/**\n * Apply a function to an argument under a type constructor.\n *\n * @since 2.0.0\n */export const ap=as=>flatMap(f=>pipe(as,map(f)));/**\n * @example\n * import * as NEA from 'fp-ts/NonEmptyArray'\n * import { pipe } from 'fp-ts/function'\n *\n * assert.deepStrictEqual(\n *   pipe(\n *     [1, 2, 3],\n *     NEA.flatMap((n) => [`a${n}`, `b${n}`])\n *   ),\n *   ['a1', 'b1', 'a2', 'b2', 'a3', 'b3']\n * )\n *\n * @category sequencing\n * @since 2.14.0\n */export const flatMap=/*#__PURE__*/dual(2,(ma,f)=>pipe(ma,chainWithIndex((i,a)=>f(a,i))));/**\n * @since 2.0.0\n */export const extend=f=>as=>{let next=tail(as);const out=[f(as)];while(isNonEmpty(next)){out.push(f(next));next=tail(next)}return out};/**\n * @since 2.5.0\n */export const duplicate=/*#__PURE__*/extend(identity);/**\n * @category sequencing\n * @since 2.5.0\n */export const flatten=/*#__PURE__*/flatMap(identity);/**\n * `map` can be used to turn functions `(a: A) => B` into functions `(fa: F<A>) => F<B>` whose argument and return types\n * use the type constructor `F` to represent some computational context.\n *\n * @category mapping\n * @since 2.0.0\n */export const map=f=>mapWithIndex((_,a)=>f(a));/**\n * @category mapping\n * @since 2.0.0\n */export const mapWithIndex=f=>as=>{const out=[f(0,head(as))];for(let i=1;i<as.length;i++){out.push(f(i,as[i]))}return out};/**\n * @category folding\n * @since 2.0.0\n */export const reduce=RNEA.reduce;/**\n * @category folding\n * @since 2.0.0\n */export const reduceWithIndex=RNEA.reduceWithIndex;/**\n * @category folding\n * @since 2.0.0\n */export const reduceRight=RNEA.reduceRight;/**\n * @category folding\n * @since 2.0.0\n */export const reduceRightWithIndex=RNEA.reduceRightWithIndex;/**\n * @category traversing\n * @since 2.6.3\n */export const traverse=F=>{const traverseWithIndexF=traverseWithIndex(F);return f=>traverseWithIndexF((_,a)=>f(a))};/**\n * @category traversing\n * @since 2.6.3\n */export const sequence=F=>traverseWithIndex(F)((_,a)=>a);/**\n * @category sequencing\n * @since 2.6.3\n */export const traverseWithIndex=F=>f=>as=>{let out=F.map(f(0,head(as)),of);for(let i=1;i<as.length;i++){out=F.ap(F.map(out,bs=>b=>pipe(bs,append(b))),f(i,as[i]))}return out};/**\n * @since 2.7.0\n */export const extract=RNEA.head;/**\n * @category type lambdas\n * @since 2.0.0\n */export const URI=\"NonEmptyArray\";/**\n * @category instances\n * @since 2.0.0\n */export const getShow=RNEA.getShow;/**\n * Builds a `Semigroup` instance for `NonEmptyArray`\n *\n * @category instances\n * @since 2.0.0\n */export const getSemigroup=()=>({concat});/**\n * @example\n * import { getEq } from 'fp-ts/NonEmptyArray'\n * import * as N from 'fp-ts/number'\n *\n * const E = getEq(N.Eq)\n * assert.strictEqual(E.equals([1, 2], [1, 2]), true)\n * assert.strictEqual(E.equals([1, 2], [1, 3]), false)\n *\n * @category instances\n * @since 2.0.0\n */export const getEq=RNEA.getEq;/**\n * @since 2.11.0\n */export const getUnionSemigroup=E=>{const unionE=union(E);return{concat:(first,second)=>unionE(second)(first)}};/**\n * @category instances\n * @since 2.7.0\n */export const Functor={URI,map:_map};/**\n * @category mapping\n * @since 2.10.0\n */export const flap=/*#__PURE__*/flap_(Functor);/**\n * @category instances\n * @since 2.10.0\n */export const Pointed={URI,of};/**\n * @category instances\n * @since 2.7.0\n */export const FunctorWithIndex={URI,map:_map,mapWithIndex:_mapWithIndex};/**\n * @category instances\n * @since 2.10.0\n */export const Apply={URI,map:_map,ap:_ap};/**\n * Combine two effectful actions, keeping only the result of the first.\n *\n * @since 2.5.0\n */export const apFirst=/*#__PURE__*/apFirst_(Apply);/**\n * Combine two effectful actions, keeping only the result of the second.\n *\n * @since 2.5.0\n */export co