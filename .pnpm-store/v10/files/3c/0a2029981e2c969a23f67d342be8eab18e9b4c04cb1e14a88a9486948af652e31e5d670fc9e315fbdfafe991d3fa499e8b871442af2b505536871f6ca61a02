import * as Context from "./context"
import * as Stream from "./parser-ts/Stream"

/**
 * Represents the position of a token within the source text.
 */
export interface Pos {
  line: number
  col: number
}
/**
 * Constructs a new `Pos` given a line number and a column number.
 */
export const pos = (line: number, col: number): Pos => ({
  line,
  col,
})

/**
 * Constructs a new `Pos` given a line number and a column number.
 */
export const updatePos = (data: Pos, line: number, col: number): Pos =>
  data === initialPos
    ? pos(line, col)
    : ((data.line = line), (data.col = col), data)

export const offsetPos = (
  data: Pos,
  line: number,
  col: number,
  lineBreak: boolean,
): Pos =>
  data === initialPos
    ? pos(line + 1, col + 1)
    : offsetPosMut(data, line, col, lineBreak)

export const offsetPosMut = (
  data: Pos,
  line: number,
  col: number,
  lineBreak: boolean,
): Pos => (
  (data.line += line),
  lineBreak ? (data.col = col + 1) : (data.col += col),
  data
)

/**
 * The initial `Pos` within any source text.
 */
export const initialPos: Pos = pos(1, 1)

