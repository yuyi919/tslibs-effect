const updatePosWith = (
  ctx: Context.ParserContext,
  buffer: Stream.SeqLike<string>,
  pos: number,
  len: number,
  lineBreak: boolean,
) => {
  let col = 0,
    line = 0,
    i = pos
  while (i < len) {
    if (buffer[i] === "\n") {
      col = 0
      line++
    } else {
      col++
    }
    i++
  }
  ctx.pos = offsetPos(ctx.pos, line, col, lineBreak && line > 0)
}

export const updateWithImage = (
  image: string,
  lineBreak?: boolean,
  ctx: Context.ParserContext = Context.useContext(),
): void => {
  // ctx.pos = Pos.updatePosWithImage(image, ctx.pos, lineBreak);
  updatePosWith(ctx, image, 0, image.length, lineBreak ?? true)
  ctx.offset += image.length
}

export const updateWithCursorDiff = (
  stream: Stream.IStream<string>,
  prevCursor: number,
  cursor: number,
  ctx: Context.ParserContext = Context.useContext(),
): void => {
  const buf = Stream.getBuffer(stream)
  updatePosWith(ctx, buf, prevCursor, cursor, true)
  ctx.offset = cursor
}
