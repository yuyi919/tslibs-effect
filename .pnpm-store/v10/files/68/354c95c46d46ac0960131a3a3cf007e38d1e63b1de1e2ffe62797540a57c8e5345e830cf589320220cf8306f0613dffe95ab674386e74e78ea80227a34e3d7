 : 1;\n/**\n * @category instances\n * @since 2.0.0\n */ export const boolean = (self, that)=>self === that ? 0 : self < that ? -1 : 1;\n/**\n * @category instances\n * @since 2.0.0\n */ export const bigint = (self, that)=>self === that ? 0 : self < that ? -1 : 1;\n/**\n * @since 2.0.0\n */ export const reverse = (O)=>flip0(O);\n/**\n * @category combining\n * @since 2.0.0\n */ export const combine = dual(2, (self, that)=>(a1, a2)=>NonNullable.nullWhen(self(a1, a2), 0) ?? that(a1, a2));\n/**\n * @category combining\n * @since 2.0.0\n */ export const combineMany = dual(2, (self, collection)=>(a1, a2)=>NonNullable.nullWhen(self(a1, a2), 0) ?? NonNullable.findIterableMap(collection, (O, _)=>NonNullable.nullWhen(O(a1, a2), 0)) ?? 0);\n/**\n * @since 2.0.0\n */ export const empty = ()=>(_a, _b)=>0;\n/**\n * @category combining\n * @since 2.0.0\n */ export const combineAll = (collection)=>combineMany(empty(), collection);\n/**\n * @category mapping\n * @since 2.0.0\n */ export const mapInput = dual(2, (self, f)=>(b1, b2)=>self(f(b1), f(b2)));\n/**\n * @category instances\n * @since 2.0.0\n */ export const Date = mapInput(number, (date)=>date.getTime());\n/**\n * @category combining\n * @since 2.0.0\n */ export const product = // readonly because invariant\n// readonly because invariant\ndual(2, (self, that)=>make(([xa, xb], [ya, yb])=>NonNullable.nullWhen(self(xa, ya), 0) ?? that(xb, yb)));\n/**\n * @category combining\n * @since 2.0.0\n */ export function all(collection) {\n    return make((x, y)=>((len)=>NonNullable.findIterableMap(collection, (O, i)=>i >= len ? 0 : NonNullable.nullWhen(O(x[i], y[i]), 0)) ?? 0)(Math.min(x.length, y.length)));\n}\n/**\n * @category combining\n * @since 2.0.0\n */ export const productMany = // readonly because invariant\n// readonly because invariant\ndual(2, (self, collection)=>((O)=>make((x, y)=>((o)=>o !== 0 ? o : O(x.slice(1), y.slice(1)))(self(x[0], y[0]))))(all(collection)));\n/**\n * Similar to `Promise.all` but operates on `Order`