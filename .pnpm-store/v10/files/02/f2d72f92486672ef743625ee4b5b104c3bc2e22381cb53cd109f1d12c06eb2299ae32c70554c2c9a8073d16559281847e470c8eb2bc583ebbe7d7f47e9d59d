@genType
type t<'a> = 'a

external map: ('a, 'a => 'b) => 'b = "%revapply"

external chain: (t<'a>, 'a => t<'b>) => t<'b> = "%revapply"

external ap: (t<'a => 'b>, t<'a>) => t<'b> = "%apply"

let constant: 't => 'p => 't = a => _ => a

@inline
let mapTo: 'p. ('p, 't) => 't = (p, a) => map(p, _ => a)

@inline
let tap = (t, f) => t->map(f)->map(_ => t)

let constThis: unit => 't = %raw("function () {return this}")

let throw: 'e => unit = %raw("e => { throw e }")

let id: ('a, ~id: string=?) => 'a = (a, ~id=?) => id->ignore->map(() => a)

module type Id = {
  type t<'a>
}
module type Id2 = {
  type t<'a, 'b>
}
module type Id3 = {
  type t<'a, 'b>
}

type unsafeWrapper = {@as("_") get: 'a. unit => 'a}

module Lazy: {
  type t<'a>
  let from: (unit => 'a) => t<'a>
  let fromUnsafe: (unit => 'a) => unsafeWrapper
  let get: t<'a> => 'a
  let getUnsafe: t<'a> => 'b
} = {
  type t<'a>
  let make: (_ => 'a, _) => t<'a> = %raw("(a, b) => a(b)")
  external get: t<'a> => 'a = "%identity"
  external getUnsafe: t<'a> => 'b = "%identity"

  let from: (unit => 'a) => t<'a> = make(_, ())
  @inline
  let fromUnsafe = (f: unit => 'a): unsafeWrapper => {
    let cache = from(f)
    {get: () => cache->getUnsafe}
  }
}

module type Idx2 = {
  module Id: Id2
  let get: unit => Id.t<'a, 'b>
}

module Idx2 = (
  Id: {
    include Id2
    let make: unit => t<'a, 'b>
  },
): (Idx2 with type Id.t<'a, 'b> = Id.t<'a, 'b>) => {
  module Id = Id
  type t
  external make: (_ => Id.t<'a, 'b>, _) => Lazy.t<t> = "%apply"
  @val
  external get: unit => Id.t<'a, 'b> = "add"
}

module Id = (M: Id): {
  open TypeVar
  type t<_> = {
    @as("_") unwrap: 'a. unit => M.t<'a>,
    @as("f") map: 'a 'return. (M.t<'a> => 'return) => 'return,
  }
  let wrap: M.t<'a> => t<a>
  let from: (unit => M.t<'a>) => t<a>
} => {
  open TypeVar
  type t<_> = {
    @as("_") unwrap: 'a 'b. unit => M.t<'a>,
    @as("f") map: 'a 'b 'return. (M.t<'a> => 'return) => 'return,
  }

  let make: ('p => M.t<'a>, 'p) => Lazy.t<M.t<a>> = %raw("(f, a) => f(a)")
  external wrap: M.t<'a> => Lazy.t<M.t<a>> = "%identity"
  external get: Lazy.t<M.t<a>> => M.t<'a> = "%identity"

  @inline
  let wrap = (f: M.t<'a>): t<a> => {
    let cache = wrap(f)
    {
      unwrap: () => cache->get,
      map: f => cache->get->f,
    }
  }
  @inline
  let from = (f: unit => M.t<'a>): t<a> => {
    let cache = make(f, ())
    {
      unwrap: () => cache->get,
      map: f => cache->get->f,
    }
  }
}
module Id2 = (M: Id2): {
  open TypeVar
  type t<'ta, 'tb> = {
    @as("_") unwrap: 'a 'b. unit => M.t<'a, 'b>,
    @as("f") map: 'a 'b 'return. (M.t<'a, 'b> => 'return) => 'return,
  }
  let from: (unit => M.t<'a, 'b>) => t<a, b>
} => {
  open TypeVar
  type t<'a, 'b> = {
    @as("_") unwrap: 'a 'b. unit => M.t<'a, 'b>,
    @as("f") map: 'a 'b 'return. (M.t<'a, 'b> => 'return) => 'return,
  }

  let make: ('p => M.t<'a, 'b>, 'p) => Lazy.t<M.t<a, b>> = %raw("(f, a) => f(a)")
  external get: Lazy.t<M.t<a, b>> => M.t<'a, 'b> = "%identity"

  @inline
  let from = (f: unit => M.t<'a, 'b>): t<a, b> => {
    let cache: Lazy.t<M.t<a, b>> = make(f, ())
    {
      unwrap: () => cache->get,
      map: f => cache->get->f,
    }
  }
}
