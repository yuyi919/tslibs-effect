import type { AbortSignalLike } from "./AbortSignal"
import {
  __cancelAnimationFrame,
  __requestAnimationFrame,
  __requestIdleCallback,
  SYMBOL_ASYNC_DISPOSE,
  SYMBOL_DISPOSE,
  UNDEFINED,
} from "./internal/constant"
import * as internal from "./internal/Disposify"
import * as internalAsync from "./internal/timeout"
import { Fn } from "./Types"

export type AnyHandle = Fn<any[], any>

/**
 * @typeArg T - 通常是void
 */
export type CloseableScope<T = void> = {
  [SYMBOL_DISPOSE](): T
  [SYMBOL_ASYNC_DISPOSE](): T
}

export type DisposifyAny = Disposify<any, any>

export interface Disposify<Fn extends AnyHandle, T = never> {
  /**
   * 自定义标识
   */
  out: T
  /**
   * 释放资源
   */
  dispose: Fn
  /**
   * @alias {@link dispose}的别名
   * @internal
   */
  _: Fn
  scope: (...args: Parameters<Fn>) => CloseableScope<ReturnType<Fn>>
  /**
   * 注册{@link AbortSignal}，当`signal`被abort时自动释放资源
   * @param signal - 需要注册的`signal`，如果`signal`已经被`abort`则无效
   * @returns 是否成功注册，如果`signal`已`abort`则返回`false`
   */
  add(signal: AbortSignalLike): boolean
  /**
   * 是否已释放
   */
  isDisposed: boolean
}

export function make<Fn extends AnyHandle, T>(
  out: T,
  fn: Fn,
): Disposify<Fn, T> {
  return new internal.Disposify(fn, out)
}

export const Disposify: new <Fn extends AnyHandle, T>(
  ...args: any[]
) => Disposify<Fn, T> = internal.Disposify

/**
 *
 * @param setup
 * @param clear
 * @returns
 */
export function disposify<TArgs extends any[], T, TO extends any[], R>(
  setup: (...args: TArgs) => T,
  clear: (handle: T, ...other: TO) => R,
): (...args: TArgs) => Disposify<(...args: TO) => R, T>
export function disposify<TArgs extends any[], T, TO extends any[], R>(
  setup: (...args: TArgs) => T,
  clear: (handle: T, ...other: TO) => R,
): (...args: TArgs) => Disposify<(...args: TO) => R, T> {
  return function (this: any) {
    const handle = setup.apply(this, arguments as unknown as TArgs)
    return make(handle, (...args: TO) => clear.apply(this, [handle, ...args]))
  }
}

export function all<
  Dis extends readonly Disposify<any, any>[],
  Targs extends Dis extends Disposify<(...args: infer Arg) => any, any>[]
    ? Arg
    : [],
  TO extends Dis extends Disposify<(...args: any) => infer TR, any>[]
    ? TR
    : unknown,
>(setup: Dis): (...args: Targs) => Disposify<() => TO[], () => TO[]> {
  return disposify(
    (...args: Targs) =>
      () =>
        (setup as readonly Disposify<(...args: Targs) => TO, any>[]).map((s) =>
          s._(...args),
        ),
    (handle) => handle(),
  )
}

export function timeout<TArgs extends any[]>(
  handler: (...args: TArgs) => void,
  timeout?: number | undefined,
  ...args: TArgs
): Disposify<() => void, internalAsync.SetTimeoutHandle>
export function timeout(
  handler: (...args: any[]) => void,
  timeout?: number | undefined,
  ...args: any[]
) {
  return disposify(
    internalAsync.__setTimeout<any[]>,
    internalAsync.__clearTimeout,
  )(handler, timeout, ...args)
}

export function interval<TArgs extends any[]>(
  handler: (...args: TArgs) => void,
  timeout?: number | undefined,
  ...args: TArgs
): Disposify<() => void, internalAsync.SetTimeoutHandle>
export function interval(
  handler: (...args: any[]) => void,
  interval?: number | undefined,
  ...args: any[]
) {
  return disposify(
    internalAsync.__setInterval<any[]>,
    internalAsync.__clearInterval,
  )(handler, interval, ...args)
}

export const reqAF:
  | undefined
  | ((callback: FrameRequestCallback) => Disposify<() => void, number>) =
  __requestAnimationFrame
    ? (disposify(__requestAnimationFrame, __cancelAnimationFrame!) satisfies (
        callback: FrameRequestCallback,
      ) => Disposify<() => void, number>)
    : UNDEFINED

export const rafLoop:
  | undefined
  | ((callback: FrameRequestCallback) => Disposify<() => void, () => void>) =
  __requestAnimationFrame
    ? disposify(
        (callback) => {
          let fn: FrameRequestCallback = (time) => (
              callback(time),
              fn && (frame = __requestAnimationFrame!(fn))
            ),
            frame: number | null = __requestAnimationFrame!(fn)
          return () => (
            frame && __cancelAnimationFrame!(frame!),
            (frame = null)
          )
        },
        (dispose) => dispose(),
      )
    : UNDEFINED

export const reqIdle:
  | undefined
  | ((
      callback: IdleRequestCallback,
      options?: IdleRequestOptions,
    ) => Disposify<() => void, number>) = __requestIdleCallback
  ? disposify(__requestIdleCallback, cancelIdleCallback)
  : UNDEFINED
