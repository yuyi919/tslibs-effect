import * as Disposify from "./Disposify"
import { addEventListener } from "./dom"
import { AbortError } from "./Errors"
import { SYMBOL_ASYNC_DISPOSE, SYMBOL_DISPOSE, VOID } from "./internal/constant"
import { no, Ok, ok } from "./Ok"

export interface AbortSignalLikeEventMap extends AbortSignalEventMap {
  abort: Event
}

export interface AbortSignalLike<R = any> extends AbortSignal {
  readonly aborted: boolean
  readonly reason: R | undefined
  addEventListener<K extends keyof AbortSignalEventMap>(
    type: K,
    listener: (this: AbortSignal, ev: AbortSignalEventMap[K]) => any,
    options?: boolean | AddEventListenerOptions,
  ): void
  addEventListener(
    type: string,
    listener: EventListenerOrEventListenerObject,
    options?: boolean | AddEventListenerOptions,
  ): void
  removeEventListener<K extends keyof AbortSignalEventMap>(
    type: K,
    listener: (this: AbortSignal, ev: AbortSignalEventMap[K]) => any,
    options?: boolean | EventListenerOptions,
  ): void
  removeEventListener(
    type: string,
    listener: EventListenerOrEventListenerObject,
    options?: boolean | EventListenerOptions,
  ): void
}

export type { AbortSignalLike as T }

export function controller(): AbortController {
  return new AbortController()
}

export function make<R = any>(): readonly [
  AbortSignalLike<R>,
  (reason?: R) => void,
] {
  const ctl = controller()
  return [ctl.signal, (reason) => /* LAZY */ ctl.abort(reason)] as const
}

export function scoped<R = any>(): Disposify.CloseableScope<void> & {
  /**
   * Returns the AbortSignal object associated with this object.
   */
  readonly signal: AbortSignalLike<R>
  /**
   * Invoking this method will set this object's AbortSignal's aborted flag and signal to any observers that the associated activity is to be aborted.
   */
  abort(reason?: R): void
} {
  const [signal, abort] = make<R>()
  const dispose = () => abort()
  return {
    signal,
    abort,
    [SYMBOL_DISPOSE]: dispose,
    [SYMBOL_ASYNC_DISPOSE]: dispose,
  } as const
}

export function isAborted(signal: AbortSignalLike): boolean {
  return signal.aborted
}

/**
 *
 * @param signal - AbortSignalLike
 * @returns 可能为空的reason，但类型上是安全的
 */
export function unsafe_getReason<R>(signal: AbortSignalLike<R>): R {
  return signal.reason!
}

/**
 * 返回一个AbortError
 * @param signal - AbortSignalLike
 * @returns 
 */
export function error<R>(signal: AbortSignalLike<R>): AbortError<R> {
  return new AbortError(unsafe_getReason(signal))
}

/**
 *
 * @param signal - AbortSignalLike
 * @returns 返回{@link Ok|Ok<R, void>}
 */
export function getReason<R>(signal: AbortSignalLike<R>): Ok<R, void> {
  return isAborted(signal) ? no(VOID) : ok(unsafe_getReason(signal))
}

/**
 * 为signal添加abort监听函数
 * @param signal - {@link AbortSignalLike}
 * @param cb - abort事件监听，回调参数为{@link AbortSignalLike.reason|AbortSignalLike<R>.reason}
 */
export function onAbort<A>(
  signal: AbortSignalLike<A>,
  cb: (reason: A | undefined) => void,
): void {
  addEventListener(signal, "abort", () => cb(signal.reason), {
    once: true,
  })
}

export function onAbortIfAlive<A>(
  signal: AbortSignalLike<A>,
  cb: (reason: A | undefined) => void,
): boolean {
  return isAborted(signal) ? false : (onAbort(signal, cb), true)
}
