EY_RETURN} ${content}`\nexport const newFunction = <F extends Function>(\n  content: string,\n  args: string[],\n) => new FUNCTION(...args, content) as F\nexport const ENABLE_EVALFUNCTION = tryCatch(\n  () => !!pure(Return(\"1\"), []),\n  (_) => false,\n)\n\nexport const pure0 = <F extends Function>(content: string): F =>\n  pure(content, []) as F\nexport const pureStrict = (content: string, args: string[]): Function =>\n  pure(\"'use strict';\" + content, args)\n\nexport const prop = (data: string, name: string | number) =>\n  data + (isStr(name) ? `.${name}` : `[${name}]`)\n\n/**\n * @internal\n * 不安全的函数\n */\nexport const tmpl = (tmpl: TemplateStringsArray, ...args: any[]) =>\n  tmpl\n    .flatMap((item, i) => (i === 0 ? [item] : [args[i - 1], item]))\n    .map((item) => (isArr(item) ? item.join(\"\") : item))\n    .join(\"\")\n\nexport const AnonymousFunc = (\n  args: readonly string[],\n  body: readonly (string | readonly string[])[],\n) => Func(\"\", args, body)\nexport const ArrowFunc = (\n  args: readonly string[],\n  body: string | readonly (string | readonly string[])[],\n) =>\n  isStr(body)\n    ? `(${args})=>${body}`\n    : `(${args})=>{\\n  ${body.flat(1).join(\"\\n  \")}\\n}`\nexport const Tuple = (args: readonly string[]) => `[${args}]`\n\nexport const Func = (\n  name: string,\n  args: readonly string[],\n  body: readonly (string | readonly string[])[],\n) => `${__KEY_FUNC} ${name}(${args}){\\n  ${body.flat(1).join(\"\\n  \")}\\n}`\n\nexport type ArgString<F extends readonly any[]> = Extract<\n  {\n    [K in keyof F]: string | number\n  },\n  any[]\n>\nexport type Fns<F extends readonly any[]> = {\n  [K in keyof F]: F[K] extends (...args: any[]) => any\n    ? (...args: ArgString<Parameters<F[K]>>) => string\n    : string\n}\n\n/**\n * @internal\n * 不安全的函数\n */\nexport function makeReturnArrowFunction<const F extends readonly any[]>(\n  deps: F,\n  contentArgs: readonly string[],\n  content: (args: readonly string[]) => (...fns: Fns<F>) => string[] | string,\n): never {\n  return make(deps, (...extend) =>\n    Return(ArrowFunc(contentArgs, content(contentArgs)(...extend))),\n  )\n}\n\n/**\n * @internal\n * 不安全的函数\n */\nexport function make<const F extends readonly any[]>(\n  args: F,\n  content: (...fns: Fns<F>) => string,\n): never {\n  const names = args.map((_, index) => `$${(_ as any).name ?? \"arg\"}$` + index)\n  const _args = names.map((name, index) =>\n    isFn(args[index])\n      ? (...args: any[]) => `${name}(\\n  ${args.join(\",\")}\\n)`\n      : name,\n  ) as Fns<F>\n  return pure(content(..._args), names)(...args) as never\n}\n"]}