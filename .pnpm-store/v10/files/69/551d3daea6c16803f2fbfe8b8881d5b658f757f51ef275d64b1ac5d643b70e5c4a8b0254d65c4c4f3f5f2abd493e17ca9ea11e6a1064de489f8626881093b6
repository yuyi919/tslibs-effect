import type * as fp from "fp-ts"
import { Kind, Kind2, URIS, URIS2 } from "fp-ts/HKT"
import { Zero2 } from "fp-ts/Zero"

import * as core from "./core"
import { liftMap2 } from "./liftmap"

/**
 * @category instances
 * @since 0.6.0
 */
export const URI = "Parser"

/**
 * @category instances
 * @since 0.6.0
 */
export type URI = typeof URI

declare module "fp-ts/HKT" {
  interface URItoKind2<E, A> {
    [URI]: core.Parser<E, A>
  }
}

/**
 * @category instances
 * @since 0.6.7
 */
export const Functor: fp.functor.Functor2<URI> = {
  URI,
  map: core.mapF,
}

/**
 * @category instances
 * @since 0.6.7
 */
export const Apply: fp.apply.Apply2<URI> = {
  URI,
  map: core.mapF,
  ap: core.apF,
}

/**
 * @category instances
 * @since 0.6.7
 */
export const Applicative: fp.applicative.Applicative2<URI> = {
  URI,
  map: core.mapF,
  ap: core.apF,
  of: core.of,
}

/**
 * @category instances
 * @since 0.6.7
 */
export const Monad: fp.monad.Monad2<URI> = {
  URI,
  map: core.mapF,
  ap: core.apF,
  of: core.of,
  chain: core.chainF,
}

/**
 * @category instances
 * @since 0.6.7
 */
export const getMonad2C = <I>() => Monad as fp.monad.Monad2C<URI, I>

/**
 * @category instances
 * @since 0.6.11
 */
export const ChainRec: fp.chainRec.ChainRec2<URI> = {
  URI,
  map: core.mapF,
  ap: core.apF,
  chain: core.chainF,
  chainRec: core.chainRecF,
}

/**
 * @category instances
 * @since 0.6.7
 */
export const Alt: fp.alt.Alt2<URI> = {
  URI,
  map: core.mapF,
  alt: core.altF,
}

/**
 * @category instances
 * @since 0.6.7
 */
export const Alternative: fp.alternative.Alternative2<URI> = {
  URI,
  map: core.mapF,
  of: core.of,
  ap: core.apF,
  alt: core.altF,
  zero: core.fail,
}

/**
 * @category instances
 * @since 0.6.7
 */
export const Zero: Zero2<URI> = {
  URI,
  zero: core.fail,
}

/**
 * @category instances
 * @since 0.6.7
 */
export const parser: fp.monad.Monad2<URI> & fp.alternative.Alternative2<URI> = {
  URI,
  map: core.mapF,
  of: core.of,
  ap: core.apF,
  chain: core.chainF,
  alt: core.altF,
  zero: core.fail,
}

/**
 * @category instances
 * @since 0.6.7
 */
export const getSemigroup: <I, A>(
  S: fp.semigroup.Semigroup<A>,
) => fp.semigroup.Semigroup<core.Parser<I, A>> = (semigroup) => ({
  concat: (x, y) => liftMap2(x, y, semigroup.concat),
})

/**
 * @category instances
 * @since 0.6.0
 */
export const getMonoid: <I, A>(
  monoid: fp.monoid.Monoid<A>,
) => fp.monoid.Monoid<core.Parser<I, A>> = (monoid) => ({
  ...getSemigroup(monoid),
  empty: core.of(monoid.empty),
})

export function getApplyF<URI extends URIS2>(
  M: fp.apply.Apply2<URI>,
): <I, E, A, B>(
  fab: core.Parser<I, Kind2<URI, E, (a: A) => B>>,
  fa: core.Parser<I, Kind2<URI, E, A>>,
) => core.Parser<I, Kind2<URI, E, B>>
export function getApplyF<URI extends URIS>(
  M: fp.apply.Apply1<URI>,
): <I, A, B>(
  fab: core.Parser<I, Kind<URI, (a: A) => B>>,
  fa: core.Parser<I, Kind<URI, A>>,
) => core.Parser<I, Kind<URI, B>>
export function getApplyF(M: any) {
  return (fab: any, fa: any): any => liftMap2(fab, fa, M.ap)
}
