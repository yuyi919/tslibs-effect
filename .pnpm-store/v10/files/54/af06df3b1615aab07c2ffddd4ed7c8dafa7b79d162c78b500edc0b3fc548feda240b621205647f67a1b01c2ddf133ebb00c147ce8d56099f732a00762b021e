export const _compose = <A, B, C>(
  mab: P.Parser<B, C>,
  ma: P.Parser<A, B>,
): P.Parser<A, C> =>
  P.define((i, option) =>
    pipe(
      P._run(ma, i, option),
      PR.chain((b, r) =>
        pipe(P._run(mab, Stream.from(b, 0), option), PR.switchStream(r)),
      ),
    ),
  )

export const compose: <C, A>(
  ea: P.Parser<C, A>,
) => <B>(ab: P.Parser<A, B>) => P.Parser<C, B> = (ca) => (ab) =>
  _compose(ab, ca)

export const Semigroupoid: SGOID.Semigroupoid2<P.URI> = {
  URI: P.URI,
  compose: _compose,
}

