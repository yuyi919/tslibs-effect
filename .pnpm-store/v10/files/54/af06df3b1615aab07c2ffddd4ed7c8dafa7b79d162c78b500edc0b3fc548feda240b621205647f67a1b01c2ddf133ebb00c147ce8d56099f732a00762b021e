type ParserResultValue<P, I> = P extends P.Parser<I, infer A> ? A : never
type ParserResultValues<I, P extends NEA.NonEmptyArray<P.Parser<I, any>>> = {
  [K in Exclude<keyof P, keyof Array<any>>]: [
    string,
    ParserResultValue<P[K], any>,
  ]
}[Exclude<keyof P, keyof Array<any>>][1]

export function alts<
  I,
  const Ps extends [P.Parser<I, any>, ...P.Parser<I, any>[]],
>(
  ...parser: Ps & NEA.NonEmptyArray<P.Parser<I, ParserResultValues<I, Ps>>>
): P.Parser<I, ParserResultValues<I, Ps>>
export function alts<
  I,
  const Ps extends [P.Parser<I, unknown>, ...P.Parser<I, unknown>[]],
>(
  ...parser: Ps & NEA.NonEmptyArray<P.Parser<I, ParserResultValues<I, Ps>>>
): P.Parser<I, ParserResultValues<I, Ps>> {
  return altAll(parser)
}

export const altAll = <I, const PS extends NEA.NonEmptyArray<P.Parser<I, any>>>(
  parser: PS & NEA.NonEmptyArray<P.Parser<I, any>>,
): P.Parser<I, ParserResultValues<I, PS>> =>
  parser.length === 1
    ? parser[0]
    : P.define((input: Stream.IStream<I>, option) => {
        const parsers = parser
        const cur = Stream.unsafeGet(input)
        const errs: PR.ParseError<I>[] = []
        if (Stream.isStringStream(input))
          for (let i = 0; i < parsers.length; ++i) {
            const hints = parsers[i]!._START_CHARS_HINT?.[cur as string]
            if (
              !hints ||
              Stream.matchNext(
                input,
                hints as unknown as Stream.SeqLike<string>,
              )
            ) {
              const e = P._run(parsers[i]!, input, option)
              if (PR.isRight(e) || PR.isFatal(e)) return e
              if (option.collectError) errs[i] = e
            }
          }
        else
          for (let i = 0; i < parsers.length; ++i) {
            const e = P._run(parsers[i]!, input, option)
            if (PR.isRight(e) || PR.isFatal(e)) return e
            if (option.collectError) errs[i] = e
          }
        return errs.length === 0
          ? PR.failed(input, PR.EMPTY_EXPECTED, false)
          : errs.reduce(PR.extend)
      })

export const withTimer =
  (label: string, warmup = false) =>
  <I, A>(parser: P.Parser<I, A>): P.Parser<I, A> =>
    P.define((i, option) => {
      warmup && P._run(parser, i, option)
      console.time(label)
      const r = P._run(parser, i, option)
      console.timeEnd(label)
      return r
    })

export const altAllLazy = <I, A>(
  ...parsers: NEA.NonEmptyArray<() => P.Parser<I, A>>
): P.Parser<I, A> => {
  let parser: P.Parser<I, A> | undefined = undefined
  return P.define((input: Stream.IStream<I>, option): PR.ParseResult<I, A> => {
    if (!parser)
      parser = alts(
        ...(NEA.Functor.map(parsers, (parser) => parser()) as [
          P.Parser<I, A>,
          ...P.Parser<I, A>[],
        ]),
      )
    return P._run(parser, input, option)
  })
}

export const withCursor: <I, A>(
  perser: P.Parser<I, A>,
) => P.Parser<I, [A, Stream.IStream<I>]> = (parser) =>
  P.mapTraceF(parser, (result, input) => [result, input])

export function lazy<I, T>(parser: () => P.Parser<I, T>): P.Parser<I, T> {
  return ((memoried: P.Parser<I, T> | null) =>
    P.define((i: Stream.IStream<I>, option) =>
      P._run((memoried ??= parser()), i, option),
    ))(null)
}

export const castArray = <I, T>(parser: P.Parser<I, T>, allowNil?: boolean) =>
  P.mapF(parser, (a) => (allowNil || isNotNil(a) ? [a] : [a]))

export const chainConcat = <T>(
  i: () => P.Parser<string, T[]>,
  allowNil?: boolean,
): ((a: P.Parser<string, T[]>) => P.Parser<string, T[]>) =>
  allowNil
    ? P.chain((r) => P.mapF(i(), (e) => (r.push(...e), r)))
    : P.chain((r) =>
        P.mapF(i(), (e) => {
          forEach(e, (a) => isNotNil(a) && r.push(a))
          return r
        }),
      )

type Exsist<T> = Exclude<T, void | undefined | null>

export function chainAndPush<T, T2>(
  i: (result: T2[]) => P.Parser<string, T>,
  allowNil?: false,
): (a: P.Parser<string, T2[]>) => P.Parser<string, Exsist<T | T2>[]>
export function chainAndPush<T, T2>(
  i: (result: T2[]) => P.Parser<string, T>,
  allowNil: true,
): (a: P.Parser<string, T2[]>) => P.Parser<string, (T | T2)[]>
export function chainAndPush<T, T2>(
  i: (result: T2[]) => P.Parser<string, T>,
  allowNil?: boolean,
): (a: P.Parser<string, T2[]>) => P.Parser<string, (T | T2)[]> {
  return P.chain((a) =>
    P.mapF(i(a), (b) => (allowNil || isNotNil(b) ? a.push(b as any) : a, a)),
  )
}

export function apPush<T, T2>(
  i: P.Parser<string, T>,
  allowNil?: false,
): (a: P.Parser<string, T2[]>) => P.Parser<string, Exsist<T | T2>[]>
export function apPush<T, T2>(
  i: P.Parser<string, T>,
  allowNil: true,
): (a: P.Parser<string, T2[]>) => P.Parser<string, (T | T2)[]>
export function apPush<T, T2>(
  i: P.Parser<string, T>,
  allowNil?: boolean,
): (a: P.Parser<string, T2[]>) => P.Parser<string, (T | T2)[]> {
  return (fa) =>
    P.liftMap2(
      fa,
      i,
      (a, b) => (allowNil || isNotNil(b) ? a.push(b as any) : a, a),
    )
}

export function apConcat<T, T2>(
  i: P.Parser<string, T[]>,
  allowNil?: false,
): (a: P.Parser<string, T2[]>) => P.Parser<string, Exsist<T | T2>[]>
export function apConcat<T, T2>(
  i: P.Parser<string, T[]>,
  allowNil: true,
): (a: P.Parser<string, T2[]>) => P.Parser<string, (T | T2)[]>
export function apConcat<T, T2>(
  i: P.Parser<string, T[]>,
  allowNil?: boolean,
): (a: P.Parser<string, T2[]>) => P.Parser<string, (T | T2)[]> {
  return (fa) =>
    P.liftMap2(
      fa,
      i,
      (a, b) => (allowNil || isNotNil(b) ? (a as (T | T2)[]).push(...b) : a, a),
    )
}

