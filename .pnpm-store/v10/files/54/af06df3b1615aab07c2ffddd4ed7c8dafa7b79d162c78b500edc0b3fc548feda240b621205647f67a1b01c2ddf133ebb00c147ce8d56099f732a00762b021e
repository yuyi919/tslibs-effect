export const concatTuple = <T2>(
  i: () => P.Parser<string, T2>,
): (<T>(a: P.Parser<string, T>) => P.Parser<string, [T, T2]>) =>
  P.chain((r) => P.mapF(i(), (e) => [r, e]))

export const tryChainOr: <I, A, B, C>(
  fa: P.Parser<I, A>,
  f: (a: A, pr: PR.ParseResult<I, A>) => P.Parser<I, B>,
  or: (a: A) => C,
) => P.Parser<I, B | C> = (fa, f, altResult) =>
  P.define((i, option) => {
    const self_ = P._run(fa, i, option)
    if (PR.isRight(self_)) {
      const second = P._run(
        f(PR.getValue(self_), self_),
        PR.getNext(self_),
        option,
      )
      return PR.isRight(second) || PR.isFatal(second)
        ? second
        : PR.succeed(altResult(PR.getValue(self_)), PR.getNext(self_), i)
    }
    return self_
  })

/**
 * 在第一项解析完成后尝试解析后续内容，如果失败则退回第一项的结果
 * @param main
 * @param tryChain
 * @returns
 */
export const _tryChain: <I, A, B>(
  main: P.Parser<I, A>,
  tryChain: (a: A, pr: PR.ParseResult<I, A>) => P.Parser<I, A | B>,
) => P.Parser<I, A | B> = (fa, f) =>
  P.define((i, option) => {
    const main = P._run(fa, i, option)
    if (PR.isRight(main)) {
      const second = P._run(
        f(PR.getValue(main), main),
        PR.getNext(main),
        option,
      )
      return PR.isRight(second) || PR.isFatal(second) ? second : main
    }
    return main
  })

/**
 * 在解析完成后尝试继续解析，如果失败则退回第一项的结果
 * @param tryChain
 * @returns
 */
export function tryChain<I, A, B>(
  f: (a: A, pr: PR.ParseResult<I, A>) => P.Parser<I, A | B>,
): (main: P.Parser<I, A>) => P.Parser<I, A | B> {
  return (main) => _tryChain(main, f)
}

/**
 * 在解析完成后尝试继续解析(使用alts)，如果失败则退回第一项的结果
 * @param main
 * @param tryChains
 * @returns
 */
export const tryChainAlts: <I, A>(
  main: P.Parser<I, A>,
  tryChains: ((a: A, pr: PR.ParseResult<I, A>) => P.Parser<I, A>)[],
) => P.Parser<I, A> = (fa, fs) =>
  P.define((start, option) => {
    const self_ = P._run(fa, start, option)
    let res: PR.ParseResult<any, any> = self_
    if (PR.isRight(self_)) {
      for (let i = 0; i < fs.length; ++i) {
        const second = P._run(
          fs[i]!(PR.getValue(self_), self_),
          PR.getNext(self_),
          option,
        )
        if (PR.isRight(second) || PR.isFatal(second)) {
          res = second
          break
        }
      }
    }
    // eslint-disable-next-line no-labels
    match: while (PR.isRight(res)) {
      let curRes!: PR.ParseResult<any, any>
      // 进行一轮匹配
      for (let i = 0; i < fs.length; ++i) {
        curRes = P._run(fs[i]!(PR.getValue(res), res), PR.getNext(res), option)
        if (PR.isRight(curRes)) {
          res = curRes
          // eslint-disable-next-line no-continue, no-labels
          continue match // 成功时就继续匹配操作符
        } else if (PR.isFatal(curRes)) {
          // eslint-disable-next-line no-labels
          break match // 失败时退出操作符匹配流程
        }
        // 匹配错误就继续
      }
      if (PR.isLeft(curRes)) break
      else res = curRes
    }
    return res
  })

