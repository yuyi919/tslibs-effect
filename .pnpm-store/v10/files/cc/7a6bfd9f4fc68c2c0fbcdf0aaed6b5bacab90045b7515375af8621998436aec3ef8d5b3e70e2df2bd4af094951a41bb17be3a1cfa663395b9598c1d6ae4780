ray<A>, B>,\n): B | undefined\nexport function find<A>(\n  self: RA<A>,\n  f: EachFn<Array<A>, unknown>,\n): A | undefined\nexport function find<A>(self: RA<A>, f: any): A | undefined {\n  return self.find(f)\n}\n\nexport function findLast<A, B extends A>(\n  self: RA<A>,\n  f: EachRefinement<RA<A>, B>,\n): B | undefined\nexport function findLast<A>(\n  self: RA<A>,\n  f: EachFn<Array<A>, unknown>,\n): A | undefined\nexport function findLast<A>(self: RA<A>, f: any): A | undefined {\n  return self.findLast(f)\n}\n\n/**\n * @remark check {@link ReadonlyArray.every}\n */\nexport function every<A, B extends A>(\n  self: NEA<A>,\n  f: EachRefinement<NEA<A>, B>,\n): self is NEA<B>\nexport function every<A, B extends A>(\n  self: RNEA<A>,\n  f: EachRefinement<RNEA<A>, B>,\n): self is RNEA<B>\nexport function every<A, B extends A>(\n  self: Array<A>,\n  f: EachRefinement<Array<A>, B>,\n): self is Array<B>\nexport function every<A, B extends A>(\n  self: RA<A>,\n  f: EachRefinement<RA<A>, B>,\n): self is RA<B>\nexport function every<A>(self: Array<A>, f: EachFn<Array<A>, unknown>): boolean\nexport function every<A>(self: RA<A>, f: EachFn<RA<A>, unknown>): boolean\nexport function every<Arr extends RA<any>>(self: Arr, f: any): boolean {\n  return helper.every(self, f)\n}\n\nexport function refineEvery<A, B extends A>(\n  f: EachRefinement<RA<A>, B>,\n): {\n  (self: ReadonlyArray<A>): self is ReadonlyArray<B>\n}\nexport function refineEvery<A, B extends A>(\n  f: EachFn<RA<A>, unknown>,\n): (self: RA<A>) => boolean\nexport function refineEvery(f: any): any {\n  return (self: any[]) => every(self, f)\n}\n\n// findLast([[]] as (number | string)[][], refineEvery(isNum))?.map((a) => a + 1)\n// findLast([[]] as (number[] | string[])[], refineEvery(isNum))?.map((a) => a + 1)\n// let i1 = [[0]] as Array<RNEA<number | string>>\n// let t2 = every(i1, refineEvery(isStr)) && forEach(i1, (a) => a)\n\n/**\n * @remark check {@link ReadonlyArray.indexOf}\n */\nexport function indexOf<A>(\n  self: RA<A>,\n  searchElement: A,\n  fromIndex?: number | undefined,\n): number {\n  return self.indexOf(searchElement, fromIndex)\n}\n\n/**\n * @remark check {@link ReadonlyArray.lastIndexOf}\n */\nexport function lastIndexOf<A>(\n  self: RA<A>,\n  searchElement: A,\n  fromIndex?: number | undefined,\n): number {\n  return self.lastIndexOf(searchElement, fromIndex)\n}\n\n/**\n * @remark check {@link Array.splice}\n */\nexport function splice<A>(\n  self: Array<A>,\n  startIndex: number,\n  deleteCount: number,\n  ...insertItems: A[]\n): A[]\nexport function splice<A>(\n  self: Array<A>,\n  startIndex: number,\n  deleteCount?: number,\n): A[]\nexport function splice<A>(\n  self: Array<A>,\n  startIndex: number,\n  ...others: [deleteCount: number, ...insertItems: A[]] | [deleteCount?: number]\n): A[] {\n  return self.splice(startIndex, ...(others as [deleteCount?: number]))\n}\n\n/**\n * @remark check {@link ReadonlyArray.toSpliced}\n */\nexport function toSpliced<A>(\n  self: Array<A>,\n  startIndex: number,\n  deleteCount: number,\n  ...insertItems: A[]\n): A[]\nexport function toSpliced<A>(\n  self: Array<A>,\n  startIndex: number,\n  deleteCount?: number,\n): A[]\nexport function toSpliced<A>(\n  self: RA<A>,\n  startIndex: number,\n  ...others: [deleteCount: number, ...insertItems: A[]] | [deleteCount?: number]\n): RA<A> {\n  return self.toSpliced(startIndex, ...(others as [deleteCount?: number]))\n}\n\n/**\n * @remark check {@link Array.splice}\n */\nexport function removeElement<A>(\n  self: Array<A>,\n  startIndex: number,\n  deleteCount: number = 1,\n) {\n  return splice(self, startIndex, deleteCount)\n}\n\n/**\n *\n * @param self - array\n * @param searchElement - see {@link Array.indexOf}\n * @param fromIndex - (DEFAULT: 0) see {@link Array.indexOf}\n * @param deleteCount - (DEFAULT: 1) see {@link Array.slice}\n * @returns succeed or fail\n */\nexport function removeElementByIndexOf<A>(\n  self: Array<A>,\n  searchElement: A,\n  fromIndex?: number,\n  deleteCount: number = 1,\n) {\n  return (\n    (fromIndex = indexOf(self, searchElement, fromIndex)) > -1 &&\n    (removeElement(self, fromIndex, deleteCount), true)\n  )\n}\n\nexport type EachFn<Arr extends ArrayLike<any>, R> = (\n  currentValue: Element<Arr>,\n  currentIndex: number,\n  array: Arr,\n) => R\n\nexport type EachRefinement<Arr extends RA<any>, R extends Element<Arr>> = {\n  (currentValue: Element<Arr>): currentValue is R\n  (\n    currentValue: Element<Arr>,\n    currentIndex: number,\n    array: Arr,\n  ): currentValue is R\n}\n\nexport type EachRefinement2<A, R extends A> = {\n  (currentValue: A): currentValue is R\n  (currentValue: A, currentIndex: number): currentValue is R\n}\n\nexport type AccumulatorFn<Arr extends readonly any[], B = Element<Arr>> = (\n  previousValue: B,\n  currentValue: Element<Arr>,\n  currentIndex: number,\n  array: Arr,\n) => B\n\n/**\n * @remark check {@link Array.reduce} or {@link ReadonlyArray.reduce}\n */\nexport function reduce<Arr extends RA<any>, B = Element<Arr>>(\n  self: Arr,\n  f: AccumulatorFn<Arr, B>,\n  initialValue: B,\n): B\nexport function reduce<Arr extends RA<any>>(\n  self: Arr,\n  f: AccumulatorFn<Arr>,\n): Arr extends RNEA<any> ? Element<Arr> : Element<Arr> | undefined\n\nexport function reduce<A, B>(\n  self: A[],\n  f: AccumulatorFn<A[], B>,\n  initialValue: B,\n): B\nexport function reduce<A>(self: NEA<A>, f: AccumulatorFn<NEA<A>, A>): A\nexport function reduce<A>(self: A[], f: AccumulatorFn<A[], A>): A | undefined\n\nexport function reduce<A, B>(\n  self: RA<A>,\n  f: AccumulatorFn<RA<A>, B>,\n  initialValue: B,\n): B\nexport function reduce<A>(self: RNEA<A>, f: AccumulatorFn<RNEA<A>, A>): A\nexport function reduce<A>(\n  self: RA<A>,\n  f: AccumulatorFn<RA<A>, A>,\n): A | undefined\nexport function reduce<A>(\n  fa: RA<A>,\n  ...args: readonly [f: any, initial?: any]\n) {\n  return fa.reduce(...args)\n}\n\n/**\n * @remark check {@link Array.reduceRight} or {@link ReadonlyArray.reduceRight}\n */\nexport function reduceRight<Arr extends RA<any>, B = Element<Arr>>(\n  self: Arr,\n  f: AccumulatorFn<Arr, B>,\n  initialValue: B,\n): B\nexport function reduceRight<Arr extends RA<any>>(\n  self: Arr,\n  f: AccumulatorFn<Arr>,\n): Arr extends RNEA<any> ? Element<Arr> : Element<Arr> | undefined\n\nexport function reduceRight<A, B>(\n  self: A[],\n  f: AccumulatorFn<A[], B>,\n  initialValue: B,\n): B\nexport function reduceRight<A>(self: NEA<A>, f: AccumulatorFn<NEA<A>, A>): A\nexport function reduceRight<A>(\n  self: A[],\n  f: AccumulatorFn<A[], A>,\n): A | undefined\n\nexport function reduceRight<A, B>(\n  self: RA<A>,\n  f: AccumulatorFn<RA<A>, B>,\n  initialValue: B,\n): B\nexport function reduceRight<A>(self: RNEA<A>, f: AccumulatorFn<RNEA<A>, A>): A\nexport function reduceRight<A>(\n  self: RA<A>,\n  f: AccumulatorFn<RA<A>, A>,\n): A | undefined\nexport function reduceRight<A>(\n  fa: RA<A> | A[],\n  ...args: readonly [f: any, initial?: any]\n) {\n  return fa.reduceRight(...args)\n}\n\n// reduceRight([1] as NEA<number>, (r, a, i, arr) => r + a)\n// reduceRight([1] as RNEA<number>, (r, a, i, arr) => r + a + \"\", \"0\")\n// reduceRight([1] as Array<number>, (r, a, i, arr) => r + a)\n// reduceRight([1] as RA<number>, (r, a, i, arr) => r + a, 0)\n\n// let arr = [1] as (string | number)[]\n// every(arr, isStr) && arr.forEach((a) => a)\n//\n\nexport function includes(\n  self: unknown[],\n  value: unknown,\n  fromIndex?: number,\n): boolean\nexport function includes(\n  self: string,\n  value: string,\n  fromIndex?: number,\n): boolean\nexport function includes(\n  self: unknown[] | string,\n  value: unknown,\n  fromIndex?: number,\n): boolean {\n  return (self as string).includes(value as string, fromIndex)\n}\n\nexport function join(self: RA<string> | TypedArray, separator?: string): string\nexport function join(self: RA, separator?: string): string\nexport function join(self: any, separator?: string): string {\n  return self.join(separator)\n}\n\nexport function filterJoin<A extends RA<string> | TypedArray>(\n  self: A,\n  predicate: EachFn<A, unknown>,\n  separator?: string,\n): string\nexport function filterJoin(\n  self: RA,\n  predicate: EachFn<RA, unknown>,\n  separator?: string,\n): string\nexport function filterJoin(\n  self: any,\n  predicate: EachFn<any, unknown>,\n  sep: string = \",\",\n): string {\n  return reduce(\n    self,\n    (r, a, i, self) => (predicate(a, i, self) ? (r ? r + sep + a : a + \"\") : r),\n    \"\",\n  )\n}\n\n/**\n * @remark check {@link Array.filter} or {@link ReadonlyArray.filter}\n */\nexport function filter<A, B extends A>(\n  self: Array<A>,\n  refinement: EachRefinement<RA<A>, B>,\n): Array<B>\nexport function filter<A>(\n  self: Array<A>,\n  predicate: EachFn<RA<A>, boolean | unknown>,\n): Array<A>\nexport function filter<A, B extends A>(\n  self: RA<A>,\n  refinement: EachRefinement<RA<A>, B>,\n): RA<B>\nexport function filter<A>(\n  self: RA<A>,\n  predicate: EachFn<RA<A>, boolean | unknown>,\n): RA<A>\nexport function filter(self: RA<any>, predicate: any) {\n  return self.filter(predicate)\n}\n\n/**\n * @remark check {@link Array.map} or {@link ReadonlyArray.map}\n */\nexport function map<Arr extends NEA<any>, B>(\n  self: Arr,\n  mapFn: EachFn<Arr, B>,\n  thisArgs?: unknown,\n): NEA<B>\nexport function map<Arr extends RA<any>, B>(\n  self: Arr,\n  mapFn: EachFn<Arr, B>,\n  thisArgs?: unknown,\n): RA<B>\nexport function map<Arr extends TypedArray, B>(\n  self: Arr,\n  mapFn: EachFn<Arr, number>,\n  thisArgs?: unknown,\n): Arr\nexport function map<A, B>(self: RA<A>, mapFn: EachFn<RA<A>, B>): RA<B>\nexport function map(\n  self: RA<any>,\n  mapFn: EachFn<any, any>,\n  thisArgs?: unknown,\n) {\n  return self.map(mapFn, thisArgs)\n}\n\nexport function isArray<T>(arg: Array<T>): arg is Array<T>\nexport function isArray<T>(arg: RA<T>): arg is RA<T>\nexport function isArray(arg: any): arg is Array<any>\nexport function isArray(arg: any): arg is any[] {\n  return IS_ARR(arg)\n}\n","import typ