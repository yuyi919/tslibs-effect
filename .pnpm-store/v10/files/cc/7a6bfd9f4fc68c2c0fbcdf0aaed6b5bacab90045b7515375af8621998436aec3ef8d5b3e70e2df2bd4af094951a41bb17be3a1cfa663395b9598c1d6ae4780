ptor: PropertyGetterDescriptor = {},\n): PropertyDescriptor {\n  return ((option) => (\n    (option.get = useThis(getter)),\n    (option.set = descriptor._set),\n    option\n  ))(fromDescriptorOptions(descriptor))\n}\n/**\n * @internal\n */\nexport function makeMethod<T extends {}, Args extends any[], ReturnValue>(\n  method: (self: T, ...args: Args) => ReturnValue,\n  descriptor?: PropertyValueDescriptor,\n): TypedPropertyDescriptor<(this: T, ...args: Args) => ReturnValue>\nexport function makeMethod(\n  method: (self: any) => any,\n  descriptor: PropertyValueDescriptor = {},\n): PropertyDescriptor {\n  return ((option) => ((option[__KEY_VALUE] = useThis(method)), option))(\n    fromDescriptorOptions(descriptor),\n  )\n}\n/**\n * @internal\n */\nexport function makeProperty<V>(\n  value: V,\n  descriptor?: PropertyValueDescriptor,\n): TypedPropertyDescriptor<V>\nexport function makeProperty(\n  value: any,\n  descriptor: PropertyValueDescriptor = {},\n): PropertyDescriptor {\n  return ((option) => (\n    ((option[__KEY_VALUE] = value),\n    (option[__KEY_WRITABLE] = descriptor?._writable ?? true)),\n    option\n  ))(fromDescriptorOptions(descriptor))\n}\n\n/**\n * @internal\n */\nexport function defineProperty<V>(\n  target: any,\n  name: string | symbol,\n  value: V,\n  descriptor?: PropertyValueDescriptor,\n): any\nexport function defineProperty<T, K extends keyof T>(\n  target: T,\n  name: K,\n  value: T[K],\n  descriptor?: PropertyValueDescriptor,\n): T\nexport function defineProperty<V, T = any>(\n  target: T,\n  name: string | symbol,\n  value: V,\n  descriptor: PropertyValueDescriptor = {},\n) {\n  return OBJ_defineProperty$(target, name, makeProperty(value, descriptor))\n}\n\n/**\n * @internal\n */\nexport function defineHiddenProperty<T>(\n  target: T,\n  name: string | symbol,\n  value: any,\n  descriptor: Omit<PropertyValueDescriptor, \"_enumerable\"> = {},\n) {\n  return defineProperty(target, name, value, {\n    _enumerable: false,\n    ...descriptor,\