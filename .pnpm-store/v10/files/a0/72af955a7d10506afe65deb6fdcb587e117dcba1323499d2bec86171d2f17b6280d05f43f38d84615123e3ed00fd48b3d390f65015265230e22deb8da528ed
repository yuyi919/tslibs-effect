{"version":3,"file":"Either.js","names":["dual","isLeft","isRight","Option","getOrThrowWith","self","onLeft","right","left","toOption","some","none","match","ma","onRight"],"sources":["src/Either.js"],"sourcesContent":["import { dual } from \"effect/Function\";\nimport { isLeft, isRight } from \"fp-ts/Either\";\nimport * as Option from \"./Option.js\";\nexport * from \"fp-ts/Either\";\n/**\n * Extracts the value of an `Either` or throws if the `Either` is `Left`.\n *\n * If a default error is sufficient for your use case and you don't need to configure the thrown error, see {@link getOrThrow}.\n *\n * @param self - The `Either` to extract the value from.\n * @param onLeft - A function that will be called if the `Either` is `Left`. It returns the error to be thrown.\n *\n * @example\n *\n * assert.deepStrictEqual(\n *   Either.getOrThrowWith(Either.right(1), () => new Error('Unexpected Left')),\n *   1\n * )\n * assert.throws(() => Either.getOrThrowWith(Either.left(\"error\"), () => new Error('Unexpected Left')))\n *\n * @category getters\n * @since 2.0.0\n */ export const getOrThrowWith = dual(2, (self, onLeft)=>{\n    if (isRight(self)) {\n        return self.right;\n    }\n    throw onLeft(self.left);\n});\nexport function toOption(self) {\n    return isRight(self) ? Option.some(self.right) : Option.none();\n}\n/**\n * @category pattern matching\n * @since 0.0.0\n */ export const match = (ma, onRight, onLeft)=>isLeft(ma) ? onLeft(ma.left) : onRight(ma.right);\n"],"mappings":"AAAA,SAASA,IAAI,QAAQ,iBAAiB;AACtC,SAASC,MAAM,EAAEC,OAAO,QAAQ,cAAc;AAC9C,OAAO,KAAKC,MAAM,MAAM,aAAa;AACrC,cAAc,cAAc;AAC5B;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AAAI,OAAO,IAAMC,cAAc,gBAAGJ,IAAI,CAAC,CAAC,EAAE,CAACK,IAAI,EAAEC,MAAM,KAAG;EACtD,IAAIJ,OAAO,CAACG,IAAI,CAAC,EAAE;IACf,OAAOA,IAAI,CAACE,KAAK;EACrB;EACA,MAAMD,MAAM,CAACD,IAAI,CAACG,IAAI,CAAC;AAC3B,CAAC,CAAC;AACF,WAAgBC,QAAQ,GAACJ,IAAI,IAClBH,OAAO,CAACG,IAAI,CAAC,GAAGF,MAAM,CAACO,IAAI,CAACL