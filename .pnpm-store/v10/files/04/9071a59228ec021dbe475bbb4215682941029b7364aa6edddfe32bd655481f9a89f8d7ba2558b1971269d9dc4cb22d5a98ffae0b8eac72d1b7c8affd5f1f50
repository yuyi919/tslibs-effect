import { beforeEach, describe, expect, it, vi } from "vitest"

import { EventHost as Emitter, EventHandlerMap, make } from "../Event"

// import { mo } from "node:assert"

describe("mitt", () => {
  it("should accept an optional event handler map", () => {
    expect(() => make({})).not.toThrowError()
    const a = vi.fn((v: undefined) => {})
    const b = vi.fn((v: undefined) => {})
    const events = make<{ foo: undefined }>({
      foo: [a, b] as ((v: undefined) => void)[],
    })
    events.emit("foo")
    expect(a).toBeCalledTimes(1)
    expect(b).toBeCalledTimes(1)
  })
})

describe("mitt#", () => {
  const eventType = Symbol("eventType")
  type Events = {
    foo: unknown
    constructor: unknown
    FOO: unknown
    bar: unknown
    Bar: unknown
    "baz:bat!": unknown
    "baz:baT!": unknown
    Foo: unknown
    [eventType]: unknown
  }
  let events: EventHandlerMap<Events> = {} as any,
    inst: Emitter<Events>

  beforeEach(() => {
    events = {} as any
    inst = make(events)
  })

  describe("properties", () => {
    it("should expose the event handler map", () => {
      // @ts-expect-error
      expect(inst._).toBeTypeOf("object")
    })
  })

  describe("on()", () => {
    it("should be a function", () => {
      expect(inst.on).toBeFunction()
    })

    it("should register handler for new type", () => {
      const foo = () => {}
      inst.on("foo", foo)

      expect(events.foo).toEqual([foo])
    })

    it("should register handlers for any type strings", () => {
      const foo = () => {}
      inst.on("constructor", foo)

      expect(events.constructor).toEqual([foo])
    })

    it("should append handler for existing type", () => {
      const foo = () => {}
      const bar = () => {}
      inst.on("foo", foo)
      inst.on("foo", bar)

      expect(events.foo).toEqual([foo, bar])
    })

    it("should NOT normalize case", () => {
      const foo = () => {}
      inst.on("FOO", foo)
      inst.on("Bar", foo)
      inst.on("baz:baT!", foo)

      expect(events.FOO).toEqual([foo])
      expect(!!events.foo).toEqual(false)
      expect(events.Bar).toEqual([foo])
      expect(!!events.bar).toEqual(false)
      expect(events["baz:baT!"]).toEqual([foo])
    })

    it("can take symbols for event types", () => {
      const foo = () => {}
      inst.on(eventType, foo)
      expect(events[eventType]).toEqual([foo])
    })

    // Adding the same listener multiple times should register it multiple times.
    // See https://nodejs.org/api/events.html#events_emitter_on_eventname_listener
    it("should add duplicate listeners", () => {
      const foo = () => {}
      inst.on("foo", foo)
      inst.on("foo", foo)
      expect(events.foo).toEqual([foo, foo])
    })
  })

  describe("off()", () => {
    it("should be a function", () => {
      expect(inst.off).toBeFunction()
    })

    it("should remove handler for type", () => {
      const foo = () => {}
      inst.on("foo", foo)
      inst.off("foo", foo)

      expect(events.foo).toEqual([])
    })

    it("should NOT normalize case", () => {
      const foo = () => {}
      inst.on("FOO", foo)
      inst.on("Bar", foo)
      inst.on("baz:bat!", foo)

      inst.off("FOO", foo)
      inst.off("Bar", foo)
      inst.off("baz:baT!", foo)

      expect(events.FOO).toEqual([])
      expect(!!events.foo).toBe(false)
      expect(events.Bar).toEqual([])
      expect(!!events.bar).toBe(false)
      expect(events["baz:bat!"]).toHaveLength(1)
    })

    it("should remove only the first matching listener", () => {
      const foo = () => {}
      inst.on("foo", foo)
      inst.on("foo", foo)
      inst.off("foo", foo)
      expect(events.foo).toEqual([foo])
      inst.off("foo", foo)
      expect(events.foo).toEqual([])
    })

    it('off("type") should remove all handlers of the given type', () => {
      inst.on("foo", () => {})
      inst.on("foo", () => {})
      inst.on("bar", () => {})
      inst.off("foo")
      expect(events.foo).toEqual([])
      expect(events.bar).toHaveLength(1)
      inst.off("bar")
      expect(events.bar).toEqual([])
    })
  })

  describe("emit()", () => {
    it("should be a function", () => {
      expect(inst.emit).toBeFunction()
    })

    it("should invoke handler for type", () => {
      const event = { a: "b" }

      inst.on("foo", (one, two?: unknown) => {
        expect(one).toEqual(event)
        expect(two).toBe(undefined)
      })

      inst.emit("foo", event)
    })

    it("should NOT ignore case", () => {
      const onFoo = vi.fn(),
        onFOO = vi.fn()
      events.Foo = [onFoo]
      events.FOO = [onFOO]

      inst.emit("Foo", "Foo arg")
      inst.emit("FOO", "FOO arg")

      expect(onFoo).toBeCalledTimes(1)
      expect(onFoo).toBeCalledWith("Foo arg")
      expect(onFOO).toBeCalledTimes(1)
      expect(onFOO).toBeCalledWith("FOO arg")
    })

    it("should invoke * handlers", () => {
      const star = vi.fn(),
        ea = { a: "a" },
        eb = { b: "b" }

      events["*"] = [star]

      inst.emit("foo", ea)
      expect(star).toBeCalledTimes(1)
      expect(star).toBeCalledWith("foo", ea)

      star.mockReset()
      inst.emit("bar", eb)
      expect(star).toBeCalledTimes(1)
      expect(star).toBeCalledWith("bar", eb)
    })
  })
})
