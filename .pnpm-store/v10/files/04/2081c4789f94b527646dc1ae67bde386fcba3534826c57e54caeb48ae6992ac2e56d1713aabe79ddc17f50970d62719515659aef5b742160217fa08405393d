import { describe, expect, it } from "vitest"

import { compressToFactory } from "./json-compress"

describe.skip("t", () => {
  const defineString: string[] = ["undefined", "true", "false"]
  it("t", () => {
    const [factory, define] = compressToFactory(
      {
        $type: "ParserRule",
        name: "Header",
        definition: {
          $type: "Group",
          elements: [
            {
              $type: "Assignment",
              feature: "raw",
              operator: "=",
              terminal: {
                $type: "RuleCall",
                rule: {
                  $ref: "#/rules@33",
                },
                arguments: [],
              },
            },
            {
              $type: "Assignment",
              feature: "separator",
              operator: "=",
              terminal: {
                $type: "Keyword",
                value: "---",
              },
            },
            {
              $type: "RuleCall",
              rule: {
                $ref: "#/rules@57",
              },
              arguments: [],
            },
          ],
        },
        definesHiddenTokens: false,
        entry: false,
        fragment: false,
        hiddenTokens: [],
        parameters: [],
        wildcard: false,
      },
      (a) => {
        if (typeof a === "string") {
          return a.length > 0
            ? `_v_${
                defineString.includes(JSON.stringify(a))
                  ? defineString.indexOf(JSON.stringify(a))
                  : defineString.push(JSON.stringify(a)) - 1
              }`
            : JSON.stringify(a)
        }
        if (defineString.includes(a + "")) {
          return `_v_${defineString.indexOf(a + "")}`
        }
        return JSON.stringify(a)
      },
    )

    expect(factory).toMatchInlineSnapshot(`
      [
        
      "const ParserRule = (name, definesHiddenTokens, entry, fragment, hiddenTokens, parameters, wildcard, definition, dataType, inferredType, returnType) => appendDefine(_v_22, returnType)(appendDefine(_v_21, inferredType)(appendDefine(_v_20, dataType)(appendDefine(_v_19, definition)(appendDefine(_v_18, wildcard)(appendDefine(_v_17, parameters)(appendDefine(_v_16, hiddenTokens)(appendDefine(_v_15, fragment)(appendDefine(_v_14, entry)(appendDefine(_v_13, definesHiddenTokens)(appendDefine(_v_12, name)(define(_v_10, _v_11)
      )))))))))))"
      ,
        
      "const RuleCall = (rule, arguments_, cardinality) => appendDefine(_v_26, cardinality)(appendDefine(_v_25, arguments_)(appendDefine(_v_24, rule)(define(_v_10, _v_23)
      )))"
      ,
        "const $ref = ($ref) => appendDefine(_v_27, $ref)({})",
        
      "const Assignment = (feature, operator, terminal) => appendDefine(_v_31, terminal)(appendDefine(_v_30, operator)(appendDefine(_v_29, feature)(define(_v_10, _v_28)
      )))"
      ,
        
      "const Keyword = (value) => appendDefine(_v_33, value)(define(_v_10, _v_32)
      )"
      ,
        
      "const Group = (elements) => appendDefine(_v_35, elements)(define(_v_10, _v_34)
      )"
      ,
      ]
    `)
    expect(define).toMatchInlineSnapshot(
      `"ParserRule(_v_3, _v_2, _v_2, _v_2, [], [], _v_2, Group([Assignment(_v_4, _v_5, RuleCall($ref(_v_6), [], _v_0)),Assignment(_v_7, _v_5, Keyword(_v_8)),RuleCall($ref(_v_9), [], _v_0)]), _v_0, _v_0, _v_0)"`,
    )
    expect(defineString).toMatchInlineSnapshot(`
      [
        "undefined",
        "true",
        "false",
        ""Header"",
        ""raw"",
        ""="",
        ""#/rules@33"",
        ""separator"",
        ""---"",
        ""#/rules@57"",
        ""$type"",
        ""ParserRule"",
        ""name"",
        ""definesHiddenTokens"",
        ""entry"",
        ""fragment"",
        ""hiddenTokens"",
        ""parameters"",
        ""wildcard"",
        ""definition"",
        ""dataType"",
        ""inferredType"",
        ""returnType"",
        ""RuleCall"",
        ""rule"",
        ""arguments"",
        ""cardinality"",
        ""$ref"",
        ""Assignment"",
        ""feature"",
        ""operator"",
        ""terminal"",
        ""Keyword"",
        ""value"",
        ""Group"",
        ""elements"",
      ]
    `)
  })
})
