export type ExtractArguments<
  Fn extends (self: any, ...args: any[]) => any,
  T extends Parameters<Fn>[0],
> = Parameters<Fn> extends [T, ...args: infer ARGS extends any[]] ? ARGS : any[]

/**
 * 将记录对象转换为原型对象，其中函数会绑定 `this`
 * @param record 记录对象
 */
export function makeStructProto<T extends Record<PropertyKey, any>>(
  record: T,
): {
  [K in keyof T]: T[K] extends (
    self: infer This,
    ...args: infer Args
  ) => infer R
    ? (this: This, ...args: Args) => R
    : T[K]
} {
  return unsafeCoerce(
    JSObject._map(record, (propertyValue, _) =>
      isFn(propertyValue) ? useThis(propertyValue) : propertyValue,
    ),
  )
}

/**
 * 创建一个构造函数，它可以作为普通函数调用，也可以用 new 调用
 * @param fn 内部实现函数，接收 `this` 作为第一个参数
 * @param name 函数名称
 */
export function useConstructFunction<
  A extends {},
  R = any,
  Args extends readonly any[] = [],
>(
  fn: (self: A | undefined) => R,
  name: string,
): {
  (...args: Args): R
  new (...args: Args): A
}
export function useConstructFunction<
  Fn extends (self: any, ...args: any[]) => any,
  T extends Parameters<Fn>[0],
>(fn: Fn, name: string): (this: T, ...args: any[]) => ReturnType<Fn> {
  return EvalFunction.ENABLE_EVALFUNCTION
    ? (EvalFunction.pureStrict(
        EvalFunction.Return(
          `${__KEY_FUNC} ${name}(){${EvalFunction.Return(`f(this, ...${__KEY_ARGUMENTS})`)} }`,
        ),
        ["f"],
      )(fn) as any)
    : useThis(fn)
}

/**
 * 创建一个函数，该函数将其 `arguments` 作为第一个参数传递给内部函数
 * @param fn 内部函数，接收 `arguments` 对象
 */
export const useArguments: {
  <Fn extends (...args: any[]) => any>(
    fn: (arg: IArguments & readonly [...Parameters<Fn>]) => ReturnType<Fn>,
  ): Fn
} = <Fn extends (...args: any[]) => any>(
  fn: (arg: IArguments & readonly [...Parameters<Fn>]) => ReturnType<Fn>,
): Fn =>
  function () {
    return fn(arguments as IArguments & Parameters<Fn>)
  } as Fn

const withoutNew = (name?: string) =>
  typeError(
    `Class constructor ${name ? name + " " : ""}cannot be invoked without 'new'`,
  )

/**
 * 获取当前函数的调用者（callee）
 */
export const getCallee: () => IArguments["callee"] = useArguments<
  () => IArguments["callee"]
>((_) => _.callee)

/**
 * 判断当前环境是否处于严格模式
 */
export const isStrictMode: boolean = !!tryCatch(getCallee, () => false)

export const OBJ_PROTO: any = getProtos(OBJECT)
/**
 * 检查一个类是否继承了其他类（除了 Object）
 * @param target 类构造函数或函数
 */
export function hasParentClass(target: TClass<any, any[]>): boolean
export function hasParentClass(target: Function): boolean
export function hasParentClass(target: TClass<any, any[]> | Function) {
  return getPrototypeOf(getProtos(target)) !== OBJ_PROTO
}

function _makeClassWith(proto: any, ctor: any): TClass<any, any[]> {
  return (
    hasParentClass(ctor) && JSObject.ownKeys(getProtos(ctor)).length > 0
      ? JSObject.defineProperties(
          getProtos(ctor),
          JSObject.getOwnPropertyDescriptors(proto),
        )
      : setProtos(ctor, proto),
    ctor
  )
}
/**
 * 创建一个类，将其原型设置为指定的 proto 对象
 * 可以通过传递 proto 和 ctor，或者先传递 ctor 再传递 proto 来使用
 * @param protoOrCtor 原型对象或构造函数
 * @param ctor 可选的构造函数
 */
export function makeClassWith<Proto extends {}, Args extends any[]>(
  ctor: (this: Proto, ...args: Args) => void,
): (proto: ThisParameterType<Proto> & Proto) => TClass<Proto, Args>
export function makeClassWith<Args extends any[]>(
  ctor: (this: Record<PropertyKey, any>, ...args: Args) => void,
): <Proto extends {}>(proto: Proto) => TClass<Proto, Args>
export function makeClassWith<Proto extends {}, Args extends any[]>(
  proto: ThisParameterType<Proto> & Proto,
  ctor: (this: Proto, ...args: Args) => void,
): TClass<Proto, Args>
export function makeClassWith(
  protoOrCtor: any,
  ctor?: any,
): TClass<any, any[]> | ((proto: any) => TClass<any, any[]>) {
  return ctor
    ? _makeClassWith(protoOrCtor, ctor)
    : (proto: any) => _makeClassWith(proto, protoOrCtor)
}

/**
 * 创建一个抽象类，将其原型设置为指定的 proto 对象
 * 可以通过传递 proto 和 ctor，或者先传递 ctor 再传递 proto 来使用
 * @param protoOrCtor 原型对象或构造函数
 * @param ctor 可选的构造函数
 */
export function makeProtoWith<Proto extends {}, Args extends any[]>(
  ctor: (this: Proto, ...args: Args) => void,
): (proto: ThisParameterType<Proto> & Proto) => AbstractClass<Proto, Args>
export function makeProtoWith<Proto extends {}, Args extends any[]>(
  proto: ThisParameterType<Proto> & Proto,
  ctor: (this: Proto, ...args: Args) => void,
): AbstractClass<Proto, Args>
export function makeProtoWith(
  protoOrCtor: any,
  ctor?: any,
): AbstractClass<any, any[]> | ((proto: any) => AbstractClass<any, any[]>) {
  return makeClassWith(protoOrCtor, ctor)
}

/**
 * 创建一个抽象类，并将其原型设置为指定的 proto 对象
 * @param proto 原型对象
 */
export const makeProto = <Proto extends {}>(
  proto: ThisParameterType<Proto> & Proto,
): AbstractClass<Proto> =>
  makeProtoWith(
    proto,
    useThis((self: any) =>
      self === UNDEFINED || self === globalThis
        ? isStrictMode
          ? raise(withoutNew(self))
          : { ...proto }
        : UNDEFINED,
    ),
  )
