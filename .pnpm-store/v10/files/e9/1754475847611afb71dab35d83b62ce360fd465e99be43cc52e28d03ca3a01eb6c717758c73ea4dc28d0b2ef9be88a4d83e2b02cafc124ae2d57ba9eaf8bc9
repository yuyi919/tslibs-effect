export type TClass<T, Args extends readonly any[] = any[]> = {
  new (...args: Args): T
  // (...args: Args): T
}
export type AbstractClass<
  T,
  Args extends readonly any[] = any[],
> = abstract new (...args: Args) => T

export interface AbstractClassLambda extends TypeLambda {
  readonly type: new (...args: Extract<this["In"], any[]>) => this["Target"]
}

/**
 * 为抽象类添加一个 `_tag` 属性
 * @param target 抽象类构造函数
 * @param value _tag 的值
 */
export const _TAG = <TAG, Const extends AbstractClass<any>>(
  target: Const,
  value: TAG,
): Const => withProtoPropertyValue(target, "_tag", value)

