/**
 * 为类的原型添加一个属性值
 * @param target 类构造函数
 * @param name 属性名
 * @param value 属性值
 */
export function withProtoPropertyValue<
  C extends AbstractClass<any>,
  T extends InstanceType<C>,
  K extends keyof T,
>(target: C, name: K, value: T[K]): C {
  return defineProtoValue(target, name, value, {
    _enumerable: true,
  })
}

/**
 * 在类的原型上执行一个函数
 * @param target 类构造函数
 * @param f 要执行的函数，参数为类的原型
 */
export function withProtoF<
  C extends AbstractClass<any>,
  T extends InstanceType<C>,
>(target: C, f: (self: T) => void): void {
  return f(getProtos(target))
}

