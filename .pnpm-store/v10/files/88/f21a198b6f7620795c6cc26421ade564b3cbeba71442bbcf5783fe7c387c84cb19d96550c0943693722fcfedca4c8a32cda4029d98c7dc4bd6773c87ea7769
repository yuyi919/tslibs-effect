import * as assert from "node:assert"
import { describe, expect, it } from "vitest"

import * as S from "./Stream"

describe("Stream", () => {
  it("from", () => {
    expect(S.from([])).toEqual(S.stream([], 0))
    expect(S.from("")).toEqual(S.stream("", 0))
  })

  it("getAndNext", () => {
    getAndNext("   foo", S.ConsumeMode.Next, 0, " ")
    getAndNext("   foo", S.ConsumeMode.IgnoreWhitespace, 3, "f")
    getAndNext("foo", S.ConsumeMode.IgnoreWhitespace, 0, "f")
    getAndNext("   foo", S.ConsumeMode.IgnoreSpace, 3, "f")
    getAndNext(" \t foo", S.ConsumeMode.IgnoreSpace, 3, "f")
    getAndNext(" \t\nfoo", S.ConsumeMode.IgnoreWhitespace, 3, "f")
    getAndNext(" \r\nfoo", S.ConsumeMode.IgnoreWhitespace, 3, "f")
    getAndNext("  \nfoo", S.ConsumeMode.IgnoreSpace, 2, "\n")
    getAndNext(" \r\nfoo", S.ConsumeMode.IgnoreSpace, 1, "\r")
    function getAndNext(
      raw: string,
      mode: S.ConsumeMode,
      cur: number,
      a = raw[cur],
    ) {
      return assert.deepEqual(
        S.getAndNext(S.fromString(raw, 0), mode),
        S.ResolveSuccess(a, S.fromString(raw, cur + 1)),
      )
    }
  })

  it("skipUntil", () => {
    skipUntil("   foo", S.ConsumeMode.Next, 0, " ")
    skipUntil("   foo", S.ConsumeMode.IgnoreWhitespace, 3, "f")
    skipUntil("   foo", S.ConsumeMode.IgnoreSpace, 3, "f")
    skipUntil(" \t foo", S.ConsumeMode.IgnoreSpace, 3, "f")
    skipUntil(" \t\nfoo", S.ConsumeMode.IgnoreWhitespace, 3, "f")
    skipUntil(" \r\nfoo", S.ConsumeMode.IgnoreWhitespace, 3, "f")
    skipUntil("  \nfoo", S.ConsumeMode.IgnoreSpace, 2, "\n")
    skipUntil(" \r\nfoo", S.ConsumeMode.IgnoreSpace, 1, "\r")
    function skipUntil(
      raw: string,
      mode: S.ConsumeMode,
      cur: number,
      next: string,
    ) {
      assert.deepEqual(
        S.resolveNext(S.fromString(raw, 0), mode),
        S.fromString(raw, cur),
      )
      assert.strictEqual(raw[cur], next)
    }
  })
})
