// Duration
import * as Duration from "./Duration"
import { PresetExtensions } from "./Extensions"
import { ignore } from "./Functions"
import * as Hash from "./Hash"
import { isEquals } from "./internal/caml-obj"
import * as constant from "./internal/constant"
import { stringify4 } from "./internal/stringifyCircular"
import * as JsTypes from "./JsTypes"
// Option
import * as Option from "./Option"
import * as Proto from "./Proto"
import { EqualSymbol, HashSymbol, NodeInspectSymbol } from "./Symbol"

export interface DurationPresetExtensions extends PresetExtensions {}
declare module "./Duration" {
  interface Duration extends DurationPresetExtensions {}
}
export const DurationPresetExtensions: DurationPresetExtensions = {
  [HashSymbol](this: Duration.Duration) {
    return Hash.cached(this, Hash.hash(this.A))
  },
  [EqualSymbol](this: Duration.Duration, that: unknown): boolean {
    return Duration.isDuration(that) && Duration.Equivalence(this, that)
  },
  toString(this: Duration.Duration) {
    return Duration.$Duration + `(${Duration.toDurationString(this)})`
  },
  toJSON(this: Duration.Duration) {
    const { A: value } = this
    if (value === Duration.infinityValue) {
      return { _id: Duration.$Duration, _tag: "Infinity" }
    } else if (JsTypes.isNum(value)) {
      return { _id: Duration.$Duration, _tag: "Millis", millis: value }
    } else {
      return {
        _id: Duration.$Duration,
        _tag: "Nanos",
        hrtime: Duration.toHrTime(this),
      }
    }
  },
  [NodeInspectSymbol]() {
    return this.toJSON()
  },
}

export function addDurationPreset(): void {
  Duration.addExtensions(DurationPresetExtensions)
}

export interface OptionPresetExtensions<T> extends PresetExtensions {}

declare module "./Option" {
  interface OptionExtensions<T> extends OptionPresetExtensions<T> {
    toJSON(this: SomeValue<T>): OptionJsonSome<T>
    toJSON(this: NoneValue): OptionJsonNone
    toJSON(this: Option<T>): OptionJson<T>
  }
}

const HashSome: number = Hash.$tag(Option.$SOME)
const HashNone: number = Hash.$structureEntries(
  Hash.$tag(Option.$NONE),
  Hash.$value(constant.UNDEFINED),
)

/**
 * @internal
 */
export const OptionPresetExtensions: OptionPresetExtensions<any> =
  Proto.makeStructProto({
    [NodeInspectSymbol]: (
      self: Option.Option<any>,
      depth: number,
      inspectOptions: import("node:util").InspectOptions,
      inspect: typeof import("node:util").inspect,
    ) =>
      Option.print(self, (o) =>
        inspect(o, { ...inspectOptions, depth: depth - 1 }),
      ),

    toString: (self: Option.Option<any>) =>
      Option.print(self, (o) => stringify4(o)),

    [EqualSymbol]: (self: Option.Option<any>, target: unknown) =>
      Option.equals(self, target, (a, b) => isEquals(a, b)),
    [HashSymbol]: (self: Option.Option<any>) =>
      self.E ? Hash.$structureEntries(HashSome, Hash.$value(self.A)) : HashNone,
    toJSON: (self: Option.Option<any>): Option.OptionJson<any> =>
      Option.toJSON(self),
  })

export function addOptionPreset(): void {
  return ignore(Option.addExtensions(OptionPresetExtensions))
}

export function addAllPreset(): void {
  addOptionPreset()
  addDurationPreset()
}
