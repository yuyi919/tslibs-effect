/**
 * 常用类型集合。
 *
 * @since 2.0.0
 * @en A collection of commonly used types.
 * @module
 */

/**
 * 一个接受类型 `A` 的值并返回布尔值的函数，用于指示该值是否满足特定条件。
 * @typeParam A - 输入值的类型。
 * @since 0.0.0
 * @public
 * @en A function that takes a value of type `A` and returns a boolean, indicating whether the value satisfies a certain condition.
 */
export type Predicate<in A> = (a: A) => boolean

/**
 * 一个函数，如果条件满足，它将输入 `A` 的类型细化为更具体的子类型 `B`。它充当类型守卫。
 * @typeParam A - 输入类型。
 * @typeParam B - 细化后的输出类型，必须是 `A` 的子类型。
 * @since 0.0.0
 * @en A function that refines the type of its input `A` to a more specific subtype `B` if the condition is met. It acts as a type guard.
 */
export type Refinement<in A, out B extends A> = (a: A) => a is B

/**
 * `Predicate` 类型的类型级工具。
 *
 * @since 3.6.0
 * @category type-level
 * @en Type-level utilities for `Predicate` types.
 */
export declare namespace Predicate {
  /**
   * 从 `Predicate<A>` 中提取输入类型 `A`。
   *
   * @typeParam T - 要提取的 `Predicate` 类型。
   * @since 3.6.0
   * @category type-level
   * @en Extracts the input type `A` from a `Predicate<A>`.
   */
  export type In<T extends Any> = [T] extends [Predicate<infer _A>] ? _A : never
  /**
   * 表示任何 `Predicate` 类型。
   *
   * @since 3.6.0
   * @category type-level
   * @en Represents any `Predicate` type.
   */
  export type Any = Predicate<any>
}

/**
 * `Refinement` 类型的类型级工具。
 *
 * @since 3.6.0
 * @category type-level
 * @en Type-level utilities for `Refinement` types.
 */
export declare namespace Refinement {
  /**
   * 从 `Refinement<A, B>` 中提取输入类型 `A`。
   *
   * @typeParam T - 要提取的 `Refinement` 类型。
   * @since 3.6.0
   * @category type-level
   * @en Extracts the input type `A` from a `Refinement<A, B>`.
   */
  export type In<T extends Any> = [T] extends [Refinement<infer _A, infer _>]
    ? _A
    : never
  /**
   * 从 `Refinement<A, B>` 中提取细化后的输出类型 `B`。
   *
   * @typeParam T - 要提取的 `Refinement` 类型。
   * @since 3.6.0
   * @category type-level
   * @en Extracts the refined output type `B` from a `Refinement<A, B>`.
   */
  export type Out<T extends Any> = [T] extends [Refinement<infer _, infer _B>]
    ? _B
    : never
  /**
   * 表示任何 `Refinement` 类型。
   *
   * @since 3.6.0
   * @category type-level
   * @en Represents any `Refinement` type.
   */
  export type Any = Refinement<any, any>
}
/**
 * @internal
 * @since 3.3.0
 */
type _TupleOf<
  T,
  N extends number,
  R extends Array<unknown>,
> = R["length"] extends N ? R : _TupleOf<T, N, [T, ...R]>

/**
 * 表示一个包含固定数量 `T` 类型元素的元组。
 *
 * @typeParam N - 元组中的元素数量。
 * @typeParam T - 元组中元素的类型。
 *
 * @example
 *
 * // 一个包含 3 个数字的元组
 * const example1: TupleOf<3, number> = [1, 2, 3]; // valid
 * // @ts-expect-error
 * const example2: TupleOf<3, number> = [1, 2]; // invalid
 * // @ts-expect-error
 * const example3: TupleOf<3, number> = [1, 2, 3, 4]; // invalid
 *
 * @category tuples
 * @since 3.3.0
 * @public
 * @en Represents a tuple with a fixed number of elements of type `T`.
 */
export type TupleOf<N extends number, T> = N extends N
  ? number extends N
    ? Array<T>
    : _TupleOf<T, N, []>
  : never

/**
 * 表示一个包含至少 `N` 个 `T` 类型元素的元组。
 *
 * 此类型构造一个元组，该元组开头包含固定数量 `N` 个 `T` 类型元素，后跟任意数量（包括零个）的相同 `T` 类型附加元素。
 *
 * @typeParam N - 元组中的最小元素数量。
 * @typeParam T - 元组中元素的类型。
 *
 * @example
 *
 * // 一个包含至少 3 个数字的元组
 * const example1: TupleOfAtLeast<3, number> = [1, 2, 3]; // valid
 * const example2: TupleOfAtLeast<3, number> = [1, 2, 3, 4, 5]; // valid
 * // @ts-expect-error
 * const example3: TupleOfAtLeast<3, number> = [1, 2]; // invalid
 *
 * @category tuples
 * @since 3.3.0
 * @public
 * @en Represents a tuple with at least `N` elements of type `T`. This type constructs a tuple that has a fixed number of elements `N` of type `T` at the start, followed by any number (including zero) of additional elements of the same type `T`.
 */
export type TupleOfAtLeast<N extends number, T> = [
  ...TupleOf<N, T>,
  ...Array<T>,
]

/**
 * 从标记类型联合中提取 `_tag` 属性。
 * @typeParam E - 要提取标签的联合类型。
 * @example
 *
 * type Res = Tags<string | { _tag: "a" } | { _tag: "b" } > // "a" | "b"
 *
 * @category types
 * @since 2.0.0
 * @public
 * @en Extracts the `_tag` property from a union of tagged types.
 */
export type Tags<E> = E extends { _tag: string } ? E["_tag"] : never

/**
 * 从联合类型中排除具有特定 `_tag` 的类型。
 * @typeParam E - 要过滤的联合类型。
 * @typeParam K - 要排除的标签。
 * @example
 *
 * type Res = ExcludeTag<string | { _tag: "a" } | { _tag: "b" }, "a"> // string | { _tag: "b" }
 *
 * @category types
 * @since 2.0.0
 * @public
 * @en Excludes types with a specific `_tag` from a union.
 */
export type ExcludeTag<E, K extends Tags<E>> = Exclude<E, { _tag: K }>

/**
 * 从联合类型中提取具有特定 `_tag` 的类型。
 *
 * @typeParam E - 要过滤的联合类型。
 * @typeParam K - 要提取的标签。
 * @example
 *
 * type Res = ExtractTag<{ _tag: "a", a: number } | { _tag: "b", b: number }, "b"> // { _tag: "b", b: number }
 *
 * @category types
 * @since 2.0.0
 * @public
 * @en Extracts types with a specific `_tag` from a union.
 */
export type ExtractTag<E, K extends Tags<E>> = Extract<E, { _tag: K }>

/**
 * 将联合类型 `T` 转换为交叉类型。
 *
 * @typeParam T - 要转换的联合类型。
 * @since 2.0.0
 * @category types
 * @public
 * @en Transforms a union type `T` into an intersection type.
 */
export type UnionToIntersection<T> = (
  T extends any ? (x: T) => any : never
) extends (x: infer R) => any
  ? R
  : never

/**
 * 通过解析交叉类型并显示最终结构来简化对象类型的签名。
 *
 * @typeParam A - 要简化的类型。
 * @example
 *
 * type Res = Simplify<{ a: number } & { b: number }> // { a: number; b: number; }
 *
 * @since 2.0.0
 * @category types
 * @public
 * @en Simplifies the type signature of an object type by resolving intersections and displaying the final structure.
 */
export type Simplify<A> = { [K in keyof A]: A[K] } extends infer B ? B : never

/**
 * 判断两个类型 `X` 和 `Y` 是否完全相等。
 *
 * @typeParam X - 第一个类型。
 * @typeParam Y - 第二个类型。
 * @example
 *
 * type Res1 = Equals<{ a: number }, { a: number }> // true
 * type Res2 = Equals<{ a: number }, { b: number }> // false
 *
 * @since 2.0.0
 * @category models
 * @public
 * @en Determines if two types `X` and `Y` are exactly equal.
 */
export type Equals<X, Y> =
  (<T>() => T extends X ? 1 : 2) extends <T>() => T extends Y ? 1 : 2
    ? true
    : false

/**
 * 判断记录 `A` 是否包含给定 `Key` 中的任意一个。
 *
 * @typeParam A - 要检查的记录类型。
 * @typeParam Key - 要查找的键的联合。
 * @example
 * type Res1 = Has<{ a: number }, "a" | "b"> // true
 * type Res2 = Has<{ c: number }, "a" | "b"> // false
 *
 * @since 2.0.0
 * @category models
 * @public
 * @en Determines if a record `A` contains any of the given `Key`s.
 */
export type Has<A, Key extends string> = (
  Key extends infer K ? (K extends keyof A ? true : never) : never
) extends never
  ? false
  : true

/**
 * 合并两个对象，当键冲突时，左侧对象 (`K`) 的键优先。结果经过简化以提高可读性。
 *
 * @typeParam K - 左侧对象类型（优先级更高）。
 * @typeParam H - 右侧对象类型。
 * @example
 * type MergeLeft = MergeLeft<{ a: number, b: number; }, { a: string }> // { a: number; b: number; }
 *
 * @since 2.0.0
 * @category models
 * @public
 * @en Merges two objects where the keys of the left object (`K`) take precedence in case of a conflict. The result is simplified for better readability.
 */
export type MergeLeft<K, H> = Simplify<{
  [k in keyof K | keyof H]: k extends keyof K
    ? K[k]
    : k extends keyof H
      ? H[k]
      : never
}>

/**
 * 合并两个对象，当键冲突时，右侧对象 (`H`) 的键优先。结果经过简化以提高可读性。
 *
 * @typeParam K - 左侧对象类型。
 * @typeParam H - 右侧对象类型（优先级更高）。
 * @example
 * type MergeRight = MergeRight<{ a: number, b: number; }, { a: string }> // { a: string; b: number; }
 * @since 2.0.0
 * @category models
 * @public
 * @en Merges two objects where the keys of the right object (`H`) take precedence in case of a conflict. The result is simplified for better readability.
 */
export type MergeRight<K, H> = Simplify<{
  [k in keyof K | keyof H]: k extends keyof H
    ? H[k]
    : k extends keyof K
      ? K[k]
      : never
}>

/**
 * 合并两个类记录对象。如果发生键冲突，将使用第一个类型 (`K`) 的值。
 * @typeParam K - 第一个记录类型。
 * @typeParam H - 第二个记录类型。
 * @since 2.0.0
 * @category models
 * @public
 * @en Merges two record-like objects. In case of key conflicts, the value from the first type (`K`) is used.
 */
export type MergeRecord<K, H> = {
  [k in keyof K | keyof H]: k extends keyof K
    ? K[k]
    : k extends keyof H
      ? H[k]
      : never
} extends infer X
  ? X
  : never

/**
 * 表示一个类型 `T`，该类型也可能为 `null` 或 `undefined`。
 * @typeParam T - 基本类型。
 * @public
 * @en Represents a type `T` that can be null or undefined.
 */
export type Nilable<T> = T | null | undefined

/**
 * 从对象类型 `T` 中提取所有可能的值类型。
 * @typeParam T - 对象类型。
 * @public
 * @en Extracts all possible value types from an object type `T`.
 */
export type ValueOf<T> = T[keyof T]

/**
 * 一个 `string` 类型，可以与 `string` 字面量类型动态联合而不会合并。
 * @public
 * @example
 * type Literals = 'true' | 'false' | DynamicString
 * @en A `string` type that can be dynamically united with `string` literal types without merging.
 */
export type DynamicString = string & {}

/**
 * 一个 `number` 类型，可以与 `number` 字面量类型动态联合而不会合并。
 * @public
 * @example
 * type Literals = 0 | 1 | DynamicNumber
 * @en A `number` type that can be dynamically united with `number` literal types without merging.
 */
export type DynamicNumber = number & {}

/**
 * 表示原始类型，该类型也可以是 `null` 或 `undefined`。
 * @public
 * @en Represents a primitive type, which can also be null or undefined.
 */
export type Primitive = NotNilPrimitive | null | undefined

/**
 * 表示非空且非 undefined 的原始类型。
 * @public
 * @en Represents a non-null and non-undefined primitive type.
 */
export type NotNilPrimitive = string | number | boolean | symbol

/**
 * 一个简化的 `Record` 类型定义，默认键为 `string`。
 * @typeParam T - 记录中值的类型（默认为 `any`）。
 * @typeParam Key - 记录中键的类型（默认为 `string`）。
 * @public
 * @en A simplified definition for a `Record` type, defaulting to `string` keys.
 */
export type Recordable<
  T extends any = any,
  Key extends string | number | symbol = string,
> = Record<Key, T>

/**
 * 表示一个返回 `Promise` 的函数。
 * @typeParam Args - 函数的参数。
 * @typeParam R - `Promise` 解析后的值类型。
 * @public
 * @en Represents a function that returns a `Promise`.
 */
export type PromiseFn<Args extends any[] = any, R = any> = (
  ...arg: Args
) => Promise<R>

/**
 * `ThenableValue` 的别名。从 `PromiseLike` 类型中提取解析后的值类型。
 * @typeParam T - `PromiseLike` 类型。
 * @public
 * @en An alias for `ThenableValue`. Extracts the resolved value type from a `PromiseLike` type.
 */
export type PromiseValue<T> = ThenableValue<T>

/**
 * 从 `PromiseLike` (Thenable) 类型中提取解析后的值类型。
 * @typeParam T - 要提取的 `PromiseLike` 类型。
 * @public
 * @en Extracts the resolved value type from a `PromiseLike` (Thenable) type.
 */
export type ThenableValue<T> = T extends PromiseLike<infer V> ? V : never

/**
 * 表示一个包装值类型，它可以是直接值、带 `value` 属性的对象，或者返回值的函数。它也包含 `null` 和 `undefined`。
 * @typeParam T - 底层值类型。
 * @typeParam GetterArgs - Getter 函数预期的参数，如果适用。
 * @public
 * @en Represents a wrapped value type, which can be a direct value, an object with a `value` property, or a function that returns the value. It also includes `null` and `undefined`.
 */
export type WrapValue<T = any, GetterArgs extends any[] = []> =
  | ((...args: GetterArgs) => T | null | undefined)
  | { value?: T | null | undefined }
  | T
  | null
  | undefined

export type Fn<Args extends readonly any[] = any[], R = any> = (
  ...args: Args
) => R

export type {
  EsModuleLike,
  EsModuleLikeWithDefault,
  RecordWithKey,
  RecordWithOptionalKey,
} from "@yuyi919/shared-types"

/**
 * 交换对象的key和value类型
 * @beta
 * @example
 * ```ts
 * type Source = {
 *  A: string;
 *  B: 2;
 * };
 * type Result = TReverseKV<Source>; // => { 1: "A"; 2: "B"; }
 * ```
 */
export type ReverseKV<
  Source extends Record<string, any>,
  Keys extends keyof Source = keyof Source,
> = {
  [ValueKey in Source[Keys]]: Extract<
    { [Key in Keys]: [Source[Key], Key] }[Keys],
    [ValueKey, any]
  >[1]
}
