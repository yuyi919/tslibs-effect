import { Simplify } from "effect/Types"

import {
  getOwnPropertyDescriptors,
  JsObject,
  JsObjectKey,
  JsPropertyKey,
} from "@yuyi919/shared-proto/JsObject"
import {
  makeGetter,
  makeMethod,
  makeProperty,
  PropertyGetterDescriptor,
} from "@yuyi919/shared-proto/Proto"
import Types from "@yuyi919/shared-types"

import { ENTRIES, OBJ_defineProperties$ } from "./constant"
import { dual } from "./helper"

export type Factory<T extends Record<any, any>> = {
  _entries: {
    readonly [K in JsObjectKey<T>]: [T[K], TypedPropertyDescriptor<T[K]>]
  }[JsObjectKey<T>]
  _obj: {
    readonly [K in JsObjectKey<T>]: TypedPropertyDescriptor<T[K]>
  }
}
export type AnyFactory = {
  _entries: (readonly [JsPropertyKey, PropertyDescriptor])[]
  _obj: Record<JsPropertyKey, PropertyDescriptor>
}
export type ProtoResolver<T extends Factory<any>> =
  T extends Factory<infer O> ? O : never

export const zero: Factory<{}> = {
  _entries: [],
  _obj: {},
} as Factory<{}>

export function from<T extends {}>(t: T) {
  return define(getOwnPropertyDescriptors(t))
}
export function define<T extends {}>(proterties: {
  readonly [K in JsObjectKey<T>]: TypedPropertyDescriptor<T[K]>
}): Factory<T>
export function define<T extends {}>(proterties: JsObject<PropertyDescriptor>) {
  return makeFactory(proterties, ENTRIES(proterties)) as Factory<T>
}
function makeFactory<T extends {}>(
  _obj: AnyFactory["_obj"],
  _entries: AnyFactory["_entries"],
) {
  return { _obj, _entries } as Factory<T>
}
export function type<T extends {}>() {
  return zero as unknown as Factory<T>
}

export function append<T extends Factory<any>, K extends JsPropertyKey, V>(
  m: Factory<T>,
  k: K,
  v: TypedPropertyDescriptor<V>,
  isMethod: 0 | 1,
): Factory<(T extends Record<K, unknown> ? Omit<T, K> : T) & Record<K, V>>
export function append<T extends Factory<any>, K extends JsPropertyKey, V>(
  k: K,
  v: TypedPropertyDescriptor<V>,
  isMethod: 0 | 1,
): (m: T) => Factory<Simplify<Omit<ProtoResolver<T>, K> & Record<K, V>> & {}>
export function append(...args: [any, any, any] | [any, any, any, any]) {
  return dual(
    4,
    (m: AnyFactory, k: JsPropertyKey, v: PropertyDescriptor, isMethod: 0 | 1) =>
      makeFactory({ ...m._obj, [k]: v }, [...m._entries, [k, v]]) as AnyFactory,
  )(...(args as [any, any, ...any]))
}

export function appendRecord(...args: [any] | [any, any]) {
  return dual(
    2,
    (m: AnyFactory, m2: AnyFactory["_obj"]) =>
      makeFactory({ ...m._obj, ...m2 }, [
        ...m._entries,
        ...ENTRIES(m2),
      ]) as AnyFactory,
  )(...(args as [any, any, ...any]))
}

export function property<T extends Factory<any>, K extends JsPropertyKey, V>(
  key: K,
  value: V,
  descriptor?: PropertyGetterDescriptor,
) {
  return (m: T) =>
    append(m, key, makeProperty(value, descriptor), 0) as unknown as Factory<
      Simplify<Omit<ProtoResolver<T>, K> & Record<K, V>> & {}
    >
}
export function propertyWith<
  T extends Factory<any>,
  K extends JsPropertyKey,
  V,
>(key: K, value: (self: T) => V, descriptor?: PropertyGetterDescriptor) {
  return (m: T) =>
    append(m, key, makeProperty(value(m), descriptor), 1) as unknown as Factory<
      Simplify<Omit<ProtoResolver<T>, K> & Record<K, V>> & {}
    >
}

export function getter<
  T extends Factory<any>,
  K extends keyof ProtoResolver<T>,
>(
  key: K,
  get: (self: ProtoResolver<T>) => ProtoResolver<T>[K],
  descriptor?: PropertyGetterDescriptor,
): (factory: T) => T
export function getter<T extends Factory<any>, K extends JsPropertyKey, V>(
  key: K,
  get: (self: ProtoResolver<T>) => V,
  descriptor?: PropertyGetterDescriptor,
): (
  factory: T,
) => Factory<Simplify<Omit<ProtoResolver<T>, K> & Record<K, V>> & {}>
export function getter<T extends Factory<any>, K extends JsPropertyKey, V>(
  key: K,
  getter: (self: ProtoResolver<T>) => V,
  descriptor?: PropertyGetterDescriptor,
) {
  return append(key, makeGetter(getter, descriptor), 0) as (
    factory: T,
  ) => Factory<Simplify<Omit<ProtoResolver<T>, K> & Record<K, V>> & {}>
}

export function raw<
  T extends Factory<any>,
  Raw extends Record<JsPropertyKey, any>,
>(
  raws: ThisType<ProtoResolver<T>> & Raw,
): (
  factory: T,
) => Factory<Simplify<Omit<ProtoResolver<T>, keyof Raw> & Raw> & {}>
export function raw<
  T extends Factory<any>,
  Raw extends Record<JsPropertyKey, any>,
>(raws: ThisType<ProtoResolver<T>> & Raw) {
  return appendRecord(getOwnPropertyDescriptors(raws)) as (
    factory: T,
  ) => Factory<Simplify<Omit<ProtoResolver<T>, keyof Raw> & Raw> & {}>
}

export function method<
  T extends Factory<any>,
  K extends keyof ProtoResolver<T>,
  M extends ProtoResolver<T>[K],
>(
  key: K,
  method: (self: ProtoResolver<T>, ...args: Parameters<M>) => ReturnType<M>,
  descriptor?: PropertyGetterDescriptor,
): (factory: T) => T
export function method<
  T extends Factory<any>,
  K extends JsPropertyKey,
  Args extends any[],
  V,
>(
  key: K,
  method: (self: ProtoResolver<T>, ...args: Args) => V,
  descriptor?: PropertyGetterDescriptor,
): (
  factory: T,
) => Factory<
  Simplify<Omit<ProtoResolver<T>, K> & Record<K, (...args: Args) => V>> & {}
>
export function method<
  T extends Factory<any>,
  K extends JsPropertyKey,
  Args extends any[],
  V,
>(
  key: K,
  method: (self: ProtoResolver<T>, ...args: Args) => V,
  descriptor?: PropertyGetterDescriptor,
): (
  factory: T,
) => Factory<
  Simplify<Omit<ProtoResolver<T>, K> & Record<K, (...args: Args) => V>> & {}
> {
  return append(key, makeMethod(method, descriptor), 1) as (
    m: T,
  ) => Factory<
    Simplify<Omit<ProtoResolver<T>, K> & Record<K, (...args: Args) => V>> & {}
  >
}

export function impl<
  T extends Factory<any>,
  K extends Extract<
    keyof ProtoResolver<T>,
    {
      [K in keyof ProtoResolver<T>]: ProtoResolver<T>[K] extends Types.Function.Base
        ? K
        : never
    }[keyof ProtoResolver<T>]
  >,
>(
  key: K,
  overload: (
    self: ProtoResolver<T>,
    ...args: Parameters<ProtoResolver<T>[K]>
  ) => ReturnType<ProtoResolver<T>[K]>,
  descriptor?: PropertyGetterDescriptor,
) {
  return method(key, overload, descriptor)
}

export function make<M extends Factory<any>>(m: M): Simplify<ProtoResolver<M>>
export function make(m: Factory<any>): any {
  return OBJ_defineProperties$({}, m._obj)
}
