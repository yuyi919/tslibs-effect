@genType.as("ElementIdentifier") @genType.import("@piress/Text/shared") @unboxed
type identifier = ElementIdentifier(int)

@genType.as("ElementIdentifierList") @genType.import("@piress/Text/shared") @unboxed
type elementIds = ElementIdentifiers(array<identifier>)

@genType.as("CompressedElementIdentifiers") @genType.import("@piress/Text/shared") @unboxed
type compressedIdentifiers = CompressedCharIdentifiers(array<identifier>)

