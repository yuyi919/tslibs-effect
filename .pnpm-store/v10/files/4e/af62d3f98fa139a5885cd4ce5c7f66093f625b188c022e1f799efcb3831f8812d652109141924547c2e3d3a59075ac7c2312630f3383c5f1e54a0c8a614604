import * as Option from "./Option"

// Option2.gen(function* () {})

export function addOptionSnapshotSerializer(expect: {
  addSnapshotSerializer: (arg0: {
    serialize(
      val: any,
      config: any,
      indentation: any,
      depth: any,
      refs: any,
      printer: any,
    ): string
    test: (value: unknown) => boolean
  }) => void
}): void {
  expect.addSnapshotSerializer({
    serialize(val, config, indentation, depth, refs, printer) {
      return Option.print(val, (val) =>
        printer(val, config, indentation, depth, refs),
      )
    },
    test: Option.isOptionValue,
  })
}
