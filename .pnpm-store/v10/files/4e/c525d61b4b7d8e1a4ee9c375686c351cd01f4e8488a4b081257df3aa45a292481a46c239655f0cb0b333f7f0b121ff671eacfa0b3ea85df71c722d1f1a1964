import { isFn } from "@yuyi919/shared-proto/JsTypes"

import { hasWindow } from "./Browser"
import { Nilable } from "./Types"

export type EventTargetLike<K = any, E = any, R = any> = {
  addEventListener: (
    name: K,
    listener: (e: E) => any,
    options?: boolean | AddEventListenerOptions | undefined,
  ) => R
  removeEventListener: (
    name: K,
    listener: (e: E) => any,
    options?: boolean | EventListenerOptions | undefined,
  ) => any
}
export function addEventListener<
  Events extends Record<string, any>,
  K extends keyof Events,
>(
  element: EventTargetLike<K, Events[K]>,
  name: K,
  listener: (e: Events[K]) => any,
  options?: boolean | AddEventListenerOptions | undefined,
): any
export function addEventListener<K extends keyof DocumentEventMap>(
  element: typeof document,
  name: K,
  listener: (e: DocumentEventMap[K]) => any,
  options?: boolean | AddEventListenerOptions | undefined,
): any
export function addEventListener<K extends keyof WindowEventMap>(
  element: typeof window,
  name: K,
  listener: (e: WindowEventMap[K]) => any,
  options?: boolean | AddEventListenerOptions | undefined,
): any
export function addEventListener<K extends keyof HTMLElementEventMap>(
  element: HTMLElement | typeof window | typeof document,
  name: K,
  listener: (e: HTMLElementEventMap[K]) => any,
  options?: boolean | AddEventListenerOptions | undefined,
): any
export function addEventListener<K extends keyof AbortSignalEventMap>(
  element: AbortSignal,
  name: K,
  listener: (e: AbortSignalEventMap[K]) => any,
  options?: boolean | AddEventListenerOptions | undefined,
): any
export function addEventListener(
  target: EventTarget,
  name: string,
  listener: EventListenerOrEventListenerObject,
  options?: boolean | AddEventListenerOptions | undefined,
): any
export function addEventListener(
  target: EventTargetLike,
  name: any,
  listener: any,
  options?: any,
) {
  return target.addEventListener(name, listener, options)
}

export function removeEventListener(
  target: EventTargetLike,
  name: string,
  listener: (e: any) => any,
  options?: boolean | EventListenerOptions | undefined,
): void {
  return target.removeEventListener(name, listener, options)
}

type TargetType = HTMLElement | Element | Window | Document

export type BasicTarget<T extends TargetType = Element> =
  | (() => Nilable<T>)
  | Nilable<T>
  | { current: Nilable<T> }

export function getTargetElement<T extends TargetType>(
  target: BasicTarget<T>,
  defaultElement?: T,
): Nilable<T> {
  if (!hasWindow) {
    return undefined
  }

  if (!target) {
    return defaultElement
  }

  let targetElement: Nilable<T>

  if (isFn(target)) {
    targetElement = target()
  } else if ("current" in target) {
    targetElement = target.current
  } else {
    targetElement = target
  }

  return targetElement
}
