{"version":3,"sources":["../esm/src/Chain.js"],"names":["chainFirst","M","tapM","tap","f","first","chain","a","map","bind","name","ma","b","Object","assign"],"mappings":";;AAWG,IAAgBA,CAAWC,CAAAA,CAAAA,EAAE,CAAC,IAAMC,CAAKC,CAAAA,CAAAA,CAAIF,CAAC,CAAA,CAAE,OAAOG,CAAAA,EAAGC,CAAOH,EAAAA,CAAAA,CAAKG,CAAMD,CAAAA,CAAC,CAAC,CAAA,CAAiCD,CAAIF,CAAAA,CAAAA,EAAS,CAACI,CAAAA,CAAMD,CAAIH,GAAAA,CAAAA,CAAEK,KAAMD,CAAAA,CAAAA,CAAME,CAAGN,EAAAA,CAAAA,CAAEO,GAAIJ,CAAAA,CAAAA,CAAEG,CAAC,CAAE,CAAA,IAAIA,CAAC,CAAC,CAAkBE,CAAAA,CAAAA,CAAKR,CAAS,EAAA,CAACS,CAAKN,CAAAA,CAAAA,GAAIO,CAAIV,EAAAA,CAAAA,CAAEK,KAAMK,CAAAA,CAAAA,CAAGJ,CAAGN,EAAAA,CAAAA,CAAEO,GAAIJ,CAAAA,CAAAA,CAAEG,CAAC,CAAA,CAAEK,CAAGC,EAAAA,MAAAA,CAAOC,MAAO,CAAA,EAAGP,CAAAA,CAAAA,CAAE,CAAC,CAACG,CAAI,EAAEE,CAAC,CAAC,CAAC,CAAC","file":"Chain.js","sourcesContent":["/**\n * The `Chain` type class extends the `Apply` type class with a `chain` operation which composes computations in\n * sequence, using the return value of one computation to determine the next computation.\n *\n * Instances must satisfy the following law in addition to the `Apply` laws:\n *\n * 1. Associativity: `F.chain(F.chain(fa, afb), bfc) <-> F.chain(fa, a => F.chain(afb(a), bfc))`\n *\n * Note. `Apply`'s `ap` can be derived: `(fab, fa) => F.chain(fab, f => F.map(fa, f))`\n *\n * @since 2.0.0\n */export function chainFirst(M){const tapM=tap(M);return f=>first=>tapM(first,f)}/** @internal */export function tap(M){return(first,f)=>M.chain(first,a=>M.map(f(a),()=>a))}export function bind(M){return(name,f)=>ma=>M.chain(ma,a=>M.map(f(a),b=>Object.assign({},a,{[name]:b})))}"]}