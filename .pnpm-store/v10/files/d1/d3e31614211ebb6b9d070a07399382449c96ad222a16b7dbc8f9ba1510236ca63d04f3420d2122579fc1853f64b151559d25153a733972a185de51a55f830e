let filterMap = (arr, f) => {
  let l = length(arr)
  let r = makeUninitializedUnsafe(l)
  let j = ref(0)
  for i in 0 to l - 1 {
    switch arr->getUnsafe(i)->f {
    | None => ()
    | Some(v) =>
      setUnsafe(r, j.contents, v)
      j.contents = j.contents + 1
    }
  }
  truncateToLengthUnsafe(r, j.contents)
  r
}

let keepSome = filterMap(_, x => x)

let findMap = (arr, f) => {
  let rec loop = i =>
    if i == arr->length {
      None
    } else {
      switch arr->getUnsafe(i)->f {
      | Some(_) as r => r
      | None => loop(i + 1)
      }
    }

  loop(0)
}

@inline
let atN = (arr, i) =>
  switch i {
  | _ if i < 0 => arr->getUnsafe(arr->length + i)
  | _ => arr->getUnsafe(i)
  }


@inline
let atCyclic = (xs, i) =>
  length(xs)->Identity.map(len =>
    len === 0
      ? invalid_arg("StdArray.atCyclic: arrays.length == 0")
      : xs->getUnsafe(
          switch i {
          | 0 => 0
          | _ if i < 0 => (len + i->I32.mod(len))->I32.mod(len)
          | _ => i->I32.mod(len)
          },
        )
  )

@inline
let atLast = (arr, i) => arr->getUnsafe(arr->length - i + 1)

@inline
let last = a => a->get(a->lastIndex)
