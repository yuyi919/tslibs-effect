@send external joinUnsafe: array<'a> => string = "join"
@send external join: array<string> => string = "join"
@send external joinWithUnsafe: (array<'a>, string) => string = "join"
@send external joinWith: (array<string>, string) => string = "join"

let make = (~length, x) => length <= 0 ? [] : makeUninitializedUnsafe(length)->fillAll(x)

let unsafe_fromInitializer = (~length, f) => {
  let arr = makeUninitializedUnsafe(length)
  for i in 0 to length - 1 {
    arr->setUnsafe(i, f(i))
  }
  arr
}

let fromInitializer = (~length, f) =>
  if length <= 0 {
    []
  } else {
    unsafe_fromInitializer(~length, f)
  }

@inline
let lastIndex = a => a->length - 1

let rec equalFromIndex = (fa, fb, i, eq, len) =>
  i === len
    ? true
    : eq(fa->getUnsafe(i), fb->getUnsafe(i)) && equalFromIndex(fa, fb, i + 1, eq, len)

let equal: (array<'a>, array<'b>, ('a, 'b) => bool) => bool = (fa, fb, eq) =>
  length(fa)->Identity.map(len => len === length(fb) && equalFromIndex(fa, fb, 0, eq, len))

let equalFromIndex: (array<'a>, array<'b>, ('a, 'b) => bool, ~start: int) => bool = (
  fa,
  fb,
  eq,
  ~start,
) => length(fa)->Identity.map(len => len === length(fb) && equalFromIndex(fa, fb, start, eq, len))

let rec compareFromIndex = (a, b, i, cmp, len) =>
  i === len
    ? COrdering.equal
    : cmp(a->getUnsafe(i), b->getUnsafe(i))->Identity.map(c =>
        c == COrdering.equal ? compareFromIndex(a, b, i + 1, cmp, len) : c
      )

let compare = (a, b, cmp) =>
  length(a)
  ->Identity.map(lenA => (lenA, COrdering.compareInt(lenA, b->length)))
  ->Identity.map(((lenA, c)) =>
    c === COrdering.Equal ? compareFromIndex(a, b, 0, cmp, lenA) : COrdering.Equal
  )

