//   P.method("pipe", (self, ...args: any[]) => pipeArguments(self, args)),
//   P.method("tapSelf", (self, ...args: any[]) => (pipeArguments(self, args), self)),
//   P.getter("|>", (self) => self.pipe),
//   P.output
// )
export const PipeableProto: Pipeable = {
  pipe: useThis((self: Pipeable, ...args: any[]) => pipeArguments(self, args)),
  tapSelf: useThis(
    (self: Pipeable, ...args: any[]) => (pipeArguments(self, args), self),
  ),
  get "|>"() {
    return this.pipe
  },
}

export const Pipeable = makeProto<Pipeable>(PipeableProto) as AbstractClass<
  Pipeable,
  []
>

/**
 * @since 2.0.0
 */
export function pipeArguments<A>(self: A, args: IArguments): unknown
export function pipeArguments<A>(
  self: A,
  args: ArrayLike<(arg: any) => any>,
): unknown
export function pipeArguments(
  self: any,
  args: IArguments | ArrayLike<(arg: any) => any>,
  length = len(args),
): unknown {
  return length === 0
    ? self
    : length === 1
      ? args[0](self)
      : length === 2
        ? args[1](args[0](self))
        : length === 3
          ? args[2](args[1](args[0](self)))
          : length === 4
            ? args[3](args[2](args[1](args[0](self))))
            : length === 5
              ? args[4](args[3](args[2](args[1](args[0](self)))))
              : pipeSlice(
                  args[5](args[4](args[3](args[2](args[1](args[0](self)))))),
                  args,
                  6,
                  length,
                )
}

const pipeSlice = (
  self: any,
  args: ArrayLike<(arg: any) => any> | IArguments,
  start: number,
  length: number,
) => {
  let ret = self,
    len = length
  for (let i = start; i < len; ++i) ret = args[i](ret)
  return ret
}
