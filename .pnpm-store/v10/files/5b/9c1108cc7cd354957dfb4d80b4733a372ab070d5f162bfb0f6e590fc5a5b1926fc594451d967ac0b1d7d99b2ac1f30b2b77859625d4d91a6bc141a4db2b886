export const pure = <A>(x: A): Eval<A> => new Now(x)
export const now: <A>(x: A) => Eval<A> = pure
export const unit: Eval<void> = now(undefined) /* defined below */
export const always = <A>(thunk: () => A): Eval<A> => new Always(thunk)
export const later = <A>(thunk: () => A): Eval<A> => new Later(thunk)
export const delay: <A>(thunk: () => A) => Eval<A> = later
export const defer = <A>(thunk: () => Eval<A>): Eval<A> => new Defer(thunk)

export function fix<A>(f: (a: Eval<A>) => Eval<A>): Eval<A>
export function fix<A>(f: (a: Eval<A>) => Eval<A>): Eval<A> {
  const a: Eval<A> = defer(() => f(a))
  return a
}

export const batch = <A>(as: Eval<A>[]): Eval<A[]> => {
  const arr = [] as A[]
  if (as.length === 0) return pure(arr)
  let head = pure(arr)
  const f = (a: A) => (arr: A[]) => (arr.push(a), arr)
  for (let i = 0; i < as.length; ++i) {
    const r = head
    head = as[i]!._chain((a) => r.then(f(a)))
  }
  return head
}
export const batchWith = <T, A>(
  as: readonly T[],
  map: (t: T) => Eval<A>,
): Eval<readonly A[]> => {
  const arr = [] as A[]
  if (as.length === 0) return pure(arr)
  let head = pure(arr)
  const f = (a: A) => (arr: A[]) => (arr.push(a), arr)
  for (let i = 0; i < as.length; ++i) {
    const r = head
    head = map(as[i]!)._chain((a) => r.then(f(a)))
  }
  return head
}

const Void: Eval<void> = unit /* defined below */
const False: Eval<boolean> = now(false) /* defined below */
const True: Eval<boolean> = now(true) /* defined below */
export { Void as void, False as false, True as true }
export const zero: Eval<number> = now(0) /* defined below */
export const one: Eval<number> = now(1) /* defined below */
export const bottom = <A = never>(): Eval<A> =>
  always<any>(() => throwError(error("Eval.bottom")))
