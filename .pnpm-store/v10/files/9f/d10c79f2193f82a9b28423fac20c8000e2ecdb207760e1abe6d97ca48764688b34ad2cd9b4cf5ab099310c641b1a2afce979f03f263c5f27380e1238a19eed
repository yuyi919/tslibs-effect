import type { Either } from "fp-ts/Either"
import type { Option } from "fp-ts/Option"
import { isLeft } from "fp-ts/Either"
import { isSome } from "fp-ts/Option"

import type { Fn, Predicate, Refinement } from "./Types"
import { unsafeCoerce } from "./Functions"
import { NEVER, UNDEFINED } from "./internal/constant"
import { tryCatch } from "./internal/helper"

/**
 * Represents an `Ok` value.
 */
export type Ok<A, E = never> =
  | { ok: true; data: A; reason: undefined }
  | { ok: false; data: undefined; reason: E }

/**
 * Represents an {@link Ok} `Promise` value.
 */
export type PromiseOk<A, E = never> = Promise<Ok<A, E>>

/**
 * Creates an `Ok` value.
 */
export function ok<A, E = never>(value: A): Ok<A, E> {
  return {
    ok: true,
    data: value,
    reason: UNDEFINED,
  }
}

/**
 * Creates a `No` value.
 */
export function no<E, A = never>(value: E): Ok<A, E> {
  return {
    ok: false,
    data: UNDEFINED,
    reason: value,
  }
}

export function tryWithOk<F extends Fn>(
  fn: F,
): <E = unknown>(...args: Parameters<F>) => Ok<ReturnType<Fn>, E> {
  return <E = unknown>(...args: Parameters<F>): Ok<ReturnType<Fn>, E> =>
    tryCatch(() => ok(fn(...args)), unsafeCoerce(no<E, ReturnType<Fn>>))
}
export function liftPredicate<A, B extends A>(
  fn: Refinement<A, B>,
): (input: A) => Ok<B, void>
export function liftPredicate<A>(fn: Predicate<A>): (input: A) => Ok<A>
export function liftPredicate<A>(fn: Predicate<A>): (input: A) => Ok<A> {
  return (input) => (fn(input) ? ok(input) : no(NEVER))
}

export function fromEither<E, A>(e: Either<E, A>): Ok<A, E> {
  return isLeft(e) ? no(e.left) : ok(e.right)
}

export function fromOption<A>(e: Option<A>): Ok<A> {
  return isSome(e) ? ok(e.value) : no(NEVER)
}
