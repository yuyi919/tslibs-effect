import { deepEqual } from "node:assert"
import { test } from "vitest"

import { parser } from "../../internal/message-pipe/parser"

test("returns simple string", () => {
  deepEqual(parser("Hello world!"), ['"Hello world!"'])
})

test("returns string with message", () => {
  deepEqual(parser("Hello {name}!"), ['"Hello "', "a.name", '"!"'])
})

test("returns empty selector + pipe", () => {
  deepEqual(parser("{|random}"), ['""', "b.random()", '""'])
  deepEqual(parser("{ | random, min: 5, max:10}"), [
    '""',
    "b.random(void 0,{min:5,max:10})",
    '""',
  ])
})

test("returns string with message and pipe", () => {
  deepEqual(parser("Hello {name | capitalize}!"), [
    '"Hello "',
    "b.capitalize(a.name)",
    '"!"',
  ])
})

test("returns string with message, pipe and arguments", () => {
  deepEqual(parser('Hello {name | capitalize, letter:"b"}!'), [
    '"Hello "',
    'b.capitalize(a.name,{letter:"b"})',
    '"!"',
  ])
})

test("returns string with message, pipe and arguments (true)", () => {
  deepEqual(parser("Hello {name | capitalize, letter}!"), [
    '"Hello "',
    "b.capitalize(a.name,{letter:true})",
    '"!"',
  ])
})

test("returns nested message selector", () => {
  deepEqual(parser("Hello {agents.{index}.name | capitalize}!"), [
    '"Hello "',
    "b.capitalize(a.agents[a.index].name)",
    '"!"',
  ])
})

test("returns nested message selector ONLY", () => {
  deepEqual(parser("Hello {{index} | capitalize}!"), [
    '"Hello "',
    "b.capitalize(a[a.index])",
    '"!"',
  ])
})

test("returns escaped selector", () => {
  deepEqual(parser("Hello \\{agents.{index}.name | capitalize\\}!"), [
    '"Hello {agents."',
    "a.index",
    '".name | capitalize}!"',
  ])
})
test("returns escaped selector", () => {
  deepEqual(
    parser("Hello {agents.{index | sub, by:1}.first_name | capitalize}!"),
    [
      '"Hello "',
      "b.capitalize(a.agents[b.sub(a.index,{by:1})].first_name)",
      '"!"',
    ],
  )
})
