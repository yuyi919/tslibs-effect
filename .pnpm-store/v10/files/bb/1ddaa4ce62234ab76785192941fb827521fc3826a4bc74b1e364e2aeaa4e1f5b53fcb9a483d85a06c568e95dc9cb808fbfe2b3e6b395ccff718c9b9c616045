/**
 * This module provides an implementation of the `Equivalence` type class, which defines a binary relation
 * that is reflexive, symmetric, and transitive. In other words, it defines a notion of equivalence between values of a certain type.
 * These properties are also known in mathematics as an "equivalence relation".
 *
 * @since 0.0.0
 */
import type { JsObject, JsObjectKey } from "./JsObject"
import type { ReadonlyRecord } from "./Record"
import * as Iterable from "./Iterable"
import { _hasOwnKey, jsObjectKeys, keys } from "./JsObject"
import * as NonNullable from "./NonNullable"

/**
 * @category type class
 * @since 0.0.0
 */
export interface Equivalence<in A> {
  (self: A, that: A): boolean
}

/**
 * @category constructors
 * @since 0.0.0
 */
export function make<A>(
  isEquivalent: (self: A, that: A) => boolean,
): Equivalence<A> {
  return (self: A, that: A): boolean =>
    self === that || isEquivalent(self, that)
}

const isStrictEquivalent = (x: unknown, y: unknown) => x === y

/**
 * Return an `Equivalence` that uses strict equality (===) to compare values.
 *
 * @since 0.0.0
 * @category constructors
 */
export const strict: <A>() => Equivalence<A> = () => isStrictEquivalent

/**
 * @category instances
 * @since 0.0.0
 */
export const string: Equivalence<string> = isStrictEquivalent

/**
 * @category instances
 * @since 0.0.0
 */
export const number: Equivalence<number> = isStrictEquivalent

/**
 * @category instances
 * @since 0.0.0
 */
export const boolean: Equivalence<boolean> = isStrictEquivalent

/**
 * @category instances
 * @since 0.0.0
 */
export const bigint: Equivalence<bigint> = isStrictEquivalent

/**
 * @category instances
 * @since 0.0.0
 */
export const symbol: Equivalence<symbol> = isStrictEquivalent

/**
 * @category combining
 * @since 0.0.0
 */
export function combine<A>(
  self: Equivalence<A>,
  that: Equivalence<A>,
): Equivalence<A> {
  return make((x, y) => self(x, y) && that(x, y))
}

/**
 * @category combining
 * @since 0.0.0
 */
export function combineMany<A>(
  self: Equivalence<A>,
  collection: Iterable<Equivalence<A>>,
): Equivalence<A> {
  return make(
    (x, y) =>
      self(x, y) &&
      Iterable.unsafe_every(collection, (equivalence) => equivalence(x, y)),
  )
}

const isAlwaysEquivalent: Equivalence<unknown> = (_x, _y) => true

/**
 * @category combining
 * @since 0.0.0
 */
export function combineAll<A>(
  collection: Iterable<Equivalence<A>>,
): Equivalence<A> {
  return combineMany(isAlwaysEquivalent, collection)
}

/**
 * @category mapping
 * @since 0.0.0
 */
export function mapInput<A, B>(
  self: Equivalence<A>,
  f: (b: B) => A,
): Equivalence<B> {
  return make((x, y) => self(f(x), f(y)))
}

/**
 * @category instances
 * @since 0.0.0
 */
export const Date: Equivalence<Date> = mapInput(number, (date) => +date)

/**
 * @category combining
 * @since 0.0.0
 */
export const product: {
  <A, B>(
    self: Equivalence<A>,
    that: Equivalence<B>,
  ): Equivalence<readonly [A, B]> // readonly because invariant
} = <A, B>(
  self: Equivalence<A>,
  that: Equivalence<B>,
): Equivalence<readonly [A, B]> =>
  make(([xa, xb], [ya, yb]) => self(xa, ya) && that(xb, yb))

/**
 * @category combining
 * @since 0.0.0
 */
export function all<A>(
  collection: Iterable<Equivalence<A>>,
): Equivalence<ReadonlyArray<A>> {
  return make((x, y) =>
    ((len) =>
      NonNullable.findIterableMap(collection, (equivalence, i) =>
        i >= len ? true : equivalence(x[i]!, y[i]!) ? null : false,
      ) ?? true)(Math.min(x.length, y.length)),
  )
}

/**
 * @category combining
 * @since 0.0.0
 */
export function productMany<A>(
  self: Equivalence<A>,
  collection: Iterable<Equivalence<A>>,
): Equivalence<readonly [A, ...Array<A>]> /* readonly because invariant */ {
  return ((equivalence) =>
    make((x, y) => self(x[0], y[0]) && equivalence(x.slice(1), y.slice(1))))(
    all(collection),
  )
}

/**
 * Similar to `Promise.all` but operates on `Equivalence`s.
 *
 * ```
 * [Equivalence<A>, Equivalence<B>, ...] -> Equivalence<[A, B, ...]>
 * ```
 *
 * Given a tuple of `Equivalence`s returns a new `Equivalence` that compares values of a tuple
 * by applying each `Equivalence` to the corresponding element of the tuple.
 *
 * @category combinators
 * @since 0.0.0
 */
export function tuple<T extends ReadonlyArray<Equivalence<any>>>(
  ...elements: T
): Equivalence<
  Readonly<{
    [I in keyof T]: [T[I]] extends [Equivalence<infer A>] ? A : never
  }>
> {
  return all(elements)
}

/**
 * Creates a new `Equivalence` for an array of values based on a given `Equivalence` for the elements of the array.
 *
 * @category combinators
 * @since 0.0.0
 */
export function array<A>(item: Equivalence<A>): Equivalence<ReadonlyArray<A>> {
  return make(
    (self, that) =>
      self.length === that.length && self.every((a, i) => item(a, that[i]!)),
  )
}

/**
 * @category combinators
 * @since 0.0.0
 */
export function recordKeys<R extends JsObject<Equivalence<any>>>(
  fields: R,
  keys: JsObjectKey<R>[],
): Equivalence<{
  readonly [K in keyof R]: [R[K]] extends [Equivalence<infer A>] ? A : never
}> {
  return make((self, that) =>
    keys.every((key) => fields[key]!(self[key], that[key])),
  )
}

/**
 * Given a struct of `Equivalence`s returns a new `Equivalence` that compares values of a struct
 * by applying each `Equivalence` to the corresponding property of the struct.
 *
 * @category combinators
 * @since 0.0.0
 */
export function struct<R extends JsObject<Equivalence<any>>>(
  fields: R,
): Equivalence<{
  readonly [K in keyof R]: [R[K]] extends [Equivalence<infer A>] ? A : never
}> {
  return recordKeys(fields, jsObjectKeys(fields))
}

/**
 * @category combinators
 * @since 0.0.0
 */
export function dict<T>(
  value: Equivalence<T>,
  fields = keys as (target: ReadonlyRecord<string, T>) => string[],
): Equivalence<ReadonlyRecord<string, T>> {
  return jsObject(value, fields)
}

/**
 * @category combinators
 * @since 0.0.0
 */
export function jsObject<T, O extends JsObject<T>>(
  value: Equivalence<T>,
  fields = jsObjectKeys as any as (target: O) => JsObjectKey<O>[],
): Equivalence<O> {
  return make((self, that) => {
    const fields1 = fields(self)
    const fields2 = fields(that)

    if (fields1.length !== fields2.length) return false
    return fields1.every(
      (key) => _hasOwnKey(that, key) && value(self[key] as T, that[key] as T),
    )
  })
}
