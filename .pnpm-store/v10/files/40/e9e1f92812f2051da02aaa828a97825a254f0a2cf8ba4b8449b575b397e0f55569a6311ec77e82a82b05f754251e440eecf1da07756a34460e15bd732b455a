import { afterEach, beforeEach, describe, expect, it, vi } from "vitest"

import * as AbortSignal from "../AbortSignal"
import { delay, timeout } from "../index"
import { delayValue } from "../Promisify"

describe("delay", () => {
  it("delay", async () => {
    expect(await delayValue(50, true)).toBe(true)
  })
})

describe("timeout", () => {
  beforeEach(() => {
    // vi.useFakeTimers()
    vi.clearAllMocks()
  })

  afterEach(() => {
    // vi.useRealTimers()
  })
  it("creates a Disposify instance with correct out and dispose", async () => {
    const handler = vi.fn()
    const disposifyInstance = timeout(handler, 100, "arg1", "arg2")

    expect(disposifyInstance.out).toBeDefined() // Timer ID should exist
    expect(typeof disposifyInstance.dispose).toBe("function")
    expect(disposifyInstance._).toBe(disposifyInstance.dispose)
    expect(disposifyInstance.isDisposed).toBe(false)

    await delay(100)
    expect(handler).toBeCalledTimes(1)
    expect(handler).toBeCalledWith("arg1", "arg2")
    disposifyInstance.dispose()
    expect(disposifyInstance.isDisposed).toBe(true)
  })

  it("supports scope with Symbol.dispose", async () => {
    const handler = vi.fn()
    const disposifyInstance = timeout(handler, 100)
    ;(() => {
      using _ = disposifyInstance.scope()
    })()
    expect(disposifyInstance.isDisposed).toBe(true)
    await delay(100)
    expect(handler).not.toHaveBeenCalled()
  })

  it("supports scope with Symbol.asyncDispose", async () => {
    const handler = vi.fn()
    const disposifyInstance = timeout(handler, 150)
    const _ = await (async () => {
      using _ = disposifyInstance.scope()
      await delay(100)
    })()
    expect(disposifyInstance.isDisposed).toBe(true)
    expect(handler).not.toHaveBeenCalled()
  })

  it("registers AbortSignal and disposes on abort", async () => {
    const handler = vi.fn()
    const disposifyInstance = timeout(handler, 150)

    const [signal, abort] = AbortSignal.make()
    const result = disposifyInstance.add(signal)
    expect(result).toBe(true)

    abort()
    expect(disposifyInstance.isDisposed).toBe(true)
    await delay(100)
    expect(handler).not.toHaveBeenCalled()
  })

  it("does not register already aborted AbortSignal", async () => {
    const handler = vi.fn()
    const disposifyInstance = timeout(handler, 100)

    const [signal, abort] = AbortSignal.make()
    abort()
    const result = disposifyInstance.add(signal)
    expect(result).toBe(false)
    expect(disposifyInstance.isDisposed).toBe(false)
    await delay(100)
    expect(handler).toHaveBeenCalled()
  })

  it("works with undefined timeout", async () => {
    const handler = vi.fn()
    const disposifyInstance = timeout(handler, undefined, "arg1")
    await delay(0) // Undefined timeout defaults to immediate execution
    expect(handler).toHaveBeenCalledWith("arg1")
    expect(disposifyInstance.out).toBeDefined()
  })
})
