export class TextStyleConfig extends Hashable.extend<
  {
    size: undefined | number
    bold: undefined | FontStyleBold
    italic: boolean
    underline: boolean
    color: undefined | NonEmptyArray<string>
  },
  TextStyleConfig
>({
  size: undefined,
  bold: undefined,
  italic: false,
  underline: false,
  color: undefined,
}) {
  _size(size: number) {
    return this._hashNum("size", size)
  }
  _bold(bold?: Exclude<FontStyleBold, FontStyleBold.Normal>) {
    return this._hashNum("bold", bold ?? FontStyleBold.Bold)
  }
  _underline(underline: boolean = true) {
    return this._hashBool("underline", underline)
  }
  _italic(italic: boolean = true) {
    return this._hashBool("italic", italic)
  }
  _color(color: NonEmptyArray<string>) {
    return this._hashArr("color", color)
  }
}
describe("hash", () => {
  it("sm", () => {
    class ABC extends Hashable.extend<
      {
        A: number | undefined
        B: string | undefined
        C: boolean | undefined
      },
      ABC
    >({
      A: undefined,
      B: undefined,
      C: false,
    }) {
      setA(size: number) {
        return this._hashNum("A", size)
      }
      setB(bold: string) {
        return this._hashStr("B", bold)
      }
      setC(underline: boolean = true) {
        return this._hashBool("C", underline)
      }
    }
    const root = ABC.init().setA(1).setC()
    expect(root).toBe(ABC.init().setC().setA(1))
    type c = HashableClass.Data<typeof ABC>
    expect(ABC.hash(root)).toBe(ABC.hash(root.get()))
  })
  it("struct", () => {
    function gen1() {
      const root = TextStyleConfig.init()
      const config = root._italic(true)
      expect(config).not.toBe(root)
      const config2 = root._underline(true)
      expect(config2).not.toBe(config)
      expect(config2).not.toBe(root)
      // console.log("TextStyleConfig", config, config2)
      //   expect(TextStyleConfig.cache.size).toBe(3)
      expect(config2._bold(FontStyleBold.Bold).get()).toMatchInlineSnapshot(`
      {
        "bold": 1,
        "color": undefined,
        "italic": false,
        "size": undefined,
        "underline": true,
      }
    `)
    }
    function gen2() {
      const root = TextStyleConfig.init()
      const config = root._italic(true)
      expect(config).not.toBe(root)
      const config2 = config._bold(FontStyleBold.Bold)
      expect(config2).not.toBe(config)
      expect(config2).not.toBe(root)
      const config3 = config2._underline(true)
      expect(config3).not.toBe(root)
      expect(config3).not.toBe(config2)
      expect(config3).not.toBe(config)
      // console.log("TextStyleConfig", config, config2)
      //   expect(TextStyleConfig.cache.size).toBe(3)
      expect(config3.get()).toMatchInlineSnapshot(`
      {
        "bold": 1,
        "color": undefined,
        "italic": true,
        "size": undefined,
        "underline": true,
      }
    `)
    }
    gen1()
    expect(TextStyleConfig.cache.size).toBe(4)
    gen1()
    expect(TextStyleConfig.cache.size).toBe(4)
    gen2()
    expect(TextStyleConfig.cache.size).toBe(6)

    expect(Array.from(TextStyleConfig.cache.values())).toMatchInlineSnapshot(`
      [
        TextStyleConfig {
          "_hash": -93262282,
          "_values": {
            "bold": undefined,
            "color": undefined,
