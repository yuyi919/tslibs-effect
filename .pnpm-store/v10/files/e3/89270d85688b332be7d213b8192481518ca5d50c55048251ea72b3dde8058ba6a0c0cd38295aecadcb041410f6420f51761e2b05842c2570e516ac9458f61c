{"version":3,"file":"NonNullable.js","names":["findIterableMap","array","mapFn","i","o","key","findArrayMap","index","length","nullElse","a","e","nullWhen","be","nullishWhen","otherwise"],"sources":["src/NonNullable.js"],"sourcesContent":["/**\n * 进行迭代，遇到第一个map结果不为null的元素时不的场合，将结果返回\n *\n * 未满足上述条件则继续迭代直到最后返回undefined\n * @param array\n * @param mapFn\n * @returns\n */ export function findIterableMap(array, mapFn) {\n    let i = 0;\n    let o;\n    for (const key of array){\n        o = mapFn(key, i);\n        if (o !== null) return o;\n        i++;\n    }\n}\nexport function findArrayMap(array, mapFn) {\n    let i = 0;\n    let o;\n    for(let index = 0; index < array.length; index++){\n        o = mapFn(array[index], i);\n        if (o !== null) return o;\n    }\n}\nexport function nullElse(a, e) {\n    return a === e ? a : null;\n}\nexport function nullWhen(a, be) {\n    return a === be ? null : a;\n}\n/**\n *\n * @param a\n * @param b\n * @param otherwise\n * @remark\n * ```ts\n * a === b ? otherwise : a\n * ```\n */ export function nullishWhen(a, be, otherwise) {\n    return a === be ? otherwise() : a;\n}\n"],"mappings":"AAAA;AACA;AACA;AACA;AACA;AACA;AACA;AACA,GAAI,WAAgBA,eAAe,GAAAA,CAACC,KAAK,EAAEC,KAAK,KAAE;EAC9C,IAAIC,CAAC,GAAG,CAAC;EACT,IAAIC,CAAC;EACL,KAAK,IAAMC,GAAG,IAAIJ,KAAK,EAAC;IACpBG,CAAC,GAAGF,KAAK,CAACG,GAAG,EAAEF,CAAC,CAAC;IACjB,IAAIC,CAAC,KAAK,IAAI,EAAE,OAAOA,CAAC;IACxBD,CAAC,EAAE;EACP;AACJ,CAAC;AACD,WAAgBG,YAAY,GAAAA,CAACL,KAAK,EAAEC,KAAK,KAAE;EACvC,IAAIC,CAAC,GAAG,CAAC;EACT,IAAIC,CAAC;EACL,KAAI,IAAIG,KAAK,GAAG,CAAC,EAAEA,KAAK,GAAGN,KAAK,CAACO,MAAM,EAAED,KAAK,EAAE,EAAC;IAC7CH,CAAC,GAAGF,KAAK,CAACD,KAAK,CAACM,KAAK,CAAC,EAAEJ,CAAC,CAAC;IAC1B,IAAIC,CAAC,KAAK,IAAI,EAAE,OAAOA,CAAC;EAC5B;AACJ,CAAC;AACD,WAAgBK,QAAQ,GAAAA,CAACC,CAAC,EAAEC,CAAC,KAClBD,CAAC,KAAKC,CAAC,GAAGD,CAAC,GAAG,IAAI;AAE7B,WAAgBE,QAAQ,GAAAA,CAACF,CAAC,EAAEG,EAAE,KACnBH,CAAC,KAAKG,EAAE,GAAG,IAAI,GAAGH,CAAC;AAE9B;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AAAI,WAAgBI,WAAW,GAAAA,CAACJ