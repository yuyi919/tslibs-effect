import * as U from "node:assert/strict"
import { describe, expect, it } from "vitest"

import { sort } from "effect/Array"
import { pipe } from "effect/Function"

import * as _ from "../Order"

describe("Order", () => {
  it("string/number/boolean/bigint", () => {
    expect(_.string("a", "b")).toBe(-1)
    expect(_.number(1, 2)).toBe(-1)
    expect(_.boolean(false, true)).toBe(-1)
    expect(_.bigint(1n, 2n)).toBe(-1)
  })
  it("struct", () => {
    const O = _.struct({ a: _.string, b: _.string })
    expect(O({ a: "a", b: "b" }, { a: "a", b: "c" })).toBe(-1)
    expect(O({ a: "a", b: "b" }, { a: "a", b: "b" })).toBe(0)
    expect(O({ a: "a", b: "c" }, { a: "a", b: "b" })).toBe(1)
  })

  it("tuple", () => {
    const O = _.tuple(_.string, _.string)
    expect(O(["a", "b"], ["a", "c"])).toBe(-1)
    expect(O(["a", "b"], ["a", "b"])).toBe(0)
    expect(O(["a", "b"], ["a", "a"])).toBe(1)
    expect(O(["a", "b"], ["b", "a"])).toBe(-1)
  })
  it("array", () => {
    const O = _.array(_.number)
    expect(O([1, 2, 3], [1, 2, 3])).toBe(0)
    expect(O([1, 2, 3], [1, 2])).toBe(1)
    expect(O([0, 2, 3], [1, 2, 3])).toBe(-1)
    expect(O([1, 2], [1, 2, 3])).toBe(-1)
    expect(O([1, 2, 4], [1, 2, 3])).toBe(1)
    expect(O([1, 2, 3, 4], [1, 2, 3])).toBe(1)
  })

  it("all", () => {
    const O = _.all([_.string, _.string, _.string])
    expect(O([], [])).toBe(0)
    expect(O(["a", "b"], ["a"])).toBe(0)
    expect(O(["a"], ["a", "c"])).toBe(0)
    expect(O(["a", "b"], ["a", "c"])).toBe(-1)
    expect(O(["a", "b"], ["a", "b"])).toBe(0)
    expect(O(["a", "b"], ["a", "a"])).toBe(1)
    expect(O(["a", "b"], ["b", "a"])).toBe(-1)
  })

  it("mapInput", () => {
    const O = _.mapInput(_.number, (s: string) => s.length)
    expect(O("a", "b")).toBe(0)
    expect(O("a", "bb")).toBe(-1)
    expect(O("aa", "b")).toBe(1)
  })

  it("Date", () => {
    const O = _.Date
    expect(O(new Date(0), new Date(1))).toBe(-1)
    expect(O(new Date(1), new Date(1))).toBe(0)
    expect(O(new Date(1), new Date(0))).toBe(1)
  })

  it("clamp", () => {
    const clamp = _.clampWith(_.number)({ min: 1, max: 10 })
    expect(clamp(2)).toBe(2)
    expect(clamp(10)).toBe(10)
    expect(clamp(20)).toBe(10)
    expect(clamp(1)).toBe(1)
    expect(clamp(-10)).toBe(1)

    expect(_.clampWith(_.number)({ min: 1, max: 10 })(2)).toBe(2)
  })

  it("between", () => {
    const between = _.betweenWith(_.number)({ min: 1, max: 10 })
    expect(between(2)).toBe(true)
    expect(between(10)).toBe(true)
    expect(between(20)).toBe(false)
    expect(between(1)).toBe(true)
    expect(between(-10)).toBe(false)

    expect(_.betweenWith(_.number)(2, { min: 1, max: 10 })).toBe(true)
  })

  it("reverse", () => {
    const O = _.reverse(_.number)
    expect(O(1, 2)).toBe(1)
    expect(O(2, 1)).toBe(-1)
    expect(O(2, 2)).toBe(0)
  })

  it("lessThan", () => {
    const lessThan = _.lessThan(_.number)
    expect(lessThan(0, 1)).toBe(true)
    expect(lessThan(1, 1)).toBe(false)
    expect(lessThan(2, 1)).toBe(false)
  })

  it("lessThanOrEqualTo", () => {
    const lessThanOrEqualTo = _.lessThanOrEqualTo(_.number)
    expect(lessThanOrEqualTo(0, 1)).toBe(true)
    expect(lessThanOrEqualTo(1, 1)).toBe(true)
    expect(lessThanOrEqualTo(2, 1)).toBe(false)
  })

  it("greaterThan", () => {
    const greaterThan = _.greaterThan(_.number)
    expect(greaterThan(0, 1)).toBe(false)
    expect(greaterThan(1, 1)).toBe(false)
    expect(greaterThan(2, 1)).toBe(true)
  })

  it("greaterThanOrEqualTo", () => {
    const greaterThanOrEqualTo = _.greaterThanOrEqualTo(_.number)
    expect(greaterThanOrEqualTo(0, 1)).toBe(false)
    expect(greaterThanOrEqualTo(1, 1)).toBe(true)
    expect(greaterThanOrEqualTo(2, 1)).toBe(true)
  })

  it("min", () => {
    type A = { a: number }
    const min = _.min(
      pipe(
        _.number,
        _.mapInput((a: A) => a.a),
      ),
    )
    U.deepStrictEqual(min({ a: 1 }, { a: 2 }), { a: 1 })
    U.deepStrictEqual(min({ a: 2 }, { a: 1 }), { a: 1 })
    const first = { a: 1 }
    const second = { a: 1 }
    U.strictEqual(min(first, second), first)
  })

  it("max", () => {
    type A = { a: number }
    const max = _.max(
      pipe(
        _.number,
        _.mapInput((a: A) => a.a),
      ),
    )
    U.deepStrictEqual(max({ a: 1 }, { a: 2 }), { a: 2 })
    U.deepStrictEqual(max({ a: 2 }, { a: 1 }), { a: 2 })
    const first = { a: 1 }
    const second = { a: 1 }
    U.strictEqual(max(first, second), first)
  })

  it("product", () => {
    const O = _.product(_.string, _.number)
    expect(O(["a", 1], ["a", 2])).toBe(-1)
    expect(O(["a", 1], ["a", 1])).toBe(0)
    expect(O(["a", 1], ["a", 0])).toBe(1)
    expect(O(["a", 1], ["b", 1])).toBe(-1)
  })

  it("productMany", () => {
    const O = _.productMany(_.string, [_.string, _.string])
    expect(O(["a", "b"], ["a", "c"])).toBe(-1)
    expect(O(["a", "b"], ["a", "b"])).toBe(0)
    expect(O(["a", "b"], ["a", "a"])).toBe(1)
    expect(O(["a", "b"], ["b", "a"])).toBe(-1)
  })

  it("combine / combineMany", () => {
    type T = [number, string]
    const tuples: Array<T> = [
      [2, "c"],
      [1, "b"],
      [2, "a"],
      [1, "c"],
    ]
    const sortByFst = pipe(
      _.number,
      _.mapInput((x: T) => x[0]),
    )
    const sortBySnd = pipe(
      _.string,
      _.mapInput((x: T) => x[1]),
    )
    U.deepStrictEqual(sort(_.combine(sortByFst, sortBySnd))(tuples), [
      [1, "b"],
      [1, "c"],
      [2, "a"],
      [2, "c"],
    ])
    U.deepStrictEqual(sort(_.combine(sortBySnd, sortByFst))(tuples), [
      [2, "a"],
      [1, "b"],
      [1, "c"],
      [2, "c"],
    ])
    U.deepStrictEqual(sort(_.combineMany(sortBySnd, []))(tuples), [
      [2, "a"],
      [1, "b"],
      [2, "c"],
      [1, "c"],
    ])
    U.deepStrictEqual(sort(_.combineMany(sortBySnd, [sortByFst]))(tuples), [
      [2, "a"],
      [1, "b"],
      [1, "c"],
      [2, "c"],
    ])
  })
})
