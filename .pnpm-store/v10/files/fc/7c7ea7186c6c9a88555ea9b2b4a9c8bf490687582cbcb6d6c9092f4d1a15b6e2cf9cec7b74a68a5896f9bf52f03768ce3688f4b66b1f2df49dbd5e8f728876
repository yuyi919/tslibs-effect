open Shared
open! IContext

@genType.as("IGenContext")
type generatorContext = {
  mutable cursor: int,
  mutable curChar: ElementBufferFactory.identifier,
  mutable line: int,
  mutable col: float,
}
@genType.as("IGen")
type generator = {
  context: generatorContext,
  next: generatorContext => ElementBufferFactory.identifier,
  result: unit => IContext.result,
  flush: unit => IContext.result,
  visit: int => ElementBufferFactory.identifier,
  mutable done: bool,
}

module Export: {
  module Ecs: ElementBufferFactory.Adapter
  @genType
  let create: (
    string,
    ElementType.elementKind,
    Font.fontStyle,
    Font.fontVariant,
    Font.fontWeight,
    Shared.f64,
    string,
    Shared.f64,
  ) => ElementBufferFactory.identifier
  @genType
  let calcAutomic: (ElementBufferFactory.elementIds, IEnv.iTypographyBaseOptions) => generator
  @genType
  let calc: (ElementBufferFactory.elementIds, IEnv.iTypographyBaseOptions) => IContext.result
} = {
  module BufferECS = ElementBuffer.Use()
  module ECS: ElementBufferFactory.Visitor = ElementBufferFactory.Make(BufferECS)
  module ProcessConfig: Process.ProcessConfig = {
    module CompressOptions = {
      include DefaultCompressOptions
    }
    module Ecs = ElementBufferFactory.Make(BufferECS)
  }
  module Proc = Process.MakeProcess(ProcessConfig)

  module Ecs = ElementBufferFactory.ExportEcs(ECS)
  module Font = {
    include Font
  }
  @inline
  let measureTextWidth = (
    char,
    text,
    ~fontStyle,
    ~fontVariant,
    ~fontWeight,
    ~fontSize,
    ~fontFamily,
    ~letterSpacing,
  ) => {
    if !(char->ECS.getElementType->ElementType.isWS) {
      let (width, font) =
        text->Font.measureTextWidth(
          ~fontStyle,
          ~fontVariant,
          ~fontWeight,
          ~fontSize,
          ~fontFamily,
          ~letterSpacing=char->ECS.getElementType === ElementType.WORD ? letterSpacing : 0.0,
        )
      char->ECS.setFont(font)->ignore
      char->ECS.setW(width)->ignore
    } else {
      let width = switch text->charAt(0) {
      | ' ' => 0.5 *. fontSize
      | '　' => 1.0 *. fontSize
      | '\t' => 2.0 *. fontSize
      | _ => 0.0
      }
      if width > 0.0 {
        let (width, font) =
          text->Font.getTextFont(
            ~width,
            ~fontStyle,
            ~fontVariant,
            ~fontWeight,
            ~fontSize,
            ~fontFamily,
            ~letterSpacing=char->ECS.getElementType === ElementType.WORD ? letterSpacing : 0.0,
          )
        char->ECS.setFont(font)->ignore
        char->ECS.setW(width)->ignore
      } else {
        char->ECS.setW(width)->ignore
      }
    }
    char
  }

  @genType
  let create = (
    character: string,
    kind,
    fontStyle,
    fontVariant,
    fontWeight,
    fontSize,
    fontFamily,
    letterSpacing: f64,
  ): ElementBufferFactory.identifier => {
    ECS.create(~character, ~fontSize)
    ->ECS.map(
      ECS.setElementType(_, kind === ElementType.UNKNOWN ? ElementType.checkType(character) : kind),
    )
    ->ECS.map(
      measureTextWidth(
        _,
        character,
        ~fontStyle,
        ~fontVariant,
        ~fontWeight,
        ~fontSize,
        ~fontFamily,
        ~letterSpacing,
      ),
    )
  }

  module Context = Proc.Context
  module Store = Proc.Store
  @genType
  let calcAutomic: (ElementBufferFactory.elementIds, IEnv.iTypographyBaseOptions) => generator = (
    source: ElementBufferFactory.elementIds,
    options,
  ) => {
    let context = Proc.Store.context
    Proc.Logger.groupCollapsed1("call proxyRun", source)
    let length = source->ElementIdentifiers.unbox->Array.length
    context->Proc.Context.prepare(~source, ~options)

    @inline
    let next = genContext => {
      let {curChar, cursor} = genContext
      if cursor >= length {
        true
      } else {
        let char = source->ElementIdentifiers.get(cursor)
        let break = if ElementBufferFactory.isValid(char) {
          context.cursor = cursor
          context->Proc.each(~char, ~prevChar=curChar)
        } else {
          Continue
        }
        switch break {
        | Break => {
            genContext.curChar = char
            true
          }
        | Continue => {
            genContext.curChar = char
            false
          }
        }
      }
    }
    let rec data = {
      done: false,
      result: () => Proc.output(context),
      flush: () => Context.incrementFlush(context),
      visit: cursor => source->ElementIdentifiers.get(cursor),
      context: {
        cursor: -1,
        curChar: context._END,
        col: context->Context.getCurrentCol,
        line: context->Context.getCurrentRow,
      },
      next: genContext => {
        if !data.done {
          genContext.cursor = genContext.cursor + 1
          data.done = next(genContext)
          genContext.col = context->Context.getCurrentCol
          genContext.line = context->Context.getCurrentRow
          // Js.log({...genContext, line: context->Context.getCurrentRow})
        }
        source->ElementIdentifiers.get(genContext.cursor)
      },
    }
    data
  }

  @genType
  let calc: (ElementBufferFactory.elementIds, IEnv.iTypographyBaseOptions) => IContext.result = (
    source: ElementBufferFactory.elementIds,
    options,
  ) => {
    let context = Store.context
    Proc.Logger.groupCollapsed1("call proxyRun", source)
    let length = source->ElementIdentifiers.unbox->Array.length
    context->Context.prepare(~source, ~options)

    @inline
    let rec loop = (cursor, prevChar) => {
      // cursor 其实就是数组index
      if cursor >= length {
        Proc.output(context)
      } else {
        let char = source->ElementIdentifiers.get(cursor)
        let break = if ElementBufferFactory.isValid(char) {
          context.cursor = cursor
          context->Proc.each(~char, ~prevChar)
        } else {
          Continue
        }
        switch break {
        | Break => Proc.output(context) // 直接结束
        | Continue => loop(cursor + 1, char)
        }
      }
    }
    loop(0, context._END)
  }
}
open Export

@genType
let calc = calc
@genType
let calcAutomic = calcAutomic
@genType
let create = create

module type Adapter = {
  include ElementBufferFactory.Adapter
}

@genType
let ecs: module(Adapter) = module(Ecs)

@genType
let getOffsetXFromFixCjkQuote = (
  ~flag_STDWIDTH,
  ~fixCJKLeftQuote,
  ~lastIsPunctuation,
  ~charFontSize,
  ~charCode: ElementBufferFactory.charcode,
  ~charWidth,
) =>
  P_Helper.getOffsetXFromFixCjkQuote(
    ~flag_STDWIDTH,
    ~fixCJKLeftQuote,
    ~lastIsPunctuation,
    ~charFontSize,
    ~charCode,
    ~charWidth,
  )

@genType
let printCache = Font.printCache
