import type { Foldable, Foldable1 } from "fp-ts/Foldable"
import type { HKT, Kind, URIS } from "fp-ts/HKT"
import * as E from "fp-ts/Either"
import * as M from "fp-ts/Monoid"
import * as O from "fp-ts/Option"
import { Monoid } from "fp-ts/string"

import { pipe } from "@yuyi919/shared-proto/Functions"

import * as P from "../Parser"
import * as C from "./char"
import * as PR from "./ParseResult"
import * as Stream from "./Stream"

// -------------------------------------------------------------------------------------
// constructors
// -------------------------------------------------------------------------------------

/**
 * Matches the exact string provided.
 *
 * @category constructors
 * @since 0.6.0
 */
export const string: (match: C.Char) => P.Parser<C.Char, C.Char> = (match) => {
  const succeed = P.of<C.Char, E.Either<number, C.Char>>(E.right(match))
  return P.expected(
    P.chainRecF<C.Char, number, C.Char>(0, (acc) =>
      acc < match.length
        ? P.mapF(
            P.sat((c) => c === match[acc]),
            () => E.left(acc + 1),
          )
        : succeed,
    ),
    JSON.stringify(match),
  )
}

// -------------------------------------------------------------------------------------
// constructors
// -------------------------------------------------------------------------------------

/**
 * Matches the exact string provided.
 *
 * @category constructors
 * @since 0.6.0
 */
export const matchBuffer: <I>(
  match: Stream.SeqLike<I>,
) => P.Parser<I, Stream.SeqLike<I>> = <I>(
  match: Stream.SeqLike<I>,
): P.Parser<I, Stream.SeqLike<I>> => {
  const succeed = P.of<I, E.Either<number, Stream.SeqLike<I>>>(E.right(match))
  return P.expected(
    P.ChainRec.chainRec<I, number, Stream.SeqLike<I>>(0, (acc) =>
      acc < match.length
        ? P.mapF(
            P.sat((cur) => cur === match[acc]),
            () => E.left(acc + 1),
          )
        : succeed,
    ),
    JSON.stringify(match),
  )
}

/**
 * Matches one of a list of strings.
 *
 * @category constructors
 * @since 0.6.0
 */
export function oneOf<F extends URIS>(
  F: Foldable1<F>,
): (ss: Kind<F, string>) => P.Parser<C.Char, C.Char>
export function oneOf<F>(
  F: Foldable<F>,
): (ss: HKT<F, string>) => P.Parser<C.Char, C.Char>
export function oneOf<F>(
  F: Foldable<F>,
): (ss: HKT<F, string>) => P.Parser<C.Char, C.Char> {
  return (ss) =>
    F.reduce(ss, P.fail(), (parser, s) =>
      pipe(
        parser,
        P.alt(() => string(s)),
      ),
    )
}

// -------------------------------------------------------------------------------------
// destructors
// -------------------------------------------------------------------------------------

/**
 * @category destructors
 * @since 0.6.0
 */
export const fold: <I>(as: Array<P.Parser<I, string>>) => P.Parser<I, string> =
  M.concatAll(P.getMonoid(Monoid))

// -------------------------------------------------------------------------------------
// combinators
// -------------------------------------------------------------------------------------

/**
 * @category combinators
 * @since 0.6.0
 */
export const maybe: <I>(parser: P.Parser<I, string>) => P.Parser<I, string> =
  P.maybe(Monoid)

/**
 * Matches the given parser zero or more times, returning a string of the
 * entire match
 *
 * @category combinators
 * @since 0.6.0
 */
export const many: <I>(parser: P.Parser<I, string>) => P.Parser<I, string> =
  P.getManyC(Monoid)

/**
 * Matches the given parser one or more times, returning a string of the
 * entire match
 *
 * @category combinators
 * @since 0.6.0
 */
export const many1: <I>(parser: P.Parser<I, string>) => P.Parser<I, string> =
  P.getMany1C(Monoid)

/**
 * Matches zero or more whitespace characters.
 *
 * @category combinators
 * @since 0.6.0
 */
export const spaces: P.Parser<C.Char, string> = C.many(C.space)

/**
 * Matches one or more whitespace characters.
 *
 * @category combinators
 * @since 0.6.0
 */
export const spaces1: P.Parser<C.Char, string> = C.many1(C.space)

/**
 * Matches zero or more non-whitespace characters.
 *
 * @category combinators
 * @since 0.6.0
 */
export const notSpaces: P.Parser<C.Char, string> = C.many(C.notSpace)

/**
 * Matches one or more non-whitespace characters.
 *
 * @category combinators
 * @since 0.6.0
 */
export const notSpaces1: P.Parser<C.Char, string> = C.many1(C.notSpace)

const fromString: (s: string) => O.Option<number> = (s) => {
  const n = +s
  return isNaN(n) || s === "" ? O.none : O.some(n)
}

const num = (s: string) =>
  P.defineLambda(
    pipe(
      fromString(s),
      O.fold(
        () => P.fail(),
        (n) => P.succeed(n),
      ),
    ),
  )

/**
 * @category combinators
 * @since 0.6.0
 */
export const int: P.Parser<C.Char, number> = P.expected(
  pipe(
    fold([maybe(C.char("-")), C.many1(C.digit)]),
    P.map((s) => +s),
  ),
  "an integer",
)

/**
 * @category combinators
 * @since 0.6.0
 */
export const float: P.Parser<C.Char, number> = P.expected(
  pipe(
    fold([
      maybe(C.char("-")),
      C.many(C.digit),
      maybe(fold([C.char("."), C.many1(C.digit)])),
    ]),
    P.chain((s) =>
      pipe(
        fromString(s),
        O.fold(
          () => P.fail(),
          (n) => P.succeed(n),
        ),
      ),
    ),
  ),
  "a float",
)

/**
 * Parses a double quoted string, with support for escaping double quotes
 * inside it, and returns the inner string. Does not perform any other form
 * of string escaping.
 *
 * @category combinators
 * @since 0.6.0
 */
export const doubleQuotedString: P.Parser<C.Char, C.Char> = P.surroundedBy(
  C.char('"'),
)(many(P.eitherConst(string('\\"'), C.notChar('"'))))

/**
 * @summary
 * Creates a stream from `string` and runs the parser.
 *
 * @category combinators
 * @since 0.6.8
 */
export function run(
  string: string,
  option: P.ParseOption = P.EmptyParseOption,
): <A>(parser: P.Parser<C.Char, A>) => PR.ParseResult<C.Char, A> {
  return (parser) =>
    PR.getResult(
      P._run(parser, Stream.fromString(string), P.extendOption(option)),
    )
}

export const sepByF = P.getSepByMonoid(Monoid)
export const sepBy =
  <I>(sep: P.Parser<I, C.Char>) =>
  (content: P.Parser<I, C.Char>) =>
    sepByF(sep, content)
