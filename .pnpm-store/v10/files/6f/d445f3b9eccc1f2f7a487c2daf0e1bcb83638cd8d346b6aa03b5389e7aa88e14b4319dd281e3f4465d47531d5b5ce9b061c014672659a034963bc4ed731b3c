import type { Fn } from "../Types"
import { constant } from "../function"
import { VOID } from "./constant"
import { NEA } from "./JsTypes.shim"
import * as Monoid from "./Monoid"
import { assign } from "./object"
import * as Semigroup from "./Semigroup"

const ListenerSybmol = Symbol()

export type ComplexFunction<Args extends readonly any[] = [], R = any> = {
  (...args: Args): R
  readonly [ListenerSybmol]?: NEA<Fn<Args, R>>
}
export type Reducer<A, R> = {
  (a: A, r: R): R
  readonly [ListenerSybmol]?: NEA<(a: A, r: R) => R>
}

const noop: ComplexFunction<any[], void> = (a) => {}

export function getFunctionSemigroup<Args extends readonly any[], R>(
  semigroup: Semigroup.ComplexSemigroup<R> | Monoid.ComplexMonoid<R>,
  emptyListener?: ComplexFunction<Args, R>,
): Semigroup.ComplexSemigroup<ComplexFunction<Args, R>> {
  const { combineMany, combineAll } = semigroup
  return Semigroup.makeComplex((self, that) => {
    if (self === emptyListener) return that
    if (that === emptyListener) return self
    if (self[ListenerSybmol]) {
      if (that[ListenerSybmol]) {
        self[ListenerSybmol].push(...that[ListenerSybmol])
      } else {
        self[ListenerSybmol].push(that)
      }
      return self
    } else if (that[ListenerSybmol]) {
      that[ListenerSybmol].push(self)
      return that
    }
    function concatMany(...args: Args): R
    function concatMany(this: any): R {
      const [head, ...other] = fn[ListenerSybmol]!
      return combineMany(
        head.apply(this, arguments as unknown as any[]),
        other.map((other) => other.apply(this, arguments as unknown as any[])),
      )
    }
    function concatAll(...args: Args): R
    function concatAll(this: any): R {
      return combineAll!(
        fn[ListenerSybmol]!.map((other) =>
          other.apply(this, arguments as unknown as any[]),
        ),
      )
    }
    const fn: ComplexFunction<Args, R> = assign(
      combineAll ? concatAll : concatMany,
      {
        [ListenerSybmol]: [self, that] as NEA<Fn<Args, R>>,
      },
    )
    return fn
  })
}

export function getFunctionMonoid<Args extends readonly any[], R>(
  monoid: Monoid.ComplexMonoid<R>,
  empty?: ComplexFunction<Args, R>,
): Monoid.ComplexMonoid<ComplexFunction<Args, R>>
export function getFunctionMonoid<Args extends readonly any[], R>(
  semigroup: Semigroup.ComplexSemigroup<R>,
  empty: ComplexFunction<Args, R>,
): Monoid.ComplexMonoid<ComplexFunction<Args, R>>
export function getFunctionMonoid<Args extends readonly any[]>(
  semigroup: Semigroup.ComplexSemigroup<void>,
): Monoid.ComplexMonoid<ComplexFunction<Args, void>>
export function getFunctionMonoid<Args extends readonly any[], R = void>(
  semigroup: Semigroup.ComplexSemigroup<R> | Monoid.ComplexMonoid<R>,
  empty?: ComplexFunction<Args, R>,
):
  | Monoid.ComplexMonoid<ComplexFunction<Args, R>>
  | Semigroup.ComplexSemigroup<ComplexFunction<Args, R>> {
  if (semigroup._tag === "Monoid") {
    empty ??=
      semigroup.empty === VOID
        ? (noop as ComplexFunction<Args, R>)
        : constant(semigroup.empty!)
  } else {
    empty ??= noop as ComplexFunction<Args, R>
  }
  return Monoid.fromSemigroup(
    getFunctionSemigroup(semigroup) satisfies Semigroup.ComplexSemigroup<
      ComplexFunction<Args, R>
    >,
    empty,
  )
}

export const AnyListenerMonoid: Monoid.ComplexMonoid<
  ComplexFunction<readonly any[], void>
> = getFunctionMonoid(Semigroup.VoidSemigroup)

export function getListenerMonoid<
  Args extends readonly any[],
>(): Monoid.ComplexMonoid<ComplexFunction<Args, void>> {
  return constant(AnyListenerMonoid)()
}

getFunctionMonoid(Semigroup.NumberAddSemigroup, constant(0))
