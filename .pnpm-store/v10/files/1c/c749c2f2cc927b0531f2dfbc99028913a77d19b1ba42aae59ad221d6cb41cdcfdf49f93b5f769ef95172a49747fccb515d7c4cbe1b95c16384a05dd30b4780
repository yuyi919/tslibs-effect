* @since 0.0.0\n */ export function jsObject(value, fields = jsObjectKeys) {\n    return make((self, that)=>{\n        const fields1 = fields(self);\n        const fields2 = fields(that);\n        if (fields1.length !== fields2.length) return false;\n        return fields1.every((key)=>_hasOwnKey(that, key) && value(self[key], that[key]));\n    });\n}\n"]}