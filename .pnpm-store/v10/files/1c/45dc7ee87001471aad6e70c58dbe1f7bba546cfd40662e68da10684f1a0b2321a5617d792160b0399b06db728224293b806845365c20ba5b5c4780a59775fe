export interface EventProto<Events extends EventTypeMap>
  extends EventHost<Events> {
  _: GenericEventHandlerMap<Events>
}

export function getProto<Events extends EventTypeMap>(): EventProto<Events> {
  return constant(
    pipe(
      P.type<EventProto<Events>>(),
      P.method(
        "on",
        (self, type: EventType, handler: GenericEventHandler<Events>) => (
          getOwnOrSet(self._, type, []).push(handler),
          self
        ),
      ),
      P.method(
        "off",
        (self, type: EventType, handler?: GenericEventHandler<Events>) => (
          ((handlers) =>
            handlers &&
            (handler
              ? removeElementByIndexOf(
                  handlers,
                  handler as Handler & WildcardHandler,
                )
              : (self._[type] = [])))(_hasOwnKey(self._, type) && self._[type]),
          self
        ),
      ),
      P.method(
        "emit",
        (self, type: EventType, evt?: Events[EventType]) => (
          Optional.forEach(
            getOwn(self._, type) as EventHandlerList<Events[keyof Events]>,
            (h) => h(evt!),
          ),
          Optional.forEach(
            self._["*"] as WildCardEventHandlerList<Events>,
            (h) => h(type, evt!),
          ),
          self
        ),
      ),
      P.method(
        "clear",
        (self) => ((self._ = {} as EventHandlerMap<Events>), self),
      ),
      P.make,
    ),
  )()
}

