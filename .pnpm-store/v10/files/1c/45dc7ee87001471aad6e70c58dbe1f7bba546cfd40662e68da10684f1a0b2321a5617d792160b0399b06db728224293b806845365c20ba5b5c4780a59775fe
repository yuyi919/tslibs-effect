export function make<Events extends EventTypeMap>(
  all: EventHandlerMap<Events> = {} as EventHandlerMap<Events>,
): EventHost<Events> {
  return Proto.setPrototypeOf(
    {
      /**
       * A Map of event names to registered handler functions.
       */
      _: all,
    },
    getProto(),
  ) as any
}
