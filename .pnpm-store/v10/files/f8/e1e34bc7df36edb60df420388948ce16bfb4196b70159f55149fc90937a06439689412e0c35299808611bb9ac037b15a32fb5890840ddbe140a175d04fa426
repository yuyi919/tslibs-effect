 from \"./internal/object\"\n\nexport {\n  _bind,\n  _bindWith,\n  _hasOwnKey,\n  _map,\n  _mapI,\n  assign,\n  defineProperties,\n  entries,\n  fromEntries,\n  getOwnPropertyDescriptor,\n  getOwnPropertyDescriptors,\n  getOwnPropertySymbols,\n  keys,\n  ownKeys,\n  singleton,\n} from \"./internal/object\"\n\nexport type JsPropertyKey<A extends PropertyKey = PropertyKey> = Exclude<\n  A,\n  number\n>\n\nexport type JsObjectKey<A extends {}> = JsPropertyKey<keyof A>\nexport type JsObjectValues<A extends {}> = A[keyof A]\nexport type JsObjectParitalMap<A extends {}, V> = {\n  [k in JsObjectKey<A>]?: V\n}\nexport type JsObjectEntries<A extends {}> = {\n  [K in JsObjectKey<A>]: readonly [key: K, value: A[K]]\n}[JsObjectKey<A>]\n\nexport type JsObject<A = any, K extends JsPropertyKey = JsPropertyKey> = Record<\n  K,\n  A\n>\nexport type ReadonlyObject<A = any, K extends JsPropertyKey = JsPropertyKey> = {\n  readonly [k in K]: A\n}\n\nexport function jsObjectKeys<T extends JsObject>(\n  target: NonNullable<T>,\n): JsObjectKey<T>[]\nexport function jsObjectKeys(target: object): (string | symbol)[]\nexport function jsObjectKeys(target: any) {\n  return ownKeys(target)\n}\n\nexport type Records<K extends JsPropertyKey, A> = {\n  [key in K]: A\n}\n\nexport type JsObjectBind<\n  T extends JsObject,\n  P extends JsPropertyKey,\n  A,\n> = Simplify<{\n  [K in keyof T | P]: K extends P ? A : T[K]\n}>\n\nexport function bind<\n  T extends JsObject,\n  Property extends JsPropertyKey,\n  const Value,\n>(data: T, key: Property, value: Value): JsObjectBind<T, Property, Value>\nexport function bind<\n  T extends JsObject,\n  Property extends JsPropertyKey,\n  const Value,\n>(key: Property, value: Value): (data: T) => JsObjectBind<T, Property, Value>\nexport function bind(...args: [any, any, any?]) {\n  return dual(3, _bind)(...args)\n}\n\nexport function bindWith<\n  T extends JsObject,\n  Property extends JsPropertyKey,\n  const A,\n>(\n  key: Property,\n  fn: (target: T) => A,\n): (data: T) => JsObjectBind<T, Property, A>\nexport function bindWith<\n  T extends JsObject,\n  Property extends JsPropertyKey,\n  const A,\n>(data: T, key: Property, fn: (target: T) => A): JsObjectBind<T, Property, A>\nexport function bindWith(a: any, b: any, c?: any) {\n  return !c ? (z: any) => _bindWith(z, a, b) : _bindWith(a, b, c)\n}\n\nexport function keyStruct<const K extends string | number>(\n  key: readonly K[],\n): {\n  [key in K extends number ? `${K}` : K]: key\n} {\n  return fromEntries(key.map((k) => [k, k])) as any\n}\n","import type { TypeLambda } from \"effect/HKT\"\n\nimport * as EvalFunction from \"./EvalFunction\"\nimport { raise, typeError, unsafeCoerce } from \"./function/core\"\nimport {\n  __KEY_ARGUMENTS,\n  __KEY_FUNC,\n  OBJECT,\n  UNDEFINED,\n} from \"./internal/constant\"\nimport { isFn, tryCatch } from \"./internal/helper\"\nimport * as JSObject from \"./internal/object\"\nimport {\n  defineProtoValue,\n  getProtos,\n  getPrototypeOf,\n  setProtos,\n  useThis,\n} from \"./internal/proto\"\n\nexport {\n  /**\n   * 获取对象的原型\n   * @param target 要获取原型的对象\n   */\n  getProtos,\n  /**\n   * 获取对象的原型\n   * @param target 要获取原型的对象\n   */\n  getPrototypeOf,\n  /**\n   * 设置对象的原型\n   * @param target 要设置原型的对象\n   * @param proto 原型对象\n   */\n  setProtos,\n  /**\n   * 设置对象的原型\n   * @param target 要设置原型的对象\n   * @param proto 原型对象\n   */\n  setPrototypeOf,\n  /**\n   * 将函数绑定到其上下文 (`this`)\n   * @param fn 要绑定的函数\n   */\n  useThis,\n} from \"./internal/proto\"\nexport { assign } from \"./JsObject\"\n\nexport type TClass<T, Args extends readonly any[] = any[]> = {\n  new (...args: Args): T\n  // (...args: Args): T\n}\nexport type AbstractClass<\n  T,\n  Args extends readonly any[] = any[],\n> = abstract new (...args: Args) => T\n\nexport interface AbstractClassLambda extends TypeLambda {\n  readonly type: new (...args: Extract<this[\"In\"], any[]>) => this[\"Target\"]\n}\n\n/**\n * 为抽象类添加一个 `_tag` 属性\n * @param target 抽象类构造函数\n * @param value _tag 的值\n */\nexport const _TAG = <TAG, Const extends AbstractClass<any>>(\n  target: Const,\n  value: TAG,\n): Const => withProtoPropertyValue(target, \"_tag\", value)\n\nexport interface PropertyCommonDescriptor {\n  _configurable?: boolean\n  _enumerable?: boolean\n}\n\nexport interface PropertyGetterDescriptor extends PropertyCommonDescriptor {\n  _set?(v: any): void\n}\n\nexport interface PropertyValueDescriptor extends PropertyCommonDescriptor {\n  _writable?: boolean\n}\n\nexport type PropertyDescriptorOptions =\n  | PropertyValueDescriptor\n  | PropertyGetterDescriptor\n\nexport {\n  /**\n   * 定义一个`getter`\n   * @param target 目标对象\n   * @param name 属性名\n   * @param getter 获取函数\n   */\n  defineGetter,\n  /**\n   * 定义一个不可枚举的属性\n   * @param target 目标对象\n   * @param name 属性名\n   * @param value 属性值\n   */\n  defineHiddenProperty,\n  /**\n   * 定义一个属性\n   * @param target 目标对象\n   * @param name 属性名\n   * @param descriptor 属性描述符\n   */\n  defineProperty,\n  /**\n   * 在对象的原型上定义一个`getter`\n   * @param target 目标对象\n   * @param name 属性名\n   * @param getter 获取函数\n   */\n  defineProtoGetter,\n  /**\n   * 在对象的原型上定义一个属性\n   * @param target 目标对象\n   * @param name 属性名\n   * @param descriptor 属性描述符\n   */\n  defineProtoPropertyDescriptor,\n  /**\n   * 在对象的原型上定义一个只读属性值\n   * @param target 目标对象\n   * @param name 属性名\n   * @param value 属性值\n   */\n  defineProtoPropertyReadonlyValue,\n  /**\n   * 在对象的原型上定义一个属性值\n   * @param target 目标对象\n   * @param name 属性名\n   * @param value 属性值\n   */\n  defineProtoValue,\n  /**\n   * 定义一个只读属性\n   * @param target 目标对象\n   * @param name 属性名\n   * @param value 属性值\n   */\n  defineReadonlyProperty,\n  /**\n   * 创建一个 getter 函数\n   * @param fn 获取函数\n   */\n  makeGetter,\n  /**\n   * 创建一个方法函数\n   * @param fn 方法函数\n   */\n  makeMethod,\n  /**\n   * 创建一个属性描述符\n   * @param descriptor 属性描述符选项\n   */\n  makeProperty,\n} from \"./internal/proto\"\n\n/**\n * 为类的原型添加一个属性值\n * @param target 类构造函数\n * @param name 属性名\n * @param value 属性值\n */\nexport function withProtoPropertyValue<\n  C extends AbstractClass<any>,\n  T extends InstanceType<C>,\n  K extends keyof T,\n>(target: C, name: K, value: T[K]): C {\n  return defineProtoValue(target, name, value, {\n    _enumerable: true,\n  })\n}\n\n/**\n * 在类的原型上执行一个函数\n * @param target 类构造函数\n * @param f 要执行的函数，参数为类的原型\n */\nexport function withProtoF<\n  C extends AbstractClass<any>,\n  T extends InstanceType<C>,\n>(target: C, f: (self: T) => void): void {\n  return f(getProtos(target))\n}\n\n// export const pkgName = \"@yuyi919/Proto\" as const;\n\nexport type ExtractArguments<\n  Fn extends (self: any, ...args: any[]) => any,\n  T extends Parameters<Fn>[0],\n> = Parameters<Fn> extends [T, ...args: infer ARGS extends any[]] ? ARGS : any[]\n\n/**\n * 将记录对象转换为原型对象，其中函数会绑定 `this`\n * @param record 记录对象\n */\nexport function makeStructProto<T extends Record<PropertyKey, any>>(\n  record: T,\n): {\n  [K in keyof T]: T[K] extends (\n    self: infer This,\n    ...args: infer Args\n  ) => infer R\n    ? (this: This, ...args: Args) => R\n    : T[K]\n} {\n  return unsafeCoerce(\n    JSObject._map(record, (propertyValue, _) =>\n      isFn(propertyValue) ? useThis(propertyValue) : propertyValue,\n    ),\n  )\n}\n\n/**\n * 创建一个构造函数，它可以作为普通函数调用，也可以用 new 调用\n * @param fn 内部实现函数，接收 `this` 作为第一个参数\n * @param name 函数名称\n */\nexport function useConstructFunction<\n  A extends {},\n  R = any,\n  Args extends readonly any[] = [],\n>(\n  fn: (self: A | undefined) => R,\n  name: string,\n): {\n  (...args: Args): R\n  new (...args: Args): A\n}\nexport function useConstructFunction<\n  Fn extends (self: any, ...args: any[]) => any,\n  T extends Parameters<Fn>[0],\n>(fn: Fn, name: string): (this: T, ...args: any[]) => ReturnType<Fn> {\n  return EvalFunction.ENABLE_EVALFUNCTION\n    ? (EvalFunction.pureStrict(\n        EvalFunction.Return(\n          `${__KEY_FUNC} ${name}(){${EvalFunction.Return(`f(this, ...${__KEY_ARGUMENTS})`)} }`,\n        ),\n        [\"f\"],\n      )(fn) as any)\n    : useThis(fn)\n}\n\n/**\n * 创建一个函数，该函数将其 `arguments` 作为第一个参数传递给内部函数\n * @param fn 内部函数，接收 `arguments` 对象\n */\nexport const useArguments: {\n  <Fn extends (...args: any[]) => any>(\n    fn: (arg: IArguments & readonly [...Parameters<Fn>]) => ReturnType<Fn>,\n  ): Fn\n} = <Fn extends (...args: any[]) => any>(\n  fn: (arg: IArguments & readonly [...Parameters<Fn>]) => ReturnType<Fn>,\n): Fn =>\n  function () {\n    return fn(arguments as IArguments & Parameters<Fn>)\n  } as Fn\n\nconst withoutNew = (name?: string) =>\n  typeError(\n    `Class constructor ${name ? name + \" \" : \"\"}cannot be invoked without 'new'`,\n  )\n\n/**\n * 获取当前函数的调用者（callee）\n */\nexport const getCallee: () => IArguments[\"callee\"] = useArguments<\n  () => IArguments[\"callee\"]\n>((_) => _.callee)\n\n/**\n * 判断当前环境是否处于严格模式\n */\nexport const isStrictMode: boolean = !!tryCatch(getCallee, () => false)\n\nexport const OBJ_PROTO: any = getProtos(OBJECT)\n/**\n * 检查一个类是否继承了其他类（除了 Object）\n * @param target 类构造函数或函数\n */\nexport function hasParentClass(target: TClass<any, any[]>): boolean\nexport function hasParentClass(target: Function): boolean\nexport function hasParentClass(target: TClass<any, any[]> | Function) {\n  return getPrototypeOf(getProtos(target)) !== OBJ_PROTO\n}\n\nfunction _makeClassWith(proto: any, ctor: any): TClass<any, any[]> {\n  return (\n    hasParentClass(ctor) && JSObject.ownKeys(getProtos(ctor)).length > 0\n      ? JSObject.defineProperties(\n          getProtos(ctor),\n          JSObject.getOwnPropertyDescriptors(proto),\n        )\n      : setProtos(ctor, proto),\n    ctor\n  )\n}\n/**\n * 创建一个类，将其原型设置为指定的 proto 对象\n * 可以通过传递 proto 和 ctor，或者先传递 ctor 再传递 proto 来使用\n * @param protoOrCtor 原型对象或构造函数\n * @param ctor 可选的构造函数\n */\nexport function makeClassWith<Proto extends {}, Args extends any[]>(\n  ctor: (this: Proto, ...args: Args) => void,\n): (proto: ThisParameterType<Proto> & Proto) => TClass<Proto, Args>\nexport function makeClassWith<Args extends any[]>(\n  ctor: (this: Record<PropertyKey, any>, ...args: Args) => void,\n): <Proto extends {}>(proto: Proto) => TClass<Proto, Args>\nexport function makeClassWith<Proto extends {}, Args extends any[]>(\n  proto: ThisParameterType<Proto> & Proto,\n  ctor: (this: Proto, ...args: Args) => void,\n): TClass<Proto, Args>\nexport function makeClassWith(\n  protoOrCtor: any,\n  ctor?: any,\n): TClass<any, any[]> | ((proto: any) => TClass<any, any[]>) {\n  return ctor\n    ? _makeClassWith(protoOrCtor, ctor)\n    : (proto: any) => _makeClassWith(proto, protoOrCtor)\n}\n\n/**\n * 创建一个抽象类，将其原型设置为指定的 proto 对象\n * 可以通过传递 proto 和 ctor，或者先传递 ctor 再传递 proto 来使用\n * @param protoOrCtor 原型对象或构造函数\n * @param ctor 可选的构造函数\n */\nexport function makeProtoWith<Proto extends {}, Args extends any[]>(\n  ctor: (this: Proto, ...args: Args) => void,\n): (proto: ThisParameterType<Proto> & Proto) => AbstractClass<Proto, Args>\nexport function makeProtoWith<Proto extends {}, Args extends any[]>(\n  proto: ThisParameterType<Proto> & Proto,\n  ctor: (this: Proto, ...args: Args) => void,\n): AbstractClass<Proto, Args>\nexport function makeProtoWith(\n  protoOrCtor: any,\n  ctor?: any,\n): AbstractClass<any, any[]> | ((proto: any) => AbstractClass<any, any[]>) {\n  return makeClassWith(protoOrCtor, ctor)\n}\n\n/**\n * 创建一个抽象类，并将其原型设置为指定的 proto 对象\n * @param proto 原型对象\n */\nexport const makeProto = <Proto extends {}>(\n  proto: ThisParameterType<Proto> & Proto,\n): AbstractClass<Proto> =>\n  makeProtoWith(\n    proto,\n    useThis((self: any) =>\n      self === UNDEFINED || self === globalThis\n        ? isStrictMode\n          ? raise(withoutNew(self))\n          : { ...proto }\n        : UNDEFINED,\n    ),\n  )\n"]}