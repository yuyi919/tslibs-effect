  return self.join(separator)
}

export function filterJoin<A extends RA<string> | TypedArray>(
  self: A,
  predicate: EachFn<A, unknown>,
  separator?: string,
): string
export function filterJoin(
  self: RA,
  predicate: EachFn<RA, unknown>,
  separator?: string,
): string
export function filterJoin(
  self: any,
  predicate: EachFn<any, unknown>,
  sep: string = ",",
): string {
  return reduce(
    self,
    (r, a, i, self) => (predicate(a, i, self) ? (r ? r + sep + a : a + "") : r),
    "",
  )
}

