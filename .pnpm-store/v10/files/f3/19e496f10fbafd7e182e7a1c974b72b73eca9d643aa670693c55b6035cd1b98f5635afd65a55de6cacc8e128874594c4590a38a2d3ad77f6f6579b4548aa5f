/**
 * @remark check {@link Array.splice}
 */
export function removeElement<A>(
  self: Array<A>,
  startIndex: number,
  deleteCount: number = 1,
) {
  return splice(self, startIndex, deleteCount)
}

/**
 *
 * @param self - array
 * @param searchElement - see {@link Array.indexOf}
 * @param fromIndex - (DEFAULT: 0) see {@link Array.indexOf}
 * @param deleteCount - (DEFAULT: 1) see {@link Array.slice}
 * @returns succeed or fail
 */
export function removeElementByIndexOf<A>(
  self: Array<A>,
  searchElement: A,
  fromIndex?: number,
  deleteCount: number = 1,
) {
  return (
    (fromIndex = indexOf(self, searchElement, fromIndex)) > -1 &&
    (removeElement(self, fromIndex, deleteCount), true)
  )
}

export type EachFn<Arr extends ArrayLike<any>, R> = (
  currentValue: Element<Arr>,
  currentIndex: number,
  array: Arr,
) => R

export type EachRefinement<Arr extends RA<any>, R extends Element<Arr>> = {
  (currentValue: Element<Arr>): currentValue is R
  (
    currentValue: Element<Arr>,
    currentIndex: number,
    array: Arr,
  ): currentValue is R
}

export type EachRefinement2<A, R extends A> = {
  (currentValue: A): currentValue is R
  (currentValue: A, currentIndex: number): currentValue is R
}

export type AccumulatorFn<Arr extends readonly any[], B = Element<Arr>> = (
  previousValue: B,
  currentValue: Element<Arr>,
  currentIndex: number,
  array: Arr,
) => B

