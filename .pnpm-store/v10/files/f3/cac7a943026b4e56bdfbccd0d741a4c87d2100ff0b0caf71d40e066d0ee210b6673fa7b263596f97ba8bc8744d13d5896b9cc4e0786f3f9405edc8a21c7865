import * as Hash from "./Hash"
import { dual } from "./internal/helper"
import * as JsObject from "./JsObject"
import { EqualSymbol, HashSymbol, NodeInspectSymbol } from "./Symbol"

/**
 * @category Extensions
 */
export interface Inspectable<T = any> {
  toString(this: T): string
  toJSON(this: T): unknown
  [NodeInspectSymbol](
    this: T,
    depth: number,
    inspectOptions: import("util").InspectOptions,
    inspect: typeof import("util").inspect,
  ): unknown
}

/**
 * @category Extensions
 */
export interface Equal<T = any> {
  [EqualSymbol](this: T, that: unknown): boolean
}

/**
 * @category Extensions
 */
export interface PresetExtensions extends Hash.Hash, Equal, Inspectable {}

export function Add<O extends {}, Extends extends {}>(
  proto: O,
  exts: Partial<O> & Extends,
): O & Extends
export function Add<Extends extends {}>(
  exts: Extends,
): <O extends {}>(proto: O) => O & Extends
export function Add<O extends {}, Extends extends {}>(
  ...args: [any, any?]
): any {
  return dual(2, (proto: O, exts: Partial<O> & Extends) =>
    JsObject.defineProperties(proto, JsObject.getOwnPropertyDescriptors(exts)),
  )(...args)
}

export function AddTo<O extends {}>(
  proto: O,
): <Extends extends {}>(exts: Partial<O> & Extends) => O & Extends
export function AddTo(_1: any): any {
  return (_2: any) => Add(_1, _2)
}
