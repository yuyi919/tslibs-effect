import { cloneFn, len } from "./internal/helper"

export type Length = number
export function str(value: string): Length {
  return cloneFn(len)(value)
}
export function numberArray(value: ArrayLike<number>): Length {
  return cloneFn(len)(value)
}
export function unknownArray(value: ArrayLike<unknown>): Length {
  return cloneFn(len)(value)
}
export function strArray(value: ArrayLike<string>): Length {
  return cloneFn(len)(value)
}
export function mapLength(value: Map<unknown, unknown>): Length {
  return value.size
}
export function setLength(value: Set<unknown>): Length {
  return value.size
}
export function arrayBuffer(value: ArrayBuffer): Length {
  return value.byteLength
}
export function uint8Array(value: Uint8Array): Length {
  return cloneFn(len)(value)
}
export function uint8ClampedArray(value: Uint8ClampedArray): Length {
  return cloneFn(len)(value)
}
export function uint16Array(value: Uint16Array): Length {
  return cloneFn(len)(value)
}
export function uint32Array(value: Uint32Array): Length {
  return cloneFn(len)(value)
}
