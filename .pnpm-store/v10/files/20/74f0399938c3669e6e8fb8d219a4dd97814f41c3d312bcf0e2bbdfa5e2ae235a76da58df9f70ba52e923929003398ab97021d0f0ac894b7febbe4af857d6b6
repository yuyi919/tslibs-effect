/**
 * @since 1.0.0
 */
import type { Kind, Kind2, Kind3, URIS, URIS2, URIS3 } from "fp-ts/HKT"
import type { Predicate } from "fp-ts/Predicate"
import type { Refinement } from "fp-ts/Refinement"
import * as EHKT from "effect/HKT"
import * as identity from "fp-ts/Identity"

import type { AssertError } from "./internal/AssertsT"
import * as assertT from "./internal/AssertsT"

type unk = unknown

type EHKTKind1<Lambda extends EHKT.TypeLambda, A> = EHKT.Kind<
  Lambda,
  unk,
  unk,
  unk,
  A
>
type EHKTKind2<Lambda extends EHKT.TypeLambda, E, A> = EHKT.Kind<
  Lambda,
  unk,
  unk,
  E,
  A
>
type EHKTKind3<Lambda extends EHKT.TypeLambda, R, E, A> = EHKT.Kind<
  Lambda,
  unk,
  R,
  E,
  A
>
type EHKTKind4<Lambda extends EHKT.TypeLambda, S, R, E, A> = EHKT.Kind<
  Lambda,
  S,
  R,
  E,
  A
>

/**
 * @category model
 * @since 1.0.0
 */
export interface AssertsE<Lambda extends EHKT.TypeLambda>
  extends EHKT.TypeClass<Lambda> {
  assert<A>(a: unknown, msg?: string): asserts a is EHKTKind1<Lambda, A>
  assertWith<A>(
    value: any,
    isMatched: boolean,
    msg?: string,
  ): asserts value is EHKTKind1<Lambda, A>
}

/**
 * @category model
 * @since 1.0.0
 */
export type AssertsT<URI extends URIS> = {
  assert<A>(a: unknown, msg?: string): asserts a is Kind<URI, A>
  assertWith<A>(
    value: any,
    isMatched: boolean,
    msg?: string,
  ): asserts value is Kind<URI, A>
}
export type AssertsT2<URI extends URIS2> = {
  assert<A, B>(a: unknown, msg?: string): asserts a is Kind2<URI, A, B>
  assertWith<A, B>(
    value: unknown,
    isMatched: boolean,
    msg?: string,
  ): asserts value is Kind2<URI, A, B>
}
export type AssertsT3<URI extends URIS3> = {
  assert<A, B, C>(a: unknown, msg?: string): asserts a is Kind3<URI, A, B, C>
  assertWith<A, B, C>(
    value: unknown,
    isMatched: boolean,
    msg?: string,
  ): asserts value is Kind3<URI, A, B, C>
}
export type AssertsT1C<URI extends URIS, T> = {
  assert<A extends T>(a: unknown, msg?: string): asserts a is Kind<URI, A>
  assertWith<A extends T>(
    value: unknown,
    isMatched: boolean,
    msg?: string,
  ): asserts value is Kind<URI, A>
}
export type AssertsT2C<URI extends URIS2, T, T2> = {
  assert<A extends T, B extends T2>(
    a: unknown,
    msg?: string,
  ): asserts a is Kind2<URI, A, B>
  assertWith<A extends T, B extends T2>(
    value: unknown,
    isMatched: boolean,
    msg?: string,
  ): asserts value is Kind2<URI, A, B>
}
export type AssertsT3C<URI extends URIS3, T, T2, T3> = {
  assert<A extends T, B extends T2, C extends T3>(
    a: unknown,
    msg?: string,
  ): asserts a is Kind3<URI, A, B, C>
  assertWith<A extends T, B extends T2, C extends T3>(
    value: unknown,
    isMatched: boolean,
    msg?: string,
  ): asserts value is Kind3<URI, A, B, C>
}

export type AssertsId<T = any> = AssertsT1C<identity.URI, T>

export function getAsserts<M extends URIS3, A>(
  isMatched: Predicate<A>,
  URI: M,
): AssertsT3<M>
export function getAsserts<M extends URIS2, A>(
  isMatched: Predicate<A>,
  URI: M,
): AssertsT2<M>
export function getAsserts<M extends URIS, A, B extends A>(
  isMatched: Refinement<A, B>,
  URI: M,
): AssertsT1C<M, B>
export function getAsserts<M extends URIS, A>(
  isMatched: Predicate<A>,
  URI: M,
): AssertsT1C<M, A>
export function getAsserts<A>(
  isMatched: Predicate<A>,
  msg?: string,
): AssertsId<A>
export function getAsserts<A>(
  isMatched: Predicate<A>,
  msg?: string,
): AssertsId<A>
export function getAsserts<A>(a: Predicate<A>, b?: any): AssertsId<A> {
  return assertT.getAsserts(a, b)
}

export type { AssertError }
