const testSeqAndMap = (str: string) =>
  expect(
    runCode.runThrow(
      P.liftMap(
        ...(str.split("").map(S.string) as [
          P.Parser<string, string>,
          P.Parser<string, string>,
        ]),
        (...strs) => Monoid.concatAll(string.Monoid)(strs),
      ),
      str,
    ),
  ).toBe(str)

describe("新函数", () => {
  it("seqAndMap", () => {
    testSeqAndMap("12345")
    testSeqAndMap("abcde")
    testSeqAndMap("abcdefghijklmnopqrstuvwxyz")
  })
})

describe("altsAll", () => {
  it("seqAndMap", () => {
    expect(
      S.run("ac")(
        pipe(
          P.altAll([C.char("b"), C.char("a")]),
          P.apSecond(P.altAll([C.char("a"), C.char("b")])),
        ),
      ),
    ).toStrictEqual(PR.errorResult(Stream.from("ac", 1), [`"a"`, `"b"`]))
  })
})
