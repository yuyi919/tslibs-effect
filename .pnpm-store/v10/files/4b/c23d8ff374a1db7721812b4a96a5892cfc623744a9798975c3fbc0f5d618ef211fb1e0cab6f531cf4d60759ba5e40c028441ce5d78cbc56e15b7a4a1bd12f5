import * as AbortSignal from "./AbortSignal"
import { AbortError, TimeoutError } from "./Errors"
import { constFalse, constVoid, toRaise } from "./Functions"
import {
  __requestAnimationFrame,
  PROMISE,
  RESOLVE,
  SYMBOL_ASYNC_DISPOSE,
  SYMBOL_DISPOSE,
  VOID,
} from "./internal/constant"
import { tryCatch } from "./internal/helper"
import {
  __clearInterval,
  __clearTimeout,
  __setInterval,
  __setTimeout,
} from "./internal/timeout"
import { isInstanceof } from "./JsTypes"
import * as Ok from "./Ok"

export function make<T = void>(
  executor: (
    resolve: (value: T) => void,
    reject: (reason?: any) => void,
  ) => void,
): Promise<T> {
  return new PROMISE<T>(executor)
}

export function makeWithOk<T = void, E = any>(
  executor: (resolve: (value: T) => void, reject: (reason: E) => void) => void,
): Ok.PromiseOk<T, E> {
  return make((resolve) =>
    executor(
      (v) => resolve(Ok.ok(v)),
      (e) => resolve(Ok.no(e)),
    ),
  )
}

export function makeController<T = void>(): {
  _reject: (reason?: any) => void
  _resolve: (value: T) => void
  _resolved: Ok.Ok<T, void>
  _promise: Promise<T>
} {
  const controller = {
    _reject: toRaise() as (reason?: any) => void,
    _resolve: toRaise() as (value: T) => void,
    _resolved: Ok.no<void, T>(VOID),
    _promise: make<T>((resolve, reject) => {
      controller._reject = reject
      controller._resolve = resolve
    }),
  }
  return controller
}

export function castPromiseLike<T = void>(value: T): Promise<Awaited<T>> {
  return RESOLVE(value)
}

export function castPromiseLikeReject<T = void>(value: unknown): Promise<T> {
  return PROMISE.reject<T>(value)
}

export {
  /**
   * @deprecated use {@link castPromiseLike|Promisify.castPromiseLike}
   */
  castPromiseLike as asPromise,
  /**
   * @deprecated use {@link castPromiseLikeReject|Promisify.castPromiseLikeReject}
   */
  castPromiseLikeReject as asReject,
  /**
   * @deprecated use {@link make|Promisify.make}
   */
  make as promise,
}

/**
 * 用一个延时Promise包裹值
 * @param duration - 延时时间（毫秒）
 * @param value - 需要延时返回的值
 * @param options - 可选配置对象，支持传入AbortSignal处理abort逻辑
 * @throws 如果传入signal并被abort，则会抛出{@link AbortError|AbortError<R>}
 */
export function delayValue<T = void, R = any>(
  duration: number,
  value: T,
  options: TimeoutOptions<R> = {},
): Promise<T> {
  const { signal } = options
  if (signal && AbortSignal.isAborted(signal)) {
    return castPromiseLikeReject<T>(AbortSignal.error(signal))
  }
  return make<T>((resolve, reject) => {
    const timerId = __setTimeout(resolve, duration, value)
    if (signal) {
      AbortSignal.onAbort(signal, (reason) => {
        __clearTimeout(timerId)
        reject(reason)
      })
    }
  })
}

export function reqAF<R = any>(
  options: TimeoutOptions<R> = {},
): Promise<DOMHighResTimeStamp> {
  const { signal } = options
  if (signal && AbortSignal.isAborted(signal)) {
    return castPromiseLikeReject<DOMHighResTimeStamp>(AbortSignal.error(signal))
  }
  return make<DOMHighResTimeStamp>((resolve, reject) => {
    const timerId = __requestAnimationFrame!(resolve)
    if (signal) {
      AbortSignal.onAbort(signal, (reason) => {
        __clearTimeout(timerId)
        reject(reason)
      })
    }
  })
}

/**
 * 用一个延时Promise包裹值
 * @param duration - 延时时间（毫秒）
 * @param value - 需要延时返回的值
 * @param options - 可选配置对象，支持传入AbortSignal处理abort逻辑
 * @returns 返回{@link Ok.PromiseOk|Ok.PromiseOk<T, AbortError<R>>}
 */
export function delayValueOk<T = void, R = any>(
  duration: number,
  value: T,
  options: TimeoutOptions<R> = {},
): Ok.PromiseOk<T, AbortError<R>> {
  const { signal } = options
  if (signal && AbortSignal.isAborted(signal)) {
    return castPromiseLike(Ok.no(AbortSignal.error(signal)))
  }
  return makeWithOk<T, AbortError<R>>((resolve, reject) => {
    const timerId = __setTimeout(resolve, duration, value)
    if (signal) {
      AbortSignal.onAbort(signal, (reason) => {
        __clearTimeout(timerId)
        reject(new AbortError(reason))
      })
    }
  })
}

/**
 * 参照{@link delay}，但延时结束后会抛出{@link TimeoutError}
 *
 * 若catch到{@link AbortError}则直接返回而不会抛出错误
 * @param duration
 * @param options
 * @throws 通常抛出{@link TimeoutError}；若传入{@link AbortSignal}且延时后处于aborted则不会抛出
 */
export async function timeout<R = any>(
  duration: number,
  options?: TimeoutOptions<R>,
): Promise<void> {
  try {
    await delay(duration, options)
  } catch (e) {
    if (!isInstanceof(e, AbortError)) throw e
  }
  if (!options?.signal?.aborted) {
    throw new TimeoutError()
  }
}

/**
 * 创建一个延时 {@link Ok.PromiseOk|PromiseOk<void, AbortError<R>>}。
 * @param duration - 延时时间（毫秒）
 * @param options - 配置对象
 * @returns Promise
 */
export function delayOK<R>(
  duration: number,
  options?: TimeoutOptions<R>,
): Ok.PromiseOk<void, AbortError<R>> {
  return delayValueOk(duration, VOID, options)
}

export { delayOK as sleepOK }

/**
 * 创建一个延时 {@link Promise}。
 * @param duration - 延时时间（毫秒）
 * @param options - 配置对象
 * @returns Promise
 */
export function delay<R>(
  duration: number,
  options?: TimeoutOptions<R>,
): Promise<void> {
  return delayValue(duration, VOID, options)
}

/**
 * @deprecated 请使用{@link delay}
 */
export function sleep<R>(
  duration: number,
  options?: TimeoutOptions<R>,
): Promise<void> {
  return delay(duration, options)
}

export interface TimeoutOptions<R> {
  signal?: AbortSignal.AbortSignalLike<R>
}

export interface IntervalOptions<R> {
  signal?: AbortSignal.AbortSignalLike<R>
  immediate?: boolean
  onError?: (e: any, immediate: boolean) => void
}

export type AfterDispose<A, R> = Ok.Ok<A, AbortError<R>>
export interface IntervalHandle<A, R> {
  /**
   * 手动触发一次调用（不影响时序）
   * @returns 如果disposed或aborted，返回false，否则返回true
   */
  tick(): boolean
  readonly i: number
  afterDispose: Promise<AfterDispose<A, R>>
  isDisposed: boolean
  dispose(reason?: A): void
  /**
   * Creates a disposable scope for the resource, allowing use in `using` or `await using` statements.
   * @param reason
   */
  scope(reason?: A): {
    [SYMBOL_DISPOSE]: () => void
    [SYMBOL_ASYNC_DISPOSE]: () => void
  }
}

/**
 * 创建一个支持中止的定时器。
 * @param callback - 定时执行的回调函数，参数为从0开始随着callback调用次数递增的整数
 * @param duration - 定时间隔（毫秒）
 * @param options - 配置对象
 * @returns 定时器句柄
 */
export function makeInterval<A = void, R = any>(
  callback: (i: number) => void,
  duration: number,
  options: IntervalOptions<R> = {},
): IntervalHandle<A, R> {
  const { signal, immediate = false, onError } = options
  let timerId: ReturnType<typeof setInterval> | null = null,
    stopped: boolean = false

  const ctl = makeController<AfterDispose<A, R>>()

  if (signal?.aborted) {
    ctl._resolve(Ok.no(AbortSignal.error(signal)))
    return {
      dispose: constVoid,
      afterDispose: ctl._promise,
      i: 0,
      tick: constFalse,
      isDisposed: true,
      scope: (_a) => ({
        [SYMBOL_DISPOSE]: constVoid,
        [SYMBOL_ASYNC_DISPOSE]: constVoid,
      }),
    }
  }

  const clear = (reason: AfterDispose<A, R>): void => {
    if (timerId !== null) {
      __clearInterval(timerId)
      timerId = null
      ctl._resolve(reason)
    }
  }
  let index = 0
  const cb = () => {
    callback(index++)
  }
  const handle: IntervalHandle<A, R> = {
    dispose: (a) => clear(Ok.ok(a as A)),
    afterDispose: ctl._promise,
    tick: () => (stopped ? false : (cb(), true)),
    get i() {
      return index
    },
    get isDisposed() {
      return timerId === null
    },
    scope: (a) => ({
      [SYMBOL_DISPOSE]: () => handle.dispose(a),
      [SYMBOL_ASYNC_DISPOSE]: () => handle.dispose(a),
    }),
  }

  timerId = onError
    ? __setInterval(() => tryCatch(cb, (e) => onError(e, false)), duration)
    : __setInterval(cb, duration)

  if (immediate) {
    onError ? tryCatch(cb, (e) => onError(e, true)) : cb()
  }

  if (signal) {
    AbortSignal.onAbort(signal, (reason) =>
      ctl._resolve(Ok.no(new AbortError(reason))),
    )
  }

  return handle
}
