/**
 * @internal
 */
export function EQEQ<T>(value: unknown, target: unknown): target is T {
  return value == target
}

/**
 * @internal
 */
export function EQEQEQ<T>(value: unknown, target: T): target is T {
  return value === target
}

/**
 * @internal
 */
export function makeEqEq<T>(value: T): (value: unknown) => value is T {
  return curry(EQEQ)(value) as (value: unknown) => value is T
}
/**
 * @internal
 */
export function makeEqEqEq<T>(value: T): (value: unknown) => value is T {
  return curry(EQEQEQ)(value) as (value: unknown) => value is T
}

