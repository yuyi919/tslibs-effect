export function isZero(value: number): value is 0 {
  return value === 0
}

export function lengthIsZero(
  value: LengthLike,
): value is { readonly length: 0 } {
  return 0 === len(value)
}

export function hasNotKeys(value: {}): value is {} {
  return lengthIsZero(OBJ_KEYS(value as {}))
}

export function isStringEmpty(value: string): value is string {
  return lengthIsZero((value as string).trim())
}

export function isEmptyArray(value: any[]): boolean {
  return lengthIsZero(value as any[])
}

/**
 * @internal
 */
export const isEmptyMapper: {
  object: typeof hasNotKeys
  array: typeof lengthIsZero
  string: typeof isStringEmpty
  number: typeof isZero
} = {
  [__KEY_OBJ]: hasNotKeys,
  [__KEY_ARR]: lengthIsZero,
  [__KEY_STR]: isStringEmpty,
  [__KEY_NUM]: isZero,
}

/**
 *
 * @param value -
 * @public
 */
export function isEmpty(value: unknown): boolean {
  return isNil(value)
    ? IS_TRUE
    : (isEmptyMapper[getType(value) as keyof typeof isEmptyMapper]?.(
        value as never,
      ) ?? IS_FALSE)
}

/**
 * Checks if a given value is null or undefined.
