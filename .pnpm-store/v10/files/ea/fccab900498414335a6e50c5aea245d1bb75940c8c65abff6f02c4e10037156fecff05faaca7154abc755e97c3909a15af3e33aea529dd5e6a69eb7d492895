export function excludeNull<const T>(target: T): NonNullable<T> | undefined {
  return target ?? UNDEFINED
}

export function excludeNaN<const T extends number>(target: T): T | undefined {
  return exclude(target, isNaN)
}

export function filterWith<const T, const Expect extends T, A>(
  target: T,
  expect: Refinement<T, Expect>,
  to: (value: Expect) => A,
): A | undefined
export function filterWith<T, A>(
  target: T,
  expect: Predicate<T>,
  to: (value: T) => A,
): A | undefined
export function filterWith<const T, A>(
  target: T,
  expect: (a: T) => boolean,
  to: (value: any) => A,
): A | undefined {
  return expect(target) ? to(target) : UNDEFINED
}

export function filterWithNot<T, Expect extends T, A>(
  target: T,
  expect: Refinement<T, Expect>,
  to: (value: Exclude<T, Expect>) => A,
): A | undefined
export function filterWithNot<T, A>(
  target: T,
  expect: Predicate<T>,
  to: (value: T) => A,
): A | undefined
export function filterWithNot(
  target: unknown,
  expect: (a: unknown) => boolean,
  to: any,
): unknown {
  return expect(target) ? to(target) : UNDEFINED
}

