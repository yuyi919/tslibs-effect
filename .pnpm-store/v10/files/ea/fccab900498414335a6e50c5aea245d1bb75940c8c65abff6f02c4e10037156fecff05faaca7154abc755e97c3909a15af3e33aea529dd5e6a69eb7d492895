/**
 * 判断一个字符串是否表示一个数字（包括 NaN）。
 * @param source - 输入字符串
 * @returns 是否为数字字符串（包括 "NaN"）
 *
 * 实现原理：
 * - 使用 `source === "NaN"` 显式检查字符串是否为 "NaN"，因为后续的 `isStrictNumberString` 会排除 NaN。
 * - 调用 `isStrictNumberString` 检查其他数字情况（如 "123", "123.45"）。
 *
 * 设计意图：
 * - JavaScript 中 NaN 是一个特殊值，`+source === +source` 对 "NaN" 返回 false（NaN 不等于自身）。
 * - 但在某些场景下，用户可能希望 "NaN" 被视为合法数字字符串，因此显式包含此检查。
 * - 将 "NaN" 与其他数字分开处理，提供灵活性和清晰的语义。
 */
export function isNumberString(source: string): boolean {
  // 显式检查 "NaN" 是为了扩展函数适用范围，满足特定场景（如解析用户输入时允许 "NaN"）。
  // 否则，`isStrictNumberString` 会将其排除，逻辑更清晰。
  return source === "NaN" || isStrictNumberString(source)
}

/**
 * 严格判断一个字符串是否表示一个有效数字（不包括 NaN 和 BigInt）。
 * @param source - 输入字符串
 * @returns 是否为严格数字字符串
 *
 * 实现原理：
 * - `!!source` 确保字符串非空（空字符串 "" 转为数字是 0，但这里视为无效）。
 * - `+source === +source` 使用单目加号将字符串转为数字，并利用 NaN 不等于自身的特性：
 *   - 如果 `+source` 是 NaN，则 `+source === +source` 为 false。
 *   - 如果是有效数字（包括 Infinity），则相等。
 * - 单目加号遵循 ToNumber 规则，处理 "123", "123.45", " 123 " 等。
 *
 * 设计意图：
 * - 简单高效，避免函数调用（如 `isNaN`）或正则表达式，提升性能。
 * - 排除 NaN 和 BigInt（"123n" 转为 NaN），符合严格数字定义。
 * - 允许前导/尾随空白（如 " 123 "），因为 ToNumber 忽略空白，符合常见需求。
 */
export function isStrictNumberString(source: string): boolean {
  // 使用 `+source === +source` 而非 `!isNaN(+source)`，避免函数调用开销。
  // 不使用正则表达式（如 `/^\d+$/`），因为正则匹配性能较差且复杂。
  return !!source && +source === +source
}

/**
 * 判断一个字符串是否表示一个整数（可选去除首尾空白）。
 * @param source - 输入字符串
 * @param trim - 是否去除首尾空白，默认为 false
 * @returns 是否为整数字符串
 *
 * 实现原理：
 * - 如果 `trim` 为 true，则调用 `source.trim()` 去除首尾空白。
 * - 委托给 `isFullIntString` 进行具体检查。
 *
 * 设计意图：
 * - 通过 `trim` 参数提供灵活性，允许用户决定是否接受带空白的字符串（如 " 123 "）。
 * - 分离空白处理逻辑和核心整数检查逻辑，便于复用和维护。
 */
export function isInt32String(source: string, trim?: boolean): boolean {
  return isFullInt32String(trim ? source.trim() : source)
}

/**
 * 判断一个字符串是否完全表示一个整数（不含小数部分）。
 * @param source - 输入字符串
 * @returns 是否为完整整数字符串
 *
 * 实现原理：
 * - `(source as unknown as number) | 0` 将字符串视为数字并执行按位或操作：
 *   - `| 0` 会将数字截断为 32 位整数，小数部分被丢弃（如 123.45 变为 123）。
 *   - 如果 `source` 不是数字字符串，结果为 0。
 * - `"" + ...` 将截断后的结果转回字符串，与原字符串比较。
 * - 如果相等，说明原字符串表示一个整数（如 "123" 或 "-123"）。
 *
 * 示例：
 * - "123" → 123 | 0 → 123 → "123" === "123" → true。
 * - "123.45" → 123 | 0 → 123 → "123" !== "123.45" → false。
 * - "abc" → NaN | 0 → 0 → "0" !== "abc" → false。
 *
 * 设计意图：
 * - 使用按位操作快速截断小数，比 `parseInt` 或正则表达式更高效。
 * - 通过字符串比较确保结果精确匹配，避免数字转换中的浮点误差。
 * - 不直接用 `+source`，因为需要区分整数和小数，而 `+source` 保留小数部分。
 */
export function isFullInt32String(source: string): boolean {
  // `| 0` 是经典技巧，利用 JavaScript 按位运算强制转为 32 位整数，简单高效。
  // 直接用 `as unknown as number` 避免类型检查开销，但假定输入是字符串。
  return "" + ((source as unknown as number) | 0) === source
}

/**
 * 判断一个字符串是否完全表示一个整数（不含小数部分，支持 Number.MAX_SAFE_INTEGER）。
 * @param source - 输入字符串
 * @returns 是否为完整整数字符串
 *
 * 实现原理：
 * - 使用 `Number(source)` 将字符串转换为数字，范围支持到 Number.MAX_SAFE_INTEGER（2^53 - 1）。
 * - `num % 1 === 0` 检查转换结果是否为整数（余数为 0 表示无小数部分）。
 * - `String(num) === source` 确保转换后的字符串与原字符串完全一致，避免空白或格式差异。
 * - 检查 `source` 是否为空或非数字字符串（如 "abc"），排除无效输入。
 *
 * 示例：
 * - "123" → Number("123") = 123，123 % 1 = 0，"123" === "123" → true。
 * - "123.45" → Number("123.45") = 123.45，123.45 % 1 ≠ 0 → false。
 * - "9007199254740991" → Number("9007199254740991") = 9007199254740991，余数 0 → true。
 * - "abc" → Number("abc") = NaN，NaN % 1 = NaN ≠ 0 → false。
 *
 * 设计意图：
 * - 替代 `| 0` 的 32 位限制，支持更大的安全整数范围。
 * - 使用 `% 1 === 0` 代替 `Number.isInteger`，避免函数调用，可能提升性能。
 * - 通过字符串比较确保精确匹配，避免浮点数转换误差。
 */
export function isFullSafeIntString(source: string): boolean {
  let num: number
  // 检查是否为整数且与原字符串完全匹配
  // 转换为数字，支持到 Number.MAX_SAFE_INTEGER
  return !!source && (num = +source) % 1 === 0 && "" + num === source
}
export function isIntString(source: string): boolean {
  // 检查是否为整数
  return !!source && +source % 1 === 0 && !source.includes(".")
}

export function toJSONValue<T>(
  source: T,
): Exclude<T, undefined | symbol | bigint> | null
export function toJSONValue(source: any): any {
  return isSymbol(source) || isBigInt(source) ? null : (source ?? null)
}

export function toJSONString(source: any): string {
  return JSON.stringify(toJSONValue(source) ?? null, (k, v) => toJSONValue(v))
}

export function toBeTruthy(source: unknown): boolean {
  return !!source
}

export function toBeFalsy(source: unknown): boolean {
  return !source
}

export function toBool<T extends boolean>(source: T): boolean
export function toBool(source: unknown): boolean
export function toBool(source: unknown): boolean {
  return BOOLEAN(source)
}

export function toNumber<T extends number>(source: T): number
export function toNumber(source: unknown): number
export function toNumber(source: any): number {
  return NUMBER(source)
}

export function toArray<T>(source: T | readonly T[] | null | undefined): T[]
export function toArray<T>(
  source: T | undefined | null,
): T extends readonly any[] ? T : T[]
export function toArray(source: any): any[] {
  return isArr(source) ? source : isNil(source) || isNaN(source) ? [] : [source]
}

export function toReadonlyArray<T>(
  source: readonly T[] | null | undefined,
): readonly T[]
export function toReadonlyArray<T>(
  source: T | undefined | null,
): T extends readonly any[] ? readonly T[number][] : readonly T[]
export function toReadonlyArray(source: any): any[] {
  return toArray(source)
}

export function getPromiseValue<T>(value: PromiseLike<T>): T | undefined {
  let e!: T | undefined
  value.then((_e) => (e = _e))
  return e
}

export function toBe(value: unknown, value2: unknown): boolean {
  return isNaN(value) ? OBJECT_IS(value, value2) : value === value2
}

