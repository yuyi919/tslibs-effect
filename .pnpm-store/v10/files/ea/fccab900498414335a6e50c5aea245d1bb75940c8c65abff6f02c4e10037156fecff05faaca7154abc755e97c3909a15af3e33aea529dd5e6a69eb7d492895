export function withNonNullable<T, R>(
  target: T,
  f: (val: NonNullable<T>) => R,
): R | undefined {
  return filterWith(target, isNotNil, f)
}

export function exclude<const T, const Expect extends T = T>(
  target: T,
  expect: Refinement<T, Expect>,
): Exclude<T, Expect> | undefined
export function exclude<const T>(target: T, expect: Predicate<T>): T | undefined
export function exclude<
  const T extends Types.Primitive,
  const Expect extends T = T,
>(target: T, expect: Expect): Exclude<T, Expect> | undefined
export function exclude<const T>(target: T | null, expect: null): T | undefined
export function exclude<T, T2 extends T = T>(
  target: T,
  expect: T2,
): T | undefined
export function exclude<T>(target: T, expect: unknown): T | undefined
export function exclude<T>(target: T, expect: any): T | undefined {
  if (isFn(expect)) {
    return target === expect || expect(target) ? UNDEFINED : target
  }
  return target === expect ? UNDEFINED : target
}

export function extract<const T, const Expect extends T = T>(
  target: T,
  expect: Refinement<T, Expect> | Predicate<T>,
): Extract<T, Expect> | undefined
export function extract<
  const T extends Types.Primitive,
  const Expect extends T = T,
>(target: T, expect: Expect): (T & Expect) | undefined
export function extract<T, T2 extends T = T>(
  target: T,
  expect: T2,
): T | undefined
export function extract<T>(target: T, expect: unknown): T | undefined
export function extract(target: any, expect: any): any {
  if (isFn(expect)) {
    return target === expect || expect(target) ? target : UNDEFINED
  }
  return target === expect ? target : UNDEFINED
}

