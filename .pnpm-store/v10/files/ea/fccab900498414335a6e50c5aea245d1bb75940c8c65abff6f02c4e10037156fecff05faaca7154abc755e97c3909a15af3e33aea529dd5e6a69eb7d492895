/**
 * UNSAFE
 * @internal
 */
export function _instanceof<T>(
  value: unknown,
  constructor: abstract new (...args: any[]) => T,
): value is T {
  return (value instanceof constructor) as boolean
}

/**
 * @public
 */
export function isInstanceof<T>(
  value: unknown,
  constructor: abstract new (...args: any[]) => T,
): value is T {
  return (!!value && _instanceof(value, constructor)) as boolean
}

/**
 * @public
 */
export function makeInstanceof<T>(
  constructor: abstract new (...args: any[]) => T,
) {
  return (value: unknown): value is T => isInstanceof(value, constructor)
}

export type ObjectTag<Name extends string = string> = `[object ${Name}]`

const TYPES: readonly [
  "Map",
  "Set",
  "WeakSet",
  "WeakMap",
  "WeakRef",
  "Date",
  "RegExp",
  "Error",
  "ArrayBuffer",
  "DataView",
] = [
  __NAME_MAP,
  __NAME_SET,
  __NAME_WEAKSET,
  __NAME_WEAKMAP,
  __NAME_WEAKREF,
  __NAME_DATE,
  __NAME_REGEXP,
  __NAME_ERROR,
  __NAME_ARRAYBUFFER,
  __NAME_DATAVIEW,
] as const

/** @internal */
export const OBJECTTAG_Module: "[object Module]" = _makeObjTag("Module")
/** @internal */
export const OBJECTTAG_Arguments: "[object Arguments]" =
  _makeObjTag(__NAME_ARGUMENTS)

/**
 * @public
 */
export type BuiltinTypes =
  | (typeof types)[number]
  | (typeof TYPES)[number]
  | "null"
  | "NaN"
  | "TypedArray"
  | "undefined"
  | "bigint"

/** @internal */
export const tag2Type = /* @__PURE__ */ (() => {
  const class2type = {} as Record<ObjectTag, BuiltinTypes>
  forEach(
    types,
    (type) =>
      (class2type[_makeObjTag(type[0]!.toUpperCase() + type.slice(1))] = type),
  )
  forEach(TYPES, (type) => (class2type[_makeObjTag(type)] = type))
  return class2type
})() as {
  "[object ArrayBuffer]": "ArrayBuffer"
  "[object Array]": "array"
  "[object Boolean]": "boolean"
  "[object DataView]": "DataView"
  "[object Date]": "Date"
  "[object Error]": "Error"
  "[object Function]": "function"
  "[object Number]": "number"
  "[object Object]": "object"
  "[object Set]": "Set"
  "[object Map]": "Map"
  "[object RegExp]": "RegExp"
  "[object String]": "string"
  "[object Symbol]": "symbol"
  "[object Arguments]": "arguments"
  "[object WeakMap]": "WeakMap"
  "[object WeakSet]": "WeakSet"
  "[object WeakRef]": "WeakRef"
  [k: ObjectTag]: BuiltinTypes
}

export const type2Tag: Types.ReverseKV<{
  "[object ArrayBuffer]": "ArrayBuffer"
  "[object Array]": "array"
  "[object Boolean]": "boolean"
  "[object DataView]": "DataView"
  "[object Date]": "Date"
  "[object Error]": "Error"
  "[object Function]": "function"
  "[object Number]": "number"
  "[object Object]": "object"
  "[object Set]": "Set"
  "[object Map]": "Map"
  "[object RegExp]": "RegExp"
  "[object String]": "string"
  "[object Symbol]": "symbol"
  "[object Arguments]": "arguments"
  "[object WeakMap]": "WeakMap"
  "[object WeakSet]": "WeakSet"
  "[object WeakRef]": "WeakRef"
}> = invert(tag2Type)

/**
 *
 * @param value -
 * @beta
 */
export function getType(value: any): BuiltinTypes | Types.DynamicString {
  if (value === NULL) return __KEY_NULL
  if (value === UNDEFINED) return __KEY_UNDEFINED
  const typeofT = typeof value
  if (typeofT === __KEY_NUM && value !== value) return "NaN"

  const isObject = typeofT === __KEY_OBJ
  const isFn = typeofT === __KEY_FUNC
  return isObject || isFn ? getObjectType(value) : typeofT
}

export function getObjectType(value: object): BuiltinTypes {
  const type = _toStringTag(value)
  return tag2Type[type] ?? (type.endsWith("Array]") ? TYPED_ARRAY : __KEY_OBJ)
}

const _toStringTag = ((value: any) =>
  OBJECT_PROPOTYPE.toString.call(value)) as (value?: any) => ObjectTag

/**
 *
 * @param value -
 * @beta
 */
export function getTypeTag(value: unknown): ObjectTag {
  return _toStringTag(value)
}

/**
 *
 * @param value -
 * @public
 */
export function isPrimitive(value: any): value is Types.Primitive {
  let type: string
  return (
    isNil(value) ||
    ((type = _typeof(value)) !== __KEY_OBJ && type !== __KEY_FUNC)
  )
}

