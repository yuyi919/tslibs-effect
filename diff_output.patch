+// const FetchIconifyJsonResolverSimple =
+//   RequestResolver.fromEffectTagged<FetchIconifyJsonRequest>()({
+//     FetchIconifyJson: (reqs) => {
+//       console.log(
+//         `[FetchIconifyJsonResolverSimple] @iconify/json/json/${reqs
