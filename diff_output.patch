+	// yield* destDts("ic", { convertId, exportName: "MuiIcons" });
+	// yield* destDts("line-md", { exportName: "LineMdIcons" });
+
+	// console.log(
+	//   yield* Eff.all([fetchIconifyBatch("mdi"), fetchIconifyBatch("line-md")], {
