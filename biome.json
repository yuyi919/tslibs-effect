{
  "$schema": "https://biomejs.dev/schemas/2.4.11/schema.json",
  "root": true,
  "files": {
    "includes": [
      "*.json",
      "src/**/*.ts",
      "example/**/*.ts",
      "./*.ts",
      "!**/node_modules"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "a11y": {
        "noStaticElementInteractions": "off",
        "useKeyWithClickEvents": "off"
      },
      "complexity": "off",
      "correctness": {
        "noUnusedVariables": "off",
        "useImportExtensions": {
          "level": "off",
          "fix": "safe",
          "options": {
            "extensionMappings": {
              "ts": "",
              "js": ""
            }
          }
        }
      },
      "performance": {
        "noImgElement": "warn",
        "noUnwantedPolyfillio": "warn",
        "useGoogleFontPreconnect": "warn"
      },
      "style": {
        "noHeadElement": "warn",
        "noNonNullAssertion": "off",
        "useExportType": "warn"
      },
      "nursery": {},
      "security": {},
      "suspicious": {
        "noImportAssign": "error",
        "noAssignInExpressions": "off",
        "noConfusingVoidType": "off",
        "noConstEnum": "off",
        "noDocumentImportInPage": "error",
        "noExplicitAny": "off",
        "noHeadImportInDocument": "error",
        "noNonNullAssertedOptionalChain": "off",
        "useGoogleFontDisplay": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "always",
      "quoteStyle": "double",
      "bracketSpacing": true
    }
  },
  "overrides": [
    {
      "includes": [
        "src/**/*.ts",
        "example/**/*.ts",
        "!**/*.test.*",
        "!**/*.spec.*"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "warn",
              "options": {
                "filenameCases": [
                  "camelCase",
                  "kebab-case",
                  "PascalCase",
                  "export"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "json": { "formatter": { "enabled": true, "indentStyle": "space" } }
}
