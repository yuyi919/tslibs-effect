{
	"$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
	"root": true,
	"linter": { "enabled": false },
	"formatter": { "enabled": true },
	"files": {
		"includes": [
			"*.json",
			"./*.ts",
			"**/src/**/*",
			"**/scripts/**/*.ts",
			"**/test/**/*.ts",
			"!**/src/baml_client/**/*.ts",
			"!**/dist/**/*",
			"!**/node_modules",
			"!**/dist",
			"!**/coverage",
			"!**/*.js"
		]
	}
}
